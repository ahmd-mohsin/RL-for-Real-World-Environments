+# Deterministic transpose of an index list.  Sorting (index, original-position)
+# fixes the accumulation order independently of CTA scheduling.
+@triton.jit
+def index_count_kernel(idx,counts,B:tl.constexpr,L:tl.constexpr,N:tl.constexpr,
+                       I0:tl.constexpr,I1:tl.constexpr,I2:tl.constexpr,S:tl.constexpr,BLOCK:tl.constexpr):
+    p=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK);mask=p<B*L;b=p//L;q=p%L
+    if S > 1: ix=tl.load(idx+b*I0+(q//S)*I1+(q%S)*I2,mask=mask,other=0)
+    else: ix=tl.load(idx+b*I0+q*I1,mask=mask,other=0)
+    tl.atomic_add(counts+b*N+ix,1,mask=mask)
