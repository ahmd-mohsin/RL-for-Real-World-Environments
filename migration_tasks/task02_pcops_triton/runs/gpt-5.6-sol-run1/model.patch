+@triton.jit
+def index_prefix_kernel(counts,offsets,maxout,B:tl.constexpr,N:tl.constexpr,BLOCK:tl.constexpr):
+    b=tl.program_id(0);j=tl.arange(0,BLOCK);v=tl.load(counts+b*N+j,mask=j<N,other=0);p=tl.cumsum(v,axis=0)-v
+    tl.store(offsets+b*(N+1)+j,p,mask=j<N);tl.store(offsets+b*(N+1)+N,tl.sum(v,axis=0))
+    tl.atomic_max(maxout,tl.max(v,axis=0))
