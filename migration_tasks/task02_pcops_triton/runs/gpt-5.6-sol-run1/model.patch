+@triton.jit
+def index_sort_kernel(idx,perm,B:tl.constexpr,L:tl.constexpr,
+                      I0:tl.constexpr,I1:tl.constexpr,I2:tl.constexpr,S:tl.constexpr,BLOCK:tl.constexpr):
+    b=tl.program_id(0);p=tl.arange(0,BLOCK);mask=p<L
+    if S > 1: ix=tl.load(idx+b*I0+(p//S)*I1+(p%S)*I2,mask=mask,other=0).to(tl.int32)
+    else: ix=tl.load(idx+b*I0+p*I1,mask=mask,other=0).to(tl.int32)
+    key=tl.where(mask,ix*(L+1)+p,0x7fffffff);key=tl.sort(key,dim=0)
+    tl.store(perm+b*L+p,key%(L+1),mask=mask)
