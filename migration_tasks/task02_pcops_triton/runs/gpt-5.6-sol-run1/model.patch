+# ---------------------------------------------------------------- fps / grid
+@triton.jit
+def fps_count_kernel(src,ptr,outptr,total,maxdeg,maxsamp,B:tl.constexpr,RATIO:tl.constexpr,BLOCK_B:tl.constexpr):
+    i=tl.arange(0,BLOCK_B); p=tl.load(ptr+i,mask=i<=B,other=0)
+    deg=tl.load(ptr+i+1,mask=i<B,other=0)-p
+    # ceil in the same source dtype is dealt with by host ratio; float64 is exact enough for sizes.
+    rr=tl.full((BLOCK_B,),RATIO,src.dtype.element_ty)
+    prod=deg.to(src.dtype.element_ty)*rr
+    if tl.constexpr(src.dtype.element_ty == tl.float64): c=tl.ceil(prod).to(tl.int64)
+    else: c=tl.ceil(prod.to(tl.float32)).to(tl.int64)
+    pref=tl.cumsum(c,axis=0)-c
+    tl.store(outptr+i,pref,mask=i<B); s=tl.sum(tl.where(i<B,c,0),axis=0)
+    tl.store(outptr+B,s); tl.store(total,s); tl.store(maxdeg,tl.max(tl.where(i<B,deg,0),axis=0)); tl.store(maxsamp,tl.max(tl.where(i<B,c,0),axis=0))
