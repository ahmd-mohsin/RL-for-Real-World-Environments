+FLOATS = (torch.float16, torch.float32, torch.float64)
+PNFLOATS = FLOATS + (torch.bfloat16,)
+ALL = (torch.uint8, torch.int8, torch.int16, torch.int32, torch.int64, torch.float16, torch.bfloat16, torch.float32, torch.float64)
+
+
+def _launch_fill(x, value):
+    if x.numel(): K.fill_kernel[(triton.cdiv(x.numel(),256),)](x,value,x.numel(),BLOCK=256)
+
+def _contig(x):
+    if x.is_contiguous(): return x
+    _err(x.dim() <= 5, "pcops supports tensors with at most 5 dimensions")
