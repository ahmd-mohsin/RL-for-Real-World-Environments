+def fps(src,ptr,ratio,random_start):
+    _cuda(src,'src'); _cuda(ptr,'ptr'); _dtype(src,FLOATS,'fps'); _err(ptr.dtype==torch.long and ptr.dim()==1,'ptr must be a one-dimensional int64 tensor')
