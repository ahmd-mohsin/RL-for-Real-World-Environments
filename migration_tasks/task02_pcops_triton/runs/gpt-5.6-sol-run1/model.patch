+_IMPL.impl('knn',knn)
+
+
+def radius(x,y,ptr_x,ptr_y,r,maxn,ignore):
+    _cuda(x,'x');_cuda(y,'y');_dtype(x,PNFLOATS,'radius'); _err(y.dtype==x.dtype,'x and y must have the same dtype'); _err(x.dim()==2 and y.dim()==2 and x.shape[1]==y.shape[1],'x and y must be 2-D with the same feature dimension'); _err(maxn>=0,'max_num_neighbors must be non-negative')
