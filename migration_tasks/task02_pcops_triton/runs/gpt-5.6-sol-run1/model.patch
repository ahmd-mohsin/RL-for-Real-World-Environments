+    K.copy_strided_kernel[(triton.cdiv(x.numel(),256),)](x,y,x.numel(),S0=st[0],S1=st[1],S2=st[2],S3=st[3],S4=st[4],Z1=sh[1],Z2=sh[2],Z3=sh[3],Z4=sh[4],ND=x.dim(),BLOCK=256)
+    return y
+
+def _ptr_default(n, like):
+    # Host-to-device copies are asynchronous and do not launch a non-Triton GPU kernel.
+    return torch.tensor([0,n],dtype=torch.long,device=like.device)
+
+def _scalar(t): return int(t.item())
+def _pow2(n): return triton.next_power_of_2(max(int(n),1))
+def _strides3(t): return tuple(t.stride())
+
+
+# schemas are defined here rather than by a shared object.
+_LIB = torch.library.Library("pcops", "DEF")
+for schema in (
+ "fps(Tensor src, Tensor ptr, float ratio, bool random_start) -> Tensor",
+ "knn(Tensor x, Tensor y, Tensor? ptr_x, Tensor? ptr_y, int k, bool cosine) -> Tensor",
+ "radius(Tensor x, Tensor y, Tensor? ptr_x, Tensor? ptr_y, float r, int max_num_neighbors, bool ignore_same_index) -> Tensor",
+ "grid(Tensor pos, Tensor size, Tensor? start, Tensor? end) -> Tensor",
+ "segment_csr(Tensor src, Tensor indptr, str reduce) -> (Tensor, Tensor)",
+ "gather_csr(Tensor src, Tensor indptr) -> Tensor",
+ "scatter(Tensor src, Tensor index, int dim, int dim_size, str reduce) -> (Tensor, Tensor)",
+ "ball_query(Tensor new_xyz, Tensor xyz, float radius, int nsample) -> Tensor",
+ "group_points(Tensor features, Tensor idx) -> Tensor",
+ "group_points_backward(Tensor grad_out, Tensor idx, int n) -> Tensor",
+ "gather_points(Tensor features, Tensor idx) -> Tensor",
+ "gather_points_backward(Tensor grad_out, Tensor idx, int n) -> Tensor",
+ "three_nn(Tensor unknown, Tensor known) -> (Tensor, Tensor)",
+ "three_interpolate(Tensor features, Tensor idx, Tensor weight) -> Tensor",
+ "three_interpolate_backward(Tensor grad_out, Tensor idx, Tensor weight, int m) -> Tensor",
