+# ---------------------------------------------------------------- CSR and scatter
+@triton.jit
+def segment_kernel(src,ptr,out,arg,B:tl.constexpr,E:tl.constexpr,K:tl.constexpr,S:tl.constexpr,
+                   RED:tl.constexpr, IS_INT:tl.constexpr,BITS:tl.constexpr,UNSIGNED:tl.constexpr, IS0:tl.constexpr,IS1:tl.constexpr):
+    t=tl.program_id(0); k=t%K; z=t//K; s=z%S; b=z//S
+    a=tl.load(ptr+b*IS0+s*IS1); e=tl.load(ptr+b*IS0+(s+1)*IS1)
+    if RED == 0 or RED == 1:
+        if IS_INT:
+            acc=tl.zeros((),tl.int64)
+            for j in range(a,e): acc += tl.load(src+(b*E+j)*K+k).to(tl.int64)
+            if BITS < 64:
+                mod=1 << BITS
+                if UNSIGNED: acc = acc % mod
+                else: acc = ((acc+(mod//2))%mod)-(mod//2)
+            if RED == 1:
+                den=tl.maximum(e-a,1); acc=tl.where(acc>=0,acc//den,-((-acc)//den))
+            tl.store(out+t,acc)
+        else:
+            acc=tl.zeros((),tl.float64) if tl.constexpr(src.dtype.element_ty == tl.float64) else tl.zeros((),tl.float32)
+            for j in range(a,e): acc += tl.load(src+(b*E+j)*K+k)
+            if RED == 1: acc /= tl.maximum(e-a,1)
+            tl.store(out+t,acc)
+    else:
+        best=tl.load(src+(b*E+a)*K+k,mask=a<e,other=0.); bestj=a
+        for j in range(a+1,e):
+            v=tl.load(src+(b*E+j)*K+k); take=v<best if RED==2 else v>best
+            best=tl.where(take,v,best); bestj=tl.where(take,j,bestj)
+        tl.store(out+t,tl.where(a<e,best,0.)); tl.store(arg+t,tl.where(a<e,bestj,E))
+
+@triton.jit
+def gather_csr_kernel(src,ptr,out,B:tl.constexpr,E:tl.constexpr,K:tl.constexpr,S:tl.constexpr,
+                      IS0:tl.constexpr,IS1:tl.constexpr,BLOCK:tl.constexpr):
+    t=tl.program_id(0); k=t%K; z=t//K; s=z%S; b=z//S
+    a=tl.load(ptr+b*IS0+s*IS1); e=tl.load(ptr+b*IS0+(s+1)*IS1); j=a+tl.arange(0,BLOCK)
+    tl.store(out+(b*E+j)*K+k,tl.load(src+(b*S+s)*K+k),mask=j<e)
+
+@triton.jit
+def scatter_kernel(src,index,out,count,numel:tl.constexpr,E:tl.constexpr,K:tl.constexpr,N:tl.constexpr,
+                   RED:tl.constexpr,BLOCK:tl.constexpr):
+    t=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=t<numel; b=t//(E*K); k=t%K
+    ix=tl.load(index+t,mask=mask,other=0).to(tl.int64); v=tl.load(src+t,mask=mask)
+    dst=b*N*K+ix*K+k
+    if RED == 0 or RED == 1: tl.atomic_add(out+dst,v,mask=mask)
+    elif RED == 2: tl.atomic_min(out+dst,v,mask=mask)
+    else: tl.atomic_max(out+dst,v,mask=mask)
+    if RED == 1: tl.atomic_add(count+dst,1,mask=mask)
+
+@triton.jit
+def scatter_finish_kernel(out,count,n:tl.constexpr,RED:tl.constexpr,IS_INT:tl.constexpr,BLOCK:tl.constexpr):
+    i=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=i<n; v=tl.load(out+i,mask=mask)
+    if RED==1:
+        c=tl.maximum(tl.load(count+i,mask=mask),1)
+        if IS_INT: v=v//c
+        else: v=v/c
+    elif RED==2:
+        v=tl.where(v==float('inf'),0.,v)
+    elif RED==3:
+        v=tl.where(v==-float('inf'),0.,v)
+    tl.store(out+i,v,mask=mask)
+
+@triton.jit
+def scatter_arg_kernel(src,index,out,arg,numel:tl.constexpr,E:tl.constexpr,K:tl.constexpr,N:tl.constexpr,BLOCK:tl.constexpr):
+    t=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=t<numel; b=t//(E*K); e=(t//K)%E; k=t%K
+    ix=tl.load(index+t,mask=mask,other=0).to(tl.int64); dst=b*N*K+ix*K+k; v=tl.load(src+t,mask=mask)
+    # max/min tie arguments use a racing assignment, as in the original. A
+    # plain store intentionally preserves that tie behaviour.
+    tl.store(arg+dst,e,mask=mask&(v==tl.load(out+dst,mask=mask)))
+
+@triton.jit
+def scatter_arg_finish_kernel(arg,n:tl.constexpr,E:tl.constexpr,BLOCK:tl.constexpr):
+    i=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=i<n; v=tl.load(arg+i,mask=mask)
+    tl.store(arg+i,tl.where(v<0,E,v),mask=mask)
+
+@triton.jit
+def fps_update_kernel(src,ptr,outptr,dist,out,vals,inds,step,
+                      B:tl.constexpr,D:tl.constexpr,NCH:tl.constexpr,
+                      S0:tl.constexpr,S1:tl.constexpr,BLOCK:tl.constexpr):
+    pid=tl.program_id(0); b=pid//NCH; ch=pid%NCH
+    a=tl.load(ptr+b); e=tl.load(ptr+b+1); oa=tl.load(outptr+b); oe=tl.load(outptr+b+1)
+    j=ch*BLOCK+tl.arange(0,BLOCK); ix=a+j; active=(oa+step)<oe; mask=(ix<e)&active
+    old=tl.load(out+oa+step-1,mask=active,other=a)
+    dd=tl.zeros((BLOCK,),tl.float64) if tl.constexpr(src.dtype.element_ty == tl.float64) else tl.zeros((BLOCK,),tl.float32)
+    for d in tl.static_range(D):
+        z=tl.load(src+old*S0+d*S1,mask=active,other=0.)-tl.load(src+ix*S0+d*S1,mask=mask,other=0.)
+        if tl.constexpr(src.dtype.element_ty == tl.float16):
+            z=z.to(tl.float16);dd=(dd+(z*z).to(tl.float16)).to(tl.float16)
+        else:dd+=z*z
+    prev=tl.load(dist+ix,mask=mask,other=-1.);now=tl.minimum(prev,dd);tl.store(dist+ix,now,mask=mask)
+    best=tl.max(tl.where(mask,now,-1.),axis=0); key=(j%256)*((NCH*BLOCK+255)//256)+(j//256); kk=tl.min(tl.where(mask&(now==best),key,0x7fffffff),axis=0)
+    tl.store(vals+pid,best);tl.store(inds+pid,kk)
+
+@triton.jit
+def fps_reduce_kernel(ptr,outptr,out,vals,inds,step,B:tl.constexpr,NCH:tl.constexpr,BLOCK:tl.constexpr):
+    b=tl.program_id(0);j=tl.arange(0,BLOCK);mask=j<NCH;v=tl.load(vals+b*NCH+j,mask=mask,other=-1.);best=tl.max(v,axis=0)
+    ii=tl.load(inds+b*NCH+j,mask=mask,other=0x7fffffffffffffff); key=tl.min(tl.where(v==best,ii,0x7fffffffffffffff),axis=0); q=(NCH*BLOCK+255)//256; rel=(key%q)*256+key//q
+    oa=tl.load(outptr+b);oe=tl.load(outptr+b+1);a=tl.load(ptr+b)
+    tl.store(out+oa+step,a+rel,mask=(oa+step)<oe)
+
+@triton.jit
+def fps_first_kernel(ptr,outptr,starts,out,B:tl.constexpr,RANDOM:tl.constexpr,BLOCK:tl.constexpr):
+    b=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); v=tl.load(ptr+b,mask=b<B)
+    if RANDOM: v += tl.load(starts+b,mask=b<B)
+    tl.store(out+tl.load(outptr+b,mask=b<B),v,mask=b<B)
+
+@triton.jit
+def scatter_convert_kernel(acc,out,count,n:tl.constexpr,RED:tl.constexpr,IS_INT:tl.constexpr,BITS:tl.constexpr,UNSIGNED:tl.constexpr,BLOCK:tl.constexpr):
+    i=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK);mask=i<n;v=tl.load(acc+i,mask=mask)
+    if RED==1:
+        c=tl.maximum(tl.load(count+i,mask=mask),1)
+        if IS_INT:
+            if BITS < 32:
+                mod=1 << BITS
+                if UNSIGNED:v=v%mod
+                else:v=((v+(mod//2))%mod)-(mod//2)
+            v=v//c
+        else:v=v/c
+    elif RED==2:v=tl.where(v==float('inf'),0.,v)
+    elif RED==3:v=tl.where(v==-float('inf'),0.,v)
+    tl.store(out+i,v,mask=mask)
