index 0000000..c2d5c98
--- /dev/null
+++ b/_build_backend.py
@@ -0,0 +1,22 @@
+"""Tiny dependency-free PEP 517 backend for this pure-Python package."""
+from pathlib import Path
+import base64, csv, hashlib, os, zipfile
+NAME, VERSION = "pcops", "0.4.0"
+DIST = f"{NAME}-{VERSION}.dist-info"
+
+def _metadata():
+    return ("Metadata-Version: 2.1\nName: pcops\nVersion: 0.4.0\n"
+            "Requires-Dist: torch\nRequires-Dist: triton\n\n")
+def prepare_metadata_for_build_wheel(metadata_directory, config_settings=None):
+    d=Path(metadata_directory)/DIST; d.mkdir(parents=True,exist_ok=True)
+    (d/'METADATA').write_text(_metadata()); (d/'WHEEL').write_text('Wheel-Version: 1.0\nGenerator: pcops\nRoot-Is-Purelib: true\nTag: py3-none-any\n')
+    return DIST
+def build_wheel(wheel_directory, config_settings=None, metadata_directory=None):
+    fn=f"{NAME}-{VERSION}-py3-none-any.whl"; target=Path(wheel_directory)/fn; rows=[]
+    with zipfile.ZipFile(target,'w',zipfile.ZIP_DEFLATED) as z:
+        files={str(p).replace(os.sep,'/'):p.read_bytes() for p in Path('pcops').glob('*.py')}
+        files[f'{DIST}/METADATA']=_metadata().encode();files[f'{DIST}/WHEEL']=b'Wheel-Version: 1.0\nGenerator: pcops\nRoot-Is-Purelib: true\nTag: py3-none-any\n'
+        for n,data in files.items():
+            z.writestr(n,data);h=base64.urlsafe_b64encode(hashlib.sha256(data).digest()).rstrip(b'=').decode();rows.append((n,'sha256='+h,str(len(data))))
+        record=f'{DIST}/RECORD'; rows.append((record,'','')); text=''.join(','.join(r)+'\n' for r in rows);z.writestr(record,text)
+    return fn
