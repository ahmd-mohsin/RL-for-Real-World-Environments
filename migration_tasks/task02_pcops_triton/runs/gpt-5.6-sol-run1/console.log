    dim,p,B,S,Kc_dummy,S2=_csr_layout(src,indptr)
    # In gather, source's reduction dimension is S and destination extent is the
final pointer.
    _err(src.shape[dim]==0 or src.shape[dim]==indptr.shape[-1]-1,'src has wrong 
segment dimension')
    E=0 if src.numel()==0 else _scalar(p.reshape(-1)[-1]); 
Kc=math.prod(src.shape[dim+1:]);shape=list(src.shape);shape[dim]=E;out=torch.emp
ty(shape,dtype=src.dtype,device=src.device)
    if not src.numel():
        if out.numel():_launch_fill(out,0)
        return out
    x=_contig(src); total=B*src.shape[dim]*Kc; block=min(_pow2(max(E,1)),65536)
    K.gather_csr_kernel[(total,)](x,p,out,B=B,E=E,K=Kc,S=src.shape[dim],IS0=p.st
ride(-2) if p.dim()>1 else 0,IS1=p.stride(-1),BLOCK=block,num_warps=8)
    return out
_IMPL.impl('gather_csr',gather_csr)


