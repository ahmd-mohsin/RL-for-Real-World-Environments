def _csr_layout(src,indptr):
    _cuda(src,'src');_cuda(indptr,'indptr');_dtype(src,ALL,'segment_csr');_err(i
ndptr.dtype==torch.long,'indptr must be int64');_err(src.dim()>=indptr.dim() and
indptr.dim()>=1,'src.dim() must be >= indptr.dim()')
    dim=indptr.dim()-1; shape=list(indptr.shape)
    for i in range(dim): shape[i]=src.shape[i]
    try: p=indptr.expand(shape)
    except Exception as e: raise RuntimeError(str(e))
    p=_contig(p); B=math.prod(src.shape[:dim]); E=src.shape[dim]; 
Kc=math.prod(src.shape[dim+1:]); S=max(indptr.shape[-1]-1,0)
    return dim,p,B,E,Kc,S

def segment(src,indptr,reduce):
    _err(reduce in ('sum','mean','min','max'),f"segment_csr: unsupported reduce 
'{reduce}'")
    dim,p,B,E,Kc,S=_csr_layout(src,indptr); x=_contig(src); 
shape=list(src.shape);shape[dim]=S;out=torch.empty(shape,dtype=src.dtype,device=
src.device)
    arg=torch.empty(shape,dtype=torch.long,device=src.device) if reduce in 
('min','max') else torch.empty(0,dtype=torch.long,device=src.device)
    total=B*S*Kc
    if total:
        red={'sum':0,'mean':1,'min':2,'max':3}[reduce]
        K.segment_kernel[(total,)](x,p,out,arg,B=B,E=E,K=Kc,S=S,RED=red,IS0=p.st
ride(-2) if p.dim()>1 else 0,IS1=p.stride(-1),num_warps=1)
    elif out.numel():_launch_fill(out,0)
    return out,arg
_IMPL.impl('segment_csr',segment)

