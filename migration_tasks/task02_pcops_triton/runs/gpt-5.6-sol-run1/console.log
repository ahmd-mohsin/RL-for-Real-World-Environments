scatter
@triton.jit
def 
segment_kernel(src,ptr,out,arg,B:tl.constexpr,E:tl.constexpr,K:tl.constexpr,S:tl
.constexpr,
                   RED:tl.constexpr, IS0:tl.constexpr,IS1:tl.constexpr):
    t=tl.program_id(0); k=t%K; z=t//K; s=z%S; b=z//S
    a=tl.load(ptr+b*IS0+s*IS1); e=tl.load(ptr+b*IS0+(s+1)*IS1)
    if RED == 0 or RED == 1:
        acc=tl.zeros((),tl.float64) if tl.constexpr(src.dtype.element_ty == 
tl.float64) else tl.zeros((),tl.float32)
        for j in range(a,e): acc += tl.load(src+(b*E+j)*K+k)
        if RED == 1: acc /= tl.maximum(e-a,1)
        tl.store(out+t,acc)
    else:
        best=tl.load(src+(b*E+a)*K+k,mask=a<e,other=0.); bestj=a
        for j in range(a+1,e):
            v=tl.load(src+(b*E+j)*K+k); take=v<best if RED==2 else v>best
            best=tl.where(take,v,best); bestj=tl.where(take,j,bestj)
        tl.store(out+t,tl.where(a<e,best,0.)); 
tl.store(arg+t,tl.where(a<e,bestj,E))

@triton.jit
def 
gather_csr_kernel(src,ptr,out,B:tl.constexpr,E:tl.constexpr,K:tl.constexpr,S:tl.
constexpr,
                      IS0:tl.constexpr,IS1:tl.constexpr,BLOCK:tl.constexpr):
    t=tl.program_id(0); k=t%K; z=t//K; s=z%S; b=z//S
    a=tl.load(ptr+b*IS0+s*IS1); e=tl.load(ptr+b*IS0+(s+1)*IS1); 
j=a+tl.arange(0,BLOCK)
    tl.store(out+(b*E+j)*K+k,tl.load(src+(b*S+s)*K+k),mask=j<e)

@triton.jit
def 
scatter_kernel(src,index,out,count,numel:tl.constexpr,E:tl.constexpr,K:tl.conste
xpr,N:tl.constexpr,
                   RED:tl.constexpr,BLOCK:tl.constexpr):
    t=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=t<numel; b=t//(E*K); k=t%K
    ix=tl.load(index+t,mask=mask,other=0).to(tl.int64); 
v=tl.load(src+t,mask=mask)
    dst=b*N*K+ix*K+k
    if RED == 0 or RED == 1: tl.atomic_add(out+dst,v,mask=mask)
    elif RED == 2: tl.atomic_min(out+dst,v,mask=mask)
    else: tl.atomic_max(out+dst,v,mask=mask)
    if RED == 1: tl.atomic_add(count+dst,1,mask=mask)

@triton.jit
def 
scatter_finish_kernel(out,count,n:tl.constexpr,RED:tl.constexpr,BLOCK:tl.constex
pr):
    i=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=i<n; 
v=tl.load(out+i,mask=mask)
    if RED==1:
        c=tl.maximum(tl.load(count+i,mask=mask),1); v=v/c
    elif RED==2:
        v=tl.where(v==float('inf'),0.,v)
    elif RED==3:
        v=tl.where(v==-float('inf'),0.,v)
    tl.store(out+i,v,mask=mask)

@triton.jit
def 
scatter_arg_kernel(src,index,out,arg,numel:tl.constexpr,E:tl.constexpr,K:tl.cons
texpr,N:tl.constexpr,BLOCK:tl.constexpr):
    t=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=t<numel; b=t//(E*K); 
e=(t//K)%E; k=t%K
    ix=tl.load(index+t,mask=mask,other=0).to(tl.int64); dst=b*N*K+ix*K+k; 
v=tl.load(src+t,mask=mask)
    # max/min ties in torch_scatter use a racing assignment. Atomic max gives a
    # stable, valid last argument and avoids torn int64 stores.
    tl.atomic_max(arg+dst,e,mask=mask&(v==tl.load(out+dst,mask=mask)))
