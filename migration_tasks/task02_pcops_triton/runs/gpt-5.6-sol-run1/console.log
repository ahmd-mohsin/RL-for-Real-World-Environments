        const acc_t d  = dx * dx + dy * dy + dz * dz;
        if(d < best1)
        {
            best3  = best2;
            besti3 = besti2;
            best2  = best1;
            besti2 = besti1;
            best1  = d;
            besti1 = static_cast<int32_t>(j);
        }
        else if(d < best2)
        {
            best3  = best2;
            besti3 = besti2;
            best2  = d;
            besti2 = static_cast<int32_t>(j);
        }
        else if(d < best3)
        {
            best3  = d;
            besti3 = static_cast<int32_t>(j);
        }
    }
    dist2[t * 3 + 0] = static_cast<scalar_t>(best1);
    dist2[t * 3 + 1] = static_cast<scalar_t>(best2);
    dist2[t * 3 + 2] = static_cast<scalar_t>(best3);
    idx[t * 3 + 0]   = besti1;
    idx[t * 3 + 1]   = besti2;
    idx[t * 3 + 2]   = besti3;
}

template<typename scalar_t>
__global__ void three_interpolate_kernel(int64_t b, int64_t c, int64_t m, 
int64_t n,
                                         const scalar_t *__restrict__ features, 
// [B, C, m]
                                         const int32_t *__restrict__ idx,       
// [B, n, 3]
                                         const scalar_t *__restrict__ weight,   
// [B, n, 3]
                                         scalar_t *__restrict__ out)            
// [B, C, n]
{
    using acc_t     = at::opmath_type<scalar_t>;
    const int64_t t = blockIdx.x * static_cast<int64_t>(blockDim.x) + 
threadIdx.x;
    if(t >= b * c * n)
    {
        return;
    }
    const int64_t ni  = t % n;
    const int64_t ci  = (t / n) % c;
    const int64_t bi  = t / (n * c);
    const int64_t w   = (bi * n + ni) * 3;
    const scalar_t *f = features + (bi * c + ci) * m;
    const acc_t v     = static_cast<acc_t>(weight[w + 0]) * 
static_cast<acc_t>(f[idx[w + 0]])
                  + static_cast<acc_t>(weight[w + 1]) * 
static_cast<acc_t>(f[idx[w + 1]])
                  + static_cast<acc_t>(weight[w + 2]) * 
static_cast<acc_t>(f[idx[w + 2]]);
    out[t] = static_cast<scalar_t>(v);
}

template<typename scalar_t>
__global__ void three_interpolate_grad_kernel(int64_t b, int64_t c, int64_t n, 
int64_t m,
                                              const scalar_t *__restrict__ 
grad_out, // [B, C, n]
                                              const int32_t *__restrict__ idx,  
// [B, n, 3]
                                              const scalar_t *__restrict__ 
weight,   // [B, n, 3]
                                              scalar_t *__restrict__ 
grad_features)  // [B, C, m]
{
    using acc_t     = at::opmath_type<scalar_t>;
    const int64_t t = blockIdx.x * static_cast<int64_t>(blockDim.x) + 
threadIdx.x;
    if(t >= b * c * n)
    {
        return;
    }
    const int64_t ni = t % n;
    const int64_t ci = (t / n) % c;
    const int64_t bi = t / (n * c);
    const int64_t w  = (bi * n + ni) * 3;
    const acc_t g    = grad_out[t];
    scalar_t *gf     = grad_features + (bi * c + ci) * m;
    for(int j = 0; j < 3; ++j)
    {
        gpuAtomicAdd(gf + idx[w + j], static_cast<scalar_t>(g * 
static_cast<acc_t>(weight[w + j])));
    }
}

