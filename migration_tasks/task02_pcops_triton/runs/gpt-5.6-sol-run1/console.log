@triton.jit
def 
scatter_arg_finish_kernel(arg,n:tl.constexpr,E:tl.constexpr,BLOCK:tl.constexpr):
    i=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK); mask=i<n; 
v=tl.load(arg+i,mask=mask)
    tl.store(arg+i,tl.where(v<0,E,v),mask=mask)
