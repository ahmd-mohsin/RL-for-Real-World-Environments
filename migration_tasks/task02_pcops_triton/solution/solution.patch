index 0000000..6dfce98
--- /dev/null
+++ b/pcops/_kernels.py
@@ -0,0 +1,466 @@
+"""Triton kernels of pcops.
+
+Conventions: float inputs are converted to float32 for arithmetic (op-math)
+and results are stored in the input dtype. Index outputs are int64 for the
+pytorch_cluster / pytorch_scatter style operators and int32 for the
+PointNet++ style ones.
+"""
+import triton
+import triton.language as tl
+
+
+# ---------------------------------------------------------------- helpers
+
+@triton.jit
+def _ordered(bits):
+    """float32 bits -> int32 with the same order as the floats (negative
+    values flip their magnitude bits); an involution."""
+    return bits ^ ((bits >> 31) & 0x7FFFFFFF)
+
+
+@triton.jit
+def _pack(dist, idx):
+    """Order-preserving (distance, index) key: compares like (dist, idx)."""
+    o = _ordered(dist.to(tl.float32).to(tl.int32, bitcast=True))
+    return (o.to(tl.int64) << 32) | idx.to(tl.int64)
+
+
+@triton.jit
+def _unpack_dist(key):
+    return _ordered((key >> 32).to(tl.int32)).to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _unpack_idx(key):
+    return (key & 0xFFFFFFFF).to(tl.int32)
+
+
+# ---------------------------------------------------------------- fps
+
+@triton.jit
+def fps_small_kernel(src, ptr, out_ptr, start, out, D: tl.constexpr, BLOCK: tl.constexpr, ACC: tl.constexpr):
+    """One program per example whose points fit in one block: coordinates and
+    running distances stay in registers for every iteration."""
+    b = tl.program_id(0)
+    s = tl.load(ptr + b)
+    e = tl.load(ptr + b + 1)
+    o0 = tl.load(out_ptr + b)
+    o1 = tl.load(out_ptr + b + 1)
+    n = e - s
+    if o1 > o0:
+        offs = tl.arange(0, BLOCK)
+        valid = offs < n
+        x = tl.load(src + (s + offs) * D + 0, mask=valid, other=0.0).to(ACC)
+        y = tl.load(src + (s + offs) * D + 1, mask=valid & (D > 1), other=0.0).to(ACC)
+        z = tl.load(src + (s + offs) * D + 2, mask=valid & (D > 2), other=0.0).to(ACC)
+        dist = tl.where(valid, 5e4, -1.0)
+        old = tl.load(start + b)
+        tl.store(out + o0, s + old)
+        for m in range(o0 + 1, o1):
+            px = tl.load(src + (s + old) * D + 0).to(ACC)
+            dd = (x - px) * (x - px)
+            if D > 1:
+                py = tl.load(src + (s + old) * D + 1).to(ACC)
+                dd += (y - py) * (y - py)
+            if D > 2:
+                pz = tl.load(src + (s + old) * D + 2).to(ACC)
+                dd += (z - pz) * (z - pz)
+            dist = tl.where(valid, tl.minimum(dist, dd), -1.0)
+            old = tl.argmax(dist, axis=0, tie_break_left=True).to(tl.int64)
+            tl.store(out + m, s + old)
+
+
+@triton.jit
+def fps_large_kernel(src, ptr, out_ptr, start, out, dist_buf, D: tl.constexpr, BLOCK: tl.constexpr, ACC: tl.constexpr):
+    """Examples larger than one block: running distances in global memory,
+    one pass over the example per sample."""
+    b = tl.program_id(0)
+    s = tl.load(ptr + b)
+    e = tl.load(ptr + b + 1)
+    o0 = tl.load(out_ptr + b)
+    o1 = tl.load(out_ptr + b + 1)
+    n = e - s
+    if o1 > o0:
+        old = tl.load(start + b)
+        tl.store(out + o0, s + old)
+        for m in range(o0 + 1, o1):
+            best = tl.full([], -1.0, ACC)
+            best_i = tl.full([], 0, tl.int64)
+            for c in range(0, n, BLOCK):
+                offs = c + tl.arange(0, BLOCK)
+                valid = offs < n
+                dd = tl.zeros([BLOCK], ACC)
+                for d in tl.static_range(D):
+                    p = tl.load(src + (s + old) * D + d).to(ACC)
+                    q = tl.load(src + (s + offs) * D + d, mask=valid, other=0.0).to(ACC)
+                    dd += (q - p) * (q - p)
+                prev = tl.load(dist_buf + s + offs, mask=valid, other=5e4)
+                if m == o0 + 1:
+                    prev = tl.where(valid, 5e4, prev)
+                cur = tl.minimum(prev, dd)
+                tl.store(dist_buf + s + offs, cur, mask=valid)
+                cur = tl.where(valid, cur, -1.0)
+                cmax = tl.max(cur, axis=0)
+                carg = tl.argmax(cur, axis=0, tie_break_left=True).to(tl.int64)
+                take = cmax > best
+                best_i = tl.where(take, c + carg, best_i)
+                best = tl.where(take, cmax, best)
+            old = best_i
+            tl.store(out + m, s + old)
+
+
+# ---------------------------------------------------------------- knn / three_nn
+
+INF_KEY = tl.constexpr(0x7F8000007FFFFFFF)  # (+inf, max index)
+
+
+@triton.jit
+def _first_cols(keys, BQ: tl.constexpr, KP: tl.constexpr, BX: tl.constexpr):
+    """keys[:, :KP] of a [BQ, BX] tensor (BX a multiple of KP)."""
+    r = tl.arange(0, BX // KP)
+    head = tl.reshape(keys, [BQ, BX // KP, KP])
+    return tl.min(tl.where((r == 0)[None, :, None], head, INF_KEY), axis=1)
+
+
+@triton.jit
+def _merge_topk(best, key, BQ: tl.constexpr, KP: tl.constexpr, BX: tl.constexpr):
+    """KP smallest keys of best [BQ, KP] (ascending) and key [BQ, BX].
+    For ascending runs A and B, the KP smallest of A u B are
+    min(A[i], B[KP - 1 - i]) (a bitonic sequence), re-sorted."""
+    ks = tl.sort(key, dim=1)
+    low = tl.minimum(best, tl.flip(_first_cols(ks, BQ, KP, BX), 1))
+    return tl.sort(low, dim=1)
+
+
+@triton.jit
+def knn_kernel(x, y, ptr_x, ex_y, col, m, k, D: tl.constexpr, BQ: tl.constexpr, BX: tl.constexpr, KP: tl.constexpr,
+               COSINE: tl.constexpr):
+    """BQ queries per program. The candidates of every query are packed
+    (distance, index) keys, merged with each tile of BX points of its example,
+    so the result is nearest first with ties on the smaller index."""
+    qo = tl.program_id(0) * BQ + tl.arange(0, BQ)
+    qv = qo < m
+    ex = tl.load(ex_y + qo, mask=qv, other=0)
+    xs = tl.load(ptr_x + ex, mask=qv, other=0)
+    xe = tl.load(ptr_x + ex + 1, mask=qv, other=0)
+    lo = tl.min(tl.where(qv, xs, 9223372036854775807), axis=0)
+    hi = tl.max(tl.where(qv, xe, 0), axis=0)
+    best = tl.full([BQ, KP], INF_KEY, tl.int64)
+    for c in range(lo, hi, BX):
+        xo = c + tl.arange(0, BX)
+        ok = qv[:, None] & (xo[None, :] >= xs[:, None]) & (xo[None, :] < xe[:, None])
+        dd = tl.zeros([BQ, BX], tl.float32)
+        na = tl.zeros([BX], tl.float32)
+        nq = tl.zeros([BQ], tl.float32)
+        for d in tl.static_range(D):
+            a = tl.load(x + xo * D + d, mask=xo < hi, other=0.0).to(tl.float32)
+            q = tl.load(y + qo * D + d, mask=qv, other=0.0).to(tl.float32)
+            if COSINE:
+                dd += a[None, :] * q[:, None]
+                na += a * a
+                nq += q * q
+            else:
+                diff = a[None, :] - q[:, None]
+                dd += diff * diff
+        if COSINE:
+            dd = 1.0 - dd / (tl.sqrt(na)[None, :] * tl.sqrt(nq)[:, None])
+        key = tl.where(ok, _pack(dd, xo[None, :]), INF_KEY)
+        best = _merge_topk(best, key, BQ, KP, BX)
+    kk = tl.arange(0, KP)
+    good = (best != INF_KEY) & (kk[None, :] < k) & qv[:, None]
+    tl.store(col + qo[:, None] * k + kk[None, :], _unpack_idx(best).to(tl.int64), mask=good)
+
+
+@triton.jit
+def _insert3(b0, b1, b2, c):
+    """Insert key c into the ascending triple (b0, b1, b2), keeping the 3 smallest."""
+    n0 = tl.minimum(b0, c)
+    t = tl.maximum(b0, c)
+    n1 = tl.minimum(b1, t)
+    t2 = tl.maximum(b1, t)
+    n2 = tl.minimum(b2, t2)
+    return n0, n1, n2
+
+
+@triton.jit
+def three_nn_kernel(unknown, known, dist2, idx, n, m, BQ: tl.constexpr, BX: tl.constexpr):
+    """Batched [B, n, 3] queries against [B, m, 3]; grid (cdiv(n, BQ), B).
+    Every tile contributes its three smallest packed (distance, index) keys,
+    extracted by three min-reductions and merged with an insertion network.
+    Missing neighbours (m < 3) keep index 0 and distance +inf."""
+    b = tl.program_id(1)
+    qo = tl.program_id(0) * BQ + tl.arange(0, BQ)
+    qv = qo < n
+    ux = tl.load(unknown + (b * n + qo) * 3 + 0, mask=qv, other=0.0).to(tl.float32)
+    uy = tl.load(unknown + (b * n + qo) * 3 + 1, mask=qv, other=0.0).to(tl.float32)
+    uz = tl.load(unknown + (b * n + qo) * 3 + 2, mask=qv, other=0.0).to(tl.float32)
+    b0 = tl.full([BQ], INF_KEY, tl.int64)
+    b1 = tl.full([BQ], INF_KEY, tl.int64)
+    b2 = tl.full([BQ], INF_KEY, tl.int64)
+    for c in range(0, m, BX):
+        xo = c + tl.arange(0, BX)
+        xv = xo < m
+        kx = tl.load(known + (b * m + xo) * 3 + 0, mask=xv, other=0.0).to(tl.float32)
+        ky = tl.load(known + (b * m + xo) * 3 + 1, mask=xv, other=0.0).to(tl.float32)
+        kz = tl.load(known + (b * m + xo) * 3 + 2, mask=xv, other=0.0).to(tl.float32)
+        dx = kx[None, :] - ux[:, None]
+        dy = ky[None, :] - uy[:, None]
+        dz = kz[None, :] - uz[:, None]
+        key = tl.where(xv[None, :], _pack(dx * dx + dy * dy + dz * dz, xo[None, :]), INF_KEY)
+        for _ in tl.static_range(3):
+            k = tl.min(key, axis=1)
+            b0, b1, b2 = _insert3(b0, b1, b2, k)
+            key = tl.where(key == k[:, None], INF_KEY, key)
+    base = (b * n + qo) * 3
+    for t in tl.static_range(3):
+        kk = b0 if t == 0 else (b1 if t == 1 else b2)
+        found = kk != INF_KEY
+        tl.store(dist2 + base + t, tl.where(found, _unpack_dist(kk), float("inf")).to(dist2.dtype.element_ty), mask=qv)
+        tl.store(idx + base + t, tl.where(found, _unpack_idx(kk), 0), mask=qv)
+
+
+# ---------------------------------------------------------------- radius / ball query
+
+@triton.jit
+def radius_kernel(x, y, ptr_x, ex_y, col, m, r2, max_nb, ignore_same, D: tl.constexpr, BQ: tl.constexpr, BX: tl.constexpr, ACC: tl.constexpr):
+    """For every query, the first max_nb points (index order) of its example
+    with squared distance < r2. Tiles are compacted with a prefix sum, so the
+    order is exact without atomics."""
+    qo = tl.program_id(0) * BQ + tl.arange(0, BQ)
+    qv = qo < m
+    ex = tl.load(ex_y + qo, mask=qv, other=0)
+    xs = tl.load(ptr_x + ex, mask=qv, other=0)
+    xe = tl.load(ptr_x + ex + 1, mask=qv, other=0)
+    lo = tl.min(tl.where(qv, xs, 9223372036854775807), axis=0)
+    hi = tl.max(tl.where(qv, xe, 0), axis=0)
+    count = tl.zeros([BQ], tl.int64)
+    for c in range(lo, hi, BX):
+        if tl.min(tl.where(qv, count, max_nb), axis=0) < max_nb:
+            xo = c + tl.arange(0, BX)
+            ok = qv[:, None] & (xo[None, :] >= xs[:, None]) & (xo[None, :] < xe[:, None])
+            dd = tl.zeros([BQ, BX], ACC)
+            for d in tl.static_range(D):
+                a = tl.load(x + xo * D + d, mask=xo < hi, other=0.0).to(ACC)
+                q = tl.load(y + qo * D + d, mask=qv, other=0.0).to(ACC)
+                diff = a[None, :] - q[:, None]
+                dd += diff * diff
+            hit = ok & (dd < r2)
+            if ignore_same:
+                hit = hit & (xo[None, :] != qo[:, None])
+            pos = count[:, None] + tl.cumsum(hit.to(tl.int64), axis=1) - 1
+            keep = hit & (pos < max_nb)
+            tl.store(col + qo[:, None] * max_nb + pos, xo[None, :].to(tl.int64), mask=keep)
+            count += tl.sum(hit.to(tl.int64), axis=1)
+
+
+@triton.jit
+def ball_query_kernel(new_xyz, xyz, idx, n, m, r2, nsample, BQ: tl.constexpr, BX: tl.constexpr, ACC: tl.constexpr):
+    """Batched; grid (cdiv(m, BQ), B). First nsample points with d2 < r2,
+    padded with the first hit; 0 when there is none."""
+    b = tl.program_id(1)
+    qo = tl.program_id(0) * BQ + tl.arange(0, BQ)
+    qv = qo < m
+    cx = tl.load(new_xyz + (b * m + qo) * 3 + 0, mask=qv, other=0.0).to(ACC)
+    cy = tl.load(new_xyz + (b * m + qo) * 3 + 1, mask=qv, other=0.0).to(ACC)
+    cz = tl.load(new_xyz + (b * m + qo) * 3 + 2, mask=qv, other=0.0).to(ACC)
+    count = tl.zeros([BQ], tl.int32)
+    first = tl.zeros([BQ], tl.int32)
+    out = idx + (b * m + qo) * nsample
+    for c in range(0, n, BX):
+        if tl.min(tl.where(qv, count, nsample), axis=0) < nsample:
+            xo = c + tl.arange(0, BX)
+            xv = xo < n
+            px = tl.load(xyz + (b * n + xo) * 3 + 0, mask=xv, other=0.0).to(ACC)
+            py = tl.load(xyz + (b * n + xo) * 3 + 1, mask=xv, other=0.0).to(ACC)
+            pz = tl.load(xyz + (b * n + xo) * 3 + 2, mask=xv, other=0.0).to(ACC)
+            dx = px[None, :] - cx[:, None]
+            dy = py[None, :] - cy[:, None]
+            dz = pz[None, :] - cz[:, None]
+            hit = qv[:, None] & xv[None, :] & (dx * dx + dy * dy + dz * dz < r2)
+            # first hit of this tile, for queries that had none yet
+            tile_first = tl.min(tl.where(hit, xo[None, :], 2147483647), axis=1)
+            first = tl.where((count == 0) & (tile_first < 2147483647), tile_first, first)
+            pos = count[:, None] + tl.cumsum(hit.to(tl.int32), axis=1) - 1
+            keep = hit & (pos < nsample)
+            tl.store(out[:, None] + pos, xo[None, :].to(tl.int32), mask=keep)
+            count += tl.sum(hit.to(tl.int32), axis=1)
+    # pad the remaining slots with the first hit (0 when there was none)
+    for s0 in range(0, nsample, BX):
+        so = s0 + tl.arange(0, BX)
+        pad = qv[:, None] & (so[None, :] >= count[:, None]) & (so[None, :] < nsample)
+        tl.store(out[:, None] + so[None, :], tl.broadcast_to(first[:, None], [BQ, BX]), mask=pad)
+
+
+@triton.jit
+def grid_kernel(pos, size, start, end, out, N, D: tl.constexpr, BLOCK: tl.constexpr, ACC: tl.constexpr):
+    o = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    v = o < N
+    c = tl.zeros([BLOCK], tl.int64)
+    k = 1
+    for d in tl.static_range(D):
+        sz = tl.load(size + d).to(ACC)
+        st = tl.load(start + d).to(ACC)
+        en = tl.load(end + d).to(ACC)
+        p = tl.load(pos + o * D + d, mask=v, other=0.0).to(ACC) - st
+        c += (p / sz).to(tl.int64) * k
+        k = k * (((en - st) / sz).to(tl.int64) + 1)
+    tl.store(out + o, c, mask=v)
+
+
+# ---------------------------------------------------------------- feature gathers
+
+@triton.jit
+def gather_rows_kernel(features, idx, out, C, N, M, BLOCK: tl.constexpr):
+    """out[b, c, j] = features[b, c, idx[b, j]] for idx flattened over M
+    (group_points: M = m * s; gather_points: M = m)."""
+    bc = tl.program_id(1)
+    b = bc // C
+    j = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    v = j < M
+    i = tl.load(idx + b * M + j, mask=v, other=0)
+    val = tl.load(features + bc * N + i, mask=v, other=0.0)
+    tl.store(out + bc * M + j, val, mask=v)
+
+
+@triton.jit
+def scatter_rows_kernel(grad_out, idx, grad, C, N, M, BLOCK: tl.constexpr):
+    """grad[b, c, idx[b, j]] += grad_out[b, c, j]; grad is float32 (float64 for double)."""
+    bc = tl.program_id(1)
+    b = bc // C
+    j = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    v = j < M
+    i = tl.load(idx + b * M + j, mask=v, other=0)
+    g = tl.load(grad_out + bc * M + j, mask=v, other=0.0).to(grad.dtype.element_ty)
+    tl.atomic_add(grad + bc * N + i, g, mask=v, sem="relaxed")
+
+
+@triton.jit
+def three_interpolate_kernel(features, idx, weight, out, C, m, n, BLOCK: tl.constexpr, ACC: tl.constexpr):
+    bc = tl.program_id(1)
+    b = bc // C
+    j = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    v = j < n
+    acc = tl.zeros([BLOCK], ACC)
+    for t in tl.static_range(3):
+        i = tl.load(idx + (b * n + j) * 3 + t, mask=v, other=0)
+        w = tl.load(weight + (b * n + j) * 3 + t, mask=v, other=0.0).to(ACC)
+        f = tl.load(features + bc * m + i, mask=v, other=0.0).to(ACC)
+        acc += w * f
+    tl.store(out + bc * n + j, acc.to(out.dtype.element_ty), mask=v)
+
+
+@triton.jit
+def three_interpolate_grad_kernel(grad_out, idx, weight, grad, C, m, n, BLOCK: tl.constexpr):
+    bc = tl.program_id(1)
+    b = bc // C
+    j = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    v = j < n
+    g = tl.load(grad_out + bc * n + j, mask=v, other=0.0).to(grad.dtype.element_ty)
+    for t in tl.static_range(3):
+        i = tl.load(idx + (b * n + j) * 3 + t, mask=v, other=0)
+        w = tl.load(weight + (b * n + j) * 3 + t, mask=v, other=0.0).to(grad.dtype.element_ty)
+        tl.atomic_add(grad + bc * m + i, g * w, mask=v, sem="relaxed")
+
+
+# ---------------------------------------------------------------- segment / scatter
+
+@triton.jit
+def segment_csr_kernel(src, indptr, out, arg, S, E, K, src_dim, REDUCE: tl.constexpr, IS_FLOAT: tl.constexpr, BK: tl.constexpr, ACC: tl.constexpr):
+    """src viewed as [L, E, K], indptr as [L, S + 1], out as [L, S, K].
+    One program per (l, s, k-tile). REDUCE: 0 sum, 1 mean, 2 min, 3 max.
+    min/max keep the first extremum; empty segments give 0 (arg = src_dim)."""
+    ls = tl.program_id(0)
+    l = ls // S
+    s = ls % S
+    ko = tl.program_id(1) * BK + tl.arange(0, BK)
+    kv = ko < K
+    a = tl.load(indptr + l * (S + 1) + s)
+    e = tl.load(indptr + l * (S + 1) + s + 1)
+    if REDUCE == 2:
+        acc = tl.full([BK], float("inf"), ACC) if IS_FLOAT else tl.full([BK], 9223372036854775807, tl.int64)
+    elif REDUCE == 3:
+        acc = tl.full([BK], float("-inf"), ACC) if IS_FLOAT else tl.full([BK], -9223372036854775807 - 1, tl.int64)
+    else:
+        acc = tl.zeros([BK], ACC) if IS_FLOAT else tl.zeros([BK], tl.int64)
+    best = tl.full([BK], src_dim, tl.int64)
+    for p in range(a, e):
+        x = tl.load(src + (l * E + p) * K + ko, mask=kv, other=0)
+        x = x.to(ACC) if IS_FLOAT else x.to(tl.int64)
+        if REDUCE == 2:
+            take = x < acc
+            best = tl.where(take, p, best)
+            acc = tl.where(take, x, acc)
+        elif REDUCE == 3:
+            take = x > acc
+            best = tl.where(take, p, best)
+            acc = tl.where(take, x, acc)
+        else:
+            acc += x
+    cnt = e - a
+    if REDUCE == 1:
+        if IS_FLOAT:
+            acc = acc / tl.maximum(cnt, 1).to(ACC)
+        else:
+            acc = acc // tl.maximum(cnt, 1)
+    if REDUCE >= 2:
+        acc = tl.where(cnt > 0, acc, 0)
+        tl.store(arg + (l * S + s) * K + ko, best, mask=kv)
+    tl.store(out + (l * S + s) * K + ko, acc.to(out.dtype.element_ty), mask=kv)
+
+
+@triton.jit
+def gather_csr_kernel(src, indptr, out, S, E_out, K, LOG_S: tl.constexpr, BR: tl.constexpr, BK: tl.constexpr):
+    """out[l, p, k] = src[l, s, k] with indptr[l, s] <= p < indptr[l, s + 1].
+    BR output rows per program; each row finds its segment by binary search."""
+    l = tl.program_id(2)
+    po = tl.program_id(0) * BR + tl.arange(0, BR)
+    pv = po < E_out
+    ko = tl.program_id(1) * BK + tl.arange(0, BK)
+    kv = ko < K
+    base = indptr + l * (S + 1)
+    # largest s with indptr[s] <= p (segments may be empty)
+    lo = tl.zeros([BR], tl.int64)
+    hi = tl.full([BR], S, tl.int64)
+    for _ in tl.static_range(LOG_S + 1):
+        mid = (lo + hi + 1) // 2
+        go = tl.load(base + mid, mask=pv & (lo < hi), other=0) <= po
+        lo = tl.where((lo < hi) & go, mid, lo)
+        hi = tl.where((lo < hi) & (~go), mid - 1, hi)
+    s = tl.minimum(lo, S - 1)
+    inside = pv & (po < tl.load(base + S))  # rows past this l's last segment are zero
+    v = tl.load(src + (l * S + s)[:, None] * K + ko[None, :], mask=inside[:, None] & kv[None, :], other=0)
+    tl.store(out + (l * E_out + po)[:, None] * K + ko[None, :], v, mask=pv[:, None] & kv[None, :])
+
+
+@triton.jit
+def scatter_kernel(src, index, out, B, E, K, N, REDUCE: tl.constexpr, BLOCK: tl.constexpr):
+    """src/index viewed as [B, E, K], out (accumulator dtype) as [B, N, K].
+    REDUCE: 0 sum, 2 min, 3 max (atomics)."""
+    o = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    v = o < B * E * K
+    k = o % K
+    b = o // (E * K)
+    i = tl.load(index + o, mask=v, other=0)
+    x = tl.load(src + o, mask=v, other=0).to(out.dtype.element_ty)
+    dst = out + (b * N + i) * K + k
+    if REDUCE == 0:
+        tl.atomic_add(dst, x, mask=v, sem="relaxed")
+    elif REDUCE == 2:
+        tl.atomic_min(dst, x, mask=v, sem="relaxed")
+    else:
+        tl.atomic_max(dst, x, mask=v, sem="relaxed")
+
+
+@triton.jit
+def scatter_arg_kernel(src, index, out, arg, B, E, K, N, BLOCK: tl.constexpr):
+    """arg[b, i, k] = smallest e with src[b, e, k] == out[b, i, k]."""
+    o = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    v = o < B * E * K
+    k = o % K
+    e = (o // K) % E
+    b = o // (E * K)
+    i = tl.load(index + o, mask=v, other=0)
+    x = tl.load(src + o, mask=v, other=0).to(out.dtype.element_ty)
+    dst = (b * N + i) * K + k
+    hit = v & (x == tl.load(out + dst, mask=v, other=0))
+    tl.atomic_min(arg + dst, e.to(tl.int64), mask=hit, sem="relaxed")
