+"""Registration of the Triton implementations as torch.ops.pcops.*.
+
+Each operator is a torch.library.custom_op with the schema of the former
+CUDA extension, so the fake implementations and autograd formulas in
+_registration.py (and torch.compile) work unchanged.
+"""
+import math
+from typing import List, Optional, Tuple
+
+import torch
+import triton
+
+from . import _kernels as K
+
+_REDUCE = {"sum": 0, "mean": 1, "min": 2, "max": 3}
+
+
+def _acc(t: torch.Tensor):
+    import triton.language as tl
+
+    return tl.float64 if t.dtype == torch.float64 else tl.float32
+
+
+def _default_ptr(ptr: Optional[torch.Tensor], n: int, device) -> torch.Tensor:
+    if ptr is None:
+        return torch.tensor([0, n], dtype=torch.long, device=device)
+    return ptr.contiguous()
+
+
+def _example_of_rows(ptr: torch.Tensor, n: int) -> torch.Tensor:
+    deg = ptr[1:] - ptr[:-1]
+    return torch.repeat_interleave(torch.arange(deg.numel(), device=ptr.device), deg, output_size=n)
+
+
+# ---------------------------------------------------------------- sampling / neighbourhoods
+
+@torch.library.custom_op("pcops::fps", mutates_args=())
+def fps(src: torch.Tensor, ptr: torch.Tensor, ratio: float, random_start: bool) -> torch.Tensor:
+    torch._check(0.0 < ratio <= 1.0, lambda: f"fps: ratio must be in (0, 1], got {ratio}")
+    src = src.reshape(src.size(0), -1).contiguous()
+    ptr = ptr.contiguous()
+    B = ptr.numel() - 1
+    deg = ptr[1:] - ptr[:-1]
+    out_ptr = torch.zeros_like(ptr)
+    out_ptr[1:] = torch.ceil(deg.to(torch.float64) * ratio).long().cumsum(0)
+    total = int(out_ptr[-1])
+    out = torch.empty(total, dtype=torch.long, device=src.device)
+    if total == 0:
+        return out
+    if random_start:
+        start = (torch.rand(B, device=src.device, dtype=src.dtype) * deg.to(src.dtype)).long()
+    else:
+        start = torch.zeros(B, dtype=torch.long, device=src.device)
+    D = src.size(1)
+    max_deg = int(deg.max())
+    if max_deg <= 8192 and D <= 3:  # the register-resident kernel holds x, y, z
+        block = max(triton.next_power_of_2(max_deg), 16)
+        warps = 4 if block <= 1024 else (8 if block <= 4096 else 16)
+        K.fps_small_kernel[(B,)](src, ptr, out_ptr, start, out, D=D, BLOCK=block, ACC=_acc(src), num_warps=warps)
+    else:
+        buf = torch.empty(src.size(0), dtype=torch.float64 if src.dtype == torch.float64 else torch.float32, device=src.device)
+        K.fps_large_kernel[(B,)](src, ptr, out_ptr, start, out, buf, D=D, BLOCK=4096, ACC=_acc(src), num_warps=16)
+    return out
+
+
+@torch.library.custom_op("pcops::knn", mutates_args=())
+def knn(x: torch.Tensor, y: torch.Tensor, ptr_x: Optional[torch.Tensor], ptr_y: Optional[torch.Tensor], k: int, cosine: bool) -> torch.Tensor:
+    torch._check(1 <= k <= 100, lambda: "`k` needs to smaller than or equal to 100")
+    x, y = x.contiguous(), y.contiguous()
+    m = y.size(0)
+    ptr_x = _default_ptr(ptr_x, x.size(0), x.device)
+    ptr_y = _default_ptr(ptr_y, m, x.device)
+    col = torch.full((m * k,), -1, dtype=torch.long, device=x.device)
+    if m > 0 and x.size(0) > 0:
+        ex = _example_of_rows(ptr_y, m)
+        KP = max(triton.next_power_of_2(k), 4)
+        BX = max(64, KP)
+        BQ = 32 if KP <= 16 else 8
+        K.knn_kernel[(triton.cdiv(m, BQ),)](x, y, ptr_x, ex, col, m, k, D=x.size(1), BQ=BQ, BX=BX, KP=KP, COSINE=cosine, num_warps=4)
+    row = torch.arange(m, device=x.device).repeat_interleave(k)
+    mask = col != -1
+    return torch.stack([row.masked_select(mask), col.masked_select(mask)], 0)
+
+
+@torch.library.custom_op("pcops::radius", mutates_args=())
+def radius(x: torch.Tensor, y: torch.Tensor, ptr_x: Optional[torch.Tensor], ptr_y: Optional[torch.Tensor], r: float,
+           max_num_neighbors: int, ignore_same_index: bool) -> torch.Tensor:
+    x, y = x.contiguous(), y.contiguous()
+    m = y.size(0)
+    ptr_x = _default_ptr(ptr_x, x.size(0), x.device)
+    ptr_y = _default_ptr(ptr_y, m, x.device)
+    col = torch.full((m * max_num_neighbors,), -1, dtype=torch.long, device=x.device)
+    if m > 0 and x.size(0) > 0 and max_num_neighbors > 0:
+        ex = _example_of_rows(ptr_y, m)
+        r2 = float(torch.tensor(r * r, dtype=x.dtype))  # as in CUDA: r*r rounded to the input dtype
+        K.radius_kernel[(triton.cdiv(m, 8),)](x, y, ptr_x, ex, col, m, r2, max_num_neighbors, ignore_same_index, D=x.size(1),
+                                             BQ=8, BX=256, ACC=_acc(x), num_warps=2)
+    row = torch.arange(m, device=x.device).repeat_interleave(max_num_neighbors)
+    mask = col != -1
+    return torch.stack([row.masked_select(mask), col.masked_select(mask)], 0)
+
+
+@torch.library.custom_op("pcops::grid", mutates_args=())
+def grid(pos: torch.Tensor, size: torch.Tensor, start: Optional[torch.Tensor], end: Optional[torch.Tensor]) -> torch.Tensor:
+    pos = pos.reshape(pos.size(0), -1).contiguous()
+    torch._check(size.numel() == pos.size(1), lambda: "Input mismatch")
+    start = pos.min(0).values if start is None else start.contiguous()
+    end = pos.max(0).values if end is None else end.contiguous()
+    out = torch.empty(pos.size(0), dtype=torch.long, device=pos.device)
+    if pos.size(0) > 0:
+        K.grid_kernel[(triton.cdiv(pos.size(0), 256),)](pos, size.contiguous(), start, end, out, pos.size(0), D=pos.size(1), BLOCK=256,
+                                                        ACC=_acc(pos))
+    return out
+
+
+@torch.library.custom_op("pcops::ball_query", mutates_args=())
+def ball_query(new_xyz: torch.Tensor, xyz: torch.Tensor, radius: float, nsample: int) -> torch.Tensor:
+    torch._check(new_xyz.dim() == 3 and new_xyz.size(2) == 3 and xyz.dim() == 3 and xyz.size(2) == 3, lambda: "xyz must be [B, N, 3]")
+    torch._check(new_xyz.size(0) == xyz.size(0), lambda: "batch sizes differ")
+    torch._check(new_xyz.dtype == xyz.dtype, lambda: "new_xyz and xyz must have the same dtype")
+    torch._check(nsample > 0, lambda: "nsample must be positive")
+    new_xyz, xyz = new_xyz.contiguous(), xyz.contiguous()
+    B, M, N = xyz.size(0), new_xyz.size(1), xyz.size(1)
+    idx = torch.zeros(B, M, nsample, dtype=torch.int32, device=xyz.device)
+    if B * M > 0 and N > 0:
+        r2 = float(torch.tensor(radius * radius, dtype=torch.float32))  # as in CUDA: radius^2 as float
+        K.ball_query_kernel[(triton.cdiv(M, 64), B)](new_xyz, xyz, idx, N, M, r2, nsample, BQ=64, BX=128, ACC=_acc(xyz), num_warps=2)
+    return idx
+
+
+@torch.library.custom_op("pcops::three_nn", mutates_args=())
+def three_nn(unknown: torch.Tensor, known: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+    torch._check(unknown.dim() == 3 and unknown.size(2) == 3 and known.dim() == 3 and known.size(2) == 3, lambda: "inputs must be [B, N, 3]")
+    torch._check(unknown.size(0) == known.size(0), lambda: "batch sizes differ")
+    unknown, known = unknown.contiguous(), known.contiguous()
+    B, n, m = unknown.size(0), unknown.size(1), known.size(1)
+    dist2 = torch.empty(B, n, 3, dtype=unknown.dtype, device=unknown.device)
+    idx = torch.empty(B, n, 3, dtype=torch.int32, device=unknown.device)
+    if B * n > 0:
+        K.three_nn_kernel[(triton.cdiv(n, 16), B)](unknown, known, dist2, idx, n, m, BQ=16, BX=128, num_warps=2)
+    return dist2, idx
+
+
+# ---------------------------------------------------------------- feature movement
+
+def _gather(features: torch.Tensor, idx: torch.Tensor, out_shape: List[int]) -> torch.Tensor:
+    features, idx = features.contiguous(), idx.contiguous()
+    B, C, N = features.shape
+    M = idx[0].numel() if idx.size(0) > 0 else 0
+    out = torch.empty(out_shape, dtype=features.dtype, device=features.device)
+    if out.numel() > 0:
+        K.gather_rows_kernel[(triton.cdiv(M, 256), B * C)](features, idx, out, C, N, M, BLOCK=256)
+    return out
+
+
+def _scatter_rows(grad_out: torch.Tensor, idx: torch.Tensor, n: int) -> torch.Tensor:
+    grad_out, idx = grad_out.contiguous(), idx.contiguous()
+    B, C = grad_out.size(0), grad_out.size(1)
+    M = idx[0].numel() if idx.size(0) > 0 else 0
+    acc_dtype = torch.float64 if grad_out.dtype == torch.float64 else torch.float32
+    grad = torch.zeros(B, C, n, dtype=acc_dtype, device=grad_out.device)
+    if grad_out.numel() > 0:
+        K.scatter_rows_kernel[(triton.cdiv(M, 256), B * C)](grad_out, idx, grad, C, n, M, BLOCK=256)
+    return grad.to(grad_out.dtype)
+
+
+@torch.library.custom_op("pcops::group_points", mutates_args=())
+def group_points(features: torch.Tensor, idx: torch.Tensor) -> torch.Tensor:
+    torch._check(features.dim() == 3, lambda: "features must be a [B, C, N] tensor")
+    torch._check(idx.dtype == torch.int32 and idx.dim() == 3, lambda: "idx must be an int32 [B, M, S] tensor")
+    return _gather(features, idx, [features.size(0), features.size(1), idx.size(1), idx.size(2)])
+
+
+@torch.library.custom_op("pcops::group_points_backward", mutates_args=())
+def group_points_backward(grad_out: torch.Tensor, idx: torch.Tensor, n: int) -> torch.Tensor:
+    return _scatter_rows(grad_out, idx, n)
+
+
+@torch.library.custom_op("pcops::gather_points", mutates_args=())
+def gather_points(features: torch.Tensor, idx: torch.Tensor) -> torch.Tensor:
+    torch._check(features.dim() == 3, lambda: "features must be a [B, C, N] tensor")
+    torch._check(idx.dtype == torch.int32 and idx.dim() == 2, lambda: "idx must be an int32 [B, M] tensor")
+    return _gather(features, idx, [features.size(0), features.size(1), idx.size(1)])
+
+
+@torch.library.custom_op("pcops::gather_points_backward", mutates_args=())
+def gather_points_backward(grad_out: torch.Tensor, idx: torch.Tensor, n: int) -> torch.Tensor:
+    return _scatter_rows(grad_out, idx, n)
+
+
+@torch.library.custom_op("pcops::three_interpolate", mutates_args=())
+def three_interpolate(features: torch.Tensor, idx: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    torch._check(idx.dtype == torch.int32 and idx.dim() == 3 and idx.size(2) == 3, lambda: "idx must be an int32 [B, n, 3] tensor")
+    torch._check(weight.shape == idx.shape and weight.dtype == features.dtype, lambda: "weight must be [B, n, 3] with the dtype of features")
+    features, idx, weight = features.contiguous(), idx.contiguous(), weight.contiguous()
+    B, C, m = features.shape
+    n = idx.size(1)
+    out = torch.empty(B, C, n, dtype=features.dtype, device=features.device)
+    if out.numel() > 0:
+        K.three_interpolate_kernel[(triton.cdiv(n, 256), B * C)](features, idx, weight, out, C, m, n, BLOCK=256, ACC=_acc(features))
+    return out
+
+
+@torch.library.custom_op("pcops::three_interpolate_backward", mutates_args=())
+def three_interpolate_backward(grad_out: torch.Tensor, idx: torch.Tensor, weight: torch.Tensor, m: int) -> torch.Tensor:
+    grad_out, idx, weight = grad_out.contiguous(), idx.contiguous(), weight.contiguous()
+    B, C, n = grad_out.shape
+    acc_dtype = torch.float64 if grad_out.dtype == torch.float64 else torch.float32
+    grad = torch.zeros(B, C, m, dtype=acc_dtype, device=grad_out.device)
+    if grad_out.numel() > 0:
+        K.three_interpolate_grad_kernel[(triton.cdiv(n, 256), B * C)](grad_out, idx, weight, grad, C, m, n, BLOCK=256)
+    return grad.to(grad_out.dtype)
+
+
+# ---------------------------------------------------------------- reductions
+
+def _lek(src: torch.Tensor, dim: int):
+    L = math.prod(src.shape[:dim])
+    E = src.size(dim)
+    Kd = math.prod(src.shape[dim + 1:])
+    return L, E, Kd
+
+
+@torch.library.custom_op("pcops::segment_csr", mutates_args=())
+def segment_csr(src: torch.Tensor, indptr: torch.Tensor, reduce: str) -> Tuple[torch.Tensor, torch.Tensor]:
+    torch._check(reduce in _REDUCE, lambda: f"segment_csr: unsupported reduce '{reduce}'")
+    dim = indptr.dim() - 1
+    src, indptr = src.contiguous(), indptr.contiguous()
+    L, E, Kd = _lek(src, dim)
+    S = max(indptr.size(-1) - 1, 0)
+    shape = list(src.shape)
+    shape[dim] = S
+    out = torch.empty(shape, dtype=src.dtype, device=src.device)
+    minmax = reduce in ("min", "max")
+    arg = torch.empty(shape if minmax else [0], dtype=torch.long, device=src.device)
+    if out.numel() > 0:
+        ind = indptr.expand(*src.shape[:dim], indptr.size(-1)).contiguous() if dim > 0 else indptr
+        K.segment_csr_kernel[(L * S, triton.cdiv(Kd, 64))](src, ind, out, arg if minmax else out, S, E, Kd, E, REDUCE=_REDUCE[reduce],
+                                                         IS_FLOAT=src.is_floating_point(), BK=64, ACC=_acc(src))
+    return out, arg
+
+
+@torch.library.custom_op("pcops::gather_csr", mutates_args=())
+def gather_csr(src: torch.Tensor, indptr: torch.Tensor) -> torch.Tensor:
+    dim = indptr.dim() - 1
+    src, indptr = src.contiguous(), indptr.contiguous()
+    L, S, Kd = _lek(src, dim)
+    E_out = int(indptr.reshape(-1, indptr.size(-1))[:, -1].max()) if indptr.numel() > 0 else 0
+    shape = list(src.shape)
+    shape[dim] = E_out
+    out = torch.empty(shape, dtype=src.dtype, device=src.device)  # the kernel writes every row
+    if src.numel() == 0 or S == 0:
+        return out.zero_()
+    if E_out > 0:
+        ind = indptr.expand(*src.shape[:dim], indptr.size(-1)).contiguous() if dim > 0 else indptr
+        BK = min(triton.next_power_of_2(max(Kd, 1)), 32)
+        BR = min(512, max(64, 8192 // BK))
+        K.gather_csr_kernel[(triton.cdiv(E_out, BR), triton.cdiv(Kd, BK), L)](src, ind, out, S, E_out, Kd, LOG_S=max(S, 1).bit_length(), BR=BR, BK=BK)
+    return out
+
+
+@torch.library.custom_op("pcops::scatter", mutates_args=())
+def scatter(src: torch.Tensor, index: torch.Tensor, dim: int, dim_size: int, reduce: str) -> Tuple[torch.Tensor, torch.Tensor]:
+    torch._check(reduce in _REDUCE, lambda: f"scatter: unsupported reduce '{reduce}'")
+    dim = dim % src.dim()
+    src, index = src.contiguous(), index.contiguous()
+    B, E, Kd = _lek(src, dim)
+    shape = list(src.shape)
+    shape[dim] = dim_size
+    minmax = reduce in ("min", "max")
+    floating = src.is_floating_point()
+    # half / bfloat16 accumulate in float32 (fp16/bf16 atomics are not portable)
+    acc_dtype = torch.float32 if src.dtype in (torch.float16, torch.bfloat16) else src.dtype
+    if minmax:
+        init = torch.finfo(acc_dtype).max if floating else torch.iinfo(acc_dtype).max
+        acc = torch.full(shape, init if reduce == "min" else -init - (0 if floating else 1), dtype=acc_dtype, device=src.device)
+    else:
+        acc = torch.zeros(shape, dtype=acc_dtype, device=src.device)
+    n = src.numel()
+    arg = torch.empty(0, dtype=torch.long, device=src.device)
+    if n > 0 and dim_size > 0:
+        code = 0 if reduce in ("sum", "mean") else _REDUCE[reduce]
+        K.scatter_kernel[(triton.cdiv(n, 512),)](src, index, acc, B, E, Kd, dim_size, REDUCE=code, BLOCK=512)
+    if reduce == "mean":
+        cnt = torch.zeros(shape, dtype=acc_dtype, device=src.device)
+        if n > 0 and dim_size > 0:
+            K.scatter_kernel[(triton.cdiv(n, 512),)](torch.ones_like(src, dtype=acc_dtype), index, cnt, B, E, Kd, dim_size, REDUCE=0,
+                                                     BLOCK=512)
+        cnt.masked_fill_(cnt < 1, 1)
+        acc = acc / cnt if floating else torch.div(acc, cnt, rounding_mode="floor")
+    if minmax:
+        empty = acc == (torch.finfo(acc_dtype).max if floating else torch.iinfo(acc_dtype).max) if reduce == "min" else \
+            acc == (-torch.finfo(acc_dtype).max if floating else torch.iinfo(acc_dtype).min)
+        arg = torch.full(shape, E, dtype=torch.long, device=src.device)
+        if n > 0 and dim_size > 0:
+            K.scatter_arg_kernel[(triton.cdiv(n, 512),)](src, index, acc, arg, B, E, Kd, dim_size, BLOCK=512)
+        acc = acc.masked_fill(empty, 0)
+    return acc.to(src.dtype), arg
