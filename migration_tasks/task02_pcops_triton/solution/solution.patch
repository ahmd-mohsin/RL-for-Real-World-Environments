-{
-    const int64_t t = blockIdx.x * static_cast<int64_t>(blockDim.x) + threadIdx.x;
-    if(t >= b * c * m * s)
-    {
-        return;
-    }
-    const int64_t si = t % s;
-    const int64_t mi = (t / s) % m;
-    const int64_t ci = (t / (s * m)) % c;
