@@ -0,0 +1,180 @@
+// Tessera - device-wide prefix sums (OpenMP offload).
+//
+// Tiles of kTile = 256 threads x 8 items. Three team kernels:
+//   1. tile_sums   every team reduces one tile
+//   2. (recursion) exclusive scan of the tile sums
+//   3. tile_scan   every team scans its tile in team memory, seeded with the
+//                  tile's offset
+// A single-tile input skips straight to tile_scan. Each element is read
+// before it is written, so in == out is supported.
+#include "team.h"
+#include "tsr/prims/prims.h"
+
+namespace tsr::prims
+{
+namespace
+{
+#pragma omp begin declare target
+constexpr int kItems         = 8;
+constexpr std::size_t kTile  = static_cast<std::size_t>(team::kThreads) * kItems;
+#pragma omp end declare target
+
+template<typename T>
+void tile_sums(const T *in, T *sums, std::size_t n, std::size_t tiles)
+{
+    const int dev = device_id();
+#pragma omp target teams num_teams(static_cast<int>(tiles)) thread_limit(team::kThreads) device(dev) is_device_ptr(in, sums)
+    {
+        T scratch[team::kThreads];
+#pragma omp allocate(scratch) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(team::kThreads)
+        {
+            const int tid           = omp_get_thread_num();
+            const int nthreads      = omp_get_num_threads();
+            for(std::size_t t = static_cast<std::size_t>(omp_get_team_num()); t < tiles; t += static_cast<std::size_t>(omp_get_num_teams()))
+            {
+                const std::size_t base = t * kTile;
+                T acc                  = T(0);
+                // coalesced: consecutive threads read consecutive elements
+                for(std::size_t i = base + tid; i < base + kTile && i < n; i += nthreads)
+                {
+                    acc += in[i];
+                }
+                const T total = team::reduce(acc, scratch, tid, nthreads, [](T a, T b) { return a + b; });
+                if(tid == 0)
+                {
+                    sums[t] = total;
+                }
+#pragma omp barrier
+            }
+        }
+    }
+}
+
+template<typename T>
+void tile_scan(const T *in, T *out, const T *offsets, std::size_t n, std::size_t tiles, bool inclusive)
+{
+    const int dev = device_id();
+#pragma omp target teams num_teams(static_cast<int>(tiles)) thread_limit(team::kThreads) device(dev) is_device_ptr(in, out, offsets)
+    {
+        T lanes[team::kThreads];
+        T tmp[team::kThreads];
+        T tile[kTile];
+#pragma omp allocate(lanes, tmp, tile) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(team::kThreads)
+        {
+            const int tid      = omp_get_thread_num();
+            const int nthreads = omp_get_num_threads();
+            for(std::size_t t = static_cast<std::size_t>(omp_get_team_num()); t < tiles; t += static_cast<std::size_t>(omp_get_num_teams()))
+            {
+                const std::size_t base = t * kTile;
+                const T offset         = offsets != nullptr ? offsets[t] : T(0);
+                // coalesced load into team memory
+                for(std::size_t j = tid; j < kTile; j += nthreads)
+                {
+                    tile[j] = base + j < n ? in[base + j] : T(0);
+                }
+#pragma omp barrier
+                // lane v owns the kItems consecutive values [v * kItems, (v + 1) * kItems)
+                for(int v = tid; v < team::kThreads; v += nthreads)
+                {
+                    T sum = T(0);
+                    for(int k = 0; k < kItems; ++k)
+                    {
+                        sum += tile[static_cast<std::size_t>(v) * kItems + k];
+                    }
+                    lanes[v] = sum;
+                }
+#pragma omp barrier
+                team::scan_lanes(lanes, tmp, tid, nthreads);
+                for(int v = tid; v < team::kThreads; v += nthreads)
+                {
+                    T prefix              = tmp[v] + offset;
+                    const std::size_t own = static_cast<std::size_t>(v) * kItems;
+                    for(int k = 0; k < kItems; ++k)
+                    {
+                        const T x = tile[own + k];
+                        if(inclusive)
+                        {
+                            prefix        += x;
+                            tile[own + k]  = prefix;
+                        }
+                        else
+                        {
+                            tile[own + k]  = prefix;
+                            prefix        += x;
+                        }
+                    }
+                }
+#pragma omp barrier
+                for(std::size_t j = tid; j < kTile && base + j < n; j += nthreads)
+                {
+                    out[base + j] = tile[j];
+                }
+#pragma omp barrier
+            }
+        }
+    }
+}
+
+template<typename T>
+void scan_impl(const T *in, T *out, std::size_t n, bool inclusive, Arena &arena)
+{
+    if(n == 0)
+    {
+        return;
+    }
+    const std::size_t tiles = (n + kTile - 1) / kTile;
+    if(tiles == 1)
+    {
+        tile_scan<T>(in, out, nullptr, n, 1, inclusive);
+        return;
+    }
+    T *sums = arena.allocate<T>(tiles);
+    tile_sums<T>(in, sums, n, tiles);
+    scan_impl<T>(sums, sums, tiles, false, arena);
+    tile_scan<T>(in, out, sums, n, tiles, inclusive);
+}
+} // namespace
+
+template<typename T>
+void exclusive_scan(const T *in, T *out, std::size_t n, Arena &arena, Stream)
+{
+    scan_impl(in, out, n, false, arena);
+}
+
+template<typename T>
+void inclusive_scan(const T *in, T *out, std::size_t n, Arena &arena, Stream)
+{
+    scan_impl(in, out, n, true, arena);
+}
+
+template<typename T>
+T exclusive_scan_total(const T *in, T *out, std::size_t n, Arena &arena, Stream)
+{
+    if(n == 0)
+    {
+        return T(0);
+    }
+    // Read the last input before the scan: with in == out it is overwritten.
+    T last_in = T(0);
+    copy_to_host(&last_in, in + n - 1, sizeof(T));
+    scan_impl(in, out, n, false, arena);
+    T last_out = T(0);
+    copy_to_host(&last_out, out + n - 1, sizeof(T));
+    return last_out + last_in;
+}
+
+#define TSR_INSTANTIATE_SCAN(T)                                                              \
+    template void exclusive_scan<T>(const T *, T *, std::size_t, Arena &, Stream);           \
+    template void inclusive_scan<T>(const T *, T *, std::size_t, Arena &, Stream);           \
+    template T exclusive_scan_total<T>(const T *, T *, std::size_t, Arena &, Stream);
+
+TSR_INSTANTIATE_SCAN(std::uint32_t)
+TSR_INSTANTIATE_SCAN(std::int32_t)
+TSR_INSTANTIATE_SCAN(std::uint64_t)
+TSR_INSTANTIATE_SCAN(std::int64_t)
+TSR_INSTANTIATE_SCAN(float)
+
+#undef TSR_INSTANTIATE_SCAN
+} // namespace tsr::prims
