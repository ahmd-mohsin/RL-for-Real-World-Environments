+++ b/src/prims/histogram.cpp
@@ -0,0 +1,60 @@
+// Tessera - 256-bin histogram (OpenMP offload).
+//
+// Each team accumulates a private histogram in team memory with shared
+// atomics, then merges it into the global histogram with one atomic per bin,
+// so global contention is bins x teams instead of one atomic per element.
+#include <algorithm>
+
+#include "team.h"
+#include "tsr/prims/prims.h"
+
+namespace tsr::prims
+{
+namespace
+{
+constexpr int kMaxTeams = 512;
+}
+
+void histogram256(const std::uint32_t *bins, std::size_t n, std::uint32_t *hist, Arena &, Stream)
+{
+    const int dev   = device_id();
+    const int teams = static_cast<int>(std::clamp<std::size_t>((n + team::kThreads * 32 - 1) / (team::kThreads * 32), 1, kMaxTeams));
+    device_memset(hist, 0, sizeof(std::uint32_t) * kHistogramBins);
+#pragma omp target teams num_teams(teams) thread_limit(team::kThreads) device(dev) is_device_ptr(bins, hist)
+    {
+        std::uint32_t local[kHistogramBins];
+#pragma omp allocate(local) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(team::kThreads)
+        {
+            const int tid               = omp_get_thread_num();
+            const int nthreads          = omp_get_num_threads();
+            const std::size_t team_id   = static_cast<std::size_t>(omp_get_team_num());
+            const std::size_t stride    = static_cast<std::size_t>(omp_get_num_teams()) * nthreads;
+            for(int b = tid; b < static_cast<int>(kHistogramBins); b += nthreads)
+            {
+                local[b] = 0;
+            }
+#pragma omp barrier
+            for(std::size_t i = team_id * nthreads + tid; i < n; i += stride)
+            {
+                const std::uint32_t b = bins[i];
+                if(b < kHistogramBins)
+                {
+#pragma omp atomic update
+                    local[b] += 1u;
+                }
+            }
+#pragma omp barrier
+            for(int b = tid; b < static_cast<int>(kHistogramBins); b += nthreads)
+            {
+                const std::uint32_t c = local[b];
+                if(c != 0)
+                {
+#pragma omp atomic update
+                    hist[b] += c;
+                }
+            }
+        }
+    }
+}
+} // namespace tsr::prims
