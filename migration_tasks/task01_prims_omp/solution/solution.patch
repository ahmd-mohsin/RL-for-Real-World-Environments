new file mode 100644
index 0000000..d104c1f
--- /dev/null
+++ b/src/device/device.cpp
@@ -0,0 +1,103 @@
+// Tessera - OpenMP offload device access.
+#include "tsr/device/device.h"
+
+#include <omp.h>
+
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+
+namespace tsr
+{
+int device_id()
+{
+    static const int id = []
+    {
+        const char *env = std::getenv("TSR_DEVICE");
+        const int dev   = env != nullptr ? std::atoi(env) : omp_get_default_device();
+        if(dev < 0 || dev >= omp_get_num_devices())
+        {
+            throw DeviceError("no OpenMP offload device " + std::to_string(dev) + " (" + std::to_string(omp_get_num_devices()) + " available)");
+        }
+        return dev;
+    }();
+    return id;
+}
+
+int host_id() { return omp_get_initial_device(); }
+
+void *device_alloc(std::size_t bytes)
+{
+    if(bytes == 0)
+    {
+        return nullptr;
+    }
+    void *p = omp_target_alloc(bytes, device_id());
+    if(p == nullptr)
+    {
+        detail::throw_device_error("omp_target_alloc of " + std::to_string(bytes) + " bytes failed", __FILE__, __LINE__);
+    }
+    return p;
+}
+
+void device_free(void *ptr) noexcept
+{
+    if(ptr != nullptr)
+    {
+        omp_target_free(ptr, device_id());
+    }
+}
+
+void copy_to_device(void *dst, const void *src, std::size_t bytes)
+{
+    if(bytes == 0)
+    {
+        return;
+    }
+    if(omp_target_memcpy(dst, src, bytes, 0, 0, device_id(), host_id()) != 0)
+    {
+        detail::throw_device_error("host-to-device copy failed", __FILE__, __LINE__);
+    }
+}
+
+void copy_to_host(void *dst, const void *src, std::size_t bytes)
+{
+    if(bytes == 0)
+    {
+        return;
+    }
+    if(omp_target_memcpy(dst, src, bytes, 0, 0, host_id(), device_id()) != 0)
+    {
+        detail::throw_device_error("device-to-host copy failed", __FILE__, __LINE__);
+    }
+}
+
+void copy_device_to_device(void *dst, const void *src, std::size_t bytes)
+{
+    if(bytes == 0)
+    {
+        return;
+    }
+    const int dev = device_id();
+    if(omp_target_memcpy(dst, src, bytes, 0, 0, dev, dev) != 0)
+    {
+        detail::throw_device_error("device-to-device copy failed", __FILE__, __LINE__);
+    }
+}
+
+void device_memset(void *dst, int value, std::size_t bytes)
+{
+    if(bytes == 0)
+    {
+        return;
+    }
+    unsigned char *p        = static_cast<unsigned char *>(dst);
+    const unsigned char v   = static_cast<unsigned char>(value);
+    const int dev           = device_id();
+#pragma omp target teams distribute parallel for device(dev) is_device_ptr(p)
+    for(std::size_t i = 0; i < bytes; ++i)
+    {
+        p[i] = v;
+    }
+}
+} // namespace tsr
