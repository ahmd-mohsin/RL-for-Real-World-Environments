-    const void *closure    = nullptr;
-    unsigned nthreads      = 0;
-    Fiber *fibers          = nullptr;
-    FiberContext sched_ctx;
-    std::vector<WarpState> warps;
-    void *dynamic_smem = nullptr;
-
-    // block barrier reductions
-    int acc_count = 0;
-    bool acc_and  = true;
-    bool acc_or   = false;
-    int res_count = 0;
-    bool res_and  = true;
-    bool res_or   = false;
-};
