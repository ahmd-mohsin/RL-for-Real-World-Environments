--- /dev/null
+++ b/src/prims/compact.cpp
@@ -0,0 +1,31 @@
+// Tessera - stream compaction of index sets (OpenMP offload).
+#include "tsr/prims/prims.h"
+
+namespace tsr::prims
+{
+std::uint32_t compact_indices(const std::uint8_t *flags, std::size_t n, std::uint32_t *out_indices, Arena &arena, Stream stream)
+{
+    if(n == 0)
+    {
+        return 0;
+    }
+    TSR_CHECK(n <= 0xffffffffu, "compact_indices supports at most 2^32-1 elements");
+    const int dev            = device_id();
+    std::uint32_t *positions = arena.allocate<std::uint32_t>(n);
+#pragma omp target teams distribute parallel for device(dev) is_device_ptr(flags, positions)
+    for(std::size_t i = 0; i < n; ++i)
+    {
+        positions[i] = flags[i] != 0 ? 1u : 0u;
+    }
+    const std::uint32_t total = exclusive_scan_total(positions, positions, n, arena, stream);
+#pragma omp target teams distribute parallel for device(dev) is_device_ptr(flags, positions, out_indices)
+    for(std::size_t i = 0; i < n; ++i)
+    {
+        if(flags[i] != 0)
+        {
+            out_indices[positions[i]] = static_cast<std::uint32_t>(i);
+        }
+    }
+    return total;
+}
+} // namespace tsr::prims
