diff --git a/src/prims/team.h b/src/prims/team.h
new file mode 100644
index 0000000..23dcced
--- /dev/null
+++ b/src/prims/team.h
@@ -0,0 +1,94 @@
+// Tessera - building blocks for team-parallel OpenMP offload kernels.
+//
+// A "team kernel" is
+//
+//   #pragma omp target teams num_teams(G) thread_limit(B) ...
+//   {
+//       T shared[...];
+//   #pragma omp allocate(shared) allocator(omp_pteam_mem_alloc)
+//   #pragma omp parallel num_threads(B)
+//       { ... #pragma omp barrier ... }
+//   }
+//
+// Variables declared in the teams region before the parallel region are
+// shared by the team's threads; the allocate directive places them in
+// on-chip team memory instead of globalized device memory. The helpers below
+// are called from inside the parallel region by every thread of the team.
+#pragma once
+
+#include <omp.h>
+
+#include <cstdint>
+
+namespace tsr::prims::team
+{
+#pragma omp begin declare target
+
+// Threads per team for every team kernel in this library.
+constexpr int kThreads = 256;
+
+// OpenMP does not guarantee that `num_threads(kThreads)` is honored: a team
+// may run with fewer threads (the host runtime routinely does). Team code is
+// therefore written over kThreads *virtual lanes*: lane v is handled by real
+// thread v mod nthreads, with per-lane state kept in team memory, so results
+// never depend on how many threads the runtime actually provides.
+static_assert((kThreads & (kThreads - 1)) == 0, "kThreads must be a power of two");
+
+// Scans lanes[0 .. kThreads) (Hillis-Steele, double-buffered with tmp).
+// On return lanes[v] holds the inclusive and tmp[v] the exclusive prefix of
+// lane v; the return value is the sum over all lanes. Every thread of the
+// team must call it.
+template<typename T>
+inline T scan_lanes(T *lanes, T *tmp, int tid, int nthreads)
+{
+    T *src = lanes;
+    T *dst = tmp;
+    int swaps = 0;
+    for(int offset = 1; offset < kThreads; offset <<= 1)
+    {
+        for(int v = tid; v < kThreads; v += nthreads)
+        {
+            dst[v] = v >= offset ? src[v] + src[v - offset] : src[v];
+        }
+#pragma omp barrier
+        T *t = src;
+        src  = dst;
+        dst  = t;
+        ++swaps;
+    }
+    if(swaps % 2 == 1) // inclusive result ended up in tmp: move it back
+    {
+        for(int v = tid; v < kThreads; v += nthreads)
+        {
+            lanes[v] = tmp[v];
+        }
+#pragma omp barrier
+    }
+    for(int v = tid; v < kThreads; v += nthreads)
+    {
+        tmp[v] = v > 0 ? lanes[v - 1] : T(0);
+    }
+#pragma omp barrier
+    return lanes[kThreads - 1];
+}
+
+// Tree reduction of one value per thread; the result is valid in thread 0.
+template<typename T, typename Op>
+inline T reduce(T value, T *scratch, int tid, int nthreads, Op op)
+{
+    scratch[tid] = value;
+#pragma omp barrier
+    for(int stride = kThreads / 2; stride > 0; stride >>= 1)
+    {
+        if(tid < stride && tid + stride < nthreads)
+        {
+            scratch[tid] = op(scratch[tid], scratch[tid + stride]);
+        }
+#pragma omp barrier
+    }
+    return scratch[0];
+}
+
+#pragma omp end declare target
+
+} // namespace tsr::prims::team
