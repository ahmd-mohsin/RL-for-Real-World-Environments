diff --git a/src/prims/radix_sort.cpp b/src/prims/radix_sort.cpp
new file mode 100644
index 0000000..a3a8e53
--- /dev/null
+++ b/src/prims/radix_sort.cpp
@@ -0,0 +1,299 @@
+// Tessera - stable LSD radix sort of key/value pairs (OpenMP offload).
+//
+// Each 4-bit pass runs three steps over tiles of 1024 keys (256 threads x 4):
+//   upsweep    team-memory digit counts per tile, stored digit-major
+//              ([digit][tile]) so that one scan yields scatter offsets
+//   scan       exclusive_scan of the 16 x tiles counters
+//   downsweep  stable ranking without warp intrinsics: thread t owns the
+//              four consecutive keys 4t .. 4t+3 of the tile, writes its
+//              per-digit counts into a 16 x 256 team table, and a team scan
+//              over that table in digit-major order gives every key the
+//              number of tile keys that precede it in the output
+#include <algorithm>
+
+#include "team.h"
+
+#define TSR_UNROLL_ALL _Pragma("unroll")
+#include "tsr/prims/prims.h"
+
+namespace tsr::prims
+{
+namespace
+{
+// Constants used inside target regions must exist on the device too: a
+// namespace-scope constexpr bound to a reference (std::min takes const T&)
+// is ODR-used, and without declare target the device link fails with an
+// undefined reference.
+#pragma omp begin declare target
+constexpr int kRadixBits        = 4;
+constexpr unsigned kRadixDigits = 1u << kRadixBits;
+constexpr int kItems            = 4;
+constexpr std::size_t kSortTile = static_cast<std::size_t>(team::kThreads) * kItems;
+constexpr int kCountsPerThread  = static_cast<int>(kRadixDigits) * team::kThreads / team::kThreads; // 16
+#pragma omp end declare target
+
+template<typename K>
+void upsweep(const K *keys, std::size_t n, int shift, unsigned mask, std::uint32_t *counts, std::size_t tiles)
+{
+    const int dev = device_id();
+#pragma omp target teams num_teams(static_cast<int>(tiles)) thread_limit(team::kThreads) device(dev) is_device_ptr(keys, counts)
+    {
+        std::uint32_t local[kRadixDigits];
+#pragma omp allocate(local) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(team::kThreads)
+        {
+            const int tid      = omp_get_thread_num();
+            const int nthreads = omp_get_num_threads();
+            for(std::size_t t = static_cast<std::size_t>(omp_get_team_num()); t < tiles; t += static_cast<std::size_t>(omp_get_num_teams()))
+            {
+                // loops, not `if(tid < 16)`: a team may have fewer than 16 threads
+                for(int d = tid; d < static_cast<int>(kRadixDigits); d += nthreads)
+                {
+                    local[d] = 0;
+                }
+#pragma omp barrier
+                const std::size_t base = t * kSortTile;
+                for(std::size_t i = base + tid; i < base + kSortTile && i < n; i += nthreads)
+                {
+                    const unsigned d = static_cast<unsigned>(keys[i] >> shift) & mask;
+#pragma omp atomic update
+                    local[d] += 1u;
+                }
+#pragma omp barrier
+                for(int d = tid; d < static_cast<int>(kRadixDigits); d += nthreads)
+                {
+                    counts[static_cast<std::size_t>(d) * tiles + t] = local[d];
+                }
+#pragma omp barrier
+            }
+        }
+    }
+}
+
+// Index into the [digit][thread] count table, padded by one word every 16
+// entries: thread t scans the 16 consecutive entries [16t, 16t + 16), and
+// without padding the 32 threads of a warp would hit the same bank 16 at a
+// time (16-way bank conflicts on every step of the scan).
+#pragma omp begin declare target
+inline int padded(int i) { return i + (i >> 4); }
+#pragma omp end declare target
+
+template<typename K, typename V>
+void downsweep(const K *keys_in, K *keys_out, const V *vals_in, V *vals_out, std::size_t n, int shift, unsigned mask,
+               const std::uint32_t *offsets, std::size_t tiles)
+{
+    constexpr int kTableEntries = static_cast<int>(kRadixDigits) * team::kThreads;
+    const int dev               = device_id();
+#pragma omp target teams num_teams(static_cast<int>(tiles)) thread_limit(team::kThreads) device(dev) \
+    is_device_ptr(keys_in, keys_out, vals_in, vals_out, offsets)
+    {
+        K s_keys[kSortTile];
+        V s_vals[kSortTile];
+        std::uint8_t s_digit[kSortTile];
+        std::uint32_t table[kTableEntries + kTableEntries / 16]; // [digit][lane], padded
+        std::uint32_t lanes[team::kThreads];
+        std::uint32_t tmp[team::kThreads];
+        std::uint32_t digit_offset[kRadixDigits];
+#pragma omp allocate(s_keys, s_vals, s_digit, table, lanes, tmp, digit_offset) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(team::kThreads)
+        {
+            const int tid      = omp_get_thread_num();
+            const int nthreads = omp_get_num_threads();
+            for(std::size_t t = static_cast<std::size_t>(omp_get_team_num()); t < tiles; t += static_cast<std::size_t>(omp_get_num_teams()))
+            {
+                const std::size_t base  = t * kSortTile;
+                const std::size_t count = std::min(kSortTile, n - base);
+
+                // coalesced load of the tile; digits of missing keys are kRadixDigits
+                for(std::size_t j = tid; j < kSortTile; j += nthreads)
+                {
+                    if(j < count)
+                    {
+                        const K k  = keys_in[base + j];
+                        s_keys[j]  = k;
+                        s_vals[j]  = vals_in[base + j];
+                        s_digit[j] = static_cast<std::uint8_t>(static_cast<unsigned>(k >> shift) & mask);
+                    }
+                    else
+                    {
+                        s_digit[j] = static_cast<std::uint8_t>(kRadixDigits);
+                    }
+                }
+                for(int i = tid; i < kTableEntries; i += nthreads)
+                {
+                    table[padded(i)] = 0;
+                }
+                for(int d = tid; d < static_cast<int>(kRadixDigits); d += nthreads)
+                {
+                    digit_offset[d] = offsets[static_cast<std::size_t>(d) * tiles + t];
+                }
+#pragma omp barrier
+
+                // lane v owns the kItems consecutive keys of the tile starting at
+                // v * kItems and is the only writer of column v of the table
+                for(int v = tid; v < team::kThreads; v += nthreads)
+                {
+                    TSR_UNROLL_ALL
+                    for(int k = 0; k < kItems; ++k)
+                    {
+                        const unsigned d = s_digit[static_cast<std::size_t>(v) * kItems + k];
+                        if(d < kRadixDigits)
+                        {
+                            table[padded(static_cast<int>(d) * team::kThreads + v)] += 1u;
+                        }
+                    }
+                }
+#pragma omp barrier
+
+                // exclusive scan of the table in digit-major order; lane v owns
+                // the 16 consecutive entries [16v, 16v + 16)
+                for(int v = tid; v < team::kThreads; v += nthreads)
+                {
+                    std::uint32_t sum = 0;
+                    for(int e = 0; e < kCountsPerThread; ++e)
+                    {
+                        sum += table[padded(v * kCountsPerThread + e)];
+                    }
+                    lanes[v] = sum;
+                }
+#pragma omp barrier
+                team::scan_lanes(lanes, tmp, tid, nthreads);
+                for(int v = tid; v < team::kThreads; v += nthreads)
+                {
+                    std::uint32_t run = tmp[v];
+                    for(int e = 0; e < kCountsPerThread; ++e)
+                    {
+                        const int i             = padded(v * kCountsPerThread + e);
+                        const std::uint32_t c   = table[i];
+                        table[i]                = run;
+                        run                    += c;
+                    }
+                }
+#pragma omp barrier
+
+                // rank = keys of smaller digits + same-digit keys of earlier
+                // lanes + same-digit keys earlier in this lane
+                for(int v = tid; v < team::kThreads; v += nthreads)
+                {
+                    const std::size_t own = static_cast<std::size_t>(v) * kItems;
+                    unsigned digits[kItems];
+                    TSR_UNROLL_ALL
+                    for(int k = 0; k < kItems; ++k)
+                    {
+                        digits[k] = s_digit[own + k];
+                    }
+                    TSR_UNROLL_ALL
+                    for(int k = 0; k < kItems; ++k)
+                    {
+                        const unsigned d = digits[k];
+                        if(d >= kRadixDigits)
+                        {
+                            continue;
+                        }
+                        std::uint32_t earlier = 0;
+                        TSR_UNROLL_ALL
+                        for(int j = 0; j < k; ++j)
+                        {
+                            earlier += digits[j] == d ? 1u : 0u;
+                        }
+                        const int row                   = static_cast<int>(d) * team::kThreads;
+                        const std::uint32_t digit_begin = table[padded(row)];
+                        const std::uint32_t rank        = table[padded(row + v)] - digit_begin + earlier;
+                        const std::uint32_t pos         = digit_offset[d] + rank;
+                        keys_out[pos]                   = s_keys[own + k];
+                        vals_out[pos]                   = s_vals[own + k];
+                    }
+                }
+#pragma omp barrier
+            }
+        }
+    }
+}
+} // namespace
+
+template<typename K, typename V>
+void radix_sort_pairs(
+    const K *keys_in,
+    K *keys_out,
+    const V *values_in,
+    V *values_out,
+    std::size_t n,
+    int begin_bit,
+    int end_bit,
+    Arena &arena,
+    Stream stream
+)
+{
+    TSR_CHECK(begin_bit >= 0 && end_bit <= static_cast<int>(8 * sizeof(K)) && begin_bit <= end_bit,
+              "invalid bit range [" << begin_bit << ", " << end_bit << ")");
+    TSR_CHECK(keys_in != keys_out && values_in != values_out, "radix_sort_pairs does not sort in place");
+    if(n == 0)
+    {
+        return;
+    }
+    TSR_CHECK(n <= 0xffffffffu, "radix_sort_pairs supports at most 2^32-1 elements");
+
+    const int passes = (end_bit - begin_bit + kRadixBits - 1) / kRadixBits;
+    if(passes == 0)
+    {
+        copy_device_to_device(keys_out, keys_in, n * sizeof(K));
+        copy_device_to_device(values_out, values_in, n * sizeof(V));
+        return;
+    }
+
+    const std::size_t tiles = (n + kSortTile - 1) / kSortTile;
+    std::uint32_t *counts   = arena.allocate<std::uint32_t>(kRadixDigits * tiles);
+    K *tmp_keys             = passes > 1 ? arena.allocate<K>(n) : nullptr;
+    V *tmp_vals             = passes > 1 ? arena.allocate<V>(n) : nullptr;
+
+    const K *src_keys = keys_in;
+    const V *src_vals = values_in;
+    for(int p = 0; p < passes; ++p)
+    {
+        // Alternate destinations so that the final pass lands in the outputs.
+        const bool to_out   = ((passes - 1 - p) % 2) == 0;
+        K *dst_keys         = to_out ? keys_out : tmp_keys;
+        V *dst_vals         = to_out ? values_out : tmp_vals;
+        const int shift     = begin_bit + p * kRadixBits;
+        const int bits      = std::min(kRadixBits, end_bit - shift);
+        const unsigned mask = (1u << bits) - 1u;
+
+        upsweep(src_keys, n, shift, mask, counts, tiles);
+        exclusive_scan(counts, counts, kRadixDigits * tiles, arena, stream);
+        downsweep(src_keys, dst_keys, src_vals, dst_vals, n, shift, mask, counts, tiles);
+        src_keys = dst_keys;
+        src_vals = dst_vals;
+    }
+}
+
+template<typename K, typename V>
+void sort_pairs(
+    const K *keys_in,
+    K *keys_out,
+    const V *values_in,
+    V *values_out,
+    std::size_t n,
+    int begin_bit,
+    int end_bit,
+    Arena &arena,
+    Stream stream
+)
+{
+    if(n <= kBitonicMaxElements)
+    {
+        bitonic_sort_pairs(keys_in, keys_out, values_in, values_out, n, stream);
+        return;
+    }
+    radix_sort_pairs(keys_in, keys_out, values_in, values_out, n, begin_bit, end_bit, arena, stream);
+}
+
+#define TSR_INSTANTIATE_SORT(K, V)                                                                              \
+    template void radix_sort_pairs<K, V>(const K *, K *, const V *, V *, std::size_t, int, int, Arena &, Stream); \
+    template void sort_pairs<K, V>(const K *, K *, const V *, V *, std::size_t, int, int, Arena &, Stream);
+
+TSR_INSTANTIATE_SORT(std::uint64_t, std::int32_t)
+TSR_INSTANTIATE_SORT(std::uint32_t, std::uint32_t)
+TSR_INSTANTIATE_SORT(std::uint32_t, std::int32_t)
+
+#undef TSR_INSTANTIATE_SORT
+} // namespace tsr::prims
