-void yield_to_scheduler()
-{
-    Fiber *f      = tl_fiber;
-    BlockState *b = tl_block;
-    context_switch(f->ctx, b->sched_ctx);
-    // Resumed by the scheduler; restore this fiber's view of the world.
-    tl_fiber = f;
