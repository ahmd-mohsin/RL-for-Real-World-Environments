-            task_t task = std::move(const_cast<pr_task &>(tasks_.top()).task);
-            tasks_.pop();
-            ++tasks_running_;
-            lock.unlock();
-            task();
-            lock.lock();
-        }
-        this_thread::index_ = std::nullopt;
-        this_thread::pool_  = std::nullopt;
-    }
