-            }
-        }
-        threads_.clear();
-    }
-
-    void worker(const std::size_t idx)
-    {
-        this_thread::index_ = idx;
-        this_thread::pool_  = this;
-        std::unique_lock lock(tasks_mutex_);
-        while(true)
-        {
-            --tasks_running_;
-            if(waiting_ && tasks_running_ == 0 && tasks_.empty())
-            {
