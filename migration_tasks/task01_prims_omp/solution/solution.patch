new file mode 100644
index 0000000..8bac1f3
--- /dev/null
+++ b/src/prims/reduce.cpp
@@ -0,0 +1,135 @@
+// Tessera - device-wide reductions (OpenMP offload).
+//
+// One team kernel. Every thread folds a grid-strided slice with four
+// independent accumulators (more loads in flight), the team folds in shared
+// memory and writes one partial per team. The last team to finish (ticket
+// counter in device memory) folds the partials and stores the result, so a
+// reduction costs a single launch.
+#include <algorithm>
+#include <limits>
+
+#include "team.h"
+#include "tsr/prims/prims.h"
+
+namespace tsr::prims
+{
+namespace
+{
+constexpr int kMaxTeams = 1024;
+
+#pragma omp begin declare target
+// Teams that have published their partial in the running reduction. The last
+// team resets it, so it is zero between calls.
+unsigned int g_reduce_tickets = 0;
+#pragma omp end declare target
+
+template<typename T>
+struct Sum
+{
+    static T identity() { return T(0); }
+    T operator()(T a, T b) const { return a + b; }
+};
+template<typename T>
+struct Max
+{
+    static T identity() { return std::numeric_limits<T>::lowest(); }
+    T operator()(T a, T b) const { return a < b ? b : a; }
+};
+template<typename T>
+struct Min
+{
+    static T identity() { return std::numeric_limits<T>::max(); }
+    T operator()(T a, T b) const { return b < a ? b : a; }
+};
+
+template<typename T, typename Op>
+void reduce_kernel(const T *in, std::size_t n, T *partials, T *out, int teams, T identity)
+{
+    const int dev = device_id();
+#pragma omp target teams num_teams(teams) thread_limit(team::kThreads) device(dev) is_device_ptr(in, partials, out)
+    {
+        T scratch[team::kThreads];
+        int last_team;
+#pragma omp allocate(scratch, last_team) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(team::kThreads)
+        {
+            const Op op{};
+            const int tid             = omp_get_thread_num();
+            const int nthreads        = omp_get_num_threads();
+            const std::size_t team_id = static_cast<std::size_t>(omp_get_team_num());
+            const unsigned int nteams = static_cast<unsigned int>(omp_get_num_teams());
+            const std::size_t stride  = static_cast<std::size_t>(nteams) * static_cast<std::size_t>(nthreads);
+            T a0 = identity, a1 = identity, a2 = identity, a3 = identity;
+            std::size_t i = team_id * static_cast<std::size_t>(nthreads) + static_cast<std::size_t>(tid);
+            for(; i + 3 * stride < n; i += 4 * stride)
+            {
+                a0 = op(a0, in[i]);
+                a1 = op(a1, in[i + stride]);
+                a2 = op(a2, in[i + 2 * stride]);
+                a3 = op(a3, in[i + 3 * stride]);
+            }
+            for(; i < n; i += stride)
+            {
+                a0 = op(a0, in[i]);
+            }
+            const T r = team::reduce(op(op(a0, a1), op(a2, a3)), scratch, tid, nthreads, op);
+            if(tid == 0)
+            {
+                partials[team_id] = r;
+#pragma omp flush
+                unsigned int ticket;
+#pragma omp atomic capture seq_cst
+                ticket = g_reduce_tickets++;
+                last_team = ticket == nteams - 1;
+            }
+#pragma omp barrier
+            if(last_team)
+            {
+#pragma omp flush
+                T acc = identity;
+                for(unsigned int t = static_cast<unsigned int>(tid); t < nteams; t += static_cast<unsigned int>(nthreads))
+                {
+                    T p;
+#pragma omp atomic read
+                    p   = partials[t];
+                    acc = op(acc, p);
+                }
+                const T total = team::reduce(acc, scratch, tid, nthreads, op);
+                if(tid == 0)
+                {
+                    *out = total;
+                    // NVPTX in LLVM 18 cannot select a seq_cst atomic store:
+                    // flush, then a relaxed atomic write.
+#pragma omp flush
+#pragma omp atomic write
+                    g_reduce_tickets = 0;
+                }
+            }
+        }
+    }
+}
+
+template<typename T, typename Op>
+void reduce_with(const T *in, std::size_t n, T *out, Arena &arena)
+{
+    const int teams = static_cast<int>(std::clamp<std::size_t>((n + team::kThreads * 16 - 1) / (team::kThreads * 16), 1, kMaxTeams));
+    T *partials     = arena.allocate<T>(static_cast<std::size_t>(teams));
+    reduce_kernel<T, Op>(in, n, partials, out, teams, Op::identity());
+}
+} // namespace
+
+template<typename T>
+void reduce(const T *in, std::size_t n, T *out, ReduceOp op, Arena &arena, Stream)
+{
+    switch(op)
+    {
+    case ReduceOp::Sum: reduce_with<T, Sum<T>>(in, n, out, arena); break;
+    case ReduceOp::Max: reduce_with<T, Max<T>>(in, n, out, arena); break;
+    case ReduceOp::Min: reduce_with<T, Min<T>>(in, n, out, arena); break;
+    }
+}
+
+template void reduce<float>(const float *, std::size_t, float *, ReduceOp, Arena &, Stream);
+template void reduce<std::uint32_t>(const std::uint32_t *, std::size_t, std::uint32_t *, ReduceOp, Arena &, Stream);
+template void reduce<std::int32_t>(const std::int32_t *, std::size_t, std::int32_t *, ReduceOp, Arena &, Stream);
+} // namespace tsr::prims
