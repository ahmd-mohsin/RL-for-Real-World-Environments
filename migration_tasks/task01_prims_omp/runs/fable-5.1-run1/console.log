// Tessera - device-wide reductions.
//
// Single launch: every team reduces its partitions of the input into one
// partial per partition, and the last team to finish folds the partials in
// partition order. Integer results are exact; floating-point sums are
// reassociated by the partitioning.
#include "tsr/prims/prims.h"
#include "tsr/prims/team.h"

namespace tsr::prims
{
namespace
{
constexpr std::uint64_t kReduceMinPartition = 8192;
constexpr unsigned kReduceMaxPartitions   = 4096;

template<typename T, typename Op>
void reduce_kernel(const T *in, T *partials, T *out, std::uint64_t n, unsigned 
P)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(in, partials, out)
    {
        T s_vals[kMaxThreads];
        unsigned s_flag;
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            const Op op{};
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                T acc                      = Op::identity();
                std::uint64_t i            = begin + ti.tid;
                const std::uint64_t stride = static_cast<std::uint64_t>(ti.nth) 
* 4;
                for(; i + 3 * ti.nth < end; i += stride)
                {
                    const T v0 = in[i];
                    const T v1 = in[i + ti.nth];
                    const T v2 = in[i + 2 * ti.nth];
                    const T v3 = in[i + 3 * ti.nth];
                    acc        = op(acc, v0);
                    acc        = op(acc, v1);
                    acc        = op(acc, v2);
                    acc        = op(acc, v3);
                }
                for(; i < end; i += ti.nth)
                {
                    acc = op(acc, in[i]);
                }
                const T r = team_reduce(acc, op, s_vals, ti.tid, ti.nth);
                if(ti.tid == 0)
                {
                    partials[p] = r;
                    publish_writes();
                }
            }
            if(team_is_last(0, ti.nteams, ti.tid, &s_flag))
            {
                T acc = Op::identity();
                for(unsigned i = ti.tid; i < P; i += ti.nth)
                {
                    acc = op(acc, team_load(&partials[i]));
                }
                const T r = team_reduce(acc, op, s_vals, ti.tid, ti.nth);
                if(ti.tid == 0)
                {
                    *out = r;
                }
            }
        }
    }
}

template<typename T, typename Op>
void reduce_with(const T *in, std::size_t n, T *out, Arena &arena)
{
    const unsigned P = partition_count(n, kReduceMinPartition, 
kReduceMaxPartitions);
    T *partials      = arena.allocate<T>(P);
    reduce_kernel<T, Op>(in, partials, out, static_cast<std::uint64_t>(n), P);
}
} // namespace

template<typename T>
void reduce(const T *in, std::size_t n, T *out, ReduceOp op, Arena &arena, 
Stream stream)
{
    (void)stream;
    switch(op)
    {
    case ReduceOp::Sum: reduce_with<T, SumOp<T>>(in, n, out, arena); break;
    case ReduceOp::Max: reduce_with<T, MaxOp<T>>(in, n, out, arena); break;
    case ReduceOp::Min: reduce_with<T, MinOp<T>>(in, n, out, arena); break;
    }
}

template void reduce<float>(const float *, std::size_t, float *, ReduceOp, Arena
&, Stream);
template void reduce<std::uint32_t>(const std::uint32_t *, std::size_t, 
std::uint32_t *, ReduceOp, Arena &, Stream);
template void reduce<std::int32_t>(const std::int32_t *, std::size_t, 
std::int32_t *, ReduceOp, Arena &, Stream);
} // namespace tsr::prims
