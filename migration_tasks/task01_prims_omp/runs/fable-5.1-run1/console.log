        tsr::prims::exclusive_scan(d.data(), d.data(), n, arena, nullptr);
        auto t4 = clk::now();
        printf("reset %.0f  reduce %.0f  download %.0f  scan %.0f us\n", 
us(t0,t1), us(t1,t2), us(t2,t3), us(t3,t4));
    }
}
