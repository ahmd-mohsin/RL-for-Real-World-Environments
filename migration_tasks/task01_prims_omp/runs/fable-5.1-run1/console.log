mini-swe-agent (step 79, $13.71):
Correctness is solid across all configurations. Now performance: scan is the 
main concern (1.22–1.34× vs a 1.30 limit). Let me build a harness to isolate the
downsweep kernel and test variants.

```
cd /tmp/probe && cat <<'EOF' > var_scan.cpp
#include <chrono>
#include <cstdio>
#include <vector>
#include <algorithm>
#include "tsr/prims/team.h"
using namespace tsr::prims;
using clk = std::chrono::steady_clock;

template<typename T, unsigned ITEMS, int VARIANT>
void scan_downsweep(const T *in, T *out, const T *totals, std::uint64_t n, 
unsigned P, bool inclusive)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(in, out, totals)
    {
        T s_vals[kMaxThreads];
        T s_seg[kScanSegments + 1];
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                T carry                   = totals[p];
                const std::uint64_t chunk = static_cast<std::uint64_t>(ti.nth) *
ITEMS;
                for(std::uint64_t cb = begin; cb < end; cb += chunk)
                {
                    const std::uint64_t i0 = cb + 
static_cast<std::uint64_t>(ti.tid) * ITEMS;
                    T items[ITEMS];
                    T incl[ITEMS];
#pragma unroll
                    for(unsigned k = 0; k < ITEMS; ++k)
                    {
                        items[k] = i0 + k < end ? in[i0 + k] : T(0);
                        incl[k]  = k == 0 ? items[0] : incl[k - 1] + items[k];
                    }
                    T total; T excl;
                    if constexpr (VARIANT == 1) { excl = 0; total = 0; }
                    else excl = team_exclusive_scan(incl[ITEMS - 1], s_vals, 
s_seg, ti.tid, ti.nth, total);
                    const T base = carry + excl;
#pragma unroll
                    for(unsigned k = 0; k < ITEMS; ++k)
                    {
                        if(i0 + k < end)
                        {
                            out[i0 + k] = inclusive ? base + incl[k] : (k == 0 ?
base : base + incl[k - 1]);
                        }
                    }
                    carry += total;
                }
            }
        }
    }
}

template<unsigned ITEMS, int V> void bench(const uint32_t* in, uint32_t* out, 
uint32_t* tot, size_t n, unsigned P, bool incl) {
    scan_downsweep<uint32_t, ITEMS, V>(in, out, tot, n, P, incl);
    std::vector<double> t;
    for (int r = 0; r < 9; ++r) { auto a = clk::now(); scan_downsweep<uint32_t, 
ITEMS, V>(in, out, tot, n, P, incl); auto b = clk::now(); 
t.push_back(std::chrono::duration<double, std::micro>(b-a).count()); }
    std::sort(t.begin(), t.end());
    printf("ITEMS=%u variant %d P=%u incl=%d: %.0f us\n", ITEMS, V, P, 
(int)incl, t[4]);
}

int main() {
    const size_t n = 1ull << 26;
    int dev = omp_get_default_device();
    uint32_t* in = (uint32_t*)omp_target_alloc(n * 4, dev);
    uint32_t* out = (uint32_t*)omp_target_alloc(n * 4, dev);
    uint32_t* tot = (uint32_t*)omp_target_alloc(1 << 16, dev);
    omp_target_memset(in, 0, n * 4, dev); omp_target_memset(tot, 0, 1 << 16, 
dev);
    for (unsigned P : {2048u, 4096u}) {
        bench<8, 0>(in, out, tot, n, P, false);
        bench<8, 0>(in, out, tot, n, P, true);
        bench<8, 1>(in, out, tot, n, P, false);
        bench<4, 0>(in, out, tot, n, P, false);
        bench<16, 0>(in, out, tot, n, P, false);
        bench<16, 1>(in, out, tot, n, P, false);
    }
}
EOF
clang++ -O3 -std=c++20 -fopenmp --offload-arch=sm_89 
-fopenmp-assume-no-nested-parallelism -fopenmp-assume-no-thread-state 
-I/app/include var_scan.cpp -o var_scan 2>&1 | grep -v "^$" | grep -v warning; 
./var_scan
