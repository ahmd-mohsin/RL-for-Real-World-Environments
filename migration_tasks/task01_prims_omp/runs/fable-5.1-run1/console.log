#include <omp.h>
#include <cstdio>
#include <cstdint>
#include <chrono>
#include <cstdlib>
#include <algorithm>

int main(int argc, char** argv) {
    const int nblocks = argc > 1 ? atoi(argv[1]) : 1024;
    const int BLOCK = 256;
    uint32_t *info = (uint32_t*)omp_target_alloc(16 * sizeof(uint32_t), 
omp_get_default_device());
    uint32_t *counts = (uint32_t*)omp_target_alloc(nblocks * sizeof(uint32_t), 
omp_get_default_device());
    const int dev = omp_get_default_device();
    printf("num devices %d default %d\n", omp_get_num_devices(), dev);
    auto t0 = std::chrono::steady_clock::now();
    #pragma omp target teams num_teams(nblocks) thread_limit(BLOCK) 
is_device_ptr(info, counts)
    {
        uint32_t s_data[2 * 256];
        #pragma omp allocate(s_data) allocator(omp_pteam_mem_alloc)
        #pragma omp parallel
        {
            const unsigned nteams = omp_get_num_teams(), team = 
omp_get_team_num();
            const unsigned nth = omp_get_num_threads(), tid = 
omp_get_thread_num();
            if (team == 0 && tid == 0) { info[0] = nteams; info[1] = nth; }
            for (unsigned b = team; b < (unsigned)nblocks; b += nteams) {
                for (unsigned vt = tid; vt < (unsigned)BLOCK; vt += nth) 
s_data[vt] = vt + b;
                #pragma omp barrier
                for (unsigned vt = tid; vt < (unsigned)BLOCK; vt += nth) 
s_data[256 + vt] = s_data[(vt + 1) % 256];
                #pragma omp barrier
                if (tid == 0) { uint32_t s = 0; for (int i = 0; i < 256; ++i) s 
+= s_data[256 + i]; counts[b] = s; }
                #pragma omp barrier
            }
        }
    }
    auto t1 = std::chrono::steady_clock::now();
    uint32_t h[16]; uint32_t* hc = new uint32_t[nblocks];
    omp_target_memcpy(h, info, 16 * 4, 0, 0, omp_get_initial_device(), dev);
    omp_target_memcpy(hc, counts, nblocks * 4, 0, 0, omp_get_initial_device(), 
dev);
    bool ok = true;
    for (int b = 0; b < nblocks; ++b) { uint32_t exp = 0; for (int i = 0; i < 
256; ++i) exp += ((i + 1) % 256) + b; ok = ok && hc[b] == exp; }
    printf("teams=%u threads=%u ok=%d time=%.3f ms\n", h[0], h[1], ok, 
std::chrono::duration<double, std::milli>(t1 - t0).count());
    // launch overhead
    t0 = std::chrono::steady_clock::now();
    for (int r = 0; r < 100; ++r) {
        #pragma omp target teams num_teams(nblocks) thread_limit(BLOCK) 
is_device_ptr(info)
        #pragma omp parallel
        { if (omp_get_team_num() == 0 && omp_get_thread_num() == 0) info[2] = r;
}
    }
    t1 = std::chrono::steady_clock::now();
    printf("launch: %.2f us each\n", std::chrono::duration<double, 
std::micro>(t1 - t0).count() / 100);
    return 0;
}
