cd /tmp/probe && cat <<'EOF' > var_scan2.cpp
#include <chrono>
#include <cstdio>
#include <vector>
#include <algorithm>
#include "tsr/prims/team.h"
using namespace tsr::prims;
using clk = std::chrono::steady_clock;

// Variant A: segmented, but loops marked unroll 1
template<typename T>
inline T scan_A(T value, T *s_vals, T *s_seg, unsigned tid, unsigned nth, T 
&total)
{
    const unsigned nseg    = nth < kScanSegments ? nth : kScanSegments;
    const unsigned seg_len = (nth + nseg - 1) / nseg;
    s_vals[tid]            = value;
#pragma omp barrier
    if(tid < nseg)
    {
        const unsigned lo = tid * seg_len;
        const unsigned hi = lo + seg_len < nth ? lo + seg_len : nth;
        T sum             = T(0);
#pragma unroll 1
        for(unsigned i = lo; i < hi; ++i) sum += s_vals[i];
        s_seg[tid] = sum;
    }
#pragma omp barrier
    if(tid == 0)
    {
        T run = T(0);
#pragma unroll 1
        for(unsigned i = 0; i < nseg; ++i) { const T c = s_seg[i]; s_seg[i] = 
run; run += c; }
        s_seg[kScanSegments] = run;
    }
#pragma omp barrier
    if(tid < nseg)
    {
        const unsigned lo = tid * seg_len;
        const unsigned hi = lo + seg_len < nth ? lo + seg_len : nth;
        T run             = s_seg[tid];
#pragma unroll 1
        for(unsigned i = lo; i < hi; ++i) { const T c = s_vals[i]; s_vals[i] = 
run; run += c; }
    }
#pragma omp barrier
    const T result = s_vals[tid];
    total          = s_seg[kScanSegments];
#pragma omp barrier
    return result;
}

// Variant B: Hillis-Steele double buffered. s_vals must hold 2*kMaxThreads.
template<typename T>
inline T scan_B(T value, T *s_vals, unsigned tid, unsigned nth, T &total)
{
    unsigned buf = 0;
    s_vals[tid] = value;
#pragma omp barrier
    for(unsigned offset = 1; offset < nth; offset <<= 1)
    {
        T v = s_vals[buf * kMaxThreads + tid];
        if(tid >= offset) v += s_vals[buf * kMaxThreads + tid - offset];
        buf ^= 1u;
        s_vals[buf * kMaxThreads + tid] = v;
#pragma omp barrier
    }
    const T incl = s_vals[buf * kMaxThreads + tid];
    total = s_vals[buf * kMaxThreads + nth - 1];
#pragma omp barrier
    return incl - value;
}

template<typename T, unsigned ITEMS, int VARIANT>
void scan_downsweep(const T *in, T *out, const T *totals, std::uint64_t n, 
unsigned P, bool inclusive)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(in, out, totals)
    {
        T s_vals[2 * kMaxThreads];
        T s_seg[kScanSegments + 1];
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                T carry                   = totals[p];
                const std::uint64_t chunk = static_cast<std::uint64_t>(ti.nth) *
ITEMS;
                for(std::uint64_t cb = begin; cb < end; cb += chunk)
                {
                    const std::uint64_t i0 = cb + 
static_cast<std::uint64_t>(ti.tid) * ITEMS;
                    T items[ITEMS];
                    T incl[ITEMS];
#pragma unroll
                    for(unsigned k = 0; k < ITEMS; ++k)
                    {
                        items[k] = i0 + k < end ? in[i0 + k] : T(0);
                        incl[k]  = k == 0 ? items[0] : incl[k - 1] + items[k];
                    }
                    T total; T excl;
                    if constexpr (VARIANT == 0) excl = 
team_exclusive_scan(incl[ITEMS - 1], s_vals, s_seg, ti.tid, ti.nth, total);
                    else if constexpr (VARIANT == 1) excl = scan_A(incl[ITEMS - 
1], s_vals, s_seg, ti.tid, ti.nth, total);
                    else excl = scan_B(incl[ITEMS - 1], s_vals, ti.tid, ti.nth, 
total);
                    const T base = carry + excl;
#pragma unroll
                    for(unsigned k = 0; k < ITEMS; ++k)
                    {
                        if(i0 + k < end)
                        {
                            out[i0 + k] = inclusive ? base + incl[k] : (k == 0 ?
base : base + incl[k - 1]);
                        }
                    }
                    carry += total;
                }
            }
        }
    }
}

template<unsigned ITEMS, int V> void bench(const uint32_t* in, uint32_t* out, 
uint32_t* tot, size_t n, unsigned P, bool incl) {
    scan_downsweep<uint32_t, ITEMS, V>(in, out, tot, n, P, incl);
    std::vector<double> t;
    for (int r = 0; r < 9; ++r) { auto a = clk::now(); scan_downsweep<uint32_t, 
ITEMS, V>(in, out, tot, n, P, incl); auto b = clk::now(); 
t.push_back(std::chrono::duration<double, std::micro>(b-a).count()); }
    std::sort(t.begin(), t.end());
    std::vector<uint32_t> h(n); omp_target_memcpy(h.data(), out, n * 4, 0, 0, 
omp_get_initial_device(), omp_get_default_device());
    size_t bad = 0; uint32_t acc = 0; uint64_t per = (n + P - 1) / P;
    for (size_t i = 0; i < n; ++i) { if (i % per == 0) acc = 0; if (h[i] != acc)
bad++; acc += 1; }
    printf("ITEMS=%u variant %d P=%u incl=%d: %.0f us (bad=%zu)\n", ITEMS, V, P,
(int)incl, t[4], bad);
}

int main() {
    const size_t n = 1ull << 26;
    int dev = omp_get_default_device();
    uint32_t* in = (uint32_t*)omp_target_alloc(n * 4, dev);
    uint32_t* out = (uint32_t*)omp_target_alloc(n * 4, dev);
    uint32_t* tot = (uint32_t*)omp_target_alloc(1 << 16, dev);
    std::vector<uint32_t> ones(n, 1); omp_target_memcpy(in, ones.data(), n * 4, 
0, 0, dev, omp_get_initial_device()); omp_target_memset(tot, 0, 1 << 16, dev);
    for (unsigned P : {4096u}) {
        bench<8, 0>(in, out, tot, n, P, false);
        bench<8, 1>(in, out, tot, n, P, false);
        bench<8, 2>(in, out, tot, n, P, false);
        bench<4, 1>(in, out, tot, n, P, false);
        bench<4, 2>(in, out, tot, n, P, false);
    }
}
EOF
