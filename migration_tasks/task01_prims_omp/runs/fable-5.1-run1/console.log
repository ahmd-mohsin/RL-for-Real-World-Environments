cd /app && cat <<'EOF' > include/tsr/device/sync.h
// Tessera - host-side synchronization helpers.
//
// The OpenMP offload runtime waits for device work with blocking (interrupt
// driven) synchronization. After a few hundred microseconds of idling, the
// calling core drops into deep idle states and low clocks, and every
// subsequent wake-up and runtime call becomes several times slower - the
// CUDA runtime avoids this by spin-waiting. SyncScope reproduces that
// behaviour portably: while a scope is open, a low-priority helper thread
// pinned to the calling core keeps the core busy, so the waiting thread
// resumes at full speed. The helper stops a few milliseconds after the last
// scope closes. Set TSR_NO_SPIN_WAIT=1 to disable it.
#pragma once

namespace tsr::detail
{
void sync_scope_begin() noexcept;
void sync_scope_end() noexcept;

struct SyncScope
{
    SyncScope() noexcept { sync_scope_begin(); }
    ~SyncScope() { sync_scope_end(); }
    SyncScope(const SyncScope &)            = delete;
    SyncScope &operator=(const SyncScope &) = delete;
};
} // namespace tsr::detail
EOF
cat <<'EOF' > src/device/sync.cpp
// Tessera - host-side synchronization helpers (see tsr/device/sync.h).
#include "tsr/device/sync.h"

#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdlib>
#include <cstring>
#include <mutex>
#include <thread>

#if defined(__linux__)
#    include <pthread.h>
#    include <sched.h>
#    include <sys/resource.h>
#    include <sys/syscall.h>
#    include <unistd.h>
#endif

namespace tsr::detail
{
namespace
{
using Clock = std::chrono::steady_clock;

// How long the helper keeps the core busy after the last scope closed, so
// that back-to-back device operations stay fast.
constexpr auto kGrace = std::chrono::milliseconds(3);
// Upper bound for a single open scope; a scope that is still open after this
// long is assumed to have been forgotten.
constexpr auto kMaxScope = std::chrono::seconds(2);

class CoreWarmer
{
public:
    static CoreWarmer &instance()
    {
        static CoreWarmer w;
        return w;
    }

    void begin() noexcept
    {
        if(!enabled_)
        {
            return;
        }
        const int depth = depth_.fetch_add(1, std::memory_order_acq_rel);
        if(depth == 0)
        {
            deadline_.store(ticks(Clock::now() + kMaxScope), 
std::memory_order_release);
#if defined(__linux__)
            const int cpu = sched_getcpu();
            if(cpu >= 0)
            {
                cpu_.store(cpu, std::memory_order_release);
            }
#endif
            if(!spinning_.load(std::memory_order_acquire))
            {
                std::lock_guard<std::mutex> lock(mutex_);
                wake_ = true;
                cv_.notify_one();
            }
        }
    }

    void end() noexcept
    {
        if(!enabled_)
        {
            return;
        }
        if(depth_.fetch_sub(1, std::memory_order_acq_rel) == 1)
        {
            deadline_.store(ticks(Clock::now() + kGrace), 
std::memory_order_release);
        }
    }

private:
    CoreWarmer()
    {
        const char *v = std::getenv("TSR_NO_SPIN_WAIT");
        enabled_      = !(v != nullptr && *v != '\0' && std::strcmp(v, "0") != 
0);
        if(enabled_)
        {
            thread_ = std::thread([this] { run(); });
            thread_.detach();
        }
    }

    static long long ticks(Clock::time_point t) { return 
std::chrono::duration_cast<std::chrono::nanoseconds>(t.time_since_epoch()).count
(); }

    void run()
    {
#if defined(__linux__)
        // Lowest priority: the helper only ever runs while the thread that
        // opened the scope is blocked in the offload runtime.
        setpriority(PRIO_PROCESS, static_cast<id_t>(syscall(SYS_gettid)), 19);
#endif
        int pinned = -1;
        for(;;)
        {
            {
                std::unique_lock<std::mutex> lock(mutex_);
                cv_.wait(lock, [this] { return wake_; });
                wake_ = false;
            }
            spinning_.store(true, std::memory_order_release);
            while(ticks(Clock::now()) < 
deadline_.load(std::memory_order_acquire))
            {
#if defined(__linux__)
                const int cpu = cpu_.load(std::memory_order_acquire);
                if(cpu != pinned && cpu >= 0)
                {
                    cpu_set_t set;
                    CPU_ZERO(&set);
                    CPU_SET(cpu, &set);
                    pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
                    pinned = cpu;
                }
#endif
                for(int i = 0; i < 64; ++i)
                {
                    spin_sink_.fetch_add(1, std::memory_order_relaxed);
                }
            }
            spinning_.store(false, std::memory_order_release);
        }
    }

    bool enabled_ = true;
    std::thread thread_;
    std::mutex mutex_;
    std::condition_variable cv_;
    bool wake_ = false;
    std::atomic<int> depth_{0};
    std::atomic<int> cpu_{-1};
    std::atomic<long long> deadline_{0};
    std::atomic<bool> spinning_{false};
    std::atomic<unsigned> spin_sink_{0};
};
} // namespace

void sync_scope_begin() noexcept
{
    CoreWarmer::instance().begin();
}

void sync_scope_end() noexcept
{
    CoreWarmer::instance().end();
}
} // namespace tsr::detail
EOF
