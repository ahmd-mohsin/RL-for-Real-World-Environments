```
cd /tmp/probe && cat <<'EOF' > bw2.cpp
#include <omp.h>
#include <cstdio>
#include <cstdint>
#include <chrono>
#include <cstdlib>
#include <cstring>

template<typename F> double timeit(F&& f, int reps = 10) {
    f();
    auto t0 = std::chrono::steady_clock::now();
    for (int r = 0; r < reps; ++r) f();
    auto t1 = std::chrono::steady_clock::now();
    return std::chrono::duration<double, std::milli>(t1 - t0).count() / reps;
}

template<int U>
void run(const uint32_t* in, uint32_t* part, size_t n, int P) {
    double ms = timeit([&] {
        #pragma omp target teams num_teams(P) thread_limit(256) 
is_device_ptr(in, part)
        {
            uint32_t s_red[256];
            #pragma omp parallel
            {
                const unsigned nteams = omp_get_num_teams(), team = 
omp_get_team_num();
                const unsigned nth = omp_get_num_threads(), tid = 
omp_get_thread_num();
                const size_t per = (n + P - 1) / P;
                for (unsigned p = team; p < (unsigned)P; p += nteams) {
                    size_t b = p * per, e = b + per < n ? b + per : n;
                    uint32_t acc = 0;
                    size_t i = b + tid;
                    const size_t stride = (size_t)nth * U;
                    for (; i + stride - nth < e; i += stride) {  // full
                        uint32_t v[U];
                        #pragma unroll
                        for (int k = 0; k < U; ++k) v[k] = in[i + k * nth];
                        #pragma unroll
                        for (int k = 0; k < U; ++k) acc += v[k];
                    }
                    for (; i < e; i += nth) acc += in[i];
                    s_red[tid] = acc;
                    #pragma omp barrier
                    if (tid == 0) { uint32_t t = 0; for (unsigned j = 0; j < 
nth; ++j) t += s_red[j]; part[p] = t; }
                    #pragma omp barrier
                }
            }
        }
    });
    printf("U=%d P=%d read-reduce: %.3f ms  %.0f GB/s\n", U, P, ms, 1.0 * n * 4 
/ ms / 1e6);
}

int main(int argc, char** argv) {
    const size_t n = 1ull << 26;
    const int dev = omp_get_default_device();
    uint32_t *in = (uint32_t*)omp_target_alloc(n * 4, dev);
    uint32_t *part = (uint32_t*)omp_target_alloc(1 << 20, dev);
    omp_target_memset(in, 1, n * 4, dev);
    for (int P : {1024, 2048, 4096}) {
        run<1>(in, part, n, P);
        run<4>(in, part, n, P);
        run<8>(in, part, n, P);
        run<16>(in, part, n, P);
    }
    return 0;
}
EOF
clang++ -O3 -std=c++20 -fopenmp --offload-arch=sm_89 bw2.cpp -o bw2 2>&1 | grep 
-v "^$"; ./bw2
```

