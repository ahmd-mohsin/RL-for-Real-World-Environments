# OpenMP target offload configuration.
#
# tsr_device_flags(<var>) stores the compiler/linker flags that select the
# offload target in <var>. The flags are needed both when compiling device
# code and when linking anything that contains device code.
function(tsr_device_flags out_var)
  if(TSR_OFFLOAD_ARCH)
    set(${out_var} -fopenmp --offload-arch=${TSR_OFFLOAD_ARCH} PARENT_SCOPE)
  elseif(TSR_OFFLOAD_TARGETS)
    set(${out_var} -fopenmp -fopenmp-targets=${TSR_OFFLOAD_TARGETS} 
PARENT_SCOPE)
  else()
    message(FATAL_ERROR "Set TSR_OFFLOAD_ARCH (e.g. sm_89) or 
TSR_OFFLOAD_TARGETS (e.g. x86_64-pc-linux-gnu)")
  endif()
endfunction()

function(tsr_target_warnings target)
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${target} PRIVATE
      $<$<COMPILE_LANGUAGE:CXX>:-Wall -Wextra -Wno-unknown-pragmas 
-Wno-unused-parameter>)
  endif()
endfunction()
