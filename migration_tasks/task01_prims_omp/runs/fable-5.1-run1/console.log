// Tessera - device backend (OpenMP target offload).
//
// Device code is expressed with portable OpenMP target constructs. Device
// memory lives on omp_get_default_device() and is handled with the
// omp_target_* API; every pointer handed to a primitive is a device pointer.
//
// Primitives execute synchronously. The `Stream` parameter is kept for API
// compatibility and is accepted as nullptr.
#pragma once

#include <omp.h>

#include <cstddef>
#include <cstdint>

#include "tsr/device/error.h"

namespace tsr
{
// Opaque execution-stream handle. Work is executed synchronously, so the
// value is not interpreted; nullptr is always valid.
struct StreamHandle;
using Stream = StreamHandle *;

template<typename T>
constexpr T div_round_up(T value, T divisor)
{
    return (value + divisor - 1) / divisor;
}

// Device that owns all buffers and runs all primitives.
inline int device_id() noexcept
{
    return omp_get_default_device();
}

inline int host_id() noexcept
{
    return omp_get_initial_device();
}

// Copies `bytes` from a device pointer to host memory (synchronous).
inline void copy_to_host(void *host, const void *device, std::size_t bytes)
{
    if(bytes > 0)
    {
        TSR_OMP_CHECK(omp_target_memcpy(host, device, bytes, 0, 0, host_id(), 
device_id()));
    }
}

// Copies `bytes` from host memory to a device pointer (synchronous).
inline void copy_to_device(void *device, const void *host, std::size_t bytes)
{
    if(bytes > 0)
    {
        TSR_OMP_CHECK(omp_target_memcpy(device, host, bytes, 0, 0, device_id(), 
host_id()));
    }
}

// Kept for source compatibility: target regions are synchronous and report
// failures through the OpenMP runtime, so there is nothing to poll.
void check_launch(Stream stream);

} // namespace tsr
