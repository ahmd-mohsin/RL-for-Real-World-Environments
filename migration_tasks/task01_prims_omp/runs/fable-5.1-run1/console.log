                        count_digit(digit_of(k2, shift, digit_mask), c0, c1, c2,
c3);
                        count_digit(digit_of(k3, shift, digit_mask), c0, c1, c2,
c3);
                    }
                    for(; i < re; i += ti.nth)
                    {
                        count_digit(digit_of(keys[i], shift, digit_mask), c0, 
c1, c2, c3);
                    }
                    const std::uint32_t packed[4] = {c0, c1, c2, c3};
#pragma unroll
                    for(unsigned d = 0; d < kRadixDigits; ++d)
                    {
                        const std::uint32_t c = (packed[d >> 2] >> (8u * (d & 
3u))) & 0xffu;
                        if(c != 0)
                        {
#pragma omp atomic update
                            s_hist[d] += c;
                        }
