                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                for(unsigned i = ti.tid; i < kRadixDigits; i += ti.nth)
                {
                    s_hist[i] = 0;
                }
#pragma omp barrier
                // Each thread counts its keys in registers (four words of
                // 8-bit counters) and flushes them every kUpsweepRound keys.
                const std::uint64_t round = static_cast<std::uint64_t>(ti.nth) *
kUpsweepRound;
                for(std::uint64_t rb = begin; rb < end; rb += round)
                {
                    const std::uint64_t re = rb + round < end ? rb + round : 
end;
                    std::uint32_t c0 = 0, c1 = 0, c2 = 0, c3 = 0;
                    std::uint64_t i  = rb + ti.tid;
                    for(; i + 3 * ti.nth < re; i += 4 * ti.nth)
                    {
                        const K k0 = keys[i];
                        const K k1 = keys[i + ti.nth];
                        const K k2 = keys[i + 2 * ti.nth];
                        const K k3 = keys[i + 3 * ti.nth];
                        count_digit(digit_of(k0, shift, digit_mask), c0, c1, c2,
c3);
                        count_digit(digit_of(k1, shift, digit_mask), c0, c1, c2,
