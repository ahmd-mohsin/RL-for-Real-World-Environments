cd /app && cat <<'EOF' > src/prims/radix_sort.cpp
// Tessera - stable LSD radix sort of key/value pairs.
//
// Each pass sorts on a 4-bit digit in two launches:
//   upsweep    every team counts the digits of its partitions; the last team
//              to finish scans the digit-major count table into scatter
//              offsets (one exclusive scan over 16 * P counters)
//   downsweep  every team walks its partitions chunk by chunk, ranks the keys
//              of a chunk with a stable counting sort and scatters them at
//              offset + rank, advancing its per-digit offsets after each chunk
//
// Ranking (after cub::BlockRadixRank): every thread keeps a 16-bit counter
// per digit for its kSortItems consecutive keys, packed two digits per
// 32-bit word. A single exclusive scan over all words in digit-major order
// yields the stable position of every key within the chunk. Keys are then
// exchanged through shared memory so that consecutive threads write
// consecutive destinations.
#include <algorithm>

#include "tsr/prims/prims.h"
#include "tsr/prims/team.h"

namespace tsr::prims
{
namespace
{
constexpr int kRadixBits                  = 4;
constexpr unsigned kRadixDigits           = 1u << kRadixBits;
constexpr unsigned kSortItems             = 4;
constexpr unsigned kCounterLanes          = kRadixDigits / 2; // two 16-bit 
counters per word
constexpr unsigned kChunkMax              = kMaxThreads * kSortItems;
constexpr unsigned kUpsweepReplicas       = 4;
constexpr std::uint64_t kSortMinPartition = 4096;
constexpr unsigned kSortMaxPartitions     = 2048;

template<typename K>
inline unsigned digit_of(K key, int shift, unsigned digit_mask)
{
    return static_cast<unsigned>(key >> shift) & digit_mask;
}

// counts is laid out digit-major: counts[d * P + p]. On return it holds the
// exclusive scan of that table, i.e. the first destination of digit d in
// partition p.
template<typename K>
void radix_upsweep(const K *keys, std::uint64_t n, int shift, unsigned 
digit_mask, std::uint32_t *counts, unsigned P)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(keys, counts)
    {
        std::uint32_t s_hist[kUpsweepReplicas * kRadixDigits];
        std::uint32_t s_vals[kMaxThreads];
        std::uint32_t s_seg[kScanSegments + 1];
        unsigned s_flag;
#pragma omp parallel
        {
            const TeamInfo ti      = this_team();
            std::uint32_t *my_hist = s_hist + (ti.tid % kUpsweepReplicas) * 
kRadixDigits;
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                for(unsigned i = ti.tid; i < kUpsweepReplicas * kRadixDigits; i 
+= ti.nth)
                {
                    s_hist[i] = 0;
                }
#pragma omp barrier
                std::uint64_t i            = begin + ti.tid;
                const std::uint64_t stride = static_cast<std::uint64_t>(ti.nth) 
* 4;
                for(; i + 3 * ti.nth < end; i += stride)
                {
                    const unsigned d0 = digit_of(keys[i], shift, digit_mask);
                    const unsigned d1 = digit_of(keys[i + ti.nth], shift, 
digit_mask);
                    const unsigned d2 = digit_of(keys[i + 2 * ti.nth], shift, 
digit_mask);
                    const unsigned d3 = digit_of(keys[i + 3 * ti.nth], shift, 
digit_mask);
#pragma omp atomic update
                    my_hist[d0] += 1u;
#pragma omp atomic update
                    my_hist[d1] += 1u;
#pragma omp atomic update
                    my_hist[d2] += 1u;
#pragma omp atomic update
                    my_hist[d3] += 1u;
                }
                for(; i < end; i += ti.nth)
                {
                    const unsigned d = digit_of(keys[i], shift, digit_mask);
#pragma omp atomic update
                    my_hist[d] += 1u;
                }
#pragma omp barrier
                for(unsigned d = ti.tid; d < kRadixDigits; d += ti.nth)
                {
                    std::uint32_t sum = 0;
#pragma unroll
                    for(unsigned r = 0; r < kUpsweepReplicas; ++r)
                    {
                        sum += s_hist[r * kRadixDigits + d];
                    }
                    counts[d * P + p] = sum;
                    publish_writes();
                }
#pragma omp barrier
            }
            if(team_is_last(0, ti.nteams, ti.tid, &s_flag))
            {
                const unsigned total_counts = kRadixDigits * P;
                const unsigned per          = (total_counts + ti.nth - 1) / 
ti.nth;
                const unsigned lo           = ti.tid * per < total_counts ? 
ti.tid * per : total_counts;
                const unsigned hi           = lo + per < total_counts ? lo + per
: total_counts;
                std::uint32_t sum           = 0;
                for(unsigned i = lo; i < hi; ++i)
                {
                    sum += team_load(&counts[i]);
                }
                std::uint32_t total;
                std::uint32_t run = team_exclusive_scan(sum, s_vals, s_seg, 
ti.tid, ti.nth, total);
                for(unsigned i = lo; i < hi; ++i)
                {
                    const std::uint32_t c = team_load(&counts[i]);
                    counts[i]             = run;
                    run                  += c;
                }
            }
        }
    }
}

template<typename K, typename V>
void radix_downsweep(
    const K *keys_in,
    K *keys_out,
    const V *values_in,
    V *values_out,
    std::uint64_t n,
    int shift,
    unsigned digit_mask,
    const std::uint32_t *offsets,
    unsigned P
)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(keys_in, keys_out, values_in, values_out, offsets)
    {
        std::uint32_t s_cnt[kCounterLanes * kMaxThreads];
        K s_keys[kChunkMax];
        V s_vals[kChunkMax];
        std::uint32_t s_scan[kMaxThreads];
        std::uint32_t s_seg[kScanSegments + 1];
        std::uint32_t s_offset[kRadixDigits];
        std::uint32_t s_begin[kRadixDigits + 1];
#pragma omp parallel
        {
            const TeamInfo ti     = this_team();
            const unsigned nth    = ti.nth;
            const unsigned tid    = ti.tid;
            const unsigned nwords = kCounterLanes * nth;
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                for(unsigned d = tid; d < kRadixDigits; d += nth)
                {
                    s_offset[d] = offsets[d * P + p];
                }
                for(unsigned i = tid; i < nwords; i += nth)
                {
                    s_cnt[i] = 0;
                }
#pragma omp barrier
                const std::uint64_t chunk = static_cast<std::uint64_t>(nth) * 
kSortItems;
                for(std::uint64_t cb = begin; cb < end; cb += chunk)
                {
                    const unsigned chunk_n = static_cast<unsigned>(end - cb < 
chunk ? end - cb : chunk);
                    const std::uint64_t i0 = cb + 
static_cast<std::uint64_t>(tid) * kSortItems;
                    K key[kSortItems];
                    V val[kSortItems];
                    unsigned word[kSortItems];
                    unsigned sh[kSortItems];
                    std::uint32_t tpre[kSortItems];
                    bool valid[kSortItems];

                    // Per-thread digit counts; tpre[k] = earlier keys of this
                    // thread with the same digit.
#pragma unroll
                    for(unsigned k = 0; k < kSortItems; ++k)
                    {
                        valid[k] = i0 + k < end;
                        key[k]   = valid[k] ? keys_in[i0 + k] : K(0);
                        val[k]   = valid[k] ? values_in[i0 + k] : V(0);
                        const unsigned d = digit_of(key[k], shift, digit_mask);
                        word[k]          = (d & (kCounterLanes - 1)) * nth + 
tid;
                        sh[k]            = 16u * (d / kCounterLanes);
                        tpre[k]          = 0;
                        if(valid[k])
                        {
                            const std::uint32_t w = s_cnt[word[k]];
                            tpre[k]               = (w >> sh[k]) & 0xffffu;
                            s_cnt[word[k]]        = w + (1u << sh[k]);
                        }
                    }
#pragma omp barrier

                    // Exclusive scan over all counter words in digit-major
                    // order; thread t rakes words [8t, 8t + 8).
                    std::uint32_t sum = 0;
#pragma unroll
                    for(unsigned i = 0; i < kCounterLanes; ++i)
                    {
                        sum += s_cnt[tid * kCounterLanes + i];
                    }
                    std::uint32_t total;
                    std::uint32_t run = team_exclusive_scan(sum, s_scan, s_seg, 
tid, nth, total);
                    // Digits 8..15 (high halves) follow all of digits 0..7.
                    run += (total & 0xffffu) << 16;
#pragma unroll
                    for(unsigned i = 0; i < kCounterLanes; ++i)
                    {
                        const std::uint32_t c       = s_cnt[tid * kCounterLanes 
+ i];
                        s_cnt[tid * kCounterLanes + i] = run;
                        run                        += c;
                    }
#pragma omp barrier

                    // Stable rank within the chunk; exchange through shared 
memory.
#pragma unroll
                    for(unsigned k = 0; k < kSortItems; ++k)
                    {
                        if(valid[k])
                        {
                            const unsigned rank = ((s_cnt[word[k]] >> sh[k]) & 
0xffffu) + tpre[k];
                            s_keys[rank]        = key[k];
                            s_vals[rank]        = val[k];
                        }
                    }
                    for(unsigned d = tid; d <= kRadixDigits; d += nth)
                    {
                        s_begin[d] = d == kRadixDigits
                                         ? chunk_n
                                         : (s_cnt[(d & (kCounterLanes - 1)) * 
nth] >> (16u * (d / kCounterLanes))) & 0xffffu;
                    }
#pragma omp barrier

                    // Scatter: consecutive ranks go to consecutive threads.
#pragma unroll
                    for(unsigned k = 0; k < kSortItems; ++k)
                    {
                        const unsigned r = tid + k * nth;
                        if(r < chunk_n)
                        {
                            const K kk              = s_keys[r];
                            const unsigned d        = digit_of(kk, shift, 
digit_mask);
                            const std::uint32_t pos = s_offset[d] + (r - 
s_begin[d]);
                            keys_out[pos]           = kk;
                            values_out[pos]         = s_vals[r];
                        }
                    }
#pragma omp barrier
                    for(unsigned d = tid; d < kRadixDigits; d += nth)
                    {
                        s_offset[d] += s_begin[d + 1] - s_begin[d];
                    }
                    for(unsigned i = tid; i < nwords; i += nth)
                    {
                        s_cnt[i] = 0;
                    }
#pragma omp barrier
                }
            }
        }
    }
}

template<typename K, typename V>
void copy_pairs(const K *keys_in, K *keys_out, const V *values_in, V 
*values_out, std::uint64_t n)
{
#pragma omp target teams distribute parallel for is_device_ptr(keys_in, 
keys_out, values_in, values_out)
    for(std::uint64_t i = 0; i < n; ++i)
    {
        keys_out[i]   = keys_in[i];
        values_out[i] = values_in[i];
    }
}
} // namespace

template<typename K, typename V>
void radix_sort_pairs(
    const K *keys_in,
    K *keys_out,
    const V *values_in,
    V *values_out,
    std::size_t n,
    int begin_bit,
    int end_bit,
    Arena &arena,
    Stream stream
)
{
    (void)stream;
    TSR_CHECK(begin_bit >= 0 && end_bit <= static_cast<int>(8 * sizeof(K)) && 
begin_bit <= end_bit,
              "invalid bit range [" << begin_bit << ", " << end_bit << ")");
    TSR_CHECK(keys_in != keys_out && values_in != values_out, "radix_sort_pairs 
does not sort in place");
    if(n == 0)
    {
        launch_noop();
        return;
    }
    TSR_CHECK(n <= 0xffffffffu, "radix_sort_pairs supports at most 2^32-1 
elements");

    const int passes = div_round_up(end_bit - begin_bit, kRadixBits);
    if(passes == 0)
    {
        copy_pairs(keys_in, keys_out, values_in, values_out, 
static_cast<std::uint64_t>(n));
        return;
    }

    const unsigned P      = partition_count(n, kSortMinPartition, 
kSortMaxPartitions);
    std::uint32_t *counts = 
arena.allocate<std::uint32_t>(static_cast<std::size_t>(kRadixDigits) * P);
    K *tmp_keys           = passes > 1 ? arena.allocate<K>(n) : nullptr;
    V *tmp_values         = passes > 1 ? arena.allocate<V>(n) : nullptr;

    const K *src_keys   = keys_in;
    const V *src_values = values_in;
    for(int p = 0; p < passes; ++p)
    {
        // Alternate destinations so that the final pass lands in the outputs.
        const bool to_out    = ((passes - 1 - p) % 2) == 0;
        K *dst_keys          = to_out ? keys_out : tmp_keys;
        V *dst_values        = to_out ? values_out : tmp_values;
        const int shift      = begin_bit + p * kRadixBits;
        const int bits       = std::min(kRadixBits, end_bit - shift);
        const unsigned dmask = (1u << bits) - 1u;

        radix_upsweep(src_keys, static_cast<std::uint64_t>(n), shift, dmask, 
counts, P);
        radix_downsweep(src_keys, dst_keys, src_values, dst_values, 
static_cast<std::uint64_t>(n), shift, dmask, counts, P);
        src_keys   = dst_keys;
        src_values = dst_values;
    }
}

template<typename K, typename V>
void sort_pairs(
    const K *keys_in,
    K *keys_out,
    const V *values_in,
    V *values_out,
    std::size_t n,
    int begin_bit,
    int end_bit,
    Arena &arena,
    Stream stream
)
{
    if(n <= kBitonicMaxElements)
    {
        // A single shared-memory network beats several radix passes for
        // small inputs. It compares whole keys, which matches the radix
        // ordering because callers only set bits inside [begin_bit, end_bit).
        bitonic_sort_pairs(keys_in, keys_out, values_in, values_out, n, stream);
        return;
    }
    radix_sort_pairs(keys_in, keys_out, values_in, values_out, n, begin_bit, 
end_bit, arena, stream);
}

#define TSR_INSTANTIATE_SORT(K, V)                                              
\
    template void radix_sort_pairs<K, V>(const K *, K *, const V *, V *, 
std::size_t, int, int, Arena &, Stream); \
    template void sort_pairs<K, V>(const K *, K *, const V *, V *, std::size_t, 
int, int, Arena &, Stream);

TSR_INSTANTIATE_SORT(std::uint64_t, std::int32_t)
TSR_INSTANTIATE_SORT(std::uint32_t, std::uint32_t)
TSR_INSTANTIATE_SORT(std::uint32_t, std::int32_t)

#undef TSR_INSTANTIATE_SORT
} // namespace tsr::prims
