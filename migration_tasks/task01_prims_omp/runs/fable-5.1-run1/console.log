#include <chrono>
#include <cstdio>
#include <vector>
#include <algorithm>
#include "tsr/prims/team.h"
using namespace tsr::prims;
using clk = std::chrono::steady_clock;

template<unsigned TL, unsigned U>
void reduce_kernel(const float *in, float *partials, float *out, std::uint64_t 
n, unsigned P)
{
#pragma omp target teams num_teams(P) thread_limit(TL) is_device_ptr(in, 
partials, out)
    {
        float s_vals[TL];
        unsigned s_flag;
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            const SumOp<float> op{};
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                float acc = 0;
                std::uint64_t i = begin + ti.tid;
                const std::uint64_t stride = static_cast<std::uint64_t>(ti.nth) 
* U;
                for(; i + (U - 1) * ti.nth < end; i += stride) {
                    float v[U];
                    #pragma unroll
                    for (unsigned k = 0; k < U; ++k) v[k] = in[i + k * ti.nth];
                    #pragma unroll
                    for (unsigned k = 0; k < U; ++k) acc = op(acc, v[k]);
                }
                for(; i < end; i += ti.nth) acc = op(acc, in[i]);
                // tree reduce
                s_vals[ti.tid] = acc;
#pragma omp barrier
                unsigned half = 1; while (half < ti.nth) half <<= 1;
                for (half >>= 1; half > 0; half >>= 1) { if (ti.tid < half && 
ti.tid + half < ti.nth) s_vals[ti.tid] += s_vals[ti.tid + half];
#pragma omp barrier
                }
                if(ti.tid == 0) { partials[p] = s_vals[0]; publish_writes(); }
#pragma omp barrier
            }
            if(team_is_last(0, ti.nteams, ti.tid, &s_flag))
            {
                float acc = 0;
                for(unsigned i = ti.tid; i < P; i += ti.nth) acc = op(acc, 
team_load(&partials[i]));
                s_vals[ti.tid] = acc;
#pragma omp barrier
                unsigned half = 1; while (half < ti.nth) half <<= 1;
                for (half >>= 1; half > 0; half >>= 1) { if (ti.tid < half && 
ti.tid + half < ti.nth) s_vals[ti.tid] += s_vals[ti.tid + half];
#pragma omp barrier
                }
                if(ti.tid == 0) *out = s_vals[0];
            }
        }
    }
}

template<unsigned TL, unsigned U> void bench(const float* in, float* part, 
float* out, size_t n, unsigned P) {
    reduce_kernel<TL, U>(in, part, out, n, P);
    std::vector<double> t;
    for (int r = 0; r < 9; ++r) { auto a = clk::now(); reduce_kernel<TL, U>(in, 
part, out, n, P); auto b = clk::now(); t.push_back(std::chrono::duration<double,
std::micro>(b-a).count()); }
    std::sort(t.begin(), t.end());
    float h; omp_target_memcpy(&h, out, 4, 0, 0, omp_get_initial_device(), 
omp_get_default_device());
    printf("TL=%u U=%u P=%u: %.0f us (sum=%g)\n", TL, U, P, t[4], h);
}

int main() {
    const size_t n = 1ull << 26;
    int dev = omp_get_default_device();
    float* in = (float*)omp_target_alloc(n * 4, dev);
    float* part = (float*)omp_target_alloc(1 << 16, dev);
    float* out = (float*)omp_target_alloc(256, dev);
    std::vector<float> h(n, 1.0f); omp_target_memcpy(in, h.data(), n * 4, 0, 0, 
dev, omp_get_initial_device());
    bench<256, 4>(in, part, out, n, 4096);
    bench<256, 8>(in, part, out, n, 4096);
    bench<512, 4>(in, part, out, n, 2048);
    bench<512, 8>(in, part, out, n, 2048);
    bench<512, 8>(in, part, out, n, 4096);
    bench<1024, 4>(in, part, out, n, 1024);
    bench<1024, 8>(in, part, out, n, 1024);
    bench<1024, 8>(in, part, out, n, 2048);
    bench<1024, 16>(in, part, out, n, 2048);
    bench<128, 8>(in, part, out, n, 4096);
    bench<128, 8>(in, part, out, n, 8192);
}
EOF
