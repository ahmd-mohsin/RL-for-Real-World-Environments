#include <chrono>
#include <cstdio>
#include <vector>
#include <algorithm>
#include "tsr/prims/team.h"
using namespace tsr::prims;
using clk = std::chrono::steady_clock;

template<typename T>
inline T scan_B(T value, T *s_vals, unsigned tid, unsigned nth, T &total)
{
    unsigned buf = 0;
    s_vals[tid] = value;
#pragma omp barrier
    for(unsigned offset = 1; offset < nth; offset <<= 1)
    {
        T v = s_vals[buf * kMaxThreads + tid];
        if(tid >= offset) v += s_vals[buf * kMaxThreads + tid - offset];
        buf ^= 1u;
        s_vals[buf * kMaxThreads + tid] = v;
#pragma omp barrier
    }
    const T incl = s_vals[buf * kMaxThreads + tid];
    total = s_vals[buf * kMaxThreads + nth - 1];
#pragma omp barrier
    return incl - value;
}

// VARIANT 0: direct blocked loads. VARIANT 1: striped loads via shared tile.
template<typename T, unsigned ITEMS, int VARIANT>
void scan_downsweep(const T *in, T *out, const T *totals, std::uint64_t n, 
unsigned P, bool inclusive)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(in, out, totals)
    {
        T s_vals[2 * kMaxThreads];
        T s_tile[kMaxThreads * ITEMS];
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                T carry                   = totals[p];
                const std::uint64_t chunk = static_cast<std::uint64_t>(ti.nth) *
ITEMS;
                for(std::uint64_t cb = begin; cb < end; cb += chunk)
                {
                    T items[ITEMS];
                    T incl[ITEMS];
                    const std::uint64_t i0 = cb + 
static_cast<std::uint64_t>(ti.tid) * ITEMS;
                    if constexpr (VARIANT == 0) {
#pragma unroll
                        for(unsigned k = 0; k < ITEMS; ++k) items[k] = i0 + k < 
end ? in[i0 + k] : T(0);
                    } else {
#pragma unroll
                        for(unsigned k = 0; k < ITEMS; ++k) { const 
std::uint64_t i = cb + k * ti.nth + ti.tid; s_tile[k * ti.nth + ti.tid] = i < 
end ? in[i] : T(0); }
#pragma omp barrier
#pragma unroll
                        for(unsigned k = 0; k < ITEMS; ++k) items[k] = 
s_tile[ti.tid * ITEMS + k];
                    }
#pragma unroll
                    for(unsigned k = 0; k < ITEMS; ++k) incl[k]  = k == 0 ? 
items[0] : incl[k - 1] + items[k];
                    T total;
                    const T excl = scan_B(incl[ITEMS - 1], s_vals, ti.tid, 
ti.nth, total);
                    const T base = carry + excl;
                    if constexpr (VARIANT == 0) {
#pragma unroll
                        for(unsigned k = 0; k < ITEMS; ++k) if(i0 + k < end) 
out[i0 + k] = inclusive ? base + incl[k] : (k == 0 ? base : base + incl[k - 1]);
                    } else {
#pragma unroll
                        for(unsigned k = 0; k < ITEMS; ++k) s_tile[ti.tid * 
ITEMS + k] = inclusive ? base + incl[k] : (k == 0 ? base : base + incl[k - 1]);
#pragma omp barrier
#pragma unroll
                        for(unsigned k = 0; k < ITEMS; ++k) { const 
std::uint64_t i = cb + k * ti.nth + ti.tid; if (i < end) out[i] = s_tile[k * 
ti.nth + ti.tid]; }
#pragma omp barrier
                    }
                    carry += total;
                }
            }
        }
    }
}

template<typename T, unsigned ITEMS, int V> void bench(const T* in, T* out, T* 
tot, size_t n, unsigned P, bool incl) {
    scan_downsweep<T, ITEMS, V>(in, out, tot, n, P, incl);
    std::vector<double> t;
    for (int r = 0; r < 9; ++r) { auto a = clk::now(); scan_downsweep<T, ITEMS, 
V>(in, out, tot, n, P, incl); auto b = clk::now(); 
t.push_back(std::chrono::duration<double, std::micro>(b-a).count()); }
    std::sort(t.begin(), t.end());
    std::vector<T> h(n); omp_target_memcpy(h.data(), out, n * sizeof(T), 0, 0, 
omp_get_initial_device(), omp_get_default_device());
    size_t bad = 0; T acc = 0; uint64_t per = (n + P - 1) / P;
    for (size_t i = 0; i < n; ++i) { if (i % per == 0) acc = 0; if (h[i] != acc)
bad++; acc += 1; }
    printf("T=%zuB ITEMS=%u variant %d P=%u: %.0f us (bad=%zu)\n", sizeof(T), 
ITEMS, V, P, t[4], bad);
}

template<typename T> void run(size_t n) {
    int dev = omp_get_default_device();
    T* in = (T*)omp_target_alloc(n * sizeof(T), dev);
    T* out = (T*)omp_target_alloc(n * sizeof(T), dev);
    T* tot = (T*)omp_target_alloc(1 << 16, dev);
    std::vector<T> ones(n, 1); omp_target_memcpy(in, ones.data(), n * sizeof(T),
0, 0, dev, omp_get_initial_device()); omp_target_memset(tot, 0, 1 << 16, dev);
    bench<T, 4, 0>(in, out, tot, n, 4096, false);
    bench<T, 4, 1>(in, out, tot, n, 4096, false);
    bench<T, 8, 1>(in, out, tot, n, 4096, false);
    bench<T, 8, 0>(in, out, tot, n, 4096, false);
    bench<T, 16, 1>(in, out, tot, n, 4096, false);
    omp_target_free(in, dev); omp_target_free(out, dev); omp_target_free(tot, 
dev);
}
int main() { run<uint32_t>(1ull << 26); run<uint64_t>(1ull << 26); }
