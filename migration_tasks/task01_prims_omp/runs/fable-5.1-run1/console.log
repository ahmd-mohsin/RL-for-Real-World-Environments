The team scan is surprisingly expensive (1311 µs with vs 681 µs without), and 
blocked loads degrade with more items per thread. Let me measure the raw cost of
OpenMP barriers on the GPU.

```
cd /tmp/probe && cat <<'EOF' > bar.cpp
#include <chrono>
#include <cstdio>
#include <vector>
#include <algorithm>
#include <omp.h>
#include <cstdint>
using clk = std::chrono::steady_clock;
template<typename F> double med(F&& f) { f(); std::vector<double> t; for (int r 
= 0; r < 7; ++r) { auto a = clk::now(); f(); auto b = clk::now(); 
t.push_back(std::chrono::duration<double, std::micro>(b-a).count()); } 
std::sort(t.begin(), t.end()); return t[3]; }
int main() {
    int dev = omp_get_default_device();
    uint32_t* out = (uint32_t*)omp_target_alloc(1 << 20, dev);
    const unsigned P = 1024;
    for (int iters : {0, 100, 1000}) {
        double t = med([&] {
            #pragma omp target teams num_teams(P) thread_limit(256) 
is_device_ptr(out)
            {
                uint32_t s[256];
                #pragma omp parallel
                {
                    unsigned tid = omp_get_thread_num();
                    uint32_t acc = tid;
                    for (int i = 0; i < iters; ++i) {
                        s[tid] = acc;
                        #pragma omp barrier
                        acc += s[(tid + 1) & 255];
                        #pragma omp barrier
                    }
                    if (tid == 0) out[omp_get_team_num()] = acc;
                }
            }
        });
        printf("P=%u iters=%d (2 barriers each): %.0f us  -> %.1f ns per barrier
per team (with ~4 teams/SM: %.1f ns effective)\n", P, iters, t, iters ? (t - 40)
* 1000 / (2.0 * iters) / (P / 128.0) : 0.0, 0.0);
    }
}
EOF
clang++ -O3 -std=c++20 -fopenmp --offload-arch=sm_89 
-fopenmp-assume-no-nested-parallelism -fopenmp-assume-no-thread-state bar.cpp -o
bar 2>&1 | grep -v "^$" | grep -v warning; ./bar
```

