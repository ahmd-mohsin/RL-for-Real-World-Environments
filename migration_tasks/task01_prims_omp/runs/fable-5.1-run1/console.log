// Tessera - 256-bin histogram.
//
// Single launch. Each team accumulates its partitions into replicated
// sub-histograms in shared memory (threads spread over the replicas to
// reduce atomic contention), merges them and adds the result to a device-wide
// accumulator with global atomics. The last team to finish copies the
// accumulator into `hist` (overwriting it) and clears the accumulator for the
// next call.
#include "tsr/prims/prims.h"
#include "tsr/prims/team.h"

namespace tsr::prims
{
namespace
{
constexpr unsigned kHistReplicas          = 8;
constexpr unsigned kHistSharedBins        = kHistReplicas * kHistogramBins;
constexpr std::uint64_t kHistMinPartition = 16384;
constexpr unsigned kHistMaxPartitions     = 2048;

#pragma omp begin declare target
std::uint32_t g_hist_acc[kHistogramBins];
#pragma omp end declare target

void histogram_kernel(const std::uint32_t *bins, std::uint64_t n, std::uint32_t 
*hist, unsigned P)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(bins, hist)
    {
        std::uint32_t s_hist[kHistSharedBins];
        unsigned s_flag;
#pragma omp parallel
        {
            const TeamInfo ti      = this_team();
            std::uint32_t *my_hist = s_hist + (ti.tid % kHistReplicas) * 
kHistogramBins;
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                for(unsigned i = ti.tid; i < kHistSharedBins; i += ti.nth)
                {
                    s_hist[i] = 0;
                }
#pragma omp barrier
                std::uint64_t i            = begin + ti.tid;
                const std::uint64_t stride = static_cast<std::uint64_t>(ti.nth) 
* 4;
                for(; i + 3 * ti.nth < end; i += stride)
                {
                    const std::uint32_t b0 = bins[i];
                    const std::uint32_t b1 = bins[i + ti.nth];
                    const std::uint32_t b2 = bins[i + 2 * ti.nth];
                    const std::uint32_t b3 = bins[i + 3 * ti.nth];
                    if(b0 < kHistogramBins)
                    {
#pragma omp atomic update
                        my_hist[b0] += 1u;
                    }
                    if(b1 < kHistogramBins)
                    {
#pragma omp atomic update
                        my_hist[b1] += 1u;
                    }
                    if(b2 < kHistogramBins)
                    {
#pragma omp atomic update
                        my_hist[b2] += 1u;
                    }
                    if(b3 < kHistogramBins)
                    {
#pragma omp atomic update
                        my_hist[b3] += 1u;
                    }
                }
                for(; i < end; i += ti.nth)
                {
                    const std::uint32_t b = bins[i];
                    if(b < kHistogramBins)
                    {
#pragma omp atomic update
                        my_hist[b] += 1u;
                    }
                }
#pragma omp barrier
                for(unsigned bin = ti.tid; bin < kHistogramBins; bin += ti.nth)
                {
                    std::uint32_t sum = 0;
#pragma unroll
                    for(unsigned r = 0; r < kHistReplicas; ++r)
                    {
                        sum += s_hist[r * kHistogramBins + bin];
                    }
                    if(sum != 0)
                    {
#pragma omp atomic update
                        g_hist_acc[bin] += sum;
                    }
                }
#pragma omp barrier
            }
            publish_writes();
            if(team_is_last(0, ti.nteams, ti.tid, &s_flag))
            {
                for(unsigned bin = ti.tid; bin < kHistogramBins; bin += ti.nth)
                {
                    hist[bin] = team_load(&g_hist_acc[bin]);
#pragma omp atomic write
                    g_hist_acc[bin] = 0u;
                }
            }
        }
    }
}
} // namespace

void histogram256(const std::uint32_t *bins, std::size_t n, std::uint32_t *hist,
Arena &arena, Stream stream)
{
    (void)arena;
    (void)stream;
    const unsigned P = partition_count(n, kHistMinPartition, 
kHistMaxPartitions);
    histogram_kernel(bins, static_cast<std::uint64_t>(n), hist, P);
}
} // namespace tsr::prims
