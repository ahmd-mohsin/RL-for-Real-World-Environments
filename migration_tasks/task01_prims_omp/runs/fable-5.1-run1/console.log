// Tessera - single-team bitonic sort for short key/value arrays.
//
// After bitonicSortShared from the cuda-samples "sortingNetworks" sample
// (BSD-3-Clause). Changes: templated key/value types, arbitrary lengths up to
// the shared-memory limit (padded with maximal sentinels to the next power of
// two), a comparator that orders by (key, value) so equal keys come out in a
// deterministic order, and comparators distributed over however many threads
// the team has.
#include <limits>

#include "tsr/prims/prims.h"
#include "tsr/prims/team.h"

namespace tsr::prims
{
namespace
{
constexpr unsigned kSharedSizeLimit = 
static_cast<unsigned>(kBitonicMaxElements);

template<typename K, typename V>
inline void comparator(K &key_a, V &val_a, K &key_b, V &val_b, unsigned dir)
{
    const bool a_greater = key_a > key_b || (key_a == key_b && val_a > val_b);
    if(a_greater == (dir != 0))
    {
        const K tk = key_a;
        key_a      = key_b;
        key_b      = tk;
        const V tv = val_a;
        val_a      = val_b;
        val_b      = tv;
    }
}

template<typename K, typename V>
void bitonic_sort_kernel(
    const K *keys_in,
    K *keys_out,
    const V *values_in,
    V *values_out,
    unsigned n,
    unsigned array_length, // power of two >= n
    unsigned dir           // 1 = ascending
)
{
#pragma omp target teams num_teams(1) thread_limit(kMaxThreads) 
is_device_ptr(keys_in, keys_out, values_in, values_out)
    {
        K s_key[kSharedSizeLimit];
        V s_val[kSharedSizeLimit];
#pragma omp parallel
        {
            const TeamInfo ti   = this_team();
            const unsigned half = array_length / 2;
            for(unsigned i = ti.tid; i < array_length; i += ti.nth)
            {
                if(i < n)
                {
                    s_key[i] = keys_in[i];
                    s_val[i] = values_in[i];
                }
                else
                {
                    s_key[i] = std::numeric_limits<K>::max();
                    s_val[i] = std::numeric_limits<V>::max();
                }
            }

            for(unsigned size = 2; size < array_length; size <<= 1)
            {
                // Bitonic merge
                for(unsigned stride = size / 2; stride > 0; stride >>= 1)
                {
#pragma omp barrier
                    for(unsigned c = ti.tid; c < half; c += ti.nth)
                    {
                        const unsigned ddd = dir ^ ((c & (size / 2)) != 0 ? 1u :
0u);
                        const unsigned pos = 2 * c - (c & (stride - 1));
                        comparator(s_key[pos], s_val[pos], s_key[pos + stride], 
s_val[pos + stride], ddd);
                    }
                }
            }

            // ddd == dir for the last bitonic merge step
            for(unsigned stride = array_length / 2; stride > 0; stride >>= 1)
            {
#pragma omp barrier
                for(unsigned c = ti.tid; c < half; c += ti.nth)
                {
                    const unsigned pos = 2 * c - (c & (stride - 1));
                    comparator(s_key[pos], s_val[pos], s_key[pos + stride], 
s_val[pos + stride], dir);
                }
            }

#pragma omp barrier
            for(unsigned i = ti.tid; i < n; i += ti.nth)
            {
                keys_out[i]   = s_key[i];
                values_out[i] = s_val[i];
            }
        }
    }
}
} // namespace

template<typename K, typename V>
void bitonic_sort_pairs(const K *keys_in, K *keys_out, const V *values_in, V 
*values_out, std::size_t n, Stream stream)
{
    (void)stream;
    TSR_CHECK(n <= kBitonicMaxElements, "bitonic_sort_pairs handles at most " <<
kBitonicMaxElements << " elements, got " << n);
    if(n == 0)
    {
        launch_noop();
        return;
    }
    unsigned length = 2;
    while(length < n)
    {
        length <<= 1;
    }
    bitonic_sort_kernel(keys_in, keys_out, values_in, values_out, 
static_cast<unsigned>(n), length, 1u);
}

template void bitonic_sort_pairs<std::uint64_t, std::int32_t>(const 
std::uint64_t *, std::uint64_t *, const std::int32_t *, std::int32_t *, 
std::size_t, Stream);
template void bitonic_sort_pairs<std::uint32_t, std::uint32_t>(const 
std::uint32_t *, std::uint32_t *, const std::uint32_t *, std::uint32_t *, 
std::size_t, Stream);
template void bitonic_sort_pairs<std::uint32_t, std::int32_t>(const 
std::uint32_t *, std::uint32_t *, const std::int32_t *, std::int32_t *, 
std::size_t, Stream);
} // namespace tsr::prims
EOF
cat <<'EOF' > src/prims/compact.cpp
// Tessera - stream compaction of index sets.
//
// Two launches: compact_count sums the flags of every partition and (in the
// last team) scans the partition counts into output offsets; compact_scatter
// walks every partition in chunks, ranks the set flags with a team scan and
// writes their indices. The total is returned through one scalar download.
#include "tsr/prims/prims.h"
#include "tsr/prims/team.h"

namespace tsr::prims
{
namespace
{
constexpr unsigned kCompactItems             = 16;
constexpr std::uint64_t kCompactMinPartition = 16384;
constexpr unsigned kCompactMaxPartitions     = 4096;

void compact_count(const std::uint8_t *flags, std::uint64_t n, std::uint32_t 
*partials, std::uint32_t *total_out, unsigned P)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(flags, partials, total_out)
    {
        std::uint32_t s_vals[kMaxThreads];
        std::uint32_t s_seg[kScanSegments + 1];
        unsigned s_flag;
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                std::uint32_t acc          = 0;
                std::uint64_t i            = begin + ti.tid;
                const std::uint64_t stride = static_cast<std::uint64_t>(ti.nth) 
* 4;
                for(; i + 3 * ti.nth < end; i += stride)
                {
                    const std::uint8_t f0 = flags[i];
                    const std::uint8_t f1 = flags[i + ti.nth];
                    const std::uint8_t f2 = flags[i + 2 * ti.nth];
                    const std::uint8_t f3 = flags[i + 3 * ti.nth];
                    acc += (f0 != 0 ? 1u : 0u) + (f1 != 0 ? 1u : 0u) + (f2 != 0 
? 1u : 0u) + (f3 != 0 ? 1u : 0u);
                }
                for(; i < end; i += ti.nth)
                {
                    acc += flags[i] != 0 ? 1u : 0u;
                }
                const std::uint32_t sum = team_reduce(acc, 
SumOp<std::uint32_t>{}, s_vals, ti.tid, ti.nth);
                if(ti.tid == 0)
                {
                    partials[p] = sum;
                    publish_writes();
                }
            }
            if(team_is_last(0, ti.nteams, ti.tid, &s_flag))
            {
                const unsigned per = (P + ti.nth - 1) / ti.nth;
                const unsigned lo  = ti.tid * per < P ? ti.tid * per : P;
                const unsigned hi  = lo + per < P ? lo + per : P;
                std::uint32_t sum  = 0;
                for(unsigned i = lo; i < hi; ++i)
                {
                    sum += team_load(&partials[i]);
                }
                std::uint32_t total;
                std::uint32_t run = team_exclusive_scan(sum, s_vals, s_seg, 
ti.tid, ti.nth, total);
                for(unsigned i = lo; i < hi; ++i)
                {
                    const std::uint32_t c = team_load(&partials[i]);
                    partials[i]           = run;
                    run                  += c;
                }
                if(ti.tid == 0)
                {
                    *total_out = total;
                }
            }
        }
    }
}

void compact_scatter(const std::uint8_t *flags, std::uint64_t n, const 
std::uint32_t *partials, std::uint32_t *out, unsigned P)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(flags, partials, out)
    {
        std::uint32_t s_vals[kMaxThreads];
        std::uint32_t s_seg[kScanSegments + 1];
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                std::uint32_t carry       = partials[p];
                const std::uint64_t chunk = static_cast<std::uint64_t>(ti.nth) *
kCompactItems;
                for(std::uint64_t cb = begin; cb < end; cb += chunk)
                {
                    const std::uint64_t i0 = cb + 
static_cast<std::uint64_t>(ti.tid) * kCompactItems;
                    bool set[kCompactItems];
                    std::uint32_t count = 0;
#pragma unroll
                    for(unsigned k = 0; k < kCompactItems; ++k)
                    {
                        set[k] = i0 + k < end && flags[i0 + k] != 0;
                        count += set[k] ? 1u : 0u;
                    }
                    std::uint32_t total;
                    std::uint32_t pos = carry + team_exclusive_scan(count, 
s_vals, s_seg, ti.tid, ti.nth, total);
#pragma unroll
                    for(unsigned k = 0; k < kCompactItems; ++k)
                    {
                        if(set[k])
                        {
                            out[pos++] = static_cast<std::uint32_t>(i0 + k);
                        }
                    }
                    carry += total;
                }
            }
        }
    }
}
} // namespace

std::uint32_t compact_indices(const std::uint8_t *flags, std::size_t n, 
std::uint32_t *out_indices, Arena &arena, Stream stream)
{
    (void)stream;
    if(n == 0)
    {
        launch_noop();
        return 0;
    }
    TSR_CHECK(n <= 0xffffffffu, "compact_indices supports at most 2^32-1 
elements");
    const unsigned P         = partition_count(n, kCompactMinPartition, 
kCompactMaxPartitions);
    std::uint32_t *partials  = arena.allocate<std::uint32_t>(P);
    std::uint32_t *total_dev = arena.allocate<std::uint32_t>(1);
    compact_count(flags, static_cast<std::uint64_t>(n), partials, total_dev, P);
    compact_scatter(flags, static_cast<std::uint64_t>(n), partials, out_indices,
P);
    std::uint32_t total = 0;
    copy_to_host(&total, total_dev, sizeof(total));
    return total;
}
} // namespace tsr::prims
