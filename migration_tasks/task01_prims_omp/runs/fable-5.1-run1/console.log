mini-swe-agent (step 76, $13.30):
The host run exposed a real bug: `team_exclusive_scan` assumed at least 16 
threads per team (here the team had 10). Fixing it to use `min(nth, 16)` 
segments:

```
cd /app && python3 - <<'EOF'
p='/app/include/tsr/prims/team.h'
s=open(p).read()
old_start=s.index('template<typename T>\ninline T team_exclusive_scan')
old_end=s.index('// Reduction of one value per thread')
new='''template<typename T>
inline T team_exclusive_scan(T value, T *s_vals, T *s_seg, unsigned tid, 
unsigned nth, T &total)
{
    const unsigned nseg    = nth < kScanSegments ? nth : kScanSegments;
    const unsigned seg_len = (nth + nseg - 1) / nseg;
    s_vals[tid]            = value;
#pragma omp barrier
    if(tid < nseg)
    {
        const unsigned lo = tid * seg_len;
        const unsigned hi = lo + seg_len < nth ? lo + seg_len : nth;
        T sum             = T(0);
        for(unsigned i = lo; i < hi; ++i)
        {
            sum += s_vals[i];
        }
        s_seg[tid] = sum;
    }
#pragma omp barrier
    if(tid == 0)
    {
        T run = T(0);
        for(unsigned i = 0; i < nseg; ++i)
        {
            const T c = s_seg[i];
            s_seg[i]  = run;
            run      += c;
        }
        s_seg[kScanSegments] = run;
    }
#pragma omp barrier
    if(tid < nseg)
    {
        const unsigned lo = tid * seg_len;
        const unsigned hi = lo + seg_len < nth ? lo + seg_len : nth;
        T run             = s_seg[tid];
        for(unsigned i = lo; i < hi; ++i)
        {
            const T c = s_vals[i];
            s_vals[i] = run;
            run      += c;
        }
    }
#pragma omp barrier
    const T result = s_vals[tid];
    total          = s_seg[kScanSegments];
#pragma omp barrier
    return result;
}

'''
s=s[:old_start]+new+s[old_end:]
open(p,'w').write(s)
EOF
ninja -C build-host 2>&1 | grep -E "error|warning|FAILED"; time 
