#include <chrono>
#include <cstdio>
#include <vector>
#include <algorithm>
#include "tsr/prims/team.h"
using namespace tsr::prims;
using clk = std::chrono::steady_clock;
template<int V, unsigned U>
void kern(const float *in, float *partials, std::uint64_t n, unsigned P)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(in, partials) nowait
    {
        float s_vals[kMaxThreads];
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end; partition_range(n, p, P, begin, end);
                float acc = 0;
                if constexpr (V == 0) {
                    std::uint64_t i = begin + ti.tid; const std::uint64_t stride
= (std::uint64_t)ti.nth * U;
                    for(; i + (U - 1) * ti.nth < end; i += stride) { float v[U];
#pragma unroll
                        for (unsigned k = 0; k < U; ++k) v[k] = in[i + k * 
ti.nth];
#pragma unroll
                        for (unsigned k = 0; k < U; ++k) acc += v[k]; }
                    for(; i < end; i += ti.nth) acc += in[i];
                } else {
                    // two accumulators
                    std::uint64_t i = begin + ti.tid; const std::uint64_t stride
= (std::uint64_t)ti.nth * U; float acc2 = 0;
                    for(; i + (U - 1) * ti.nth < end; i += stride) { float v[U];
#pragma unroll
                        for (unsigned k = 0; k < U; ++k) v[k] = in[i + k * 
ti.nth];
#pragma unroll
                        for (unsigned k = 0; k < U; k += 2) { acc += v[k]; acc2 
+= v[k+1]; } }
                    for(; i < end; i += ti.nth) acc += in[i];
                    acc += acc2;
                }
                const float r = team_reduce(acc, SumOp<float>{}, s_vals, ti.tid,
ti.nth);
                if(ti.tid == 0) partials[p] = r;
            }
        }
    }
}
template<int V, unsigned U> void bench(const float* in, float* part, size_t n, 
unsigned P) {
    kern<V, U>(in, part, n, P);
#pragma omp taskwait
    auto a = clk::now();
    for (int r = 0; r < 20; ++r) kern<V, U>(in, part, n, P);
#pragma omp taskwait
    auto b = clk::now();
    printf("V=%d U=%u P=%u: %.0f us per kernel (pipelined)\n", V, U, P, 
std::chrono::duration<double, std::micro>(b - a).count() / 20);
}
int main() {
    const size_t n = 1ull << 26; int dev = omp_get_default_device();
    float* in = (float*)omp_target_alloc(n * 4, dev); float* part = 
(float*)omp_target_alloc(1 << 16, dev);
    std::vector<float> h(n, 1.0f); omp_target_memcpy(in, h.data(), n * 4, 0, 0, 
dev, omp_get_initial_device());
    bench<0, 4>(in, part, n, 4096); bench<0, 8>(in, part, n, 4096); bench<1, 
8>(in, part, n, 4096); bench<0, 4>(in, part, n, 2048); bench<0, 4>(in, part, n, 
1024); bench<0, 16>(in, part, n, 1024); bench<0, 4>(in, part, n, 8192); bench<0,
4>(in, part, n, 16384);
}
