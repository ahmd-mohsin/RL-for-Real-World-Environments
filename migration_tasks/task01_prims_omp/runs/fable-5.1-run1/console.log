#include <omp.h>
#include <cstdio>
#include <cstdint>
#include <chrono>
#include <cstdlib>
#include <cstring>

template<typename F> double timeit(F&& f, int reps = 10) {
    f();
    auto t0 = std::chrono::steady_clock::now();
    for (int r = 0; r < reps; ++r) f();
    auto t1 = std::chrono::steady_clock::now();
    return std::chrono::duration<double, std::milli>(t1 - t0).count() / reps;
}

int main(int argc, char** argv) {
    const size_t n = 1ull << 26;
    const int dev = omp_get_default_device();
    uint32_t *in = (uint32_t*)omp_target_alloc(n * 4, dev);
    uint32_t *out = (uint32_t*)omp_target_alloc(n * 4, dev);
    uint32_t *part = (uint32_t*)omp_target_alloc(1 << 20, dev);
    omp_target_memset(in, 1, n * 4, dev);
    const int P_list[] = {512, 1024, 2048, 4096};
    for (int P : P_list) {
        // striped copy, grid-stride over partitions
        double ms = timeit([&] {
            #pragma omp target teams num_teams(P) thread_limit(256) 
is_device_ptr(in, out)
            #pragma omp parallel
            {
                const unsigned nteams = omp_get_num_teams(), team = 
omp_get_team_num();
                const unsigned nth = omp_get_num_threads(), tid = 
omp_get_thread_num();
                const size_t per = (n + P - 1) / P;
                for (unsigned p = team; p < (unsigned)P; p += nteams) {
                    size_t b = p * per, e = b + per < n ? b + per : n;
                    for (size_t i = b + tid; i < e; i += nth) out[i] = in[i] + 
1;
                }
            }
        });
        printf("P=%d striped copy: %.3f ms  %.0f GB/s\n", P, ms, 2.0 * n * 4 / 
ms / 1e6);
        // blocked copy: 4 items per thread, chunk = nth*4
        ms = timeit([&] {
            #pragma omp target teams num_teams(P) thread_limit(256) 
is_device_ptr(in, out)
            #pragma omp parallel
            {
                const unsigned nteams = omp_get_num_teams(), team = 
omp_get_team_num();
                const unsigned nth = omp_get_num_threads(), tid = 
omp_get_thread_num();
                const size_t per = (n + P - 1) / P;
                for (unsigned p = team; p < (unsigned)P; p += nteams) {
                    size_t b = p * per, e = b + per < n ? b + per : n;
                    for (size_t base = b; base < e; base += (size_t)nth * 4) {
                        size_t mine = base + (size_t)tid * 4;
                        uint32_t it[4];
                        #pragma unroll
                        for (int k = 0; k < 4; ++k) it[k] = mine + k < e ? 
in[mine + k] : 0;
                        uint32_t s = it[0]; it[0] = 0; 
                        #pragma unroll
                        for (int k = 1; k < 4; ++k) { uint32_t t = it[k]; it[k] 
= s; s += t; }
                        #pragma unroll
                        for (int k = 0; k < 4; ++k) if (mine + k < e) out[mine +
k] = it[k];
                    }
                }
            }
        });
        printf("P=%d blocked copy: %.3f ms  %.0f GB/s\n", P, ms, 2.0 * n * 4 / 
ms / 1e6);
        // reduce-like read only
        ms = timeit([&] {
            #pragma omp target teams num_teams(P) thread_limit(256) 
is_device_ptr(in, part)
            {
                uint32_t s_red[256];
                #pragma omp parallel
                {
                    const unsigned nteams = omp_get_num_teams(), team = 
omp_get_team_num();
                    const unsigned nth = omp_get_num_threads(), tid = 
omp_get_thread_num();
                    const size_t per = (n + P - 1) / P;
                    for (unsigned p = team; p < (unsigned)P; p += nteams) {
                        size_t b = p * per, e = b + per < n ? b + per : n;
                        uint32_t acc = 0;
                        for (size_t i = b + tid; i < e; i += nth) acc += in[i];
                        s_red[tid] = acc;
                        #pragma omp barrier
                        if (tid == 0) { uint32_t t = 0; for (unsigned i = 0; i <
nth; ++i) t += s_red[i]; part[p] = t; }
                        #pragma omp barrier
                    }
                }
            }
        });
        printf("P=%d read-reduce: %.3f ms  %.0f GB/s\n", P, ms, 1.0 * n * 4 / ms
/ 1e6);
    }
    return 0;
}
EOF
