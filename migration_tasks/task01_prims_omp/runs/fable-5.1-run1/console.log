#include <omp.h>
#include <cstdio>
#include <cstdint>
#include <chrono>
int main() {
    const int dev = omp_get_default_device();
    uint32_t *p = (uint32_t*)omp_target_alloc(1024, dev);
    uint32_t *q = (uint32_t*)omp_target_alloc(1024, dev);
    uint64_t n = 5; int flag = 1;
    for (int variant = 0; variant < 3; ++variant) {
        auto t0 = std::chrono::steady_clock::now();
        for (int r = 0; r < 200; ++r) {
            if (variant == 0) {
                #pragma omp target teams num_teams(1) thread_limit(256) 
is_device_ptr(p)
                #pragma omp parallel
                { if (omp_get_thread_num() == 0) p[0] = r; }
            } else if (variant == 1) {
                #pragma omp target teams num_teams(1) thread_limit(256) 
is_device_ptr(p, q) firstprivate(n, flag)
                #pragma omp parallel
                { if (omp_get_thread_num() == 0) { p[0] = r + n; q[0] = flag; } 
}
            } else {
                #pragma omp target is_device_ptr(p)
                { p[0] = r; }
            }
        }
        auto t1 = std::chrono::steady_clock::now();
        printf("variant %d: %.2f us\n", variant, std::chrono::duration<double, 
std::micro>(t1 - t0).count() / 200);
    }
    // D2H copy cost
    uint32_t h;
    auto t0 = std::chrono::steady_clock::now();
    for (int r = 0; r < 200; ++r) omp_target_memcpy(&h, p, 4, 0, 0, 
omp_get_initial_device(), dev);
    auto t1 = std::chrono::steady_clock::now();
    printf("d2h 4B: %.2f us\n", std::chrono::duration<double, std::micro>(t1 - 
t0).count() / 200);
    return 0;
}
