cd /app && cat <<'EOF' > tests/test_prims_extended.cpp
// Randomized comparisons of every instantiation against host references.
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <limits>
#include <numeric>
#include <random>
#include <vector>

#include "doctest.h"
#include "tsr/prims/prims.h"

using namespace tsr;

namespace
{
const std::vector<std::size_t> kSizes = {1, 2, 3, 31, 32, 33, 255, 256, 257, 
1023, 1024, 1025, 2047, 4096, 4097, 8191, 8193, 16384, 70001, 262145, 1000003};

template<typename T>
std::vector<T> random_ints(std::size_t n, std::uint32_t seed, long long lo, long
long hi)
{
    std::mt19937_64 rng(seed);
    std::uniform_int_distribution<long long> dist(lo, hi);
    std::vector<T> out(n);
    for(auto &v : out)
    {
        v = static_cast<T>(dist(rng));
    }
    return out;
}

template<typename T>
void check_scans(std::size_t n, std::uint32_t seed, long long lo, long long hi, 
Arena &arena)
{
    const auto host = random_ints<T>(n, seed, lo, hi);
    DeviceBuffer<T> in, out(n);
    in.upload(host);
    std::vector<T> excl(n), incl(n);
    T acc = T(0);
    for(std::size_t i = 0; i < n; ++i)
    {
        excl[i] = acc;
        acc     = static_cast<T>(acc + host[i]);
        incl[i] = acc;
    }
    arena.reset();
    prims::exclusive_scan(in.data(), out.data(), n, arena, nullptr);
    CHECK(out.to_host() == excl);
    arena.reset();
    prims::inclusive_scan(in.data(), out.data(), n, arena, nullptr);
    CHECK(out.to_host() == incl);
    // in place with total
    DeviceBuffer<T> buf;
    buf.upload(host);
    arena.reset();
    const T total = prims::exclusive_scan_total(buf.data(), buf.data(), n, 
arena, nullptr);
    CHECK(total == acc);
    CHECK(buf.to_host() == excl);
    arena.reset();
    prims::inclusive_scan(in.data(), in.data(), n, arena, nullptr);
    CHECK(in.to_host() == incl);
}
} // namespace

TEST_CASE("ext: integer scans of every type")
{
    Arena arena;
    for(std::size_t n : kSizes)
    {
        CAPTURE(n);
        check_scans<std::uint32_t>(n, 1, 0, 1000, arena);
        check_scans<std::int32_t>(n, 2, -1000, 1000, arena);
        check_scans<std::uint64_t>(n, 3, 0, 1LL << 40, arena);
        check_scans<std::int64_t>(n, 4, -(1LL << 40), 1LL << 40, arena);
    }
}

TEST_CASE("ext: float scan")
{
    Arena arena;
    for(std::size_t n : kSizes)
    {
        CAPTURE(n);
        std::mt19937 rng(static_cast<std::uint32_t>(n));
        std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
        std::vector<float> host(n);
        for(auto &v : host)
        {
            v = dist(rng);
        }
        DeviceBuffer<float> in, out(n);
        in.upload(host);
        arena.reset();
        const float total = prims::exclusive_scan_total(in.data(), out.data(), 
n, arena, nullptr);
        auto got          = out.to_host();
        double acc        = 0;
        bool ok           = true;
        for(std::size_t i = 0; i < n; ++i)
        {
            ok  = ok && std::fabs(got[i] - acc) <= 1e-3 * (1.0 + std::fabs(acc))
+ 1e-4 * std::sqrt(static_cast<double>(i + 1));
            acc += host[i];
        }
        CHECK(ok);
        CHECK(std::fabs(total - acc) <= 1e-3 * (1.0 + std::fabs(acc)) + 1e-4 * 
std::sqrt(static_cast<double>(n)));
        arena.reset();
        prims::inclusive_scan(in.data(), out.data(), n, arena, nullptr);
        got = out.to_host();
        CHECK(std::fabs(got.back() - acc) <= 1e-3 * (1.0 + std::fabs(acc)) + 
1e-4 * std::sqrt(static_cast<double>(n)));
    }
}

