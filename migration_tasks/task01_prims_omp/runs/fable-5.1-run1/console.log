#include <thread>
#include <omp.h>
#include <cstdint>
using clk = std::chrono::steady_clock;
void kern_sync(const float* in, float* part, size_t n, unsigned P) {
#pragma omp target teams num_teams(P) thread_limit(256) is_device_ptr(in, part)
#pragma omp parallel
    { unsigned team = omp_get_team_num(), nth = omp_get_num_threads(), tid = 
omp_get_thread_num(); size_t per = n / P; float acc = 0; for (size_t i = team * 
per + tid; i < (team + 1) * per; i += nth) acc += in[i]; if (tid == 0) 
part[team] = acc; }
}
void kern_nowait(const float* in, float* part, size_t n, unsigned P) {
#pragma omp target teams num_teams(P) thread_limit(256) is_device_ptr(in, part) 
nowait
#pragma omp parallel
    { unsigned team = omp_get_team_num(), nth = omp_get_num_threads(), tid = 
omp_get_thread_num(); size_t per = n / P; float acc = 0; for (size_t i = team * 
per + tid; i < (team + 1) * per; i += nth) acc += in[i]; if (tid == 0) 
part[team] = acc; }
#pragma omp taskwait
}
int main(int argc, char** argv) {
    int mode = argc > 1 ? atoi(argv[1]) : 0;
    const size_t n = 1ull << 26; int dev = omp_get_default_device(), host = 
omp_get_initial_device();
    float* in = (float*)omp_target_alloc(n * 4, dev); float* part = 
(float*)omp_target_alloc(1 << 16, dev);
    std::vector<float> h(n, 1.0f); omp_target_memcpy(in, h.data(), n * 4, 0, 0, 
dev, host);
    float v;
    for (int round = 0; round < 6; ++round) {
        std::vector<double> t;
        for (int r = 0; r < 16; ++r) {
            auto a = clk::now();
            if (mode == 0) { kern_sync(in, part, n, 4096); omp_target_memcpy(&v,
part, 4, 0, 0, host, dev); }
            else if (mode == 1) { kern_nowait(in, part, n, 4096); 
omp_target_memcpy(&v, part, 4, 0, 0, host, dev); }
            else { kern_nowait(in, part, n, 4096); omp_target_memcpy_async(&v, 
part, 4, 0, 0, host, dev, 0, nullptr);
#pragma omp taskwait
            }
            auto b = clk::now();
            if (r) t.push_back(std::chrono::duration<double, std::micro>(b - 
a).count());
        }
        std::sort(t.begin(), t.end());
        printf("mode %d round %d: min %.0f med %.0f max %.0f\n", mode, round, 
t.front(), t[t.size()/2], t.back());
        std::this_thread::sleep_for(std::chrono::milliseconds(400 * round));
    }
}
