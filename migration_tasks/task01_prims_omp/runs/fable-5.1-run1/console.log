TEST_CASE("ext: histogram overwrites and ignores values >= 256")
{
    Arena arena;
    for(std::size_t n : kSizes)
    {
        CAPTURE(n);
        const auto host = random_ints<std::uint32_t>(n, 11, 0, n % 2 ? 1000 : 
255);
        DeviceBuffer<std::uint32_t> in, hist(prims::kHistogramBins);
        in.upload(host);
        std::vector<std::uint32_t> garbage(prims::kHistogramBins, 0xdeadbeefu);
        hist.upload(garbage);
        arena.reset();
        prims::histogram256(in.data(), n, hist.data(), arena, nullptr);
        std::vector<std::uint32_t> ref(prims::kHistogramBins, 0);
        for(auto v : host)
        {
            if(v < prims::kHistogramBins)
            {
                ++ref[v];
            }
        }
        CHECK(hist.to_host() == ref);
    }
    // all-equal values: heavy contention
    std::vector<std::uint32_t> same(300000, 7u);
    DeviceBuffer<std::uint32_t> in, hist(prims::kHistogramBins);
    in.upload(same);
    prims::histogram256(in.data(), same.size(), hist.data(), arena, nullptr);
    auto h = hist.to_host();
    CHECK(h[7] == 300000u);
    CHECK(std::accumulate(h.begin(), h.end(), 0u) == 300000u);
}

namespace
{
template<typename K, typename V>
void check_radix(std::size_t n, int begin_bit, int end_bit, std::uint64_t 
key_mask, std::uint32_t seed, Arena &arena)
{
    std::mt19937_64 rng(seed);
    std::vector<K> keys(n);
    std::vector<V> vals(n);
    for(std::size_t i = 0; i < n; ++i)
    {
        keys[i] = static_cast<K>(rng() & key_mask);
        vals[i] = static_cast<V>(i * 7 + 3);
    }
    DeviceBuffer<K> kin, kout(n);
    DeviceBuffer<V> vin, vout(n);
    kin.upload(keys);
    vin.upload(vals);
    arena.reset();
    prims::radix_sort_pairs(kin.data(), kout.data(), vin.data(), vout.data(), n,
begin_bit, end_bit, arena, nullptr);
    std::vector<std::size_t> order(n);
    std::iota(order.begin(), order.end(), 0);
    const auto digit = [&](std::size_t i)
    {
        const std::uint64_t k = static_cast<std::uint64_t>(keys[i]) >> 
begin_bit;
        const int bits        = end_bit - begin_bit;
        return bits >= 64 ? k : (k & ((std::uint64_t{1} << bits) - 1));
    };
    std::stable_sort(order.begin(), order.end(), [&](std::size_t a, std::size_t 
b) { return digit(a) < digit(b); });
    const auto gk = kout.to_host();
    const auto gv = vout.to_host();
    bool ok       = true;
    for(std::size_t i = 0; i < n; ++i)
    {
        ok = ok && gk[i] == keys[order[i]] && gv[i] == vals[order[i]];
    }
    CHECK(ok);
    // inputs untouched
    CHECK(kin.to_host() == keys);
    CHECK(vin.to_host() == vals);
}
} // namespace

TEST_CASE("ext: radix sort instantiations, bit ranges and stability")
{
    Arena arena;
    for(std::size_t n : kSizes)
    {
        CAPTURE(n);
        check_radix<std::uint64_t, std::int32_t>(n, 0, 64, ~std::uint64_t{0}, 
21, arena);
        check_radix<std::uint64_t, std::int32_t>(n, 0, 44, (std::uint64_t{1} << 
44) - 1, 22, arena);
        check_radix<std::uint64_t, std::int32_t>(n, 3, 17, 0xffffffffu, 23, 
arena);
        check_radix<std::uint64_t, std::int32_t>(n, 10, 10, 0xffffu, 24, arena);
// zero passes: copy
        check_radix<std::uint32_t, std::uint32_t>(n, 0, 32, 0xffffffffu, 25, 
arena);
        check_radix<std::uint32_t, std::uint32_t>(n, 0, 32, 0xfu, 26, arena); //
few distinct keys
        check_radix<std::uint32_t, std::uint32_t>(n, 5, 6, 0xffffffffu, 27, 
arena); // single partial digit
        check_radix<std::uint32_t, std::int32_t>(n, 0, 32, 0xffffffffu, 28, 
arena);
        check_radix<std::uint32_t, std::int32_t>(n, 0, 32, 0u, 29, arena); // 
all equal
    }
}

