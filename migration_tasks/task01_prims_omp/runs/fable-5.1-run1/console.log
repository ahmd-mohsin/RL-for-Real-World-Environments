All kernels are SPMD. Let me isolate what makes the reduce kernel slower than my
micro-benchmark by testing variants in a scratch harness.

```
cd /tmp/probe && cat <<'EOF' > var_red.cpp
#include <chrono>
#include <cstdio>
#include <vector>
#include <algorithm>
#include "tsr/prims/team.h"
using namespace tsr::prims;
using clk = std::chrono::steady_clock;

template<int VARIANT>
void reduce_kernel(const float *in, float *partials, float *out, std::uint64_t 
n, unsigned P)
{
#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) 
is_device_ptr(in, partials, out)
    {
        float s_vals[kMaxThreads];
        unsigned s_flag;
#pragma omp parallel
        {
            const TeamInfo ti = this_team();
            const SumOp<float> op{};
            for(unsigned p = ti.team; p < P; p += ti.nteams)
            {
                std::uint64_t begin, end;
                partition_range(n, p, P, begin, end);
                float acc = 0;
                if constexpr (VARIANT == 0) {
                    std::uint64_t i = begin + ti.tid;
                    const std::uint64_t stride = 
static_cast<std::uint64_t>(ti.nth) * 4;
                    for(; i + 3 * ti.nth < end; i += stride) {
                        const float v0 = in[i]; const float v1 = in[i + ti.nth];
const float v2 = in[i + 2 * ti.nth]; const float v3 = in[i + 3 * ti.nth];
                        acc = op(acc, v0); acc = op(acc, v1); acc = op(acc, v2);
acc = op(acc, v3);
                    }
                    for(; i < end; i += ti.nth) acc = op(acc, in[i]);
                } else if constexpr (VARIANT == 1) {
                    for (std::uint64_t i = begin + ti.tid; i < end; i += ti.nth)
acc += in[i];
                } else if constexpr (VARIANT == 2) {
                    // blocked by 4 with uniform chunking
                    const std::uint64_t chunk = (std::uint64_t)ti.nth * 4;
                    for (std::uint64_t cb = begin; cb < end; cb += chunk) {
                        const std::uint64_t i0 = cb + ti.tid * 4;
                        #pragma unroll
                        for (int k = 0; k < 4; ++k) if (i0 + k < end) acc += 
in[i0 + k];
                    }
                } else if constexpr (VARIANT == 3) {
                    // striped, 8 independent loads per iteration (uniform trip 
count)
                    const std::uint64_t chunk = (std::uint64_t)ti.nth * 8;
                    for (std::uint64_t cb = begin; cb < end; cb += chunk) {
                        float v[8];
                        #pragma unroll
                        for (int k = 0; k < 8; ++k) { const std::uint64_t i = cb
+ k * ti.nth + ti.tid; v[k] = i < end ? in[i] : 0.0f; }
                        #pragma unroll
                        for (int k = 0; k < 8; ++k) acc += v[k];
                    }
                }
                float r;
                if constexpr (VARIANT == 9) { r = acc; }
                else r = team_reduce(acc, op, s_vals, ti.tid, ti.nth);
                if(ti.tid == 0) { partials[p] = r; publish_writes(); }
            }
            if(team_is_last(0, ti.nteams, ti.tid, &s_flag))
            {
                float acc = 0;
                for(unsigned i = ti.tid; i < P; i += ti.nth) acc = op(acc, 
team_load(&partials[i]));
                const float r = team_reduce(acc, op, s_vals, ti.tid, ti.nth);
                if(ti.tid == 0) *out = r;
            }
        }
    }
}

template<int V> void bench(const float* in, float* part, float* out, size_t n, 
unsigned P) {
    reduce_kernel<V>(in, part, out, n, P);
    std::vector<double> t;
    for (int r = 0; r < 9; ++r) { auto a = clk::now(); reduce_kernel<V>(in, 
part, out, n, P); auto b = clk::now(); t.push_back(std::chrono::duration<double,
std::micro>(b-a).count()); }
    std::sort(t.begin(), t.end());
    float h; omp_target_memcpy(&h, out, 4, 0, 0, omp_get_initial_device(), 
omp_get_default_device());
    printf("variant %d P=%u: %.0f us (sum=%g)\n", V, P, t[4], h);
}

int main() {
    const size_t n = 1ull << 26;
    int dev = omp_get_default_device();
    float* in = (float*)omp_target_alloc(n * 4, dev);
    float* part = (float*)omp_target_alloc(1 << 16, dev);
    float* out = (float*)omp_target_alloc(256, dev);
    std::vector<float> h(n, 1.0f); omp_target_memcpy(in, h.data(), n * 4, 0, 0, 
dev, omp_get_initial_device());
    for (unsigned P : {1024u, 2048u, 4096u, 8192u}) {
        bench<0>(in, part, out, n, P); bench<1>(in, part, out, n, P); 
bench<2>(in, part, out, n, P); bench<3>(in, part, out, n, P);
    }
}
EOF
