new file mode 100644
index 0000000..ebdc1b5
--- /dev/null
+++ b/src/device/memory.cpp
@@ -0,0 +1,115 @@
+// Tessera - device memory ownership.
+#include "tsr/device/memory.h"
+
+#include <cstdint>
+
+namespace tsr
+{
+int device_id() noexcept
+{
+    return omp_get_default_device();
+}
+
+int host_id() noexcept
+{
+    return omp_get_initial_device();
+}
+
+void copy_to_host(void *host, const void *device, std::size_t bytes)
+{
+    if(bytes > 0)
+    {
+        TSR_OMP_CHECK(omp_target_memcpy(host, device, bytes, 0, 0, host_id(), device_id()));
+    }
+}
+
+void copy_to_device(void *device, const void *host, std::size_t bytes)
+{
+    if(bytes > 0)
+    {
+        TSR_OMP_CHECK(omp_target_memcpy(device, host, bytes, 0, 0, device_id(), host_id()));
+    }
+}
+
+namespace detail
+{
+void *alloc_device(std::size_t bytes, void *&raw)
+{
+    raw = omp_target_alloc(bytes + kDeviceAlignment, device_id());
+    if(raw == nullptr)
+    {
+        std::ostringstream os;
+        os << "omp_target_alloc of " << bytes << " bytes on device " << device_id() << " failed";
+        throw DeviceError(-1, os.str());
+    }
+    const auto addr    = reinterpret_cast<std::uintptr_t>(raw);
+    const auto aligned = (addr + kDeviceAlignment - 1) / kDeviceAlignment * kDeviceAlignment;
+    return reinterpret_cast<void *>(aligned);
+}
+
+void free_device(void *raw) noexcept
+{
+    omp_target_free(raw, device_id());
+}
+
+void memset_device(void *ptr, int value, std::size_t bytes)
+{
+    if(omp_target_memset(ptr, value, bytes, device_id()) == nullptr)
+    {
+        throw DeviceError(-1, "omp_target_memset failed");
+    }
+}
+} // namespace detail
+
+void Arena::reserve(std::size_t bytes)
+{
+    bytes = align_up(bytes);
+    if(bytes > main_.size())
+    {
+        TSR_CHECK(offset_ == 0 && overflow_.empty(), "Arena::reserve called while allocations are live");
+        main_.resize(bytes);
+    }
+}
+
+void Arena::reset()
+{
+    if(!overflow_.empty())
+    {
+        // Grow the main block so the next frame fits without overflowing.
+        const std::size_t want = align_up(high_water_);
+        overflow_.clear();
+        main_.release();
+        main_.resize(want);
+    }
+    offset_ = 0;
+    used_   = 0;
+}
+
+void *Arena::allocate_bytes(std::size_t bytes)
+{
+    const std::size_t aligned = align_up(bytes == 0 ? 1 : bytes);
+    used_                    += aligned;
+    if(used_ > high_water_)
+    {
+        high_water_ = used_;
+    }
+    if(offset_ + aligned <= main_.size())
+    {
+        void *p  = main_.data() + offset_;
+        offset_ += aligned;
+        return p;
+    }
+    overflow_.emplace_back(aligned);
+    return overflow_.back().data();
+}
+
+std::size_t Arena::capacity() const noexcept
+{
+    std::size_t total = main_.size();
+    for(const auto &b : overflow_)
+    {
+        total += b.size();
+    }
+    return total;
+}
+} // namespace tsr
