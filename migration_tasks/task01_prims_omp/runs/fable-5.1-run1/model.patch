+// Randomized comparisons of every instantiation against host references.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <numeric>
+#include <random>
+#include <vector>
+
+#include "doctest.h"
+#include "tsr/prims/prims.h"
+
+using namespace tsr;
+
+namespace
+{
+const std::vector<std::size_t> kSizes = {1, 2, 3, 31, 32, 33, 255, 256, 257, 1023, 1024, 1025, 2047, 4096, 4097, 8191, 8193, 16384, 70001, 262145, 1000003};
+
+template<typename T>
+std::vector<T> random_ints(std::size_t n, std::uint32_t seed, long long lo, long long hi)
+{
+    std::mt19937_64 rng(seed);
+    std::uniform_int_distribution<long long> dist(lo, hi);
+    std::vector<T> out(n);
+    for(auto &v : out)
+    {
+        v = static_cast<T>(dist(rng));
+    }
+    return out;
+}
+
+template<typename T>
+void check_scans(std::size_t n, std::uint32_t seed, long long lo, long long hi, Arena &arena)
+{
+    const auto host = random_ints<T>(n, seed, lo, hi);
+    DeviceBuffer<T> in, out(n);
+    in.upload(host);
+    std::vector<T> excl(n), incl(n);
+    T acc = T(0);
+    for(std::size_t i = 0; i < n; ++i)
+    {
+        excl[i] = acc;
+        acc     = static_cast<T>(acc + host[i]);
+        incl[i] = acc;
+    }
+    arena.reset();
+    prims::exclusive_scan(in.data(), out.data(), n, arena, nullptr);
+    CHECK(out.to_host() == excl);
+    arena.reset();
+    prims::inclusive_scan(in.data(), out.data(), n, arena, nullptr);
+    CHECK(out.to_host() == incl);
+    // in place with total
+    DeviceBuffer<T> buf;
+    buf.upload(host);
+    arena.reset();
+    const T total = prims::exclusive_scan_total(buf.data(), buf.data(), n, arena, nullptr);
+    CHECK(total == acc);
+    CHECK(buf.to_host() == excl);
+    arena.reset();
+    prims::inclusive_scan(in.data(), in.data(), n, arena, nullptr);
+    CHECK(in.to_host() == incl);
+}
+} // namespace
+
+TEST_CASE("ext: integer scans of every type")
+{
+    Arena arena;
+    for(std::size_t n : kSizes)
+    {
+        CAPTURE(n);
+        check_scans<std::uint32_t>(n, 1, 0, 1000, arena);
+        check_scans<std::int32_t>(n, 2, -1000, 1000, arena);
+        check_scans<std::uint64_t>(n, 3, 0, 1LL << 40, arena);
+        check_scans<std::int64_t>(n, 4, -(1LL << 40), 1LL << 40, arena);
+    }
+}
+
+TEST_CASE("ext: float scan")
+{
+    Arena arena;
+    for(std::size_t n : kSizes)
+    {
+        CAPTURE(n);
+        std::mt19937 rng(static_cast<std::uint32_t>(n));
+        std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+        std::vector<float> host(n);
+        for(auto &v : host)
+        {
+            v = dist(rng);
+        }
+        DeviceBuffer<float> in, out(n);
+        in.upload(host);
+        arena.reset();
+        const float total = prims::exclusive_scan_total(in.data(), out.data(), n, arena, nullptr);
+        auto got          = out.to_host();
+        double acc        = 0;
+        bool ok           = true;
+        for(std::size_t i = 0; i < n; ++i)
+        {
+            ok  = ok && std::fabs(got[i] - acc) <= 1e-3 * (1.0 + std::fabs(acc)) + 1e-4 * std::sqrt(static_cast<double>(i + 1));
+            acc += host[i];
+        }
+        CHECK(ok);
+        CHECK(std::fabs(total - acc) <= 1e-3 * (1.0 + std::fabs(acc)) + 1e-4 * std::sqrt(static_cast<double>(n)));
+        arena.reset();
+        prims::inclusive_scan(in.data(), out.data(), n, arena, nullptr);
+        got = out.to_host();
+        CHECK(std::fabs(got.back() - acc) <= 1e-3 * (1.0 + std::fabs(acc)) + 1e-4 * std::sqrt(static_cast<double>(n)));
+    }
+}
+
+TEST_CASE("ext: reductions of every type and op")
+{
+    Arena arena;
+    for(std::size_t n : kSizes)
+    {
+        CAPTURE(n);
+        {
+            const auto host = random_ints<std::uint32_t>(n, 5, 0, 0xffffffffu);
+            DeviceBuffer<std::uint32_t> in, out(1);
+            in.upload(host);
+            arena.reset();
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Sum, arena, nullptr);
+            CHECK(out.to_host()[0] == std::accumulate(host.begin(), host.end(), 0u));
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Max, arena, nullptr);
+            CHECK(out.to_host()[0] == *std::max_element(host.begin(), host.end()));
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Min, arena, nullptr);
+            CHECK(out.to_host()[0] == *std::min_element(host.begin(), host.end()));
+        }
+        {
+            const auto host = random_ints<std::int32_t>(n, 6, -2000000000, 2000000000);
+            DeviceBuffer<std::int32_t> in, out(1);
+            in.upload(host);
+            arena.reset();
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Sum, arena, nullptr);
+            std::int32_t ref = 0;
+            for(auto v : host)
+            {
+                ref = static_cast<std::int32_t>(static_cast<std::uint32_t>(ref) + static_cast<std::uint32_t>(v));
+            }
+            CHECK(out.to_host()[0] == ref);
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Max, arena, nullptr);
+            CHECK(out.to_host()[0] == *std::max_element(host.begin(), host.end()));
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Min, arena, nullptr);
+            CHECK(out.to_host()[0] == *std::min_element(host.begin(), host.end()));
+        }
+        {
+            std::mt19937 rng(static_cast<std::uint32_t>(n) + 9);
+            std::uniform_real_distribution<float> dist(-100.0f, 100.0f);
+            std::vector<float> host(n);
+            for(auto &v : host)
+            {
+                v = dist(rng);
+            }
+            DeviceBuffer<float> in, out(1);
+            in.upload(host);
+            arena.reset();
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Max, arena, nullptr);
+            CHECK(out.to_host()[0] == *std::max_element(host.begin(), host.end()));
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Min, arena, nullptr);
+            CHECK(out.to_host()[0] == *std::min_element(host.begin(), host.end()));
+            prims::reduce(in.data(), n, out.data(), prims::ReduceOp::Sum, arena, nullptr);
+            const double ref = std::accumulate(host.begin(), host.end(), 0.0);
+            CHECK(std::fabs(out.to_host()[0] - ref) <= 1e-3 * std::sqrt(static_cast<double>(n)) * 100.0 + 1e-3);
+        }
+    }
+}
+
+TEST_CASE("ext: histogram overwrites and ignores values >= 256")
+{
+    Arena arena;
+    for(std::size_t n : kSizes)
+    {
+        CAPTURE(n);
+        const auto host = random_ints<std::uint32_t>(n, 11, 0, n % 2 ? 1000 : 255);
+        DeviceBuffer<std::uint32_t> in, hist(prims::kHistogramBins);
+        in.upload(host);
+        std::vector<std::uint32_t> garbage(prims::kHistogramBins, 0xdeadbeefu);
+        hist.upload(garbage);
+        arena.reset();
+        prims::histogram256(in.data(), n, hist.data(), arena, nullptr);
+        std::vector<std::uint32_t> ref(prims::kHistogramBins, 0);
+        for(auto v : host)
+        {
+            if(v < prims::kHistogramBins)
+            {
+                ++ref[v];
+            }
+        }
+        CHECK(hist.to_host() == ref);
+    }
+    // all-equal values: heavy contention
+    std::vector<std::uint32_t> same(300000, 7u);
+    DeviceBuffer<std::uint32_t> in, hist(prims::kHistogramBins);
+    in.upload(same);
+    prims::histogram256(in.data(), same.size(), hist.data(), arena, nullptr);
+    auto h = hist.to_host();
+    CHECK(h[7] == 300000u);
+    CHECK(std::accumulate(h.begin(), h.end(), 0u) == 300000u);
+}
+
+namespace
+{
+template<typename K, typename V>
+void check_radix(std::size_t n, int begin_bit, int end_bit, std::uint64_t key_mask, std::uint32_t seed, Arena &arena)
+{
+    std::mt19937_64 rng(seed);
+    std::vector<K> keys(n);
+    std::vector<V> vals(n);
+    for(std::size_t i = 0; i < n; ++i)
+    {
+        keys[i] = static_cast<K>(rng() & key_mask);
+        vals[i] = static_cast<V>(i * 7 + 3);
+    }
+    DeviceBuffer<K> kin, kout(n);
+    DeviceBuffer<V> vin, vout(n);
+    kin.upload(keys);
+    vin.upload(vals);
+    arena.reset();
+    prims::radix_sort_pairs(kin.data(), kout.data(), vin.data(), vout.data(), n, begin_bit, end_bit, arena, nullptr);
+    std::vector<std::size_t> order(n);
+    std::iota(order.begin(), order.end(), 0);
+    const auto digit = [&](std::size_t i)
+    {
+        const std::uint64_t k = static_cast<std::uint64_t>(keys[i]) >> begin_bit;
+        const int bits        = end_bit - begin_bit;
+        return bits >= 64 ? k : (k & ((std::uint64_t{1} << bits) - 1));
+    };
+    std::stable_sort(order.begin(), order.end(), [&](std::size_t a, std::size_t b) { return digit(a) < digit(b); });
+    const auto gk = kout.to_host();
+    const auto gv = vout.to_host();
+    bool ok       = true;
+    for(std::size_t i = 0; i < n; ++i)
+    {
+        ok = ok && gk[i] == keys[order[i]] && gv[i] == vals[order[i]];
+    }
+    CHECK(ok);
+    // inputs untouched
+    CHECK(kin.to_host() == keys);
+    CHECK(vin.to_host() == vals);
+}
+} // namespace
+
+TEST_CASE("ext: radix sort instantiations, bit ranges and stability")
+{
+    Arena arena;
+    for(std::size_t n : kSizes)
+    {
+        CAPTURE(n);
+        check_radix<std::uint64_t, std::int32_t>(n, 0, 64, ~std::uint64_t{0}, 21, arena);
+        check_radix<std::uint64_t, std::int32_t>(n, 0, 44, (std::uint64_t{1} << 44) - 1, 22, arena);
+        check_radix<std::uint64_t, std::int32_t>(n, 3, 17, 0xffffffffu, 23, arena);
+        check_radix<std::uint64_t, std::int32_t>(n, 10, 10, 0xffffu, 24, arena); // zero passes: copy
+        check_radix<std::uint32_t, std::uint32_t>(n, 0, 32, 0xffffffffu, 25, arena);
+        check_radix<std::uint32_t, std::uint32_t>(n, 0, 32, 0xfu, 26, arena); // few distinct keys
+        check_radix<std::uint32_t, std::uint32_t>(n, 5, 6, 0xffffffffu, 27, arena); // single partial digit
+        check_radix<std::uint32_t, std::int32_t>(n, 0, 32, 0xffffffffu, 28, arena);
+        check_radix<std::uint32_t, std::int32_t>(n, 0, 32, 0u, 29, arena); // all equal
+    }
+}
+
+TEST_CASE("ext: sort_pairs picks a correct algorithm")
+{
+    Arena arena;
+    for(std::size_t n : {std::size_t{1}, std::size_t{1000}, std::size_t{1024}, std::size_t{1025}, std::size_t{50000}})
+    {
+        CAPTURE(n);
+        std::mt19937 rng(static_cast<std::uint32_t>(n));
+        std::vector<std::uint32_t> keys(n), vals(n);
+        for(std::size_t i = 0; i < n; ++i)
+        {
+            keys[i] = rng() % 1000;
+            vals[i] = static_cast<std::uint32_t>(i);
+        }
+        DeviceBuffer<std::uint32_t> kin, kout(n), vin, vout(n);
+        kin.upload(keys);
+        vin.upload(vals);
+        arena.reset();
+        prims::sort_pairs(kin.data(), kout.data(), vin.data(), vout.data(), n, 0, 10, arena, nullptr);
+        std::vector<std::size_t> order(n);
+        std::iota(order.begin(), order.end(), 0);
+        std::stable_sort(order.begin(), order.end(), [&](std::size_t a, std::size_t b) { return keys[a] < keys[b]; });
+        const auto gk = kout.to_host();
+        const auto gv = vout.to_host();
+        bool ok       = true;
+        for(std::size_t i = 0; i < n; ++i)
+        {
+            ok = ok && gk[i] == keys[order[i]] && gv[i] == vals[order[i]];
+        }
+        CHECK(ok);
+    }
+}
+
+TEST_CASE("ext: bitonic sort instantiations")
+{
+    for(std::size_t n : {std::size_t{1}, std::size_t{2}, std::size_t{7}, std::size_t{64}, std::size_t{65}, std::size_t{513}, std::size_t{1000}, std::size_t{1024}})
+    {
+        CAPTURE(n);
+        std::mt19937_64 rng(n);
+        std::vector<std::uint64_t> keys(n);
+        std::vector<std::int32_t> vals(n);
+        for(std::size_t i = 0; i < n; ++i)
+        {
+            keys[i] = rng() % 50;
+            vals[i] = static_cast<std::int32_t>(rng() % 20) - 10;
+        }
+        DeviceBuffer<std::uint64_t> kin, kout(n);
+        DeviceBuffer<std::int32_t> vin, vout(n);
+        kin.upload(keys);
+        vin.upload(vals);
+        prims::bitonic_sort_pairs(kin.data(), kout.data(), vin.data(), vout.data(), n, nullptr);
+        std::vector<std::pair<std::uint64_t, std::int32_t>> ref(n);
+        for(std::size_t i = 0; i < n; ++i)
+        {
+            ref[i] = {keys[i], vals[i]};
+        }
+        std::sort(ref.begin(), ref.end());
+        const auto gk = kout.to_host();
+        const auto gv = vout.to_host();
+        bool ok       = true;
+        for(std::size_t i = 0; i < n; ++i)
+        {
+            ok = ok && gk[i] == ref[i].first && gv[i] == ref[i].second;
+        }
+        CHECK(ok);
+    }
+}
+
+TEST_CASE("ext: compact_indices over sizes and densities")
+{
+    Arena arena;
+    for(std::size_t n : kSizes)
+    {
+        CAPTURE(n);
+        for(int density : {0, 1, 50, 100})
+        {
+            std::mt19937 rng(static_cast<std::uint32_t>(n) + density);
+            std::vector<std::uint8_t> flags(n);
+            std::vector<std::uint32_t> ref;
+            for(std::size_t i = 0; i < n; ++i)
+            {
+                flags[i] = static_cast<int>(rng() % 100) < density ? static_cast<std::uint8_t>(1 + rng() % 255) : 0;
+                if(flags[i])
+                {
+                    ref.push_back(static_cast<std::uint32_t>(i));
+                }
+            }
+            DeviceBuffer<std::uint8_t> f;
+            DeviceBuffer<std::uint32_t> out(n);
+            f.upload(flags);
+            arena.reset();
+            const auto count = prims::compact_indices(f.data(), n, out.data(), arena, nullptr);
+            REQUIRE(count == ref.size());
+            auto got = out.to_host();
+            got.resize(count);
+            CHECK(got == ref);
+        }
+    }
+}
+
+TEST_CASE("ext: unaligned sub-buffers")
+{
+    Arena arena;
+    const std::size_t n = 100003;
+    const auto host     = random_ints<std::uint32_t>(n + 3, 77, 0, 100);
+    DeviceBuffer<std::uint32_t> in, out(n + 3);
+    in.upload(host);
+    arena.reset();
+    prims::exclusive_scan(in.data() + 3, out.data() + 1, n, arena, nullptr);
+    auto got = out.to_host();
+    std::uint32_t acc = 0;
+    bool ok           = true;
+    for(std::size_t i = 0; i < n; ++i)
+    {
+        ok  = ok && got[i + 1] == acc;
+        acc += host[i + 3];
+    }
+    CHECK(ok);
+}
