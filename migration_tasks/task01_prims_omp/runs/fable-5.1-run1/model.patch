new file mode 100644
index 0000000..d5d8c36
--- /dev/null
+++ b/include/tsr/prims/team.h
@@ -0,0 +1,252 @@
+// Tessera - team-level building blocks for OpenMP target kernels.
+//
+// Every kernel is a `target teams` region whose body is one `parallel`
+// region. The host picks a number of partitions of the input; teams
+// grid-stride over partitions and, inside a team, the code adapts to the
+// number of threads the runtime actually granted (omp_get_num_threads()), so
+// the same source is correct on a GPU with 256-thread teams and on the host
+// device where a team may have a single thread.
+//
+// Arrays declared at team scope (between `target teams` and `parallel`) are
+// shared by the team's threads; sizes are bounded by kMaxThreads, the
+// thread_limit of every launch.
+//
+// The helpers are internal to each translation unit (static): device
+// functions that contain OpenMP constructs must not be merged across
+// translation units by the device linker.
+#pragma once
+
+#include <omp.h>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace tsr::prims
+{
+#pragma omp begin declare target
+// Upper bound for the threads of a team; every launch uses this thread_limit.
+// TSR_TEAM_THREADS may be overridden at build time to exercise other sizes.
+#ifndef TSR_TEAM_THREADS
+#    define TSR_TEAM_THREADS 256
+#endif
+constexpr unsigned kMaxThreads = TSR_TEAM_THREADS;
+static_assert(kMaxThreads >= 1 && kMaxThreads <= 1024, "team size out of range");
+// Shared scratch items needed by team_exclusive_scan().
+constexpr unsigned kScanScratch = 2 * kMaxThreads;
+// Completion tickets for the "last team finishes the job" pattern, see
+// team_is_last(). Every kernel uses its own slot (TicketSlot) and the last
+// team resets the slot for the next launch. The array is defined once, in
+// team.cpp, so that each device holds a single copy.
+enum TicketSlot : unsigned
+{
+    kTicketScan = 0,
+    kTicketReduce,
+    kTicketHistogram,
+    kTicketRadixUpsweep,
+    kTicketCompact,
+    kTicketSlots
+};
+extern unsigned g_tickets[kTicketSlots];
+#pragma omp end declare target
+
+struct TeamInfo
+{
+    unsigned nteams;
+    unsigned team;
+    unsigned nth;
+    unsigned tid;
+};
+
+// Must be called inside the parallel region.
+static inline TeamInfo this_team()
+{
+    return TeamInfo{
+        static_cast<unsigned>(omp_get_num_teams()),
+        static_cast<unsigned>(omp_get_team_num()),
+        static_cast<unsigned>(omp_get_num_threads()),
+        static_cast<unsigned>(omp_get_thread_num())};
+}
+
+// Number of partitions for a streaming kernel over n elements: at least
+// min_elements per partition, at most max_partitions (and at least one).
+static inline unsigned partition_count(std::uint64_t n, std::uint64_t min_elements, unsigned max_partitions)
+{
+    const std::uint64_t parts = (n + min_elements - 1) / min_elements;
+    if(parts <= 1)
+    {
+        return 1;
+    }
+    return parts < max_partitions ? static_cast<unsigned>(parts) : max_partitions;
+}
+
+// Element range [begin, end) of partition p out of P over n elements.
+static inline void partition_range(std::uint64_t n, unsigned p, unsigned P, std::uint64_t &begin, std::uint64_t &end)
+{
+    const std::uint64_t per = (n + P - 1) / P;
+    begin                   = static_cast<std::uint64_t>(p) * per;
+    end                     = begin + per < n ? begin + per : n;
+    if(begin > end)
+    {
+        begin = end;
+    }
+}
+
+template<typename T>
+struct SumOp
+{
+    T operator()(const T &a, const T &b) const { return a + b; }
+    static T identity() { return T(0); }
+};
+
+template<typename T>
+struct MaxOp
+{
+    T operator()(const T &a, const T &b) const { return a < b ? b : a; }
+    static T identity();
+};
+
+template<typename T>
+struct MinOp
+{
+    T operator()(const T &a, const T &b) const { return b < a ? b : a; }
+    static T identity();
+};
+
+template<>
+inline float MaxOp<float>::identity()
+{
+    return -3.402823466e+38f;
+}
+template<>
+inline float MinOp<float>::identity()
+{
+    return 3.402823466e+38f;
+}
+template<>
+inline std::uint32_t MaxOp<std::uint32_t>::identity()
+{
+    return 0u;
+}
+template<>
+inline std::uint32_t MinOp<std::uint32_t>::identity()
+{
+    return 0xffffffffu;
+}
+template<>
+inline std::int32_t MaxOp<std::int32_t>::identity()
+{
+    return -2147483647 - 1;
+}
+template<>
+inline std::int32_t MinOp<std::int32_t>::identity()
+{
+    return 2147483647;
+}
+
+// Exclusive prefix sum of one value per thread, in thread order. All threads
+// of the team must call it. Returns the thread's exclusive prefix; `total`
+// receives the team total in every thread. s_vals holds 2 * kMaxThreads
+// items (double buffered Hillis-Steele) and is free for reuse on return.
+template<typename T>
+static inline T team_exclusive_scan(T value, T *s_vals, unsigned tid, unsigned nth, T &total)
+{
+    unsigned buf = 0;
+    s_vals[tid]  = value;
+#pragma omp barrier
+    for(unsigned offset = 1; offset < nth; offset <<= 1)
+    {
+        T v = s_vals[buf * kMaxThreads + tid];
+        if(tid >= offset)
+        {
+            v += s_vals[buf * kMaxThreads + tid - offset];
+        }
+        buf ^= 1u;
+        s_vals[buf * kMaxThreads + tid] = v;
+#pragma omp barrier
+    }
+    // Exclusive prefix = predecessor's inclusive prefix (no subtraction, so
+    // floating-point prefixes do not suffer from cancellation).
+    const T exclusive = tid > 0 ? s_vals[buf * kMaxThreads + tid - 1] : T(0);
+    total             = s_vals[buf * kMaxThreads + nth - 1];
+#pragma omp barrier
+    return exclusive;
+}
+
+// Reduction of one value per thread; the result is returned in every thread.
+// Deterministic for a given thread count. s_vals holds kMaxThreads items and
+// is free for reuse on return.
+template<typename T, typename Op>
+static inline T team_reduce(T value, Op op, T *s_vals, unsigned tid, unsigned nth)
+{
+    s_vals[tid] = value;
+#pragma omp barrier
+    unsigned half = 1;
+    while(half < nth)
+    {
+        half <<= 1;
+    }
+    for(half >>= 1; half > 0; half >>= 1)
+    {
+        if(tid < half && tid + half < nth)
+        {
+            s_vals[tid] = op(s_vals[tid], s_vals[tid + half]);
+        }
+#pragma omp barrier
+    }
+    const T result = s_vals[0];
+#pragma omp barrier
+    return result;
+}
+
+// Publishes this thread's global-memory writes to other teams. Call after
+// the writes and before team_is_last().
+static inline void publish_writes()
+{
+#pragma omp flush
+}
+
+// Returns true in every thread of the team that finished last. The caller
+// must have published its global writes (publish_writes() by each writing
+// thread). The last team sees all other teams' published writes after this
+// call, provided it reads them with team_load().
+static inline bool team_is_last(unsigned slot, unsigned nteams, unsigned tid, unsigned *s_flag)
+{
+#pragma omp barrier
+    if(tid == 0)
+    {
+#pragma omp flush
+        unsigned ticket;
+#pragma omp atomic capture
+        {
+            ticket = g_tickets[slot];
+            g_tickets[slot] += 1u;
+        }
+        const bool last = ticket + 1u == nteams;
+        if(last)
+        {
+            // Reset for the next launch; no other team touches the slot now.
+#pragma omp atomic write
+            g_tickets[slot] = 0u;
+#pragma omp flush
+        }
+        *s_flag = last ? 1u : 0u;
+    }
+#pragma omp barrier
+    return *s_flag != 0u;
+}
+
+// Empty target region: primitives launch it when there is no work, so that
+// every call still runs on the device. Defined in team.cpp.
+void launch_noop();
+
+// Load of a value written by another team during this launch.
+template<typename T>
+static inline T team_load(T *p)
+{
+    T v;
+#pragma omp atomic read
+    v = p[0];
+    return v;
+}
+
+} // namespace tsr::prims
