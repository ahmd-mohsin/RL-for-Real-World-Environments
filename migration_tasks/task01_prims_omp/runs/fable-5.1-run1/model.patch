@@ -0,0 +1,143 @@
+// Tessera - stream compaction of index sets.
+//
+// Two launches: compact_count sums the flags of every partition and (in the
+// last team) scans the partition counts into output offsets; compact_scatter
+// walks every partition in chunks, ranks the set flags with a team scan and
+// writes their indices. The total is returned through one scalar download.
+#include "tsr/prims/prims.h"
+#include "tsr/prims/team.h"
+
+namespace tsr::prims
+{
+namespace
+{
+constexpr unsigned kCompactItems             = 16;
+constexpr std::uint64_t kCompactMinPartition = 8192;
+constexpr unsigned kCompactMaxPartitions     = 4096;
+
+void compact_count(const std::uint8_t *flags, std::uint64_t n, std::uint32_t *partials, std::uint32_t *total_out, unsigned P)
+{
+#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) is_device_ptr(flags, partials, total_out)
+    {
+        std::uint32_t s_vals[kScanScratch];
+        unsigned s_flag;
+#pragma omp parallel
+        {
+            const TeamInfo ti = this_team();
+            for(unsigned p = ti.team; p < P; p += ti.nteams)
+            {
+                std::uint64_t begin, end;
+                partition_range(n, p, P, begin, end);
+                std::uint32_t acc          = 0;
+                std::uint64_t i            = begin + ti.tid;
+                const std::uint64_t stride = static_cast<std::uint64_t>(ti.nth) * 4;
+                for(; i + 3 * ti.nth < end; i += stride)
+                {
+                    const std::uint8_t f0 = flags[i];
+                    const std::uint8_t f1 = flags[i + ti.nth];
+                    const std::uint8_t f2 = flags[i + 2 * ti.nth];
+                    const std::uint8_t f3 = flags[i + 3 * ti.nth];
+                    acc += (f0 != 0 ? 1u : 0u) + (f1 != 0 ? 1u : 0u) + (f2 != 0 ? 1u : 0u) + (f3 != 0 ? 1u : 0u);
+                }
+                for(; i < end; i += ti.nth)
+                {
+                    acc += flags[i] != 0 ? 1u : 0u;
+                }
+                const std::uint32_t sum = team_reduce(acc, SumOp<std::uint32_t>{}, s_vals, ti.tid, ti.nth);
+                if(ti.tid == 0)
+                {
+                    partials[p] = sum;
+                    publish_writes();
+                }
+            }
+            if(team_is_last(kTicketCompact, ti.nteams, ti.tid, &s_flag))
+            {
+                const unsigned per = (P + ti.nth - 1) / ti.nth;
+                const unsigned lo  = ti.tid * per < P ? ti.tid * per : P;
+                const unsigned hi  = lo + per < P ? lo + per : P;
+                std::uint32_t sum  = 0;
+#pragma unroll 4
+                for(unsigned i = lo; i < hi; ++i)
+                {
+                    sum += team_load(&partials[i]);
+                }
+                std::uint32_t total;
+                std::uint32_t run = team_exclusive_scan(sum, s_vals, ti.tid, ti.nth, total);
+#pragma unroll 4
+                for(unsigned i = lo; i < hi; ++i)
+                {
+                    const std::uint32_t c = team_load(&partials[i]);
+                    partials[i]           = run;
+                    run                  += c;
+                }
+                if(ti.tid == 0)
+                {
+                    *total_out = total;
+                }
+            }
+        }
+    }
+}
+
+void compact_scatter(const std::uint8_t *flags, std::uint64_t n, const std::uint32_t *partials, std::uint32_t *out, unsigned P)
+{
+#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) is_device_ptr(flags, partials, out)
+    {
+        std::uint32_t s_vals[kScanScratch];
+#pragma omp parallel
+        {
+            const TeamInfo ti = this_team();
+            for(unsigned p = ti.team; p < P; p += ti.nteams)
+            {
+                std::uint64_t begin, end;
+                partition_range(n, p, P, begin, end);
+                std::uint32_t carry       = partials[p];
+                const std::uint64_t chunk = static_cast<std::uint64_t>(ti.nth) * kCompactItems;
+                for(std::uint64_t cb = begin; cb < end; cb += chunk)
+                {
+                    const std::uint64_t i0 = cb + static_cast<std::uint64_t>(ti.tid) * kCompactItems;
+                    bool set[kCompactItems];
+                    std::uint32_t count = 0;
+#pragma unroll
+                    for(unsigned k = 0; k < kCompactItems; ++k)
+                    {
+                        set[k] = i0 + k < end && flags[i0 + k] != 0;
+                        count += set[k] ? 1u : 0u;
+                    }
+                    std::uint32_t total;
+                    std::uint32_t pos = carry + team_exclusive_scan(count, s_vals, ti.tid, ti.nth, total);
+#pragma unroll
+                    for(unsigned k = 0; k < kCompactItems; ++k)
+                    {
+                        if(set[k])
+                        {
+                            out[pos++] = static_cast<std::uint32_t>(i0 + k);
+                        }
+                    }
+                    carry += total;
+                }
+            }
+        }
+    }
+}
+} // namespace
+
+std::uint32_t compact_indices(const std::uint8_t *flags, std::size_t n, std::uint32_t *out_indices, Arena &arena, Stream stream)
+{
+    (void)stream;
+    if(n == 0)
+    {
+        launch_noop();
+        return 0;
+    }
+    TSR_CHECK(n <= 0xffffffffu, "compact_indices supports at most 2^32-1 elements");
+    const unsigned P         = partition_count(n, kCompactMinPartition, kCompactMaxPartitions);
+    std::uint32_t *partials  = arena.allocate<std::uint32_t>(P);
+    std::uint32_t *total_dev = arena.allocate<std::uint32_t>(1);
+    compact_count(flags, static_cast<std::uint64_t>(n), partials, total_dev, P);
+    compact_scatter(flags, static_cast<std::uint64_t>(n), partials, out_indices, P);
+    std::uint32_t total = 0;
+    copy_to_host(&total, total_dev, sizeof(total));
+    return total;
+}
+} // namespace tsr::prims
