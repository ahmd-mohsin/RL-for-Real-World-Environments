+// Tests for the device memory utilities and the error paths of the primitives.
+#include <cstdint>
+#include <numeric>
+#include <vector>
+
+#include "doctest.h"
+#include "tsr/device/memory.h"
+#include "tsr/prims/prims.h"
+
+using namespace tsr;
+
+TEST_CASE("memory: DeviceBuffer upload, download and move")
+{
+    std::vector<std::uint32_t> host(1000);
+    std::iota(host.begin(), host.end(), 0u);
+    DeviceBuffer<std::uint32_t> a;
+    CHECK(a.empty());
+    a.upload(host);
+    CHECK(a.size() == 1000);
+    CHECK(a.bytes() == 4000);
+    CHECK(reinterpret_cast<std::uintptr_t>(a.data()) % Arena::kAlignment == 0);
+    CHECK(a.to_host() == host);
+
+    const auto *ptr = a.data();
+    DeviceBuffer<std::uint32_t> b(std::move(a));
+    CHECK(b.data() == ptr);
+    CHECK(b.size() == 1000);
+    CHECK(a.data() == nullptr);
+    CHECK(a.empty());
+
+    DeviceBuffer<std::uint32_t> c(10);
+    c = std::move(b);
+    CHECK(c.data() == ptr);
+    CHECK(c.to_host() == host);
+
+    // Shrinking keeps the allocation.
+    c.resize(10);
+    CHECK(c.data() == ptr);
+    CHECK(c.size() == 10);
+    std::vector<std::uint32_t> part(10);
+    c.download(part.data(), 10);
+    CHECK(part == std::vector<std::uint32_t>(host.begin(), host.begin() + 10));
+    CHECK_THROWS_AS(c.download(part.data(), 11), tsr::Error);
+
+    c.zero();
+    CHECK(c.to_host() == std::vector<std::uint32_t>(10, 0u));
+    c.release();
+    CHECK(c.data() == nullptr);
+}
+
+TEST_CASE("memory: Arena alignment, overflow and reset")
+{
+    Arena arena(1024);
+    CHECK(arena.capacity() == 1024);
+    void *p0 = arena.allocate_bytes(100);
+    void *p1 = arena.allocate_bytes(1);
+    CHECK(reinterpret_cast<std::uintptr_t>(p0) % Arena::kAlignment == 0);
+    CHECK(reinterpret_cast<std::uintptr_t>(p1) % Arena::kAlignment == 0);
+    CHECK(static_cast<std::uint8_t *>(p1) - static_cast<std::uint8_t *>(p0) == 256);
+    CHECK(arena.used() == 512);
+
+    // Overflow goes to an extra block and is coalesced on reset.
+    auto *p2 = arena.allocate<std::uint32_t>(1024);
+    CHECK(p2 != nullptr);
+    CHECK(reinterpret_cast<std::uintptr_t>(p2) % Arena::kAlignment == 0);
+    CHECK(arena.capacity() == 1024 + 4096);
+    CHECK(arena.high_water() == 512 + 4096);
+    CHECK_THROWS_AS(arena.reserve(1 << 20), tsr::Error);
+
+    arena.reset();
+    CHECK(arena.used() == 0);
+    CHECK(arena.capacity() == 512 + 4096);
+    void *q0 = arena.allocate_bytes(4096);
+    CHECK(reinterpret_cast<std::uintptr_t>(q0) % Arena::kAlignment == 0);
+    CHECK(arena.capacity() == 512 + 4096);
+    arena.reset();
+    arena.reserve(1 << 16);
+    CHECK(arena.capacity() == (1 << 16));
+}
+
+TEST_CASE("prims: error paths")
+{
+    Arena arena;
+    DeviceBuffer<std::uint64_t> k(16), ko(16);
+    DeviceBuffer<std::int32_t> v(16), vo(16);
+    CHECK_THROWS_AS(prims::radix_sort_pairs(k.data(), ko.data(), v.data(), vo.data(), 16, -1, 8, arena, nullptr), tsr::Error);
+    CHECK_THROWS_AS(prims::radix_sort_pairs(k.data(), ko.data(), v.data(), vo.data(), 16, 0, 65, arena, nullptr), tsr::Error);
+    CHECK_THROWS_AS(prims::radix_sort_pairs(k.data(), ko.data(), v.data(), vo.data(), 16, 8, 4, arena, nullptr), tsr::Error);
+    CHECK_THROWS_AS(prims::radix_sort_pairs(k.data(), k.data(), v.data(), vo.data(), 16, 0, 8, arena, nullptr), tsr::Error);
+    CHECK_THROWS_AS(prims::radix_sort_pairs(k.data(), ko.data(), v.data(), v.data(), 16, 0, 8, arena, nullptr), tsr::Error);
+    CHECK_NOTHROW(prims::radix_sort_pairs(k.data(), ko.data(), v.data(), vo.data(), 16, 0, 64, arena, nullptr));
+    CHECK_NOTHROW(prims::radix_sort_pairs(k.data(), ko.data(), v.data(), vo.data(), 16, 4, 4, arena, nullptr));
+    DeviceBuffer<std::uint32_t> big(2000), bigo(2000);
+    CHECK_THROWS_AS(prims::bitonic_sort_pairs(big.data(), bigo.data(), big.data(), bigo.data(), 1025, nullptr), tsr::Error);
+    CHECK_NOTHROW(prims::bitonic_sort_pairs(big.data(), bigo.data(), big.data(), bigo.data(), 1024, nullptr));
+}
+
+TEST_CASE("prims: empty inputs")
+{
+    Arena arena;
+    DeviceBuffer<std::uint32_t> a(1), b(1), hist(prims::kHistogramBins);
+    DeviceBuffer<float> f(1);
+    DeviceBuffer<std::uint8_t> flags(1);
+    CHECK_NOTHROW(prims::exclusive_scan(a.data(), b.data(), 0, arena, nullptr));
+    CHECK(prims::exclusive_scan_total(a.data(), b.data(), 0, arena, nullptr) == 0u);
+    prims::reduce(f.data(), 0, f.data(), prims::ReduceOp::Max, arena, nullptr);
+    CHECK(f.to_host()[0] == -3.402823466e+38f);
+    prims::reduce(f.data(), 0, f.data(), prims::ReduceOp::Sum, arena, nullptr);
+    CHECK(f.to_host()[0] == 0.0f);
+    prims::histogram256(a.data(), 0, hist.data(), arena, nullptr);
+    CHECK(hist.to_host() == std::vector<std::uint32_t>(prims::kHistogramBins, 0u));
+    CHECK(prims::compact_indices(flags.data(), 0, b.data(), arena, nullptr) == 0u);
+}
