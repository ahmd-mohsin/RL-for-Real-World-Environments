diff --git a/src/prims/scan.cpp b/src/prims/scan.cpp
new file mode 100644
index 0000000..5fd1a41
--- /dev/null
+++ b/src/prims/scan.cpp
@@ -0,0 +1,210 @@
+// Tessera - device-wide prefix sums.
+//
+// Reduce-then-scan in two launches:
+//   1. scan_upsweep     every team sums its partitions of the input; the last
+//                       team to finish turns the partition sums into
+//                       exclusive partition offsets (and the grand total)
+//   2. scan_downsweep   every team scans its partitions chunk by chunk, each
+//                       chunk being kScanItems items per thread, carrying the
+//                       running total from chunk to chunk
+// Partition boundaries are chosen by the host and do not depend on the team
+// size, so any thread count the runtime grants produces the same result.
+#include "tsr/prims/prims.h"
+#include "tsr/prims/team.h"
+
+namespace tsr::prims
+{
+namespace
+{
+constexpr unsigned kScanItems           = 4;
+constexpr std::uint64_t kScanMinPartition = 4096;
+constexpr unsigned kScanMaxPartitions   = 4096;
+
+// totals[p] receives the exclusive prefix of partition p's sum; *grand (if
+// non-null) the sum of everything.
+template<typename T>
+void scan_upsweep(const T *in, T *totals, T *grand, std::uint64_t n, unsigned P)
+{
+#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) is_device_ptr(in, totals, grand)
+    {
+        T s_vals[kScanScratch];
+        unsigned s_flag;
+#pragma omp parallel
+        {
+            const TeamInfo ti = this_team();
+            for(unsigned p = ti.team; p < P; p += ti.nteams)
+            {
+                std::uint64_t begin, end;
+                partition_range(n, p, P, begin, end);
+                T acc                      = T(0);
+                std::uint64_t i            = begin + ti.tid;
+                const std::uint64_t stride = static_cast<std::uint64_t>(ti.nth) * 4;
+                for(; i + 3 * ti.nth < end; i += stride)
+                {
+                    const T v0 = in[i];
+                    const T v1 = in[i + ti.nth];
+                    const T v2 = in[i + 2 * ti.nth];
+                    const T v3 = in[i + 3 * ti.nth];
+                    acc += v0;
+                    acc += v1;
+                    acc += v2;
+                    acc += v3;
+                }
+                for(; i < end; i += ti.nth)
+                {
+                    acc += in[i];
+                }
+                const T sum = team_reduce(acc, SumOp<T>{}, s_vals, ti.tid, ti.nth);
+                if(ti.tid == 0)
+                {
+                    totals[p] = sum;
+                    publish_writes();
+                }
+            }
+            if(team_is_last(kTicketScan, ti.nteams, ti.tid, &s_flag))
+            {
+                const unsigned per = (P + ti.nth - 1) / ti.nth;
+                const unsigned lo  = ti.tid * per < P ? ti.tid * per : P;
+                const unsigned hi  = lo + per < P ? lo + per : P;
+                T sum              = T(0);
+#pragma unroll 4
+                for(unsigned i = lo; i < hi; ++i)
+                {
+                    sum += team_load(&totals[i]);
+                }
+                T total;
+                T run = team_exclusive_scan(sum, s_vals, ti.tid, ti.nth, total);
+#pragma unroll 4
+                for(unsigned i = lo; i < hi; ++i)
+                {
+                    const T c = team_load(&totals[i]);
+                    totals[i] = run;
+                    run      += c;
+                }
+                if(ti.tid == 0 && grand != nullptr)
+                {
+                    *grand = total;
+                }
+            }
+        }
+    }
+}
+
+// `in` and `out` may alias: every element is read and written by the same
+// thread, so in-place scans are safe.
+template<typename T, bool kInclusive>
+void scan_downsweep(const T *in, T *out, const T *totals, std::uint64_t n, unsigned P)
+{
+#pragma omp target teams num_teams(P) thread_limit(kMaxThreads) is_device_ptr(in, out, totals)
+    {
+        T s_vals[kScanScratch];
+#pragma omp parallel
+        {
+            const TeamInfo ti = this_team();
+            for(unsigned p = ti.team; p < P; p += ti.nteams)
+            {
+                std::uint64_t begin, end;
+                partition_range(n, p, P, begin, end);
+                T carry                   = totals[p];
+                const std::uint64_t chunk = static_cast<std::uint64_t>(ti.nth) * kScanItems;
+                for(std::uint64_t cb = begin; cb < end; cb += chunk)
+                {
+                    const std::uint64_t i0 = cb + static_cast<std::uint64_t>(ti.tid) * kScanItems;
+                    T items[kScanItems];
+                    T incl[kScanItems];
+#pragma unroll
+                    for(unsigned k = 0; k < kScanItems; ++k)
+                    {
+                        items[k] = i0 + k < end ? in[i0 + k] : T(0);
+                        incl[k]  = k == 0 ? items[0] : incl[k - 1] + items[k];
+                    }
+                    T total;
+                    const T excl = team_exclusive_scan(incl[kScanItems - 1], s_vals, ti.tid, ti.nth, total);
+                    const T base = carry + excl;
+#pragma unroll
+                    for(unsigned k = 0; k < kScanItems; ++k)
+                    {
+                        if(i0 + k < end)
+                        {
+                            if constexpr(kInclusive)
+                            {
+                                out[i0 + k] = base + incl[k];
+                            }
+                            else
+                            {
+                                out[i0 + k] = k == 0 ? base : base + incl[k - 1];
+                            }
+                        }
+                    }
+                    carry += total;
+                }
+            }
+        }
+    }
+}
+
+template<typename T>
+void scan_impl(const T *in, T *out, std::size_t n, bool inclusive, T *grand, Arena &arena)
+{
+    if(n == 0)
+    {
+        launch_noop();
+        return;
+    }
+    const unsigned P = partition_count(n, kScanMinPartition, kScanMaxPartitions);
+    T *totals        = arena.allocate<T>(P);
+    scan_upsweep(in, totals, grand, static_cast<std::uint64_t>(n), P);
+    if(inclusive)
+    {
+        scan_downsweep<T, true>(in, out, totals, static_cast<std::uint64_t>(n), P);
+    }
+    else
+    {
+        scan_downsweep<T, false>(in, out, totals, static_cast<std::uint64_t>(n), P);
+    }
+}
+} // namespace
+
+template<typename T>
+void exclusive_scan(const T *in, T *out, std::size_t n, Arena &arena, Stream stream)
+{
+    (void)stream;
+    scan_impl(in, out, n, false, static_cast<T *>(nullptr), arena);
+}
+
+template<typename T>
+void inclusive_scan(const T *in, T *out, std::size_t n, Arena &arena, Stream stream)
+{
+    (void)stream;
+    scan_impl(in, out, n, true, static_cast<T *>(nullptr), arena);
+}
+
+template<typename T>
+T exclusive_scan_total(const T *in, T *out, std::size_t n, Arena &arena, Stream stream)
+{
+    (void)stream;
+    if(n == 0)
+    {
+        launch_noop();
+        return T(0);
+    }
+    T *grand = arena.allocate<T>(1);
+    scan_impl(in, out, n, false, grand, arena);
+    T total = T(0);
+    copy_to_host(&total, grand, sizeof(T));
+    return total;
+}
+
+#define TSR_INSTANTIATE_SCAN(T)                                                               \
+    template void exclusive_scan<T>(const T *, T *, std::size_t, Arena &, Stream);            \
+    template void inclusive_scan<T>(const T *, T *, std::size_t, Arena &, Stream);            \
+    template T exclusive_scan_total<T>(const T *, T *, std::size_t, Arena &, Stream);
+
+TSR_INSTANTIATE_SCAN(std::uint32_t)
+TSR_INSTANTIATE_SCAN(std::int32_t)
+TSR_INSTANTIATE_SCAN(std::uint64_t)
+TSR_INSTANTIATE_SCAN(std::int64_t)
+TSR_INSTANTIATE_SCAN(float)
+
+#undef TSR_INSTANTIATE_SCAN
+} // namespace tsr::prims
