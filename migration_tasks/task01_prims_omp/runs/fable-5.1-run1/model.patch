-}
-
-namespace detail
-{
-template<typename Kernel, typename Tuple>
-struct Closure
-{
-    Kernel kernel;
-    Tuple args;
-};
-
-template<typename C>
-void invoke_closure(const void *p)
-{
-    const C &c = *static_cast<const C *>(p);
