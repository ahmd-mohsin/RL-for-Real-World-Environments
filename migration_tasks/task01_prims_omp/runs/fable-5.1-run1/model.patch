new file mode 100644
index 0000000..ea122a6
--- /dev/null
+++ b/src/prims/bitonic_sort.cpp
@@ -0,0 +1,126 @@
+// Tessera - single-team bitonic sort for short key/value arrays.
+//
+// After bitonicSortShared from the NVIDIA "sortingNetworks" sample
+// (BSD-3-Clause). Changes: templated key/value types, arbitrary lengths up to
+// the shared-memory limit (padded with maximal sentinels to the next power of
+// two), a comparator that orders by (key, value) so equal keys come out in a
+// deterministic order, and comparators distributed over however many threads
+// the team has.
+#include <limits>
+
+#include "tsr/prims/prims.h"
+#include "tsr/prims/team.h"
+
+namespace tsr::prims
+{
+namespace
+{
+constexpr unsigned kSharedSizeLimit = static_cast<unsigned>(kBitonicMaxElements);
+
+template<typename K, typename V>
+inline void comparator(K &key_a, V &val_a, K &key_b, V &val_b, unsigned dir)
+{
+    const bool a_greater = key_a > key_b || (key_a == key_b && val_a > val_b);
+    if(a_greater == (dir != 0))
+    {
+        const K tk = key_a;
+        key_a      = key_b;
+        key_b      = tk;
+        const V tv = val_a;
+        val_a      = val_b;
+        val_b      = tv;
+    }
+}
+
+template<typename K, typename V>
+void bitonic_sort_kernel(
+    const K *keys_in,
+    K *keys_out,
+    const V *values_in,
+    V *values_out,
+    unsigned n,
+    unsigned array_length, // power of two >= n
+    unsigned dir           // 1 = ascending
+)
+{
+#pragma omp target teams num_teams(1) thread_limit(kMaxThreads) is_device_ptr(keys_in, keys_out, values_in, values_out)
+    {
+        K s_key[kSharedSizeLimit];
+        V s_val[kSharedSizeLimit];
+#pragma omp parallel
+        {
+            const TeamInfo ti   = this_team();
+            const unsigned half = array_length / 2;
+            for(unsigned i = ti.tid; i < array_length; i += ti.nth)
+            {
+                if(i < n)
+                {
+                    s_key[i] = keys_in[i];
+                    s_val[i] = values_in[i];
+                }
+                else
+                {
+                    s_key[i] = std::numeric_limits<K>::max();
+                    s_val[i] = std::numeric_limits<V>::max();
+                }
+            }
+
+            for(unsigned size = 2; size < array_length; size <<= 1)
+            {
+                // Bitonic merge
+                for(unsigned stride = size / 2; stride > 0; stride >>= 1)
+                {
+#pragma omp barrier
+                    for(unsigned c = ti.tid; c < half; c += ti.nth)
+                    {
+                        const unsigned ddd = dir ^ ((c & (size / 2)) != 0 ? 1u : 0u);
+                        const unsigned pos = 2 * c - (c & (stride - 1));
+                        comparator(s_key[pos], s_val[pos], s_key[pos + stride], s_val[pos + stride], ddd);
+                    }
+                }
+            }
+
+            // ddd == dir for the last bitonic merge step
+            for(unsigned stride = array_length / 2; stride > 0; stride >>= 1)
+            {
+#pragma omp barrier
+                for(unsigned c = ti.tid; c < half; c += ti.nth)
+                {
+                    const unsigned pos = 2 * c - (c & (stride - 1));
+                    comparator(s_key[pos], s_val[pos], s_key[pos + stride], s_val[pos + stride], dir);
+                }
+            }
+
+#pragma omp barrier
+            for(unsigned i = ti.tid; i < n; i += ti.nth)
+            {
+                keys_out[i]   = s_key[i];
+                values_out[i] = s_val[i];
+            }
+        }
+    }
+}
+} // namespace
+
+template<typename K, typename V>
+void bitonic_sort_pairs(const K *keys_in, K *keys_out, const V *values_in, V *values_out, std::size_t n, Stream stream)
+{
+    (void)stream;
+    TSR_CHECK(n <= kBitonicMaxElements, "bitonic_sort_pairs handles at most " << kBitonicMaxElements << " elements, got " << n);
+    if(n == 0)
+    {
+        launch_noop();
+        return;
+    }
+    unsigned length = 2;
+    while(length < n)
+    {
+        length <<= 1;
+    }
+    bitonic_sort_kernel(keys_in, keys_out, values_in, values_out, static_cast<unsigned>(n), length, 1u);
+}
+
+template void bitonic_sort_pairs<std::uint64_t, std::int32_t>(const std::uint64_t *, std::uint64_t *, const std::int32_t *, std::int32_t *, std::size_t, Stream);
+template void bitonic_sort_pairs<std::uint32_t, std::uint32_t>(const std::uint32_t *, std::uint32_t *, const std::uint32_t *, std::uint32_t *, std::size_t, Stream);
+template void bitonic_sort_pairs<std::uint32_t, std::int32_t>(const std::uint32_t *, std::uint32_t *, const std::int32_t *, std::int32_t *, std::size_t, Stream);
+} // namespace tsr::prims
