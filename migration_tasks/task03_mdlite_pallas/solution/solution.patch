new file mode 100644
index 0000000..5a97258
--- /dev/null
+++ b/mdlite/_nonbonded.py
@@ -0,0 +1,144 @@
+"""Short-range nonbonded forces as a Pallas (Triton) kernel.
+
+Mixed precision: pair interactions are evaluated in float32 from coordinates
+split into float32 hi/lo parts (wrapped into the box in float64), so pair
+displacements keep float64 accuracy. Each pair contribution is converted to
+64-bit fixed point before it is summed, which makes the result independent of
+the neighbour-list layout (bitwise reproducible across rebuilds and restarts).
+"""
+from __future__ import annotations
+
+import functools
+
+import jax
+import jax.numpy as jnp
+from jax.experimental import pallas as pl
+from jax.experimental.pallas import triton as plgpu
+
+F32 = jnp.float32
+I64 = jnp.int64
+SCALE = 4294967296.0  # 2^32, as in the engine's fixed point
+BI = 32               # atoms per program
+BJ = 32               # neighbours per inner iteration
+
+# parameter slots (float32 vector)
+P_RC2, P_BETA, P_KRF, P_CRF, P_SH6, P_SH12, P_RSW, P_A6, P_B6, P_C6, P_A12, P_B12, P_C12 = range(13)
+P_LH, P_LL, P_INVL = 13, 16, 19
+NPARAM = 24
+
+
+def erfc_f32(z):
+    """erfc for z >= 0 with ~1.2e-7 relative error (Chebyshev fit, Numerical Recipes erfcc)."""
+    t = 1.0 / (1.0 + 0.5 * z)
+    poly = -1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 + t * (-0.18628806 + t * (
+        0.27886807 + t * (-1.13520398 + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277))))))))
+    return t * jnp.exp(-z * z + poly)
+
+
+def _fixed(v):
+    return jnp.floor(v * SCALE + 0.5).astype(I64)
+
+
+def _kernel(nbr_ref, cnt_ref, xh_ref, yh_ref, zh_ref, xl_ref, yl_ref, zl_ref, q_ref, t_ref, c6_ref, c12_ref, p_ref, *out,
+            cap, ntypes, coul, vdw, energy):
+    pid = pl.program_id(0)
+    rows = pid * BI + jnp.arange(BI)
+    cnt = cnt_ref[pl.ds(pid * BI, BI)]
+    xi_h, yi_h, zi_h = xh_ref[pl.ds(pid * BI, BI)], yh_ref[pl.ds(pid * BI, BI)], zh_ref[pl.ds(pid * BI, BI)]
+    xi_l, yi_l, zi_l = xl_ref[pl.ds(pid * BI, BI)], yl_ref[pl.ds(pid * BI, BI)], zl_ref[pl.ds(pid * BI, BI)]
+    qi = q_ref[pl.ds(pid * BI, BI)]
+    ti = t_ref[pl.ds(pid * BI, BI)] * ntypes
+    rc2 = p_ref[P_RC2]
+    Lh = [p_ref[P_LH + d] for d in range(3)]
+    Ll = [p_ref[P_LL + d] for d in range(3)]
+    iL = [p_ref[P_INVL + d] for d in range(3)]
+    nmax = jnp.max(cnt)
+    nchunks = (nmax + BJ - 1) // BJ
+    cols = jnp.arange(BJ)
+
+    def body(k, acc):
+        slot = k * BJ + cols
+        valid = slot[None, :] < cnt[:, None]
+        j = nbr_ref[rows[:, None] * cap + slot[None, :]]
+        j = jnp.where(valid, j, rows[:, None])
+        d = []
+        for dim, (ih, il, rh, rl) in enumerate(((xi_h, xi_l, xh_ref, xl_ref), (yi_h, yi_l, yh_ref, yl_ref),
+                                                (zi_h, zi_l, zh_ref, zl_ref))):
+            dd = (ih[:, None] - rh[j]) + (il[:, None] - rl[j])
+            s = jnp.floor(dd * iL[dim] + 0.5)
+            d.append(dd - s * Lh[dim] - s * Ll[dim])
+        dx, dy, dz = d
+        r2 = dx * dx + dy * dy + dz * dz
+        inc = valid & (r2 < rc2)
+        r2s = jnp.where(inc, r2, 1.0)
+        rinv = jax.lax.rsqrt(r2s)
+        rinv2 = rinv * rinv
+        tj = t_ref[j]
+        c6 = c6_ref[ti[:, None] + tj]
+        c12 = c12_ref[ti[:, None] + tj]
+        rinv6 = rinv2 * rinv2 * rinv2
+        if vdw == 0:
+            v6 = c6 * rinv6
+            v12 = c12 * rinv6 * rinv6
+            elj = (v12 - c12 * p_ref[P_SH12]) - (v6 - c6 * p_ref[P_SH6])
+            fs = (12.0 * v12 - 6.0 * v6) * rinv2
+        else:
+            r = r2s * rinv
+            f6 = 6.0 * rinv6 * rinv
+            f12 = 12.0 * rinv6 * rinv6 * rinv
+            w6 = rinv6 - p_ref[P_C6]
+            w12 = rinv6 * rinv6 - p_ref[P_C12]
+            dr = jnp.maximum(r - p_ref[P_RSW], 0.0)
+            dr2 = dr * dr
+            dr3 = dr2 * dr
+            f6 = f6 + p_ref[P_A6] * dr2 + p_ref[P_B6] * dr3
+            f12 = f12 + p_ref[P_A12] * dr2 + p_ref[P_B12] * dr3
+            w6 = w6 - (p_ref[P_A6] / 3.0 * dr3 + p_ref[P_B6] / 4.0 * dr3 * dr)
+            w12 = w12 - (p_ref[P_A12] / 3.0 * dr3 + p_ref[P_B12] / 4.0 * dr3 * dr)
+            elj = c12 * w12 - c6 * w6
+            fs = (c12 * f12 - c6 * f6) * rinv
+        qq = qi[:, None] * q_ref[j]
+        if coul == 0:
+            beta = p_ref[P_BETA]
+            r = r2s * rinv
+            br = beta * r
+            ex = jnp.exp(-br * br)
+            ec_ = erfc_f32(br)
+            ec = qq * ec_ * rinv
+            fs = fs + qq * (ec_ * rinv + 1.1283791670955126 * beta * ex) * rinv2
+        else:
+            ec = qq * (rinv + p_ref[P_KRF] * r2s - p_ref[P_CRF])
+            fs = fs + qq * (rinv * rinv2 - 2.0 * p_ref[P_KRF])
+        fs = jnp.where(inc, fs, 0.0)
+        fx, fy, fz = fs * dx, fs * dy, fs * dz
+        new = [acc[0] + jnp.sum(_fixed(fx), axis=1), acc[1] + jnp.sum(_fixed(fy), axis=1), acc[2] + jnp.sum(_fixed(fz), axis=1)]
+        if energy:
+            elj = jnp.where(inc, elj, 0.0)
+            ec = jnp.where(inc, ec, 0.0)
+            terms = (elj, ec, dx * fx, dy * fy, dz * fz, dx * fy, dx * fz, dy * fz)
+            for k2, tval in enumerate(terms):
+                new.append(acc[3 + k2] + jnp.sum(_fixed(tval), axis=1))
+        return tuple(new)
+
+    nacc = 11 if energy else 3
+    init = tuple(jnp.zeros(BI, I64) for _ in range(nacc))
+    acc = jax.lax.fori_loop(0, nchunks, body, init)
+    for o, a in zip(out, acc):
+        o[pl.ds(pid * BI, BI)] = a
+
+
+@functools.lru_cache(maxsize=None)
+def make_nonbonded(nb, cap, ntypes, coul, vdw, energy):
+    """Returns f(nbr, cnt, xh, yh, zh, xl, yl, zl, q_scaled_i, q, type, c6, c12, params) -> int64 accumulators.
+
+    Outputs: fx, fy, fz (fixed point, per atom); with energy also per-atom
+    sums of e_lj, e_coul and the six virial components, each counted from both
+    atoms of a pair (halve at read-out)."""
+    nout = 11 if energy else 3
+    kern = functools.partial(_kernel, cap=cap, ntypes=ntypes, coul=coul, vdw=vdw, energy=energy)
+    call = pl.pallas_call(kern, out_shape=[jax.ShapeDtypeStruct((nb,), I64)] * nout, grid=(nb // BI,),
+                          compiler_params=plgpu.CompilerParams(num_warps=4, num_stages=1), name="mdlite_nonbonded")
+
+    def run(nbr, cnt, xh, yh, zh, xl, yl, zl, q, typ, c6, c12, params):
+        return call(nbr.reshape(-1), cnt, xh, yh, zh, xl, yl, zl, q, typ, c6, c12, params)
+    return run
