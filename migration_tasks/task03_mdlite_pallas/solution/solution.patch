+"""System validation and the derived topology (exclusions, LJ tables, constraint clusters, molecules)."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from ._params import MdliteError
+from .system import System
+
+FLEXIBLE_CONSTRAINT_K = 400000.0  # kJ/mol/nm^2, constraints become bonds when constraints = no
+
+
+def validate_system(s: System) -> None:
+    def req(ok, m):
+        if not ok:
+            raise MdliteError("mdsys: " + m)
+    n = s.natoms
+    req(n >= 1, "system has no atoms")
+    req(len(s.types) >= 1, "system has no atom types")
+    req(bool(np.all(np.isfinite(s.box)) and np.all(s.box > 0)), "box lengths must be positive")
+    req(0 <= s.nrexcl <= 5, "nrexcl must be in [0, 5]")
+    req(bool(np.all(s.types["sigma"] >= 0) and np.all(s.types["epsilon"] >= 0)), "negative LJ parameter")
+    nt = len(s.types)
+    for r in s.nbfix:
+        req(0 <= r["ti"] < nt and 0 <= r["tj"] < nt and r["sigma"] >= 0 and r["epsilon"] >= 0, "bad nbfix entry")
+    req(bool(np.all((s.type >= 0) & (s.type < nt))), "atom type out of range")
+    req(bool(np.all(np.isfinite(s.mass) & (s.mass > 0))), "masses must be positive")
+    req(bool(np.all(np.isfinite(s.charge))), "non-finite charge")
+    req(bool(np.all(np.isfinite(s.positions))), "non-finite position")
+    if s.velocities is not None:
+        req(bool(np.all(np.isfinite(s.velocities))), "non-finite velocity")
+    mol = s.molecule
+
+    def atoms(*cols):
+        for c in cols:
+            req(bool(np.all((c >= 0) & (c < n))), "atom index out of range")
+
+    def same(a, b):
+        req(bool(np.all(mol[a] == mol[b])), "bonded atoms must belong to the same molecule")
+    # same order of checks as the engine: per entry type, indices first
+    b = s.bonds
+    if len(b):
+        for r in b:
+            atoms(np.array([r["i"]]), np.array([r["j"]]))
+            req(r["i"] != r["j"], "bond to self")
+            same(r["i"], r["j"])
+    for r in s.angles:
+        atoms(np.array([r["i"]]), np.array([r["j"]]), np.array([r["k"]]))
+        same(r["i"], r["j"]); same(r["j"], r["k"])
+    for r in s.dihedrals:
+        atoms(*[np.array([r[c]]) for c in "ijkl"])
+        req(0 <= r["mult"] <= 6, "dihedral multiplicity must be in [0, 6]")
+        same(r["i"], r["j"]); same(r["j"], r["k"]); same(r["k"], r["l"])
+    for r in s.pairs:
+        atoms(np.array([r["i"]]), np.array([r["j"]]))
+        req(r["i"] != r["j"], "pair to self")
+    for r in s.constraints:
+        atoms(np.array([r["i"]]), np.array([r["j"]]))
+        req(r["i"] != r["j"], "constraint to self")
+        req(r["d"] > 0, "constraint length must be > 0")
+        same(r["i"], r["j"])
+    for r in s.exclusions:
+        atoms(np.array([r["i"]]), np.array([r["j"]]))
+
+
+@dataclass
+class Topology:
+    excl_ptr: np.ndarray
+    excl_idx: np.ndarray
+    excl_pairs: np.ndarray       # (P, 2) i < j
+    c6: np.ndarray               # (T, T)
+    c12: np.ndarray
+    bonds: np.ndarray            # (B, 2) int, (B, 2) params in bond_par
+    bond_par: np.ndarray
+    angles: np.ndarray
+    angle_par: np.ndarray        # theta0 in rad, k
+    dihedrals: np.ndarray        # (D, 4)
+    dih_mult: np.ndarray
+    dih_par: np.ndarray          # phi0 in rad, k
+    pairs: np.ndarray
+    cons: np.ndarray             # (C, 2)
+    cons_d: np.ndarray
+    clusters: list               # list of arrays of constraint indices, in engine order
+    mol_ptr: np.ndarray
+    mol_atoms: np.ndarray
+    ncons: int
+
+
+def build_topology(s: System, use_constraints: bool) -> Topology:
+    n = s.natoms
+    bonds = [(int(r["i"]), int(r["j"]), float(r["r0"]), float(r["k"])) for r in s.bonds]
+    cons = [(int(r["i"]), int(r["j"]), float(r["d"])) for r in s.constraints]
+    if not use_constraints:
+        bonds += [(i, j, d, FLEXIBLE_CONSTRAINT_K) for i, j, d in cons]
+        graph_cons = []
+        cons = []
+    else:
+        graph_cons = cons
+    adj = [[] for _ in range(n)]
+    for i, j, *_ in bonds:
+        adj[i].append(j); adj[j].append(i)
+    for i, j, _ in graph_cons:
+        adj[i].append(j); adj[j].append(i)
+    ex = [set() for _ in range(n)]
+    if s.nrexcl > 0:
+        for i in range(n):
+            if not adj[i]:
+                continue
+            dist = {i: 0}
+            frontier = [i]
+            while frontier:
+                nxt = []
+                for a in frontier:
+                    if dist[a] == s.nrexcl:
+                        continue
+                    for b in adj[a]:
+                        if b not in dist:
+                            dist[b] = dist[a] + 1
+                            ex[i].add(b)
+                            nxt.append(b)
+                frontier = nxt
+    for r in s.exclusions:
+        a, b = int(r["i"]), int(r["j"])
+        if a != b:
+            ex[a].add(b); ex[b].add(a)
+    ptr = np.zeros(n + 1, np.int64)
+    idx, pairs = [], []
+    for i in range(n):
+        lst = sorted(ex[i])
+        ptr[i + 1] = ptr[i] + len(lst)
+        idx += lst
+        pairs += [(i, j) for j in lst if i < j]
+
+    T = len(s.types)
+    c6 = np.zeros((T, T)); c12 = np.zeros((T, T))
+
+    def setp(a, b, sig, eps):
+        s6 = sig ** 6
+        c6[a, b] = c6[b, a] = 4.0 * eps * s6
+        c12[a, b] = c12[b, a] = 4.0 * eps * s6 * s6
+    sg, ep = s.types["sigma"], s.types["epsilon"]
+    for a in range(T):
+        for b in range(a, T):
+            setp(a, b, 0.5 * (sg[a] + sg[b]), np.sqrt(ep[a] * ep[b]))
+    for r in s.nbfix:
+        setp(int(r["ti"]), int(r["tj"]), float(r["sigma"]), float(r["epsilon"]))
+
+    # constraint clusters by union-find, ordered by first constraint
+    clusters = []
+    if cons:
+        parent = list(range(n))
+
+        def find(a):
+            while parent[a] != a:
+                parent[a] = parent[parent[a]]
+                a = parent[a]
+            return a
+        for i, j, _ in cons:
+            parent[find(i)] = find(j)
+        root_cl = {}
+        for k, (i, j, _) in enumerate(cons):
+            r = find(i)
+            if r not in root_cl:
+                root_cl[r] = len(clusters)
+                clusters.append([])
+            clusters[root_cl[r]].append(k)
+    mols = {}
+    for i, m in enumerate(s.molecule.tolist()):
+        mols.setdefault(m, []).append(i)
+    mol_ptr = [0]
+    mol_atoms = []
+    for m in sorted(mols):
+        mol_atoms += mols[m]
+        mol_ptr.append(len(mol_atoms))
+
+    deg = np.pi / 180.0
+    return Topology(
+        excl_ptr=ptr, excl_idx=np.array(idx, np.int64), excl_pairs=np.array(pairs, np.int64).reshape(-1, 2), c6=c6, c12=c12,
+        bonds=np.array([b[:2] for b in bonds], np.int64).reshape(-1, 2), bond_par=np.array([b[2:] for b in bonds]).reshape(-1, 2),
+        angles=np.stack([s.angles["i"], s.angles["j"], s.angles["k"]], 1).astype(np.int64) if len(s.angles) else np.zeros((0, 3), np.int64),
+        angle_par=np.stack([s.angles["theta0"] * deg, s.angles["kth"]], 1) if len(s.angles) else np.zeros((0, 2)),
+        dihedrals=np.stack([s.dihedrals[c] for c in "ijkl"], 1).astype(np.int64) if len(s.dihedrals) else np.zeros((0, 4), np.int64),
+        dih_mult=s.dihedrals["mult"].astype(np.int64) if len(s.dihedrals) else np.zeros(0, np.int64),
+        dih_par=np.stack([s.dihedrals["phi0"] * deg, s.dihedrals["kphi"]], 1) if len(s.dihedrals) else np.zeros((0, 2)),
+        pairs=np.stack([s.pairs["i"], s.pairs["j"]], 1).astype(np.int64) if len(s.pairs) else np.zeros((0, 2), np.int64),
+        cons=np.array([c[:2] for c in cons], np.int64).reshape(-1, 2), cons_d=np.array([c[2] for c in cons], float),
+        clusters=[np.array(c, np.int64) for c in clusters], mol_ptr=np.array(mol_ptr, np.int64),
+        mol_atoms=np.array(mol_atoms, np.int64), ncons=len(cons))
