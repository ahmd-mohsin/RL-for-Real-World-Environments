-// 53-bit uniform in the open interval (0, 1) from two 32-bit words
-__host__ __device__ inline double uniform53(uint32_t a, uint32_t b) {
-  return ((double)(a >> 5) * 67108864.0 + (double)(b >> 6) + 0.5) * (1.0 / 9007199254740992.0);
-}
