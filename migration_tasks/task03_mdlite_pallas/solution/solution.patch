diff --git a/mdlite/_neighbor.py b/mdlite/_neighbor.py
new file mode 100644
index 0000000..4b40500
--- /dev/null
+++ b/mdlite/_neighbor.py
@@ -0,0 +1,120 @@
+"""Cell-list neighbour search: cell sort in XLA, list construction in a Pallas kernel.
+
+Capacities (neighbours per atom, atoms per cell, cells per dimension) are
+static shapes; any overflow is reported so the caller can grow them and redo
+the work. Nothing is silently truncated.
+"""
+from __future__ import annotations
+
+import functools
+import itertools
+
+import jax
+import jax.numpy as jnp
+from jax.experimental import pallas as pl
+from jax.experimental.pallas import triton as plgpu
+
+F32, I32 = jnp.float32, jnp.int32
+BI = 32
+BJ = 32
+OFFS = list(itertools.product((-1, 0, 1), repeat=3))
+
+
+def _kernel(cx_ref, cy_ref, cz_ref, start_ref, count_ref, order_ref, xh_ref, yh_ref, zh_ref, xl_ref, yl_ref, zl_ref, ex_ref,
+            ip_ref, fp_ref, off_ref, nbr_ref, cnt_ref, *, cap, E, natoms):
+    pid = pl.program_id(0)
+    sl = pl.ds(pid * BI, BI)
+    rows = pid * BI + jnp.arange(BI)
+    real = rows < natoms
+    cx, cy, cz = cx_ref[sl], cy_ref[sl], cz_ref[sl]
+    n0, n1, n2 = ip_ref[0], ip_ref[1], ip_ref[2]
+    rl2 = fp_ref[0]
+    Lh = [fp_ref[1 + d] for d in range(3)]
+    Ll = [fp_ref[4 + d] for d in range(3)]
+    iL = [fp_ref[7 + d] for d in range(3)]
+    xi = [(xh_ref[sl], xl_ref[sl]), (yh_ref[sl], yl_ref[sl]), (zh_ref[sl], zl_ref[sl])]
+    ex = [ex_ref[rows * E + e] for e in range(E)]
+    cols = jnp.arange(BJ)
+    cnt = jnp.zeros(BI, I32)
+
+    def per_offset(t, cnt):
+        t = t.astype(I32)
+        ox = t // 9 - 1
+        oy = (t // 3) % 3 - 1
+        oz = t - (t // 3) * 3 - 1
+        use = off_ref[t] > 0
+        ncx = (cx + ox + n0) % n0
+        ncy = (cy + oy + n1) % n1
+        ncz = (cz + oz + n2) % n2
+        cid = (ncx * n1 + ncy) * n2 + ncz
+        st = start_ref[cid]
+        ct = jnp.where(use & real, count_ref[cid], 0)
+        nchunks = (jnp.max(ct) + BJ - 1) // BJ
+
+        def body(k, cnt):
+            slot = k * BJ + cols
+            valid = slot[None, :] < ct[:, None]
+            j = order_ref[jnp.where(valid, st[:, None] + slot[None, :], 0)]
+            r2 = jnp.zeros((BI, BJ), F32)
+            for d in range(3):
+                hi, lo = xi[d]
+                rh = (xh_ref, yh_ref, zh_ref)[d]
+                rl = (xl_ref, yl_ref, zl_ref)[d]
+                dd = (hi[:, None] - rh[j]) + (lo[:, None] - rl[j])
+                s = jnp.floor(dd * iL[d] + 0.5)
+                dd = dd - s * Lh[d] - s * Ll[d]
+                r2 = r2 + dd * dd
+            m = valid & (j != rows[:, None]) & (r2 < rl2)
+            for e in range(E):
+                m = m & (j != ex[e][:, None])
+            mi = m.astype(I32)
+            pos = cnt[:, None] + jnp.cumsum(mi, axis=1) - 1
+            plgpu.store(nbr_ref.at[rows[:, None] * cap + pos], j, mask=m & (pos < cap))
+            return cnt + jnp.sum(mi, axis=1).astype(I32)
+
+        return jax.lax.fori_loop(0, nchunks, body, cnt)
+
+    cnt = jax.lax.fori_loop(jnp.int32(0), jnp.int32(27), per_offset, cnt)
+    cnt_ref[sl] = cnt
+
+
+@functools.lru_cache(maxsize=None)
+def _call(nb, cap, E, natoms):
+    return pl.pallas_call(functools.partial(_kernel, cap=cap, E=E, natoms=natoms),
+                          out_shape=[jax.ShapeDtypeStruct((nb * cap,), I32), jax.ShapeDtypeStruct((nb,), I32)],
+                          grid=(nb // BI,), name="mdlite_neighbor_build",
+                          compiler_params=plgpu.CompilerParams(num_warps=4, num_stages=1))
+
+
+def offsets_used(ncs):
+    """(27,) int32: 1 for the cell offsets to visit; offsets are deduplicated
+    when a dimension has fewer than 3 cells (only 0, or 0 and +1)."""
+    o = jnp.array(OFFS, I32)
+    need = jnp.where(o == 0, 1, jnp.where(o == 1, 2, 3))
+    return jnp.all(ncs[None, :] >= need, axis=1).astype(I32)
+
+
+def build(x, hi, lo, L, natoms, rlist, excl, *, cap, cap_cell, max_cells):
+    """x: (nb, 3) float64; hi/lo: float32 split of the wrapped positions.
+    Returns nbr (nb, cap) int32, cnt (nb,) int32 (clipped), overflow flag."""
+    nb = x.shape[0]
+    real = jnp.arange(nb) < natoms
+    nc = jnp.maximum(1, jnp.floor(L / rlist)).astype(I32)
+    over_cells = jnp.any(nc > max_cells)
+    ncs = jnp.minimum(nc, max_cells)
+    s = x / L - jnp.floor(x / L)
+    c = jnp.clip((s * ncs).astype(I32), 0, ncs - 1)
+    cid = (c[:, 0] * ncs[1] + c[:, 1]) * ncs[2] + c[:, 2]
+    ntot = max_cells ** 3
+    cid = jnp.where(real, cid, ntot)
+    order = jnp.argsort(cid, stable=True).astype(I32)
+    counts = jnp.zeros(ntot + 1, I32).at[cid].add(1)[:ntot]
+    starts = (jnp.cumsum(counts) - counts).astype(I32)
+    Lh = L.astype(F32)
+    Ll = (L - Lh.astype(jnp.float64)).astype(F32)
+    fp = jnp.concatenate([jnp.array([rlist * rlist], F32), Lh, Ll, (1.0 / L).astype(F32)])
+    E = excl.shape[1]
+    nbr, cnt = _call(nb, cap, E, natoms)(c[:, 0], c[:, 1], c[:, 2], starts, counts, order, hi[:, 0], hi[:, 1], hi[:, 2],
+                                         lo[:, 0], lo[:, 1], lo[:, 2], excl.reshape(-1), ncs, fp, offsets_used(ncs))
+    overflow = over_cells | (jnp.max(cnt) > cap)
+    return nbr.reshape(nb, cap), jnp.minimum(cnt, cap), overflow
