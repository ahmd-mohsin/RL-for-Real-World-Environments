+            E = lambda k: sums[k].astype(F64) / SCALE
+            lj = 0.5 * E("lj2")
+            coul_sr = 0.5 * E("coul2")
+            disp = jnp.zeros((), F64)
+            if p.dispcorr:
+                disp = -2.0 / 3.0 * math.pi * float(n) * float(n) * self.avg_c6 / (V * p.cutoff ** 3)
+            if self.coul == 0:
+                selfe = -ONE_4PI_EPS0 * self.beta / math.sqrt(math.pi) * self.sum_q2
+                net = -ONE_4PI_EPS0 * math.pi * self.sum_q * self.sum_q / (2.0 * V * self.beta * self.beta)
+                recip = sums["erec"] + E("coul_excl") + selfe + net
+            else:
+                coul_sr = coul_sr + E("coul_excl") - 0.5 * ONE_4PI_EPS0 * self.crf * self.sum_q2
+                recip = jnp.zeros((), F64)
+                net = 0.0
+            terms = [lj, E("lj_14"), disp, coul_sr, E("coulomb_14"), recip, E("bond"), E("angle"), E("dihedral")]
+            pot = sum(terms[1:], terms[0])
+            w = 0.5 * sums["v2"].astype(F64) / SCALE + sums["vir1"].astype(F64) / SCALE + sums["vrec"] + st["cvir"]
+            diag = jnp.array([1.0, 1.0, 1.0, 0.0, 0.0, 0.0])
+            if self.coul == 0:
+                w = w + diag * net
+            w = w + diag * 2.0 * disp
+            ke6, _ = kinetic(st["v"])
+            ke = ke6[0] + ke6[1] + ke6[2]
+            pt = (2.0 * ke6 + w) / V * PRESFAC
+            temp = 2.0 * ke / (self.dof * BOLTZ) if self.dof > 0 else jnp.zeros((), F64)
+            pres = (pt[0] + pt[1] + pt[2]) / 3.0
+            cons = pot + ke + st["integral"]
+            if p.pcoupl != "no":
+                cons = cons + p.ref_p * V / PRESFAC
+            out = jnp.stack(terms + [pot, ke, pot + ke, cons, temp, pres, V])
+            return out, w, pt
+
+        def energies(st):
+            st2, sums = forces(st, True)
+            terms, w, pt = assemble(st2, sums)
+            return st2, terms, w, pt
+
+        # --- constraints helpers
+        def shake(st, x, xref, v, inv_dt, fix_v):
+            xs, vs, fail = self.cons.shake(x, xref, v, st["L"], p.shake_tol, inv_dt, p.shake_maxiter, fix_v)
+            flags = st["flags"] | jnp.where(fail != 0, FAIL_SHAKE, 0)
+            return xs, vs, flags
+
+        def rattle(st, x, v, flags):
+            vs, vir, fail = self.cons.rattle(x, v, st["L"], p.shake_tol, p.dt, p.shake_maxiter)
+            return vs, vir, flags | jnp.where(fail != 0, FAIL_RATTLE, 0)
+
+        def kick(v, f, h):
+            return v + h * self.inv_mass[:, None] * (f.astype(F64) / SCALE)
+
+        def remove_com(v):
+            _, mom = kinetic(v)
+            return jnp.where(self.real[:, None], v - (mom / self.total_mass)[None, :], v)
+
+        def first_fail_step(st, flags_new):
+            return jnp.where((st["flags"] == 0) & (flags_new != 0), st["step"], st["fail_step"])
+
+        def csvr(st, v):
+            ke6, _ = kinetic(v)
+            K = ke6[0] + ke6[1] + ke6[2]
+            Kt = 0.5 * self.dof * BOLTZ * p.ref_t
+            c = math.exp(-p.nsttcouple * p.dt / p.tau_t)
+            seed, step = jnp.uint64(p.seed), st["step"].astype(jnp.uint64)
+            ctr = jnp.uint32(0)
+            r1, ctr = rng.stream_gauss(seed, step, rng.STREAM_CSVR, ctr)
+            sumr2, ctr = rng.stream_sum_noises(seed, step, rng.STREAM_CSVR, ctr, self.dof - 1)
+            Ks = jnp.where(K > 0, K, 1.0)
+            Knew = K + (1.0 - c) * (Kt * (sumr2 + r1 * r1) / self.dof - K) + 2.0 * r1 * jnp.sqrt(Kt / self.dof * (1.0 - c) * c * Ks)
+            Knew = jnp.maximum(Knew, 0.0)
+            lam = jnp.sqrt(Knew / Ks)
+            ok = K > 0
+            v = jnp.where(ok, v * lam, v)
+            integral = st["integral"] - jnp.where(ok, Knew - K, 0.0)
+            return v, integral
+
+        def step_vv(st):
+            dt = p.dt
+            x, v = st["x"], st["v"]
+            v = kick(v, st["f"], 0.5 * dt)
+            xold = x
+            x = x + dt * v
+            flags = st["flags"]
+            if self.cons.ncl:
+                x, v, flags = shake(st, x, xold, v, 1.0 / dt, True)
+            st = dict(st, x=x, v=v, flags=flags, fail_step=first_fail_step(st, flags))
+            st = dict(st, step=st["step"] + 1)
+            st, _ = forces(st, False)
+            v = kick(st["v"], st["f"], 0.5 * dt)
+            cvir = st["cvir"]
+            flags = st["flags"]
+            if self.cons.ncl:
+                v, cvir, flags = rattle(st, st["x"], v, flags)
+            integral = st["integral"]
+            if p.tcoupl == "csvr" and self.dof > 0:
+                due = (st["step"] % p.nsttcouple) == 0
+                v2, i2 = csvr(st, v)
+                v = jnp.where(due, v2, v)
+                integral = jnp.where(due, i2, integral)
+            if p.nstcomm > 0:
+                v = jnp.where((st["step"] % p.nstcomm) == 0, remove_com(v), v)
+            return dict(st, v=v, cvir=cvir, flags=flags, integral=integral, fail_step=first_fail_step(st, flags))
+
+        def step_baoab(st):
+            dt = p.dt
+            x, v = st["x"], st["v"]
+            flags = st["flags"]
+            v = kick(v, st["f"], 0.5 * dt)
+            if self.cons.ncl:
+                v, _, flags = rattle(st, x, v, flags)
+            xold = x
+            x = x + 0.5 * dt * v
+            if self.cons.ncl:
+                x, v, flags = shake(dict(st, flags=flags), x, xold, v, 2.0 / dt, True)
+                v, _, flags = rattle(st, x, v, flags)
+            ke0, _ = kinetic(v)
+            c1 = math.exp(-dt / p.tau_t)
+            c2 = math.sqrt(1.0 - c1 * c1)
+            g = rng.gauss3(jnp.uint64(p.seed), st["step"].astype(jnp.uint64), rng.STREAM_LANGEVIN, nb)
+            sig = c2 * jnp.sqrt(BOLTZ * p.ref_t * self.inv_mass)
+            v = c1 * v + sig[:, None] * g
+            if self.cons.ncl:
+                v, _, flags = rattle(st, x, v, flags)
+            ke1, _ = kinetic(v)
+            integral = st["integral"] - ((ke1[0] + ke1[1] + ke1[2]) - (ke0[0] + ke0[1] + ke0[2]))
+            xold = x
+            x = x + 0.5 * dt * v
+            if self.cons.ncl:
+                x, v, flags = shake(dict(st, flags=flags), x, xold, v, 2.0 / dt, True)
+            st = dict(st, x=x, v=v, flags=flags, integral=integral, fail_step=first_fail_step(st, flags))
+            st = dict(st, step=st["step"] + 1)
+            st, _ = forces(st, False)
+            v = kick(st["v"], st["f"], 0.5 * dt)
+            cvir = st["cvir"]
+            flags = st["flags"]
+            if self.cons.ncl:
+                v, cvir, flags = rattle(st, st["x"], v, flags)
+            if p.nstcomm > 0:
+                v = jnp.where((st["step"] % p.nstcomm) == 0, remove_com(v), v)
+            return dict(st, v=v, cvir=cvir, flags=flags, fail_step=first_fail_step(st, flags))
+
+        def barostat(st):
+            st, terms, w, pt = energies(st)
+            P = terms[TERMS.index("pressure")]
+            L = st["L"]
+            V = L[0] * L[1] * L[2]
+            cf = p.compressibility * p.nstpcouple * p.dt / p.tau_p
+            if p.pcoupl == "berendsen":
+                mu = jnp.cbrt(1.0 - cf * (p.ref_p - P))
+            else:
+                kT_bar = BOLTZ * p.ref_t * PRESFAC / V
+                g, _ = rng.stream_gauss(jnp.uint64(p.seed), st["step"].astype(jnp.uint64), rng.STREAM_CRESCALE, jnp.uint32(0))
+                deps = -cf * (p.ref_p - P - kT_bar) + jnp.sqrt(2.0 * kT_bar * cf) * g
+                mu = jnp.exp(deps / 3.0)
+            x = st["x"]
+            # molecule centres of mass, summed in a fixed order (no float scatter-add)
+            mt = self.mol_table
+            ok = mt >= 0
+            mi = jnp.where(ok, self.mass[jnp.maximum(mt, 0)], 0.0)
+            M = jnp.zeros(mt.shape[0])
+            C = jnp.zeros((mt.shape[0], 3))
+            for k in range(mt.shape[1]):
+                M = M + mi[:, k]
+                C = C + mi[:, k, None] * x[jnp.maximum(mt[:, k], 0)]
+            shift = (mu - 1.0) * C / M[:, None]
+            shift = jnp.concatenate([shift, jnp.zeros((1, 3))])
+            x = x + shift[self.mol_of]
+            L = L * mu
+            v = st["v"]
+            integral = st["integral"]
+            if p.pcoupl == "c-rescale":
+                K0 = terms[TERMS.index("kinetic")]
+                v = v / mu
+                integral = integral - (K0 / (mu * mu) - K0)
+            st = dict(st, x=x, L=L, v=v, integral=integral, rebuild=jnp.array(True))
+            st, _ = forces(st, False)
+            return st
+
+        step_fn = step_vv if p.integrator == "vv" else step_baoab
+
+        def advance(st, nsteps):
+            def body(_, st):
+                ok = (st["flags"] == 0) & ~st["overflow"]
+
+                def go(st):
+                    if p.pcoupl != "no":
+                        st = lax.cond((st["step"] % p.nstpcouple) == 0, barostat, lambda s: s, st)
+                    return step_fn(st)
+                return lax.cond(ok, go, lambda s: s, st)
+            return lax.fori_loop(0, nsteps, body, st)
+
+        return {"forces": jax.jit(lambda st: forces(st, False)[0]), "energies": jax.jit(energies),
+                "advance": jax.jit(advance), "rattle": jax.jit(lambda st, v: rattle(st, st["x"], v, st["flags"])),
+                "shake_pos": jax.jit(lambda st, xref: shake(st, st["x"], xref, st["v"], 0.0, False)),
+                "kick": jax.jit(kick), "remove_com": jax.jit(remove_com), "kinetic": jax.jit(kinetic)}
+
+    # ------------------------------------------------------------------ state
+    def new_state(self, x, v, L):
+        nb = self.nb
+        X = np.zeros((nb, 3)); X[:self.n] = x
+        Vv = np.zeros((nb, 3)); Vv[:self.n] = v
+        return {"x": jnp.asarray(X), "v": jnp.asarray(Vv), "L": jnp.asarray(np.asarray(L, float)), "step": jnp.int64(0),
+                "integral": jnp.float64(0.0), "cvir": jnp.zeros(6), "f": jnp.zeros((nb, 3), I64),
+                "nbr": jnp.zeros((nb, self.cap), I32), "cnt": jnp.zeros(nb, I32), "xref": jnp.asarray(X),
+                "rebuild": jnp.array(True), "flags": jnp.int32(0), "fail_step": jnp.int64(0), "overflow": jnp.array(False)}
+
+    def resize_state(self, st):
+        return dict(st, nbr=jnp.zeros((self.nb, self.cap), I32), cnt=jnp.zeros(self.nb, I32), rebuild=jnp.array(True),
+                    overflow=jnp.array(False))
+
+    def grow(self, st_after):
+        """Grow capacities after an overflow (st_after: state where it was detected)."""
+        self.cap = int(_round_up(int(self.cap * 1.5) + 32, 32))
+        self.cap_cell = int(_round_up(int(self.cap_cell * 1.5) + 8, 8))
+        L = np.asarray(st_after["L"])
+        self.max_cells = int(max(self.max_cells, math.floor(float(L.max()) / self.rlist) + 2))
