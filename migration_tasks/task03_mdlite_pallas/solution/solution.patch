-    addf(f, j, mul(-1.0, fj));
-    addf(f, k, mul(-1.0, fk));
-    addf(f, l, fl);
-    addvir(v, rij, fi);
-    addvir(v, rkj, mul(-1.0, fk));
-    addvir(v, sub(rkj, rkl), fl);
