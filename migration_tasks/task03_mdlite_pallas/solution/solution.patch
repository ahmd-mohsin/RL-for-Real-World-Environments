index 0000000..5595ec4
--- /dev/null
+++ b/mdlite/_bonded.py
@@ -0,0 +1,176 @@
+"""Bonded interactions and exclusion corrections (float64, XLA), accumulated in
+64-bit fixed point (order independent, deterministic)."""
+from __future__ import annotations
+
+import jax.numpy as jnp
+from jax.scipy.special import erf
+
+from .units import ONE_4PI_EPS0
+
+SCALE = 4294967296.0
+I64 = jnp.int64
+TWO_OVER_SQRT_PI = 1.1283791670955126
+
+
+def fx(v):
+    return jnp.floor(v * SCALE + 0.5).astype(I64)
+
+
+def _mi(d, L):
+    return d - L * jnp.round(d / L)
+
+
+def _dot(a, b):
+    return jnp.sum(a * b, axis=-1)
+
+
+def _vir6(r, f):
+    return jnp.stack([r[:, 0] * f[:, 0], r[:, 1] * f[:, 1], r[:, 2] * f[:, 2], r[:, 0] * f[:, 1], r[:, 0] * f[:, 2],
+                      r[:, 1] * f[:, 2]], 1)
+
+
+class Acc:
+    """Fixed-point force array (nb, 3) plus named energy / virial sums."""
+
+    def __init__(self, nb):
+        self.f = jnp.zeros((nb, 3), I64)
+        self.e = {}
+        self.vir = jnp.zeros(6, I64)
+
+    def add_force(self, idx, f):
+        self.f = self.f.at[idx].add(fx(f))
+
+    def add_energy(self, name, e):
+        self.e[name] = self.e.get(name, jnp.zeros((), I64)) + jnp.sum(fx(e))
+
+    def add_vir(self, v6):
+        self.vir = self.vir + jnp.sum(fx(v6), axis=0)
+
+
+def bonds(acc, x, L, idx, par):
+    if idx.shape[0] == 0:
+        acc.add_energy("bond", jnp.zeros(0)); return
+    i, j = idx[:, 0], idx[:, 1]
+    d = _mi(x[i] - x[j], L)
+    r = jnp.sqrt(_dot(d, d))
+    dr = r - par[:, 0]
+    k = par[:, 1]
+    acc.add_energy("bond", 0.5 * k * dr * dr)
+    fs = jnp.where(r > 0, -k * dr / jnp.where(r > 0, r, 1.0), 0.0)
+    fi = fs[:, None] * d
+    acc.add_force(i, fi)
+    acc.add_force(j, -fi)
+    acc.add_vir(_vir6(d, fi))
+
+
+def angles(acc, x, L, idx, par):
+    if idx.shape[0] == 0:
+        acc.add_energy("angle", jnp.zeros(0)); return
+    i, j, k = idx[:, 0], idx[:, 1], idx[:, 2]
+    rij = _mi(x[i] - x[j], L)
+    rkj = _mi(x[k] - x[j], L)
+    nrij2, nrkj2 = _dot(rij, rij), _dot(rkj, rkj)
+    nrij_1, nrkj_1 = 1.0 / jnp.sqrt(nrij2), 1.0 / jnp.sqrt(nrkj2)
+    cth = jnp.clip(_dot(rij, rkj) * nrij_1 * nrkj_1, -1.0, 1.0)
+    th = jnp.arccos(cth)
+    dth = th - par[:, 0]
+    kth = par[:, 1]
+    acc.add_energy("angle", 0.5 * kth * dth * dth)
+    st = -kth * dth / jnp.sqrt(jnp.maximum(1.0 - cth * cth, 1e-12))
+    sth = st * cth
+    cik = (st * nrij_1 * nrkj_1)[:, None]
+    cii = (sth * nrij_1 * nrij_1)[:, None]
+    ckk = (sth * nrkj_1 * nrkj_1)[:, None]
+    fi = -(cik * rkj - cii * rij)
+    fk = -(cik * rij - ckk * rkj)
+    fj = -(fi + fk)
+    acc.add_force(i, fi)
+    acc.add_force(j, fj)
+    acc.add_force(k, fk)
+    acc.add_vir(_vir6(rij, fi) + _vir6(rkj, fk))
+
+
+def dihedrals(acc, x, L, idx, mult, par):
+    if idx.shape[0] == 0:
+        acc.add_energy("dihedral", jnp.zeros(0)); return
+    i, j, k, l = idx[:, 0], idx[:, 1], idx[:, 2], idx[:, 3]
+    rij = _mi(x[i] - x[j], L)
+    rkj = _mi(x[k] - x[j], L)
+    rkl = _mi(x[k] - x[l], L)
+    m = jnp.cross(rij, rkj)
+    n = jnp.cross(rkj, rkl)
+    mn = jnp.cross(m, n)
+    phi = jnp.arctan2(jnp.sqrt(_dot(mn, mn)), _dot(m, n))
+    phi = jnp.where(_dot(rij, n) < 0, -phi, phi)
+    mf = mult.astype(jnp.float64)
+    mdphi = mf * phi - par[:, 0]
+    kphi = par[:, 1]
+    acc.add_energy("dihedral", kphi * (1.0 + jnp.cos(mdphi)))
+    ddphi = -kphi * mf * jnp.sin(mdphi)
+    iprm, iprn = _dot(m, m), _dot(n, n)
+    ok = (iprm > 1e-24) & (iprn > 1e-24)
+    nrkj2 = _dot(rkj, rkj)
+    nrkj = jnp.sqrt(nrkj2)
+    fi = jnp.where(ok, -ddphi * nrkj / jnp.where(ok, iprm, 1.0), 0.0)[:, None] * m
+    fl = jnp.where(ok, ddphi * nrkj / jnp.where(ok, iprn, 1.0), 0.0)[:, None] * n
+    p = (_dot(rij, rkj) / nrkj2)[:, None]
+    q = (_dot(rkl, rkj) / nrkj2)[:, None]
+    svec = p * fi - q * fl
+    fj = fi - svec
+    fk = fl + svec
+    acc.add_force(i, fi)
+    acc.add_force(j, -fj)
+    acc.add_force(k, -fk)
+    acc.add_force(l, fl)
+    acc.add_vir(_vir6(rij, fi) + _vir6(rkj, -fk) + _vir6(rkj - rkl, fl))
+
+
+def pairs14(acc, x, L, idx, typ, q, c6t, c12t, fudge_lj, fudge_qq):
+    if idx.shape[0] == 0:
+        acc.add_energy("lj_14", jnp.zeros(0)); acc.add_energy("coulomb_14", jnp.zeros(0)); return
+    i, j = idx[:, 0], idx[:, 1]
+    d = _mi(x[i] - x[j], L)
+    r2 = _dot(d, d)
+    rinv2 = 1.0 / r2
+    rinv6 = rinv2 * rinv2 * rinv2
+    c6 = fudge_lj * c6t[typ[i], typ[j]]
+    c12 = fudge_lj * c12t[typ[i], typ[j]]
+    elj = c12 * rinv6 * rinv6 - c6 * rinv6
+    flj = (12.0 * c12 * rinv6 * rinv6 - 6.0 * c6 * rinv6) * rinv2
+    qq = fudge_qq * ONE_4PI_EPS0 * q[i] * q[j]
+    rinv = jnp.sqrt(rinv2)
+    ec = qq * rinv
+    fc = qq * rinv * rinv2
+    fi = (flj + fc)[:, None] * d
+    acc.add_force(i, fi)
+    acc.add_force(j, -fi)
+    acc.add_vir(_vir6(d, fi))
+    acc.add_energy("lj_14", elj)
+    acc.add_energy("coulomb_14", ec)
+
+
+def exclusions(acc, x, L, idx, q, coul, beta, krf, crf, rc2):
+    if idx.shape[0] == 0:
+        acc.add_energy("coul_excl", jnp.zeros(0)); return
+    i, j = idx[:, 0], idx[:, 1]
+    qq = ONE_4PI_EPS0 * q[i] * q[j]
+    d = _mi(x[i] - x[j], L)
+    r2 = _dot(d, d)
+    if coul == 0:
+        pos = r2 > 0
+        r = jnp.sqrt(jnp.where(pos, r2, 1.0))
+        br = beta * r
+        erf_br = erf(br)
+        e = jnp.where(pos, -qq * erf_br / r, -qq * TWO_OVER_SQRT_PI * beta)
+        fs = jnp.where(pos, -qq * (erf_br / r - TWO_OVER_SQRT_PI * beta * jnp.exp(-br * br)) / jnp.where(pos, r2, 1.0), 0.0)
+    else:
+        inside = r2 < rc2
+        e = jnp.where(inside, qq * (krf * r2 - crf), 0.0)
+        fs = jnp.where(inside, -2.0 * qq * krf, 0.0)
+    e = jnp.where(qq != 0.0, e, 0.0)
+    fs = jnp.where(qq != 0.0, fs, 0.0)
+    f = fs[:, None] * d
+    acc.add_force(i, f)
+    acc.add_force(j, -f)
+    acc.add_energy("coul_excl", e)
+    acc.add_vir(_vir6(d, f))
