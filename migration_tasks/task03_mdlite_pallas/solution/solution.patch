-    double div = 1.0 / (j - 1.0);
-    w[j - 1] = div * fr * w[j - 2];
-    for (int k = 1; k < j - 1; ++k) w[j - k - 1] = div * ((fr + k) * w[j - k - 2] + (j - k - fr) * w[j - k - 1]);
