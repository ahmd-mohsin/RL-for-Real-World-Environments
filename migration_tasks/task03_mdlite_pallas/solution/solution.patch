+"""Philox4x32-10 counter-based random numbers, bit-identical to the engine's.
+
+key = (seed lo, seed hi), counter = (c0, step lo, step hi, stream).
+"""
+from __future__ import annotations
+
+import jax
+import jax.numpy as jnp
+from jax import lax
+
+STREAM_LANGEVIN, STREAM_GENVEL, STREAM_CSVR, STREAM_CRESCALE = 1, 2, 3, 4
+_M0, _M1, _W0, _W1 = 0xD2511F53, 0xCD9E8D57, 0x9E3779B9, 0xBB67AE85
+_U32 = jnp.uint32
+
+
+def _mulhilo(a, b):
+    p = a.astype(jnp.uint64) * jnp.uint64(b)
+    return (p >> jnp.uint64(32)).astype(_U32), p.astype(_U32)
+
+
+def philox(seed, step, stream, c0):
+    """Arrays (broadcast) -> 4 uint32 arrays. seed/step are uint64 scalars."""
+    seed = jnp.asarray(seed, jnp.uint64)
+    step = jnp.asarray(step, jnp.uint64)
+    k0 = seed.astype(_U32)
+    k1 = (seed >> jnp.uint64(32)).astype(_U32)
+    c0 = jnp.asarray(c0, _U32)
+    x, y, z, w = c0, jnp.broadcast_to(step.astype(_U32), c0.shape), \
+        jnp.broadcast_to((step >> jnp.uint64(32)).astype(_U32), c0.shape), jnp.full(c0.shape, stream, _U32)
+    for _ in range(10):
+        hi0, lo0 = _mulhilo(x, _M0)
+        hi1, lo1 = _mulhilo(z, _M1)
+        x, y, z, w = hi1 ^ y ^ k0, lo1, hi0 ^ w ^ k1, lo0
+        k0 = k0 + _U32(_W0)
+        k1 = k1 + _U32(_W1)
+    return x, y, z, w
+
+
+def uniform53(a, b):
+    return ((a >> _U32(5)).astype(jnp.float64) * 67108864.0 + (b >> _U32(6)).astype(jnp.float64) + 0.5) * (1.0 / 9007199254740992.0)
+
+
+def gauss2(r):
+    x, y, z, w = r
+    u1 = uniform53(x, y)
+    u2 = uniform53(z, w)
+    rad = jnp.sqrt(-2.0 * jnp.log(u1))
+    th = 2.0 * 3.14159265358979323846 * u2
+    return rad * jnp.cos(th), rad * jnp.sin(th)
+
+
+def gauss3(seed, step, stream, n):
+    """(n, 3) normal deviates for atoms 0..n-1 (two Philox blocks per atom)."""
+    a = jnp.arange(n, dtype=_U32)
+    g0, g1 = gauss2(philox(seed, step, stream, _U32(2) * a))
+    g2, _ = gauss2(philox(seed, step, stream, _U32(2) * a + _U32(1)))
+    return jnp.stack([g0, g1, g2], axis=1)
+
+
+# --- sequential stream (thermostat / barostat), usable inside jit
+def _block(seed, step, stream, counter):
+    return philox(seed, step, stream, counter)
+
+
+def stream_uniform(seed, step, stream, counter):
+    x, y, _, _ = _block(seed, step, stream, counter)
+    return uniform53(x, y), counter + _U32(1)
+
+
+def stream_gauss(seed, step, stream, counter):
+    g0, _ = gauss2(_block(seed, step, stream, counter))
+    return g0, counter + _U32(1)
+
+
+def stream_gamma(seed, step, stream, counter, a):
+    """Marsaglia-Tsang gamma deviate (shape a >= 1)."""
+    d = a - 1.0 / 3.0
+    c = 1.0 / jnp.sqrt(9.0 * d)
+
+    def body(st):
+        _, _, ctr = st
+        x, ctr = stream_gauss(seed, step, stream, ctr)
+        t = 1.0 + c * x
+        bad = t <= 0.0
+        v = t * t * t
+        u, ctr2 = stream_uniform(seed, step, stream, ctr)
+        # when t <= 0 the engine draws no uniform for this attempt
+        ctr = jnp.where(bad, ctr, ctr2)
+        vs = jnp.where(bad, 1.0, v)
+        acc = (~bad) & (jnp.log(u) < 0.5 * x * x + d - d * vs + d * jnp.log(vs))
+        return acc, d * vs, ctr
+
+    acc, val, ctr = lax.while_loop(lambda st: ~st[0], body, (jnp.array(False), jnp.float64(0.0), counter))
+    return val, ctr
+
+
+def stream_sum_noises(seed, step, stream, counter, n: int):
+    """Sum of n squared normal deviates (n is static)."""
+    if n == 0:
+        return jnp.float64(0.0), counter
+    if n == 1:
+        g, counter = stream_gauss(seed, step, stream, counter)
+        return g * g, counter
+    if n % 2 == 0:
+        v, counter = stream_gamma(seed, step, stream, counter, 0.5 * n)
+        return 2.0 * v, counter
+    g, counter = stream_gauss(seed, step, stream, counter)
+    v, counter = stream_gamma(seed, step, stream, counter, 0.5 * (n - 1))
+    return 2.0 * v + g * g, counter
+
+
+jax.config.update("jax_enable_x64", True)
