@@ -0,0 +1,194 @@
+"""Run-configuration parsing and validation (mirrors the engine's rules exactly)."""
+from __future__ import annotations
+
+import math
+import re
+from dataclasses import dataclass, field
+
+
+class MdliteError(RuntimeError):
+    """Raised for invalid input and for failures inside the engine."""
+
+
+@dataclass
+class Params:
+    integrator: str = "vv"          # vv | baoab
+    dt: float = 0.002
+    nsteps: int = 0
+    seed: int = 1
+    cutoff: float = 1.0
+    skin: float = 0.1
+    vdw_modifier: str = "potential-shift"
+    rvdw_switch: float = 0.0
+    dispcorr: bool = False
+    coulombtype: str = "pme"        # pme | reaction-field | cutoff
+    epsilon_rf: float = 1.0
+    ewald_rtol: float = 1e-5
+    fourier_spacing: float = 0.12
+    pme_order: int = 4
+    tcoupl: str = "no"              # no | csvr
+    ref_t: float = 300.0
+    tau_t: float = 1.0
+    nsttcouple: int = 10
+    pcoupl: str = "no"              # no | berendsen | c-rescale
+    ref_p: float = 1.0
+    tau_p: float = 2.0
+    compressibility: float = 4.5e-5
+    nstpcouple: int = 10
+    nstcomm: int = 100
+    constraints: bool = True
+    shake_tol: float = 1e-10
+    shake_maxiter: int = 1000
+    gen_vel: bool = False
+    gen_temp: float = 300.0
+    nstenergy: int = 100
+    nstxout: int = 0
+    nstvout: int = 0
+    nstcheckpoint: int = 0
+    raw: dict = field(default_factory=dict)
+
+
+_FLOAT_RE = re.compile(r"^[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?$|^[+-]?(?:inf|infinity|nan)$", re.I)
+_HEX_FLOAT_RE = re.compile(r"^[+-]?0[xX](?:[0-9a-fA-F]+\.?[0-9a-fA-F]*|\.[0-9a-fA-F]+)(?:[pP][+-]?\d+)?$")
+_INT_RE = re.compile(r"^[+-]?\d+$")
+
+
+def _num(key, v):
+    # strtod semantics: decimal or hexadecimal floats; inf/nan are rejected as non-finite
+    if _FLOAT_RE.match(v):
+        d = float(v)
+    elif _HEX_FLOAT_RE.match(v):
+        d = float.fromhex(v)
+    else:
+        raise MdliteError(f"config: '{key}' expects a number, got '{v}'")
+    if not math.isfinite(d):
+        raise MdliteError(f"config: '{key}' expects a number, got '{v}'")
+    return d
+
+
+def _int(key, v):
+    if not _INT_RE.match(v):
+        raise MdliteError(f"config: '{key}' expects an integer, got '{v}'")
+    i = int(v)
+    if not -(2 ** 63) <= i < 2 ** 63:
+        raise MdliteError(f"config: '{key}' expects an integer, got '{v}'")
+    return i
+
+
+def _int32(key, v):
+    # the engine stores these in a 32-bit int after a 64-bit parse (C truncation)
+    i = _int(key, v) & 0xFFFFFFFF
+    return i - (1 << 32) if i >= (1 << 31) else i
+
+
+def _bool(key, v):
+    l = v.lower()
+    if l in ("yes", "true", "on", "1"):
+        return True
+    if l in ("no", "false", "off", "0"):
+        return False
+    raise MdliteError(f"config: '{key}' expects yes/no, got '{v}'")
+
+
+def _enum(key, v, opts):
+    l = v.lower()
+    for name, val in opts:
+        if l == name:
+            return val
+    raise MdliteError(f"config: '{key}' must be one of " + " ".join(n for n, _ in opts) + f", got '{v}'")
+
+
+def _strip(s):
+    return s.strip(" \t\n\r\f\v")
+
+
+def parse(text: str) -> Params:
+    p = Params()
+    for lineno, line in enumerate(text.split("\n"), 1):
+        cut = min([k for k in (line.find("#"), line.find(";")) if k >= 0], default=-1)
+        if cut >= 0:
+            line = line[:cut]
+        line = _strip(line)
+        if not line:
+            continue
+        eq = line.find("=")
+        if eq < 0:
+            raise MdliteError(f"config line {lineno}: expected 'key = value'")
+        key = _strip(line[:eq]).lower().replace("-", "_")
+        val = _strip(line[eq + 1:])
+        if not key or not val:
+            raise MdliteError(f"config line {lineno}: empty key or value")
+        if key in p.raw:
+            raise MdliteError(f"config: duplicate key '{key}'")
+        p.raw[key] = val
+        if key == "integrator": p.integrator = _enum(key, val, [("vv", "vv"), ("baoab", "baoab")])
+        elif key == "dt": p.dt = _num(key, val)
+        elif key == "nsteps": p.nsteps = _int(key, val)
+        elif key == "seed":
+            s = _int(key, val)
+            if s < 0:
+                raise MdliteError("config: 'seed' must be >= 0")
+            p.seed = s
+        elif key == "cutoff": p.cutoff = _num(key, val)
+        elif key == "skin": p.skin = _num(key, val)
+        elif key == "vdw_modifier": p.vdw_modifier = _enum(key, val, [("potential-shift", "potential-shift"), ("force-switch", "force-switch")])
+        elif key == "rvdw_switch": p.rvdw_switch = _num(key, val)
+        elif key == "dispcorr": p.dispcorr = _enum(key, val, [("no", False), ("enerpres", True)])
+        elif key == "coulombtype": p.coulombtype = _enum(key, val, [("pme", "pme"), ("reaction-field", "reaction-field"), ("cutoff", "cutoff")])
+        elif key == "epsilon_rf": p.epsilon_rf = _num(key, val)
+        elif key == "ewald_rtol": p.ewald_rtol = _num(key, val)
+        elif key == "fourier_spacing": p.fourier_spacing = _num(key, val)
+        elif key == "pme_order": p.pme_order = _int32(key, val)
+        elif key == "tcoupl": p.tcoupl = _enum(key, val, [("no", "no"), ("csvr", "csvr"), ("v-rescale", "csvr")])
+        elif key == "ref_t": p.ref_t = _num(key, val)
+        elif key == "tau_t": p.tau_t = _num(key, val)
+        elif key == "nsttcouple": p.nsttcouple = _int32(key, val)
+        elif key == "pcoupl": p.pcoupl = _enum(key, val, [("no", "no"), ("berendsen", "berendsen"), ("c-rescale", "c-rescale")])
+        elif key == "ref_p": p.ref_p = _num(key, val)
+        elif key == "tau_p": p.tau_p = _num(key, val)
+        elif key == "compressibility": p.compressibility = _num(key, val)
+        elif key == "nstpcouple": p.nstpcouple = _int32(key, val)
+        elif key == "nstcomm": p.nstcomm = _int32(key, val)
+        elif key == "constraints": p.constraints = _bool(key, val)
+        elif key == "shake_tol": p.shake_tol = _num(key, val)
+        elif key == "shake_maxiter": p.shake_maxiter = _int32(key, val)
+        elif key == "gen_vel": p.gen_vel = _bool(key, val)
+        elif key == "gen_temp": p.gen_temp = _num(key, val)
+        elif key == "nstenergy": p.nstenergy = _int32(key, val)
+        elif key == "nstxout": p.nstxout = _int32(key, val)
+        elif key == "nstvout": p.nstvout = _int32(key, val)
+        elif key == "nstcheckpoint": p.nstcheckpoint = _int32(key, val)
+        else:
+            raise MdliteError(f"config: unknown key '{key}'")
+    validate(p)
+    return p
+
+
+def validate(p: Params) -> None:
+    def req(ok, msg):
+        if not ok:
+            raise MdliteError("config: " + msg)
+    req(0 < p.dt <= 0.01, "dt must be in (0, 0.01] ps")
+    req(p.nsteps >= 0, "nsteps must be >= 0")
+    req(p.cutoff > 0, "cutoff must be > 0")
+    req(p.skin >= 0, "skin must be >= 0")
+    if p.vdw_modifier == "force-switch":
+        req(0 <= p.rvdw_switch < p.cutoff, "rvdw_switch must be in [0, cutoff) for force-switch")
+    req(p.epsilon_rf == 0 or p.epsilon_rf >= 1, "epsilon_rf must be 0 (infinity) or >= 1")
+    req(0 < p.ewald_rtol < 1, "ewald_rtol must be in (0, 1)")
+    req(p.fourier_spacing > 0, "fourier_spacing must be > 0")
+    req(3 <= p.pme_order <= 8, "pme_order must be in [3, 8]")
+    req(p.ref_t >= 0, "ref_t must be >= 0")
+    req(p.tau_t > 0, "tau_t must be > 0")
+    req(p.nsttcouple >= 1, "nsttcouple must be >= 1")
+    req(p.tau_p > 0, "tau_p must be > 0")
+    req(p.compressibility >= 0, "compressibility must be >= 0")
+    req(p.nstpcouple >= 1, "nstpcouple must be >= 1")
+    req(p.nstcomm >= 0, "nstcomm must be >= 0")
+    req(0 < p.shake_tol < 1e-2, "shake_tol must be in (0, 0.01)")
+    req(p.shake_maxiter >= 1, "shake_maxiter must be >= 1")
+    req(p.gen_temp >= 0, "gen_temp must be >= 0")
+    req(p.nstenergy >= 0 and p.nstxout >= 0 and p.nstvout >= 0 and p.nstcheckpoint >= 0, "output intervals must be >= 0")
+    req(p.nstvout == 0 or p.nstvout == p.nstxout, "nstvout must be 0 or equal to nstxout (velocities are stored in the trajectory frames)")
+    if p.integrator == "baoab":
+        req(p.tcoupl == "no", "the baoab integrator is a Langevin thermostat; use tcoupl = no")
