-    std::vector<int> dist(N, -1);
-    for (int i = 0; i < N; ++i) {
-      if (adj[i].empty()) continue;
-      std::vector<int> touched{i};
-      std::queue<int> q;
-      q.push(i);
-      dist[i] = 0;
-      while (!q.empty()) {
-        int a = q.front(); q.pop();
-        if (dist[a] == s.nrexcl) continue;
-        for (int b : adj[a])
