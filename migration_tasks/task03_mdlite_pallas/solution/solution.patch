-void Simulation::check_box() const {
-  for (int d = 0; d < 3; ++d)
-    if (!(L_[d] >= 2.0 * nl_.rlist))
-      throw Error("box length " + std::to_string(L_[d]) + " nm is smaller than twice the cut-off plus skin (" +
-                  std::to_string(2.0 * nl_.rlist) + " nm)");
-}
