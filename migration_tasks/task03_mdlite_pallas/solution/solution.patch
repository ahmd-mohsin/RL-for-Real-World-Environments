-// its first Box-Muller deviate.
-struct HostStream {
-  uint64_t seed, step;
-  uint32_t stream;
-  uint32_t counter = 0;
-  HostStream(uint64_t seed_, uint64_t step_, uint32_t stream_) : seed(seed_), step(step_), stream(stream_) {}
