index 0000000..6be1930
--- /dev/null
+++ b/mdlite/_constraints.py
@@ -0,0 +1,338 @@
+"""SHAKE / RATTLE as Pallas kernels: one lane per constraint cluster, Gauss-Seidel
+sweeps over the cluster's constraints in topology order (as the engine does),
+until every constraint of the cluster is within tolerance."""
+from __future__ import annotations
+
+import functools
+
+import jax
+import jax.numpy as jnp
+from jax import lax
+from jax.experimental import pallas as pl
+from jax.experimental.pallas import triton as plgpu
+
+F64 = jnp.float64
+BC = 32
+
+
+def _min_image(d, L):
+    return d - L * jnp.floor(d / L + 0.5)
+
+
+def _shake_kernel(tab_ref, ci_ref, cj_ref, cd2_ref, im_ref, xr_ref, p_ref, x_in, v_in, x_ref, v_ref, fail_ref, *, maxc, fix_v):
+    pid = pl.program_id(0)
+    lanes = pid * BC + jnp.arange(BC)
+    L = [p_ref[d] for d in range(3)]
+    tol, inv_dt, maxit = p_ref[3], p_ref[4], p_ref[5]
+    cons = [tab_ref[lanes * maxc + k] for k in range(maxc)]
+
+    def sweep(state):
+        it, active, fail = state
+        done = jnp.ones(BC, jnp.bool_)
+        for k in range(maxc):
+            c = cons[k]
+            ok = (c >= 0) & active
+            cc = jnp.where(ok, c, 0)
+            i, j = ci_ref[cc], cj_ref[cc]
+            d2 = cd2_ref[cc]
+            r = [_min_image(x_ref[i * 3 + d] - x_ref[j * 3 + d], L[d]) for d in range(3)]
+            diff = d2 - (r[0] * r[0] + r[1] * r[1] + r[2] * r[2])
+            need = ok & (jnp.abs(diff) > 2.0 * tol * d2)
+            s = [_min_image(xr_ref[i * 3 + d] - xr_ref[j * 3 + d], L[d]) for d in range(3)]
+            rs = r[0] * s[0] + r[1] * s[1] + r[2] * s[2]
+            bad = need & (rs < 0.1 * d2)
+            fail = jnp.where(bad, 2, fail)
+            need = need & ~bad
+            mi, mj = im_ref[i], im_ref[j]
+            g = jnp.where(need, diff / (2.0 * jnp.where(need, rs, 1.0) * (mi + mj)), 0.0)
+            for d in range(3):
+                plgpu.store(x_ref.at[i * 3 + d], x_ref[i * 3 + d] + g * mi * s[d], mask=need)
+                plgpu.store(x_ref.at[j * 3 + d], x_ref[j * 3 + d] - g * mj * s[d], mask=need)
+                if fix_v:
+                    plgpu.store(v_ref.at[i * 3 + d], v_ref[i * 3 + d] + g * mi * s[d] * inv_dt, mask=need)
+                    plgpu.store(v_ref.at[j * 3 + d], v_ref[j * 3 + d] - g * mj * s[d] * inv_dt, mask=need)
+            done = done & ~need
+            active = active & ~bad
+        active = active & ~done
+        return it + 1, active, fail
+
+    def cond(state):
+        it, active, _ = state
+        return (it < maxit) & (jnp.max(active.astype(jnp.int32)) > 0)
+
+    init = (jnp.int32(0), cons[0] >= 0, jnp.zeros(BC, jnp.int32))
+    _, active, fail = lax.while_loop(cond, sweep, init)
+    fail_ref[pl.ds(pid * BC, BC)] = jnp.where(active & (fail == 0), 1, fail)
+
+
+def _rattle_kernel(tab_ref, ci_ref, cj_ref, cd2_ref, im_ref, x_ref, p_ref, v_in, v_ref, vir_ref, fail_ref, *, maxc):
+    pid = pl.program_id(0)
+    lanes = pid * BC + jnp.arange(BC)
+    L = [p_ref[d] for d in range(3)]
+    tol, dt, maxit = p_ref[3], p_ref[4], p_ref[5]
+    cons = [tab_ref[lanes * maxc + k] for k in range(maxc)]
+
+    def sweep(state):
+        it, active, w = state
+        done = jnp.ones(BC, jnp.bool_)
+        w = list(w)
+        for k in range(maxc):
+            c = cons[k]
+            ok = (c >= 0) & active
+            cc = jnp.where(ok, c, 0)
+            i, j = ci_ref[cc], cj_ref[cc]
+            d2 = cd2_ref[cc]
+            r = [_min_image(x_ref[i * 3 + d] - x_ref[j * 3 + d], L[d]) for d in range(3)]
+            vv = [v_ref[i * 3 + d] - v_ref[j * 3 + d] for d in range(3)]
+            rv = r[0] * vv[0] + r[1] * vv[1] + r[2] * vv[2]
+            need = ok & (jnp.abs(rv) > tol * d2 / dt)
+            mi, mj = im_ref[i], im_ref[j]
+            r2 = r[0] * r[0] + r[1] * r[1] + r[2] * r[2]
+            g = jnp.where(need, -rv / (jnp.where(need, r2, 1.0) * (mi + mj)), 0.0)
+            for d in range(3):
+                plgpu.store(v_ref.at[i * 3 + d], v_ref[i * 3 + d] + g * mi * r[d], mask=need)
+                plgpu.store(v_ref.at[j * 3 + d], v_ref[j * 3 + d] - g * mj * r[d], mask=need)
+            fs = 2.0 * g / dt
+            w[0] = w[0] + r[0] * fs * r[0]; w[1] = w[1] + r[1] * fs * r[1]; w[2] = w[2] + r[2] * fs * r[2]
+            w[3] = w[3] + r[0] * fs * r[1]; w[4] = w[4] + r[0] * fs * r[2]; w[5] = w[5] + r[1] * fs * r[2]
+            done = done & ~need
+        active = active & ~done
+        return it + 1, active, tuple(w)
+
+    def cond(state):
+        it, active, _ = state
+        return (it < maxit) & (jnp.max(active.astype(jnp.int32)) > 0)
+
+    init = (jnp.int32(0), cons[0] >= 0, tuple(jnp.zeros(BC, F64) for _ in range(6)))
+    _, active, w = lax.while_loop(cond, sweep, init)
+    for c in range(6):
+        vir_ref[pl.ds(c * vir_ref.shape[0] // 6 + pid * BC, BC)] = w[c]
+    fail_ref[pl.ds(pid * BC, BC)] = jnp.where(active, 1, 0)
+
+
+# ---------------------------------------------------------------------------
+# register variants for small clusters (<= MAXA_REG atoms): the cluster's atoms
+# are loaded once, iterated in registers in the same Gauss-Seidel order, and
+# stored once.
+MAXA_REG = 4
+
+
+def _sel(vals, idx):
+    out = vals[0]
+    for a in range(1, len(vals)):
+        out = jnp.where(idx == a, vals[a], out)
+    return out
+
+
+def _shake_reg_kernel(atoms_ref, la_ref, lb_ref, cd2_ref, im_ref, xr_ref, p_ref, x_in, v_in, x_ref, v_ref, fail_ref, *, maxa, maxc, fix_v):
+    pid = pl.program_id(0)
+    lanes = pid * BC + jnp.arange(BC)
+    L = [p_ref[d] for d in range(3)]
+    tol, inv_dt, maxit = p_ref[3], p_ref[4], p_ref[5]
+    at = [atoms_ref[lanes * maxa + a] for a in range(maxa)]
+    have = [t >= 0 for t in at]
+    ai = [jnp.where(h, t, 0) for t, h in zip(at, have)]
+    X = [[x_ref[ai[a] * 3 + d] for d in range(3)] for a in range(maxa)]
+    XR = [[xr_ref[ai[a] * 3 + d] for d in range(3)] for a in range(maxa)]
+    V = [[v_ref[ai[a] * 3 + d] for d in range(3)] for a in range(maxa)]
+    IM = [im_ref[ai[a]] for a in range(maxa)]
+    la = [la_ref[lanes * maxc + k] for k in range(maxc)]
+    lb = [lb_ref[lanes * maxc + k] for k in range(maxc)]
+    d2s = [cd2_ref[lanes * maxc + k] for k in range(maxc)]
+    # reference vectors do not change during the iteration
+    S = []
+    for k in range(maxc):
+        S.append([_min_image(_sel([XR[a][d] for a in range(maxa)], la[k]) - _sel([XR[a][d] for a in range(maxa)], lb[k]), L[d])
+                  for d in range(3)])
+    MI = [_sel(IM, la[k]) for k in range(maxc)]
+    MJ = [_sel(IM, lb[k]) for k in range(maxc)]
+
+    def sweep(state):
+        it, active, fail, X, V = state
+        X = [list(r) for r in X]
+        V = [list(r) for r in V]
+        done = jnp.ones(BC, jnp.bool_)
+        for k in range(maxc):
+            ok = (la[k] >= 0) & active
+            d2 = d2s[k]
+            r = [_min_image(_sel([X[a][d] for a in range(maxa)], la[k]) - _sel([X[a][d] for a in range(maxa)], lb[k]), L[d])
+                 for d in range(3)]
+            diff = d2 - (r[0] * r[0] + r[1] * r[1] + r[2] * r[2])
+            need = ok & (jnp.abs(diff) > 2.0 * tol * d2)
+            sv = S[k]
+            rs = r[0] * sv[0] + r[1] * sv[1] + r[2] * sv[2]
+            bad = need & (rs < 0.1 * d2)
+            fail = jnp.where(bad, 2, fail)
+            need = need & ~bad
+            mi, mj = MI[k], MJ[k]
+            g = jnp.where(need, diff / (2.0 * jnp.where(need, rs, 1.0) * (mi + mj)), 0.0)
+            for a in range(maxa):
+                wi = jnp.where(la[k] == a, g * mi, 0.0) - jnp.where(lb[k] == a, g * mj, 0.0)
+                for d in range(3):
+                    X[a][d] = X[a][d] + wi * sv[d]
+                    if fix_v:
+                        V[a][d] = V[a][d] + wi * sv[d] * inv_dt
+            done = done & ~need
+            active = active & ~bad
+        active = active & ~done
+        return it + 1, active, fail, tuple(tuple(r) for r in X), tuple(tuple(r) for r in V)
+
+    def cond(state):
+        return (state[0] < maxit) & (jnp.max(state[1].astype(jnp.int32)) > 0)
+
+    init = (jnp.int32(0), la[0] >= 0, jnp.zeros(BC, jnp.int32), tuple(tuple(r) for r in X), tuple(tuple(r) for r in V))
+    _, active, fail, X, V = lax.while_loop(cond, sweep, init)
+    for a in range(maxa):
+        for d in range(3):
+            plgpu.store(x_ref.at[ai[a] * 3 + d], X[a][d], mask=have[a])
+            if fix_v:
+                plgpu.store(v_ref.at[ai[a] * 3 + d], V[a][d], mask=have[a])
+    fail_ref[pl.ds(pid * BC, BC)] = jnp.where(active & (fail == 0), 1, fail)
+
+
+def _rattle_reg_kernel(atoms_ref, la_ref, lb_ref, cd2_ref, im_ref, x_ref, p_ref, v_in, v_ref, vir_ref, fail_ref, *, maxa, maxc):
+    pid = pl.program_id(0)
+    lanes = pid * BC + jnp.arange(BC)
+    L = [p_ref[d] for d in range(3)]
+    tol, dt, maxit = p_ref[3], p_ref[4], p_ref[5]
+    at = [atoms_ref[lanes * maxa + a] for a in range(maxa)]
+    have = [t >= 0 for t in at]
+    ai = [jnp.where(h, t, 0) for t, h in zip(at, have)]
