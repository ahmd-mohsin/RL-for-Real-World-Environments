+"""Pallas kernels used by the molecular dynamics hot paths.
+
+The kernels deliberately use integer fixed-point output for all pair forces and
+sums.  Besides matching mdlite's historical arithmetic this makes atomics and
+reductions independent of scheduling order.
+"""
+from __future__ import annotations
+from functools import lru_cache
+import math
+import jax
+import jax.numpy as jnp
+from jax import lax
+from jax.experimental import pallas as pl
+from jax.experimental.pallas import triton as pt
+
+F64=jnp.float64; I64=jnp.int64; I32=jnp.int32
+SCALE=4294967296.0; GRID_SCALE=1099511627776.0
+TILE=128
+_CALLS={}
+
+# JAX does not register erfc in the deprecated Pallas-Triton table even though
+# CUDA libdevice supplies it. Register the ordinary device math symbol.
+try:
+    from jax._src.pallas.triton import lowering as _tl
+    _tl.triton_lowering_rules[lax.erfc_p] = _tl._make_dispatch_table(
+        'erfc', cuda=[_tl._Extern([jnp.float32], '__nv_erfcf', jnp.float32),
+                      _tl._Extern([jnp.float64], '__nv_erfc', jnp.float64)],
+        rocm=[_tl._Fallback([jnp.floating], _tl.math_dialect.erfc)])
+except Exception:
+    pass
+
+def _load(ref, idx, mask, other=0): return pt.load(ref.at[idx],mask=mask,other=other)
+def _store(ref, idx, val, mask): pt.store(ref.at[idx],val,mask=mask)
+def rn(x): return jnp.floor(x + 0.5)
+def fixed(x): return rn(x*SCALE).astype(I64)
+def erfc_approx(x):
+    # Abramowitz-Stegun 7.1.26; max absolute error 1.5e-7.
+    t=1.0/(1.0+0.3275911*x)
+    return (((((1.061405429*t-1.453152027)*t+1.421413741)*t-0.284496736)*t+0.254829592)*t)*jnp.exp(-x*x)
+
+@lru_cache(None)
+def _neighbor_call(N,cap,n0,n1,n2,maxex):
+    offsets=[]
+    for n in (n0,n1,n2):
+        offsets.append((-1,0,1) if n>=3 else tuple(range(n)))
+    def kernel(x,L,cell,order,start,end,ex,out_count,out_list):
+        ii=pl.program_id(0)*TILE+jnp.arange(TILE,dtype=I32); valid=ii<N; isafe=jnp.minimum(ii,N-1)
+        xi=_load(x,(isafe,0),valid,0.); yi=_load(x,(isafe,1),valid,0.); zi=_load(x,(isafe,2),valid,0.)
+        ci=_load(cell,isafe,valid,0); cz=ci%n2; cy=(ci//n2)%n1; cx=ci//(n1*n2)
+        cnt=jnp.zeros((TILE,),I32); L0=L[0];L1=L[1];L2=L[2]
+        for ox in offsets[0]:
+          for oy in offsets[1]:
+            for oz in offsets[2]:
+              nb=(((cx+ox+n0)%n0)*n1+(cy+oy+n1)%n1)*n2+(cz+oz+n2)%n2
+              st=_load(start,nb,valid,0); en=_load(end,nb,valid,0); ln=en-st
+              def body(k,cnt):
+                active=valid&(k<ln); pos=jnp.where(active,st+k,0); jj=_load(order,pos,active,0)
+                js=jnp.minimum(jj,N-1)
+                dx=xi-_load(x,(js,0),active,0.);dy=yi-_load(x,(js,1),active,0.);dz=zi-_load(x,(js,2),active,0.)
+                dx-=L0*rn(dx/L0);dy-=L1*rn(dy/L1);dz-=L2*rn(dz/L2)
+                take=active&(jj!=ii)&(dx*dx+dy*dy+dz*dz < (0.0+RLIST2))
+                for e in range(maxex): take &= (_load(ex,(isafe,e),valid,-1)!=jj)
+                _store(out_list,(isafe,jnp.minimum(cnt,cap-1)),jj,take&(cnt<cap))
+                return cnt+take.astype(I32)
+              cnt=lax.fori_loop(0,jnp.max(ln),body,cnt)
+        _store(out_count,isafe,cnt,valid)
+    # patched by wrapper: a closure constant avoids passing a scalar to each program
+    RLIST2=1.0
+    return kernel
+
+def neighbor_search(x,L,cell,order,start,end,exdense,cap,rlist,nc):
+    """Build a full per-atom Verlet list.  Cell sorting is bookkeeping in XLA;
+    candidate search and exclusion filtering are performed by this kernel."""
+    N=x.shape[0]; n0,n1,n2=map(int,nc); maxex=exdense.shape[1]
+    key=('neighbor',N,cap,n0,n1,n2,maxex,float(rlist))
+    if key in _CALLS:return _CALLS[key](x,L,cell,order,start,end,exdense)
+    offsets=[]
+    for n in (n0,n1,n2): offsets.append((-1,0,1) if n>=3 else tuple(range(n)))
+    rl2=float(rlist*rlist)
+    def kernel(x,L,cell,order,start,end,ex,out_count,out_list):
+        ii=pl.program_id(0)*TILE+jnp.arange(TILE,dtype=I32); valid=ii<N; isafe=jnp.minimum(ii,N-1)
+        xyz=[_load(x,(isafe,d),valid,0.) for d in range(3)]
+        ci=_load(cell,isafe,valid,0); cz=ci%n2;cy=(ci//n2)%n1;cx=ci//(n1*n2)
+        cnt=jnp.zeros((TILE,),I32)
+        for ox in offsets[0]:
+          for oy in offsets[1]:
+            for oz in offsets[2]:
+              nb=(((cx+ox+n0)%n0)*n1+(cy+oy+n1)%n1)*n2+(cz+oz+n2)%n2
+              st=_load(start,nb,valid,0);en=_load(end,nb,valid,0);ln=en-st
+              def body(k,cnt):
+                active=valid&(k<ln);pos=jnp.where(active,st+k,0);jj=_load(order,pos,active,0);js=jnp.minimum(jj,N-1)
+                ds=[]
+                for d in range(3):
+                    z=xyz[d]-_load(x,(js,d),active,0.); ld=L[d];ds.append(z-ld*rn(z/ld))
+                take=active&(jj!=ii)&(ds[0]**2+ds[1]**2+ds[2]**2<rl2)
+                for e in range(maxex):take &= (_load(ex,(isafe,e),valid,-1)!=jj)
+                _store(out_list,(isafe,jnp.minimum(cnt,cap-1)),jj,take&(cnt<cap))
+                return cnt+take.astype(I32)
+              cnt=lax.fori_loop(0,jnp.max(ln),body,cnt)
+        _store(out_count,isafe,cnt,valid)
+    out=(jax.ShapeDtypeStruct((N,),I32),jax.ShapeDtypeStruct((N,cap),I32))
+    call=jax.jit(pl.pallas_call(kernel,out_shape=out,grid=((N+TILE-1)//TILE,),name='mdlite_neighbor_search'));_CALLS[key]=call
+    return call(x,L,cell,order,start,end,exdense)
+
+def nonbonded(x,L,count,nblist,types,q,c6,c12,p):
+    """Full-list short-range force kernel, one vector lane per central atom."""
+    N=x.shape[0];cap=nblist.shape[1];nt=c6.shape[0]
+    rc2=float(p['rc2']); coul=int(p['coul']); vdw=int(p['vdw']); beta=float(p.get('beta',0.));krf=float(p.get('krf',0.));crf=float(p.get('crf',0.))
+    sh6=float(p['sh6']);sh12=float(p['sh12']);rsw=float(p.get('rsw',0.));A6=float(p.get('A6',0.));B6=float(p.get('B6',0.));C6=float(p.get('C6',0.));A12=float(p.get('A12',0.));B12=float(p.get('B12',0.));C12=float(p.get('C12',0.))
+    key=('nonbond',N,cap,nt,tuple(sorted((k,float(v)) for k,v in p.items())))
+    if key in _CALLS:return _CALLS[key](x,L,count,nblist,types,q,c6,c12)
+    def kernel(x,L,count,nblist,types,q,c6,c12,of,oa):
+      ii=pl.program_id(0)*TILE+jnp.arange(TILE,dtype=I32);valid=ii<N;isafe=jnp.minimum(ii,N-1)
+      xyz=[_load(x,(isafe,d),valid,0.) for d in range(3)]; qi=_load(q,isafe,valid,0.)*138.935457833; ti=_load(types,isafe,valid,0)
+      nn=_load(count,isafe,valid,0); ff=[jnp.zeros((TILE,),I64) for _ in range(3)];aa=[jnp.zeros((TILE,),I64) for _ in range(8)]
+      def body(k,state):
+        fx,fy,fz,a0,a1,a2,a3,a4,a5,a6,a7=state
+        active=valid&(k<nn);jj=_load(nblist,(isafe,k),active,0);js=jnp.minimum(jj,N-1)
+        ds=[]
+        for d in range(3):
+          z=xyz[d]-_load(x,(js,d),active,0.);ld=L[d];ds.append(z-ld*rn(z/ld))
+        r2=ds[0]**2+ds[1]**2+ds[2]**2; inside=active&(r2<rc2); safe=jnp.where(inside,r2,1.);ri=1/jnp.sqrt(safe);ri2=ri*ri;ri6=ri2*ri2*ri2
+        tj=_load(types,js,active,0); cc6=_load(c6,(ti,tj),active,0.);cc12=_load(c12,(ti,tj),active,0.)
+        if vdw==0:
+          v6=cc6*ri6;v12=cc12*ri6*ri6;elj=(v12-cc12*sh12)-(v6-cc6*sh6); flj=(12*v12-6*v6)*ri2
+        else:
+          r=r2*ri;dr=jnp.maximum(r-rsw,0.);dr2=dr*dr;dr3=dr2*dr
+          f6=6*ri6*ri+A6*dr2+B6*dr3;f12=12*ri6*ri6*ri+A12*dr2+B12*dr3
+          v6=ri6-C6-A6/3*dr3-B6/4*dr3*dr;v12=ri6*ri6-C12-A12/3*dr3-B12/4*dr3*dr
+          elj=cc12*v12-cc6*v6;flj=(cc12*f12-cc6*f6)*ri
+        qq=qi*_load(q,js,active,0.)
+        if coul==0:
+          r=r2*ri;br=beta*r;er=lax.erfc(br);ec=qq*er*ri;fc=qq*(er*ri+1.1283791670955126*beta*jnp.exp(-br*br))*ri2
+        else:
+          ec=qq*(ri+krf*r2-crf);fc=qq*(ri*ri2-2*krf)
+        elj=jnp.where(inside,elj,0.);ec=jnp.where(inside,ec,0.);fs=jnp.where(inside,flj+fc,0.)
+        fp=[fs*z for z in ds]
+        return (fx+fixed(fp[0]),fy+fixed(fp[1]),fz+fixed(fp[2]),
+                a0+fixed(elj),a1+fixed(ec),a2+fixed(ds[0]*fp[0]),a3+fixed(ds[1]*fp[1]),a4+fixed(ds[2]*fp[2]),a5+fixed(ds[0]*fp[1]),a6+fixed(ds[0]*fp[2]),a7+fixed(ds[1]*fp[2]))
+      init=tuple(ff)+tuple(aa); z=lax.fori_loop(0,jnp.max(nn),body,init)
+      for d in range(3):_store(of,(isafe,d),z[d].astype(I64),valid)
+      for a in range(8):_store(oa,(isafe,a),z[3+a],valid)
+    out=(jax.ShapeDtypeStruct((N,3),I64),jax.ShapeDtypeStruct((N,8),I64))
+    call=jax.jit(pl.pallas_call(kernel,out_shape=out,grid=((N+TILE-1)//TILE,),name='mdlite_nonbonded_pairs'));_CALLS[key]=call
+    return call(x,L,count,nblist,types,q,c6,c12)
+
+def bspline_weights(fr,p):
+    w=[jnp.zeros_like(fr) for _ in range(p)];w[1]=fr;w[0]=1-fr
+    for jj in range(3,p):
+      div=1/(jj-1);w[jj-1]=div*fr*w[jj-2]
+      for k in range(1,jj-1):w[jj-k-1]=div*((fr+k)*w[jj-k-2]+(jj-k-fr)*w[jj-k-1])
+      w[0]=div*(1-fr)*w[0]
+    dw=[-w[0]]+[w[j-1]-w[j] for j in range(1,p)]
+    div=1/(p-1);w[p-1]=div*fr*w[p-2]
+    for k in range(1,p-1):w[p-k-1]=div*((fr+k)*w[p-k-2]+(p-k-fr)*w[p-k-1])
+    w[0]=div*(1-fr)*w[0]
+    return w,dw
+
+def pme_spread(x,q,L,shape,p):
+    """Fixed-point cardinal B-spline charge spreading in Pallas.
+
+    Pallas produces the atom/grid contributions; XLA performs the integer
+    scatter reduction because Triton's int64 atomics are unreliable on sm_120.
+    """
