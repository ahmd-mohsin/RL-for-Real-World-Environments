+"""Tiny dependency-free PEP 517 backend for this pure-Python package."""
+from __future__ import annotations
+import base64, csv, hashlib, io, os, tarfile, zipfile
+from pathlib import Path
+NAME='mdlite'; VERSION='1.3.0'; DIST=f'{NAME}-{VERSION}.dist-info'
+
+def _metadata():
+    return ('Metadata-Version: 2.1\nName: mdlite\nVersion: 1.3.0\n'
+            'Summary: Molecular dynamics with JAX and Pallas\nRequires-Python: >=3.10\n'
+            'Requires-Dist: numpy\nRequires-Dist: jax>=0.11\n\n').encode()
+def prepare_metadata_for_build_wheel(metadata_directory,config_settings=None):
+    d=Path(metadata_directory)/DIST;d.mkdir(parents=True,exist_ok=True)
+    (d/'METADATA').write_bytes(_metadata());(d/'WHEEL').write_text('Wheel-Version: 1.0\nGenerator: mdlite\nRoot-Is-Purelib: true\nTag: py3-none-any\n')
+    return DIST
+def build_wheel(wheel_directory,config_settings=None,metadata_directory=None):
+    fn=f'{NAME}-{VERSION}-py3-none-any.whl';path=Path(wheel_directory)/fn; records=[]
+    def put(z,name,data):
+        z.writestr(name,data);h=base64.urlsafe_b64encode(hashlib.sha256(data).digest()).rstrip(b'=').decode();records.append((name,'sha256='+h,str(len(data))))
+    with zipfile.ZipFile(path,'w',zipfile.ZIP_DEFLATED) as z:
+      for p in sorted(Path('mdlite').glob('*.py')):put(z,p.as_posix(),p.read_bytes())
+      put(z,DIST+'/METADATA',_metadata());put(z,DIST+'/WHEEL',b'Wheel-Version: 1.0\nGenerator: mdlite\nRoot-Is-Purelib: true\nTag: py3-none-any\n')
+      put(z,DIST+'/entry_points.txt',b'[console_scripts]\nmdlite = mdlite.cli:main\n')
+      out=io.StringIO();w=csv.writer(out,lineterminator='\n');w.writerows(records+[(DIST+'/RECORD','','')]);z.writestr(DIST+'/RECORD',out.getvalue())
+    return fn
+def build_sdist(sdist_directory,config_settings=None):
+    fn=f'{NAME}-{VERSION}.tar.gz';root=f'{NAME}-{VERSION}'
+    with tarfile.open(Path(sdist_directory)/fn,'w:gz') as t:
+      for p in list(Path('mdlite').glob('*.py'))+[Path('setup.py'),Path('pyproject.toml'),Path('_build.py')]:t.add(p,arcname=root+'/'+p.as_posix())
+    return fn
