-void Simulation::run(long long nsteps) {
-  for (long long k = 0; k < nsteps; ++k) {
-    write_outputs(false);
-    if (cfg_.pcoupl != Pcoupl::None && step_ % cfg_.nstpcouple == 0) barostat();
-    if (cfg_.integrator == Integrator::VV) step_vv();
-    else step_baoab();
-  }
-  write_outputs(true);
-}
