-  compute_forces();
-  kick(v_.p, f_.p, dt_.inv_mass.p, 0.5 * dt, N, s_);
-  if (dt_.nclusters) {
-    for (double& c : cvir_) c = 0;
-    constrain_velocities(cvir_);
-  }
-  if (cfg_.tcoupl == Tcoupl::CSVR && step_ % cfg_.nsttcouple == 0) thermostat_csvr();
