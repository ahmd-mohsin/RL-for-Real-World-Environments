-#define MDL_CUDA(call)                                                                           \
-  do {                                                                                           \
-    cudaError_t err_ = (call);                                                                   \
-    if (err_ != cudaSuccess)                                                                     \
-      throw ::mdl::Error(std::string("CUDA error: ") + cudaGetErrorString(err_) + " at " +      \
-                         __FILE__ + ":" + std::to_string(__LINE__));                            \
-  } while (0)
