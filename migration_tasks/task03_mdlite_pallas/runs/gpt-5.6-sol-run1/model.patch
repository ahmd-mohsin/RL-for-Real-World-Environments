-void Simulation::step_baoab() {
-  int N = sys_.natoms;
-  double dt = cfg_.dt;
-  double scratch[6];
-  kick(v_.p, f_.p, dt_.inv_mass.p, 0.5 * dt, N, s_);
-  constrain_velocities(scratch);
-  MDL_CUDA(cudaMemcpyAsync(xold_.p, x_.p, 3 * (size_t)N * sizeof(double), cudaMemcpyDeviceToDevice, s_));
