@@ -0,0 +1,85 @@
+"""Strict parser for the mdlite run configuration."""
+from __future__ import annotations
+from dataclasses import dataclass, field
+import math
+
+class ConfigError(ValueError): pass
+
+@dataclass
+class Config:
+    integrator:str='vv'; dt:float=.002; nsteps:int=0; seed:int=1
+    cutoff:float=1.; skin:float=.1; vdw_modifier:str='potential-shift'; rvdw_switch:float=0.; dispcorr:bool=False
+    coulombtype:str='pme'; epsilon_rf:float=1.; ewald_rtol:float=1e-5; fourier_spacing:float=.12; pme_order:int=4
+    tcoupl:str='no'; ref_t:float=300.; tau_t:float=1.; nsttcouple:int=10
+    pcoupl:str='no'; ref_p:float=1.; tau_p:float=2.; compressibility:float=4.5e-5; nstpcouple:int=10
+    nstcomm:int=100; constraints:bool=True; shake_tol:float=1e-10; shake_maxiter:int=1000
+    gen_vel:bool=False; gen_temp:float=300.; nstenergy:int=100; nstxout:int=0; nstvout:int=0; nstcheckpoint:int=0
+    raw:dict=field(default_factory=dict)
+
+def _number(k,v):
+    try: x=float(v)
+    except Exception: raise ConfigError(f"config: '{k}' expects a number, got '{v}'")
+    if not math.isfinite(x): raise ConfigError(f"config: '{k}' expects a number, got '{v}'")
+    return x
+
+def _integer(k,v):
+    # strtoll accepts leading whitespace/sign, but no decimal notation.
+    try:
+        if not v.strip() or any(c not in '+-0123456789' for c in v.strip()) or v.strip() in ('+','-'): raise ValueError
+        x=int(v,10)
+        if x < -(1<<63) or x >= (1<<63): raise ValueError
+        return x
+    except Exception: raise ConfigError(f"config: '{k}' expects an integer, got '{v}'")
+
+def _bool(k,v):
+    z=v.lower()
+    if z in ('yes','true','on','1'): return True
+    if z in ('no','false','off','0'): return False
+    raise ConfigError(f"config: '{k}' expects yes/no, got '{v}'")
+
+def _enum(k,v,opts):
+    z=v.lower()
+    if z in opts:return opts[z]
+    raise ConfigError(f"config: '{k}' must be one of {' '.join(opts)}, got '{v}'")
+
+def parse_config(text):
+    c=Config()
+    nums={'dt','cutoff','skin','rvdw_switch','epsilon_rf','ewald_rtol','fourier_spacing','ref_t','tau_t','ref_p','tau_p','compressibility','shake_tol','gen_temp'}
+    ints={'nsteps','seed','pme_order','nsttcouple','nstpcouple','nstcomm','shake_maxiter','nstenergy','nstxout','nstvout','nstcheckpoint'}
+    bools={'constraints','gen_vel'}
+    enums={
+      'integrator':{'vv':'vv','baoab':'baoab'},
+      'vdw_modifier':{'potential-shift':'potential-shift','force-switch':'force-switch'},
+      'dispcorr':{'no':False,'enerpres':True},
+      'coulombtype':{'pme':'pme','reaction-field':'reaction-field','cutoff':'cutoff'},
+      'tcoupl':{'no':'no','csvr':'csvr','v-rescale':'csvr'},
+      'pcoupl':{'no':'no','berendsen':'berendsen','c-rescale':'c-rescale'}}
+    for lineno,line in enumerate(text.splitlines(),1):
+        cut=min([p for p in (line.find('#'),line.find(';')) if p>=0],default=len(line)); line=line[:cut].strip()
+        if not line: continue
+        if '=' not in line: raise ConfigError(f"config line {lineno}: expected 'key = value'")
+        k,v=line.split('=',1); k=k.strip().lower().replace('-','_'); v=v.strip()
+        if not k or not v: raise ConfigError(f"config line {lineno}: empty key or value")
+        if k in c.raw: raise ConfigError(f"config: duplicate key '{k}'")
+        c.raw[k]=v
+        if not hasattr(c,k) or k=='raw': raise ConfigError(f"config: unknown key '{k}'")
+        if k in nums: z=_number(k,v)
+        elif k in ints: z=_integer(k,v)
+        elif k in bools: z=_bool(k,v)
+        elif k in enums: z=_enum(k,v,enums[k])
+        else: raise ConfigError(f"config: unknown key '{k}'")
+        setattr(c,k,z)
+    req=lambda ok,msg: None if ok else (_ for _ in ()).throw(ConfigError('config: '+msg))
+    req(c.dt>0 and c.dt<=.01,'dt must be in (0, 0.01] ps'); req(c.nsteps>=0,'nsteps must be >= 0')
+    req(c.seed>=0,"'seed' must be >= 0"); req(c.cutoff>0,'cutoff must be > 0'); req(c.skin>=0,'skin must be >= 0')
+    if c.vdw_modifier=='force-switch': req(c.rvdw_switch>=0 and c.rvdw_switch<c.cutoff,'rvdw_switch must be in [0, cutoff) for force-switch')
+    req(c.epsilon_rf==0 or c.epsilon_rf>=1,'epsilon_rf must be 0 (infinity) or >= 1')
+    req(0<c.ewald_rtol<1,'ewald_rtol must be in (0, 1)'); req(c.fourier_spacing>0,'fourier_spacing must be > 0')
+    req(3<=c.pme_order<=8,'pme_order must be in [3, 8]'); req(c.ref_t>=0,'ref_t must be >= 0'); req(c.tau_t>0,'tau_t must be > 0')
+    req(c.nsttcouple>=1,'nsttcouple must be >= 1'); req(c.tau_p>0,'tau_p must be > 0'); req(c.compressibility>=0,'compressibility must be >= 0')
+    req(c.nstpcouple>=1,'nstpcouple must be >= 1'); req(c.nstcomm>=0,'nstcomm must be >= 0')
+    req(0<c.shake_tol<1e-2,'shake_tol must be in (0, 0.01)'); req(c.shake_maxiter>=1,'shake_maxiter must be >= 1')
+    req(c.gen_temp>=0,'gen_temp must be >= 0'); req(min(c.nstenergy,c.nstxout,c.nstvout,c.nstcheckpoint)>=0,'output intervals must be >= 0')
+    req(c.nstvout==0 or c.nstvout==c.nstxout,'nstvout must be 0 or equal to nstxout (velocities are stored in the trajectory frames)')
+    if c.integrator=='baoab': req(c.tcoupl=='no','the baoab integrator is a Langevin thermostat; use tcoupl = no')
+    return c
