-  }
-  void upload(const std::vector<T>& h) { upload(h.data(), h.size()); }
-  void download(T* h, size_t count) const {
-    if (count) MDL_CUDA(cudaMemcpy(h, p, count * sizeof(T), cudaMemcpyDeviceToHost));
-  }
-  std::vector<T> to_host() const {
