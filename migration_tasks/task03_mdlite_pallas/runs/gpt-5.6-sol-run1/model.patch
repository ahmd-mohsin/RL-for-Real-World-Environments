-    e.term[T_COUL_RECIP] = e_recip_ + E(A_COUL_EXCL) + self + net;
-  } else {
-    e.term[T_COUL_SR] += E(A_COUL_EXCL) - 0.5 * ONE_4PI_EPS0 * nb_.crf * sum_q2_;
-  }
-  double pot = 0;
-  for (int k = T_LJ; k <= T_DIHEDRAL; ++k) pot += e.term[k];
