-// smallest even n >= max(ceil(L / spacing), 2 * order) whose prime factors are all in {2, 3, 5, 7}
-int pme_grid_size(double L, double spacing, int order) {
-  int n = std::max((int)std::ceil(L / spacing), 2 * order);
-  for (;; ++n) {
-    if (n % 2) continue;
-    int m = n;
-    for (int p : {2, 3, 5, 7})
-      while (m % p == 0) m /= p;
-    if (m == 1) return n;
-  }
-}
