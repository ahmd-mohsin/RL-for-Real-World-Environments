void Simulation::load_checkpoint(const std::string& path) {
  std::ifstream f(path, std::ios::binary);
  if (!f) throw Error("cannot open checkpoint '" + path + "'");
  std::vector<char> buf((std::istreambuf_iterator<char>(f)), 
std::istreambuf_iterator<char>());
  int N = sys_.natoms;
  size_t expect = 8 + 8 + 8 + 24 + 8 + 48 + 8 + 8 + 48 * (size_t)N + 4;
  if (buf.size() < 16 || std::memcmp(buf.data(), CPT_MAGIC, 8) != 0) throw 
Error("checkpoint: bad magic");
  if (buf.size() != expect) throw Error("checkpoint: size does not match the 
system");
  uint32_t crc;
  std::memcpy(&crc, buf.data() + buf.size() - 4, 4);
  if (crc32(reinterpret_cast<const unsigned char*>(buf.data()), buf.size() - 4) 
!= crc) throw Error("checkpoint: checksum mismatch");
  const char* p = buf.data() + 8;
  auto get = [&](void* dst, size_t n) { std::memcpy(dst, p, n); p += n; };
  int64_t st;
  get(&st, 8);
  int32_t hdr[2];
  get(hdr, 8);
  if (hdr[0] != N) throw Error("checkpoint: atom count does not match the 
system");
  double L[3], integral, cvir[6], dt;
  uint64_t seed;
  get(L, 24);
  get(&integral, 8);
  get(cvir, 48);
  get(&seed, 8);
  get(&dt, 8);
  std::vector<double> x(3 * (size_t)N), v(3 * (size_t)N);
  get(x.data(), x.size() * 8);
  get(v.data(), v.size() * 8);
  double Lold[3] = {L_[0], L_[1], L_[2]};
  for (int d = 0; d < 3; ++d) L_[d] = L[d];
  try {
    check_box();
  } catch (...) {
    for (int d = 0; d < 3; ++d) L_[d] = Lold[d];
    throw;
  }
  step_ = st;
  integral_ = integral;
  std::memcpy(cvir_, cvir, sizeof(cvir_));
  MDL_CUDA(cudaMemcpy(x_.p, x.data(), x.size() * 8, cudaMemcpyHostToDevice));
  MDL_CUDA(cudaMemcpy(v_.p, v.data(), v.size() * 8, cudaMemcpyHostToDevice));
  box_changed_ = true;
  forces_valid_ = false;
  cache_valid_ = false;
  last_output_step_ = -1;
  compute_forces();
}

std::string Simulation::info_json() const {
  std::ostringstream o;
  o.precision(17);
  o << "{\"natoms\": " << sys_.natoms << ", \"dof\": " << dof_ << ", 
\"constraints\": " << topo_.ncons
    << ", \"constraint_clusters\": " << dt_.nclusters << ", \"exclusion_pairs\":
" << dt_.nexcl_pairs
    << ", \"rlist\": " << nl_.rlist << ", \"neighbor_builds\": " << nl_.builds 
<< ", \"neighbor_capacity\": " << nl_.cap
    << ", \"cells\": [" << nl_.nc[0] << ", " << nl_.nc[1] << ", " << nl_.nc[2] 
<< "]";
  if (pme_)
    o << ", \"ewald_beta\": " << nb_.beta << ", \"pme_grid\": [" << pme_->n[0] 
<< ", " << pme_->n[1] << ", " << pme_->n[2] << "]";
  else
    o << ", \"ewald_beta\": null, \"pme_grid\": null";
  if (nb_.coul == 1) o << ", \"k_rf\": " << nb_.krf << ", \"c_rf\": " << 
nb_.crf;
  o << "}";
  return o.str();
}

}  // namespace mdl
// C interface of libmdlite, used by the Python package through ctypes.
// Every function returns 0 on success and -1 on failure; mdl_last_error()
// then describes the failure.
#include <cstring>
#include <exception>
#include <string>

#include "simulation.h"

using mdl::Simulation;

namespace {
thread_local std::string g_error;

template <class F>
int guard(F&& f) {
  try {
    f();
    return 0;
  } catch (const std::exception& e) {
    g_error = e.what();
  } catch (...) {
    g_error = "unknown error";
  }
  return -1;
}
Simulation* S(void* h) { return static_cast<Simulation*>(h); }
}  // namespace

extern "C" {

const char* mdl_last_error() { return g_error.c_str(); }
int mdl_term_count() { return mdl::T_COUNT; }
const char* mdl_term_name(int k) { return (k >= 0 && k < mdl::T_COUNT) ? 
mdl::TERM_NAMES[k] : ""; }

void* mdl_create(const char* sys_path, const char* cfg_text, const char* 
out_dir) {
  Simulation* sim = nullptr;
  int rc = guard([&] {
    mdl::System sys = mdl::System::read(sys_path);
    mdl::Config cfg = mdl::Config::parse(cfg_text ? cfg_text : "");
    sim = new Simulation(sys, cfg, out_dir ? out_dir : "");
  });
  return rc == 0 ? sim : nullptr;
}

void mdl_destroy(void* h) { delete S(h); }
int mdl_natoms(void* h) { return S(h)->natoms(); }
long long mdl_step(void* h) { return S(h)->step(); }
int mdl_dof(void* h) { return S(h)->dof(); }
int mdl_run(void* h, long long n) { return guard([&] { S(h)->run(n); }); }
int mdl_finish(void* h) { return guard([&] { S(h)->finish_outputs(); }); }

int mdl_energies(void* h, double* terms, double* virial, double* pressure) {
  return guard([&] {
    const mdl::Energies& e = S(h)->energies();
    std::memcpy(terms, e.term, sizeof(e.term));
    std::memcpy(virial, e.virial, sizeof(e.virial));
    std::memcpy(pressure, e.pressure, sizeof(e.pressure));
  });
}

int mdl_forces(void* h, double* out) { return guard([&] { S(h)->forces(out); });
}
int mdl_get_positions(void* h, double* out) { return guard([&] { 
S(h)->get_positions(out); }); }
int mdl_get_velocities(void* h, double* out) { return guard([&] { 
S(h)->get_velocities(out); }); }
int mdl_set_positions(void* h, const double* in) { return guard([&] { 
S(h)->set_positions(in); }); }
int mdl_set_velocities(void* h, const double* in) { return guard([&] { 
S(h)->set_velocities(in); }); }
int mdl_get_box(void* h, double* out) {
  return guard([&] { std::memcpy(out, S(h)->box(), 3 * sizeof(double)); });
}
int mdl_set_box(void* h, const double* in) { return guard([&] { 
S(h)->set_box(in); }); }
int mdl_save_checkpoint(void* h, const char* path) { return guard([&] { 
S(h)->save_checkpoint(path); }); }
int mdl_load_checkpoint(void* h, const char* path) { return guard([&] { 
S(h)->load_checkpoint(path); }); }
int mdl_info(void* h, char* buf, int n) {
  return guard([&] {
    std::string s = S(h)->info_json();
    if ((int)s.size() + 1 > n) throw std::runtime_error("info buffer too 
small");
    std::memcpy(buf, s.c_str(), s.size() + 1);
  });
}

}  // extern "C"

