switched to zero between rsw and rc
    41      double r = r2 * rinv;
    42      double f6 = 6.0 * rinv6 * rinv, f12 = 12.0 * rinv6 * rinv6 * rinv;
    43      double v6 = rinv6 - p.fsw_C6, v12 = rinv6 * rinv6 - p.fsw_C12;
    44      if (r > p.rsw) {
