   424  void Simulation::barostat() {
   425    const Energies& e = energies();
   426    double P = e.term[T_PRESSURE];
   427    double V = L_[0] * L_[1] * L_[2];
   428    double cf = cfg_.compressibility * cfg_.nstpcouple * cfg_.dt / 
cfg_.tau_p;
   429    double mu;
   430    if (cfg_.pcoupl == Pcoupl::Berendsen) {
   431      mu = std::cbrt(1.0 - cf * (cfg_.ref_p - P));
   432    } else {
