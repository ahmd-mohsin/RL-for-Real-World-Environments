"""Philox4x32-10 streams used by mdlite (host and JAX forms)."""
import math
import numpy as np
import jax.numpy as jnp
MASK=0xffffffff

def philox_host(seed,step,stream,c0):
    c=[c0&MASK,step&MASK,(step>>32)&MASK,stream&MASK];k0=seed&MASK;k1=(seed>>32)
&MASK
    for _ in range(10):
      p0=0xD2511F53*c[0];p1=0xCD9E8D57*c[2]
      c=[((p1>>32)^c[1]^k0)&MASK,p1&MASK,((p0>>32)^c[3]^k1)&MASK,p0&MASK]
      k0=(k0+0x9E3779B9)&MASK;k1=(k1+0xBB67AE85)&MASK
    return c

def uniform53(r,a=0,b=1):return 
((r[a]>>5)*67108864.0+(r[b]>>6)+.5)/9007199254740992.0
def gauss2_host(r):
    u1=uniform53(r);u2=uniform53(r,2,3);rad=math.sqrt(-2*math.log(u1));th=2*math
.pi*u2
    return rad*math.cos(th),rad*math.sin(th)
class HostStream:
    def 
__init__(self,seed,step,stream):self.seed=seed;self.step=step;self.stream=stream
;self.counter=0
    def 
block(self):r=philox_host(self.seed,self.step,self.stream,self.counter);self.cou
nter+=1;return r
    def uniform(self):return uniform53(self.block())
    def gauss(self):return gauss2_host(self.block())[0]
    def gamma(self,a):
      d=a-1/3;c=1/math.sqrt(9*d)
      while True:
        x=self.gauss();t=1+c*x
        if t<=0:continue
        v=t*t*t;u=self.uniform()
        if math.log(u)<.5*x*x+d-d*v+d*math.log(v):return d*v
    def sum_noises(self,n):
      if n==0:return 0.
      if n==1:
        g=self.gauss();return g*g
      if n%2==0:return 2*self.gamma(.5*n)
      g=self.gauss();return 2*self.gamma(.5*(n-1))+g*g

def philox_jax(seed,step,stream,c0):
    U=jnp.uint64; W=jnp.uint32
    c0=c0.astype(W); 
c1=jnp.full_like(c0,W(step&0xffffffff));c2=jnp.full_like(c0,W((step>>32)&0xfffff
fff));c3=jnp.full_like(c0,W(stream));k0=W(seed&0xffffffff);k1=W((seed>>32)&0xfff
fffff)
