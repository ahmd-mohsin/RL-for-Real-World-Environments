   187    pme.beta = beta;
   188    for (int d = 0; d < 3; ++d) {
   189      pme.n[d] = n[d];
   190      pme.bmod[d].upload(bspline_moduli(n[d], order));
   191    }
   192    size_t nreal = (size_t)n[0] * n[1] * n[2];
   193    size_t ncplx = (size_t)n[0] * n[1] * (n[2] / 2 + 1);
   194    pme.qgrid_fixed.resize(nreal);
   195    pme.grid.resize(nreal);
   196    pme.kgrid.resize(ncplx);
   197    pme.red.resize(7 * (size_t)blocks_for(ncplx, RED_THREADS));
   198    if (pme.fwd) cufftDestroy(pme.fwd);
   199    if (pme.bwd) cufftDestroy(pme.bwd);
   200    if (cufftPlan3d(&pme.fwd, n[0], n[1], n[2], CUFFT_D2Z) != 
CUFFT_SUCCESS ||
   201        cufftPlan3d(&pme.bwd, n[0], n[1], n[2], CUFFT_Z2D) != 
CUFFT_SUCCESS)
