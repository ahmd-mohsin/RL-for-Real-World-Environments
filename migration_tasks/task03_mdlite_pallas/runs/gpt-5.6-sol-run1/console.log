   124  __global__ void k_gather(const double* x, const double* q, int N, double
L0, double L1, double L2, int n0, int n1, int n2, int p,
   125                           const double* phi, long long* f) {
   126    int i = blockIdx.x * blockDim.x + threadIdx.x;
   127    if (i >= N) return;
   128    double qi = q[i];
   129    if (qi == 0.0) return;
   130    double fr[3], w[3][MAXORD], dw[3][MAXORD];
   131    int k0 = grid_base(x[3 * i], L0, n0, fr[0]);
   132    int k1 = grid_base(x[3 * i + 1], L1, n1, fr[1]);
   133    int k2 = grid_base(x[3 * i + 2], L2, n2, fr[2]);
   134    for (int d = 0; d < 3; ++d) bspline(fr[d], p, w[d], dw[d]);
   135    double gx = 0, gy = 0, gz = 0;
   136    for (int a = 0; a < p; ++a) {
   137      int ix = (k0 + a) % n0;
   138      for (int b = 0; b < p; ++b) {
   139        int iy = (k1 + b) % n1;
   140        const double* row = phi + ((size_t)ix * n1 + iy) * n2;
   141        for (int c = 0; c < p; ++c) {
   142          double ph = row[(k2 + c) % n2];
   143          gx += dw[0][a] * w[1][b] * w[2][c] * ph;
   144          gy += w[0][a] * dw[1][b] * w[2][c] * ph;
   145          gz += w[0][a] * w[1][b] * dw[2][c] * ph;
   146        }
   147      }
   148    }
   149    f[3 * i] += to_fixed(-qi * gx * n0 / L0, FORCE_SCALE);
   150    f[3 * i + 1] += to_fixed(-qi * gy * n1 / L1, FORCE_SCALE);
   151    f[3 * i + 2] += to_fixed(-qi * gz * n2 / L2, FORCE_SCALE);
   152  }
