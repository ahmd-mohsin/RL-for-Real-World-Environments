      a[4] += to_fixed(dz * fpz, VIRIAL_SCALE);
      a[5] += to_fixed(dx * fpy, VIRIAL_SCALE);
      a[6] += to_fixed(dx * fpz, VIRIAL_SCALE);
      a[7] += to_fixed(dy * fpz, VIRIAL_SCALE);
