    69  // Sequential host-side stream for the global (per-system) random 
numbers of
    70  // the thermostat and barostat. Each Philox block is consumed whole: 
uniform()
    71  // takes words (x, y) of a fresh block, gauss() takes a fresh block and 
returns
    72  // its first Box-Muller deviate.
    73  struct HostStream {
    74    uint64_t seed, step;
    75    uint32_t stream;
    76    uint32_t counter = 0;
    77    HostStream(uint64_t seed_, uint64_t step_, uint32_t stream_) : 
seed(seed_), step(step_), stream(stream_) {}
    78    double uniform() {
    79      U4 r = philox(seed, step, stream, counter++);
    80      return uniform53(r.x, r.y);
    81    }
    82    double gauss() {
    83      double g0, g1;
    84      gauss2(philox(seed, step, stream, counter++), g0, g1);
    85      return g0;
    86    }
    87    // Marsaglia-Tsang gamma deviate with shape a >= 1 and unit scale
    88    double gamma(double a) {
    89      const double d = a - 1.0 / 3.0;
    90      const double c = 1.0 / std::sqrt(9.0 * d);
    91      for (;;) {
    92        double x = gauss();
    93        double t = 1.0 + c * x;
    94        if (t <= 0.0) continue;
    95        double v = t * t * t;
    96        double u = uniform();
    97        if (std::log(u) < 0.5 * x * x + d - d * v + d * std::log(v)) 
return d * v;
    98      }
    99    }
   100    // sum of n squared standard normal deviates (Bussi's 
resamplekin_sumnoises)
   101    double sum_noises(long long n) {
   102      if (n == 0) return 0.0;
   103      if (n == 1) { double g = gauss(); return g * g; }
   104      if (n % 2 == 0) return 2.0 * gamma(0.5 * (double)n);
   105      double g = gauss();
   106      return 2.0 * gamma(0.5 * (double)(n - 1)) + g * g;
   107    }
   108  };
