void kick(double* v, const long long* f, const double* inv_mass, double half_dt,
int N, cudaStream_t s);
void drift(double* x, const double* v, double h, int N, cudaStream_t s);
void langevin_o(double* v, const double* inv_mass, double c1, double c2, double 
kT, uint64_t seed, uint64_t step, int N, cudaStream_t s);
void scale_velocities(double* v, double lambda, int N, cudaStream_t s);
// kinetic energy tensor diagonal + off-diagonal (6) and total momentum (3) and 
total mass, deterministic order
void kinetic(const double* v, const double* mass, int N, double ke6[6], double 
mom[3], cudaStream_t s);
void remove_com(double* v, const double com_v[3], int N, cudaStream_t s);
