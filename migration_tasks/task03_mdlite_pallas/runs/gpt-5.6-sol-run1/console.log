"""Python interface to the mdlite engine."""
from __future__ import annotations

import ctypes
import json
import os
import tempfile
from pathlib import Path

import numpy as np

from ._lib import lib, ptr
from .config import config_text
from .system import System, load_system

TERMS = tuple(lib.mdl_term_name(k).decode() for k in 
range(lib.mdl_term_count()))


class MdliteError(RuntimeError):
    """Raised for invalid input and for failures inside the engine."""


def _check(rc):
    if rc != 0:
        raise MdliteError(lib.mdl_last_error().decode())


class Simulation:
    """A molecular dynamics simulation on the GPU.

    ``system``      a :class:`System` or a path to a ``.mdsys`` file
    ``config``      dict, ``key = value`` text, or a path to a config file
    ``output_dir``  if given, ``energy.csv``, ``traj.mdtrj`` and periodic 
checkpoints are written there
    """

    def __init__(self, system, config=None, output_dir=None):
        text = config_text(config)
        if isinstance(system, System):
            fd, tmp = tempfile.mkstemp(suffix=".mdsys")
            os.close(fd)
            try:
                system.save(tmp)
                h = lib.mdl_create(tmp.encode(), text.encode(), str(output_dir 
or "").encode())
            finally:
                os.unlink(tmp)
            self.system = system
        else:
            h = lib.mdl_create(str(system).encode(), text.encode(), 
str(output_dir or "").encode())
            self.system = load_system(system) if h else None
        if not h:
            raise MdliteError(lib.mdl_last_error().decode())
        self._h = h
        self.natoms = lib.mdl_natoms(h)
        self.output_dir = Path(output_dir) if output_dir else None

    # --- lifecycle
    def close(self):
        if getattr(self, "_h", None):
            lib.mdl_destroy(self._h)
            self._h = None

    def __del__(self):
        self.close()

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()

    # --- state
    @property
    def step(self) -> int:
        return int(lib.mdl_step(self._h))

    @property
    def dof(self) -> int:
        return int(lib.mdl_dof(self._h))

    @property
    def positions(self) -> np.ndarray:
        a = np.empty((self.natoms, 3))
        _check(lib.mdl_get_positions(self._h, ptr(a)))
        return a

    @positions.setter
    def positions(self, x):
        a = np.ascontiguousarray(x, dtype=np.float64)
        if a.shape != (self.natoms, 3):
            raise MdliteError(f"positions must have shape ({self.natoms}, 3)")
        _check(lib.mdl_set_positions(self._h, ptr(a)))

    @property
    def velocities(self) -> np.ndarray:
        a = np.empty((self.natoms, 3))
        _check(lib.mdl_get_velocities(self._h, ptr(a)))
        return a

    @velocities.setter
    def velocities(self, v):
        a = np.ascontiguousarray(v, dtype=np.float64)
        if a.shape != (self.natoms, 3):
            raise MdliteError(f"velocities must have shape ({self.natoms}, 3)")
        _check(lib.mdl_set_velocities(self._h, ptr(a)))

    @property
    def box(self) -> np.ndarray:
        a = np.empty(3)
        _check(lib.mdl_get_box(self._h, ptr(a)))
        return a

    @box.setter
    def box(self, L):
        a = np.ascontiguousarray(L, dtype=np.float64).reshape(3)
        _check(lib.mdl_set_box(self._h, ptr(a)))

    @property
    def info(self) -> dict:
        buf = ctypes.create_string_buffer(4096)
        _check(lib.mdl_info(self._h, buf, len(buf)))
        return json.loads(buf.value.decode())

    # --- computation
    def run(self, nsteps: int) -> None:
        if int(nsteps) < 0:
            raise MdliteError("nsteps must be >= 0")
        _check(lib.mdl_run(self._h, int(nsteps)))

    def finish(self) -> None:
        """Write the outputs of the current step (if due) and flush the output 
files."""
        _check(lib.mdl_finish(self._h))

    def forces(self) -> np.ndarray:
        a = np.empty((self.natoms, 3))
        _check(lib.mdl_forces(self._h, ptr(a)))
        return a

    def energies(self) -> dict:
        """Energy terms (kJ/mol), temperature (K), pressure (bar), volume 
(nm^3),
        plus ``virial`` (sum of r_ij (x) f_ij, kJ/mol) and ``pressure_tensor`` 
(bar) as 3x3 arrays."""
        t = np.empty(len(TERMS))
        vir = np.empty(9)
        pres = np.empty(9)
        _check(lib.mdl_energies(self._h, ptr(t), ptr(vir), ptr(pres)))
        out = {name: float(val) for name, val in zip(TERMS, t)}
        out["virial"] = vir.reshape(3, 3)
        out["pressure_tensor"] = pres.reshape(3, 3)
        return out

    # --- checkpoints
    def save_checkpoint(self, path) -> None:
        _check(lib.mdl_save_checkpoint(self._h, str(path).encode()))

    def load_checkpoint(self, path) -> None:
        _check(lib.mdl_load_checkpoint(self._h, str(path).encode()))
"""ctypes binding of libmdlite.so (built from ``src/`` by setup.py)."""
from __future__ import annotations

import ctypes
import os
from pathlib import Path

_c_double_p = ctypes.POINTER(ctypes.c_double)


def _load():
    here = Path(__file__).resolve().parent
    cands = [os.environ.get("MDLITE_LIBRARY", ""), str(here / "libmdlite.so")]
    for c in cands:
        if c and Path(c).exists():
            lib = ctypes.CDLL(c)
            break
    else:
        raise ImportError("libmdlite.so not found; build mdlite with `pip 
install .`")
    vp, cp, i, ll = ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int, 
ctypes.c_longlong
    sig = {
        "mdl_last_error": (cp, []),
        "mdl_term_count": (i, []),
        "mdl_term_name": (cp, [i]),
        "mdl_create": (vp, [cp, cp, cp]),
        "mdl_destroy": (None, [vp]),
        "mdl_natoms": (i, [vp]),
        "mdl_step": (ll, [vp]),
        "mdl_dof": (i, [vp]),
        "mdl_run": (i, [vp, ll]),
        "mdl_finish": (i, [vp]),
        "mdl_energies": (i, [vp, _c_double_p, _c_double_p, _c_double_p]),
        "mdl_forces": (i, [vp, _c_double_p]),
        "mdl_get_positions": (i, [vp, _c_double_p]),
        "mdl_get_velocities": (i, [vp, _c_double_p]),
        "mdl_set_positions": (i, [vp, _c_double_p]),
        "mdl_set_velocities": (i, [vp, _c_double_p]),
        "mdl_get_box": (i, [vp, _c_double_p]),
        "mdl_set_box": (i, [vp, _c_double_p]),
        "mdl_save_checkpoint": (i, [vp, cp]),
        "mdl_load_checkpoint": (i, [vp, cp]),
        "mdl_info": (i, [vp, ctypes.c_char_p, i]),
    }
    for name, (res, args) in sig.items():
        fn = getattr(lib, name)
        fn.restype = res
        fn.argtypes = args
    return lib


lib = _load()


def ptr(a):
    return a.ctypes.data_as(_c_double_p)
"""``mdlite`` command line.

    mdlite run  -s system.mdsys -c run.cfg -o outdir [--checkpoint state.mdcpt] 
[--nsteps N]
    mdlite info -s system.mdsys -c run.cfg
    mdlite energy -s system.mdsys -c run.cfg      # energies of the initial 
state as JSON
"""
from __future__ import annotations

import argparse
import json
import sys
import time
from pathlib import Path

from .config import config_text, read_config


def run_simulation(system, config, output_dir, checkpoint=None, nsteps=None):
    from .simulation import Simulation

    out = Path(output_dir)
    out.mkdir(parents=True, exist_ok=True)
    text = config_text(config)
    sim = Simulation(system, text, output_dir=out)
    try:
        if checkpoint:
            sim.load_checkpoint(checkpoint)
        if nsteps is None:
            cfg = {}
            for line in text.splitlines():
                for c in "#;":
                    line = line.split(c, 1)[0]
                if "=" in line:
                    k, _, v = line.partition("=")
                    cfg[k.strip().lower().replace("-", "_")] = v.strip()
            nsteps = int(cfg.get("nsteps", "0"))
        t0 = time.perf_counter()
        sim.run(nsteps)
        elapsed = time.perf_counter() - t0
        sim.save_checkpoint(out / "final.mdcpt")
        info = sim.info
        info.update({"steps": int(nsteps), "final_step": sim.step, "seconds": 
elapsed,
                     "steps_per_second": nsteps / elapsed if elapsed > 0 else 
None})
        (out / "log.json").write_text(json.dumps(info, indent=2) + "\n")
        return info
    finally:
        sim.close()


def main(argv=None):
    ap = argparse.ArgumentParser(prog="mdlite")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("-s", "--system", required=True)
    r.add_argument("-c", "--config", required=True)
    r.add_argument("-o", "--output", required=True)
    r.add_argument("--checkpoint")
    r.add_argument("--nsteps", type=int)
    for name in ("info", "energy"):
        p = sub.add_parser(name)
        p.add_argument("-s", "--system", required=True)
        p.add_argument("-c", "--config", required=True)
    a = ap.parse_args(argv)
    from .simulation import MdliteError, Simulation
    try:
        if a.cmd == "run":
            info = run_simulation(a.system, Path(a.config), a.output, 
checkpoint=a.checkpoint, nsteps=a.nsteps)
            print(json.dumps(info))
        else:
            with Simulation(a.system, Path(a.config)) as sim:
                if a.cmd == "info":
                    print(json.dumps(sim.info))
                else:
                    e = sim.energies()
                    print(json.dumps({k: v for k, v in e.items() if 
isinstance(v, float)}))
    except MdliteError as e:
        print(f"mdlite: error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
