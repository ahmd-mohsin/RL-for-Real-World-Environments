   424  void Simulation::barostat() {
   425    const Energies& e = energies();
   426    double P = e.term[T_PRESSURE];
   427    double V = L_[0] * L_[1] * L_[2];
   428    double cf = cfg_.compressibility * cfg_.nstpcouple * cfg_.dt / 
cfg_.tau_p;
   429    double mu;
   430    if (cfg_.pcoupl == Pcoupl::Berendsen) {
   431      mu = std::cbrt(1.0 - cf * (cfg_.ref_p - P));
   432    } else {
   433      // Bernetti & Bussi, J. Chem. Phys. 153, 114107 (2020), isotropic
   434      double kT_bar = BOLTZ * cfg_.ref_t * PRESFAC / V;
   435      HostStream rs(cfg_.seed, (uint64_t)step_, STREAM_CRESCALE);
   436      double g = rs.gauss();
   437      double deps = -cf * (cfg_.ref_p - P - kT_bar) + std::sqrt(2.0 * 
kT_bar * cf) * g;
   438      mu = std::exp(deps / 3.0);
   439    }
   440    double Lold[3] = {L_[0], L_[1], L_[2]};
   441    scale_molecules(dt_, x_.p, mu, Lold, s_);
   442    for (double& L : L_) L *= mu;
   443    if (cfg_.pcoupl == Pcoupl::CRescale) {
   444      double K0 = e.term[T_KINETIC];
   445      scale_velocities(v_.p, 1.0 / mu, sys_.natoms, s_);
   446      integral_ -= K0 / (mu * mu) - K0;
   447    }
   448    box_changed_ = true;
   449    forces_valid_ = false;
   450    cache_valid_ = false;
   451    compute_forces();
   452  }
   453  
   454  void Simulation::run(long long nsteps) {
   455    for (long long k = 0; k < nsteps; ++k) {
   456      write_outputs(false);
   457      if (cfg_.pcoupl != Pcoupl::None && step_ % cfg_.nstpcouple == 0) 
barostat();
   458      if (cfg_.integrator == Integrator::VV) step_vv();
   459      else step_baoab();
   460    }
   461    write_outputs(true);
   462  }
   463  
   464  void Simulation::finish_outputs() { write_outputs(true); }
   465  
   466  void Simulation::write_outputs(bool final_call) {
   467    if (out_dir_.empty() || last_output_step_ == step_) {
   468      if (final_call && energy_file_) std::fflush(energy_file_);
   469      return;
   470    }
   471    last_output_step_ = step_;
   472    if (cfg_.nstenergy > 0 && step_ % cfg_.nstenergy == 0) 
write_energy_row(energies());
   473    if (traj_file_ && step_ % cfg_.nstxout == 0) write_frame();
   474    if (cfg_.nstcheckpoint > 0 && step_ % cfg_.nstcheckpoint == 0)
   475      save_checkpoint(out_dir_ + "/state_" + std::to_string(step_) + 
".mdcpt");
   476    if (final_call) {
   477      if (energy_file_) std::fflush(energy_file_);
   478      if (traj_file_) std::fflush(traj_file_);
   479    }
   480  }
