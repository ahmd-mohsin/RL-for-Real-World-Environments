def pme_spread(x,q,L,shape,p):
    """Fixed-point cardinal B-spline charge spreading (Pallas atomics)."""
    N=x.shape[0];n0,n1,n2=shape;nreal=n0*n1*n2;key=('spread_scalar',N,shape,p)
    if key in _CALLS:return 
_CALLS[key](jnp.zeros((nreal,),I64),x,q,L).reshape(shape)
    def kernel(grid,x,q,L,out):
      ii=pl.program_id(0)+jnp.arange(1,dtype=I32);valid=ii<N;isafe=jnp.minimum(i
i,N-1);qq=_load(q,isafe,valid,0.)
      bases=[];ws=[]
      for d,n in enumerate(shape):
        xx=_load(x,(isafe,d),valid,0.);s=xx/L[d]-jnp.floor(xx/L[d]);u=s*n;k=jnp.
floor(u).astype(I32);bases.append(k);ws.append(bspline_weights(u-k,p)[0])
      for a in range(p):
       for b in range(p):
        for c in range(p):
          ind=(((bases[0]+a)%n0)*n1+(bases[1]+b)%n1)*n2+(bases[2]+c)%n2
          pt.atomic_add(out,ind,rn(qq*ws[0][a]*ws[1][b]*ws[2][c]*GRID_SCALE).ast
ype(I64),mask=valid&(qq!=0))
    zero=jnp.zeros((nreal,),I64)
    call=pl.pallas_call(kernel,out_shape=jax.ShapeDtypeStruct((nreal,),I64),grid
=(N,),input_output_aliases={0:0},name='mdlite_pme_charge_spread')
    call=jax.jit(call);_CALLS[key]=call
    return call(zero,x,q,L).reshape(shape)

def pme_gather(x,q,L,phi,p):
    """B-spline electric-field interpolation from the PME mesh."""
    N=x.shape[0];shape=phi.shape;n0,n1,n2=shape;flat=phi.reshape(-1);key=('gathe
r',N,shape,p)
    if key in _CALLS:return _CALLS[key](x,q,L,flat)

