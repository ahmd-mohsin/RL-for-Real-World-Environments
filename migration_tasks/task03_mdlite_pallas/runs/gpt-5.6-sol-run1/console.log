   154  // cardinal B-spline M_p(x) by the recursion M_n(x) = x/(n-1) M_{n-1}(x)
+ (n-x)/(n-1) M_{n-1}(x-1)
   155  double bspline_M(int n, double x) {
   156    if (n == 2) return (x < 0 || x > 2) ? 0.0 : 1.0 - std::fabs(x - 1.0);
   157    return x / (n - 1) * bspline_M(n - 1, x) + (n - x) / (n - 1) * 
bspline_M(n - 1, x - 1.0);
   158  }
   159  
   160  std::vector<double> bspline_moduli(int n, int p) {
   161    std::vector<double> mod(n);
   162    for (int k = 0; k < n; ++k) {
   163      double re = 0, im = 0;
   164      for (int j = 0; j <= p - 2; ++j) {
   165        double m = bspline_M(p, j + 1.0);
   166        double arg = 2.0 * PI * j * k / n;
   167        re += m * std::cos(arg);
   168        im += m * std::sin(arg);
   169      }
   170      mod[k] = re * re + im * im;
   171    }
   172    // odd orders have zeros at the Nyquist frequency; interpolate as in 
AMBER / GROMACS
   173    for (int k = 0; k < n; ++k)
   174      if (mod[k] < 1e-7) mod[k] = 0.5 * (mod[(k - 1 + n) % n] + mod[(k + 
1) % n]);
   175    return mod;
   176  }
