// mdlite run configuration ("key = value" text, '#' and ';' start comments).
#pragma once

#include <cstdint>
#include <map>
#include <string>

namespace mdl {

enum class Integrator { VV, BAOAB };
enum class VdwModifier { PotentialShift, ForceSwitch };
enum class Coulomb { PME, ReactionField, Cutoff };
enum class Tcoupl { None, CSVR };
enum class Pcoupl { None, Berendsen, CRescale };

struct Config {
  Integrator integrator = Integrator::VV;
  double dt = 0.002;
  long long nsteps = 0;
  uint64_t seed = 1;

  double cutoff = 1.0;  // nonbonded cut-off (LJ and Coulomb), nm
  double skin = 0.1;    // Verlet buffer, nm
  VdwModifier vdw_modifier = VdwModifier::PotentialShift;
  double rvdw_switch = 0.0;
  bool dispcorr = false;

  Coulomb coulombtype = Coulomb::PME;
  double epsilon_rf = 1.0;  // 0 means infinity
  double ewald_rtol = 1e-5;
  double fourier_spacing = 0.12;
  int pme_order = 4;

  Tcoupl tcoupl = Tcoupl::None;
  double ref_t = 300.0;
  double tau_t = 1.0;
  int nsttcouple = 10;

  Pcoupl pcoupl = Pcoupl::None;
  double ref_p = 1.0;
  double tau_p = 2.0;
  double compressibility = 4.5e-5;
  int nstpcouple = 10;

  int nstcomm = 100;
  bool constraints = true;
  double shake_tol = 1e-10;
  int shake_maxiter = 1000;

  bool gen_vel = false;
  double gen_temp = 300.0;

  int nstenergy = 100;
  int nstxout = 0;
  int nstvout = 0;
  int nstcheckpoint = 0;

  std::map<std::string, std::string> raw;  // as given, for the log

  static Config parse(const std::string& text);
  void validate() const;
};

}  // namespace mdl
#include "config.h"

#include <algorithm>
#include <cctype>
#include <cerrno>
#include <cmath>
#include <cstdlib>
#include <sstream>

#include "common.cuh"

namespace mdl {
namespace {

std::string trim(const std::string& s) {
  size_t a = 0, b = s.size();
  while (a < b && std::isspace((unsigned char)s[a])) ++a;
  while (b > a && std::isspace((unsigned char)s[b - 1])) --b;
  return s.substr(a, b - a);
}

std::string lower(std::string s) {
  for (auto& c : s) c = (char)std::tolower((unsigned char)c);
  return s;
}

double to_double(const std::string& key, const std::string& v) {
  char* end = nullptr;
  errno = 0;
  double d = std::strtod(v.c_str(), &end);
  if (end == v.c_str() || *end != '\0' || errno == ERANGE || !std::isfinite(d))
    throw Error("config: '" + key + "' expects a number, got '" + v + "'");
  return d;
}

long long to_int(const std::string& key, const std::string& v) {
  char* end = nullptr;
  errno = 0;
  long long i = std::strtoll(v.c_str(), &end, 10);
  if (end == v.c_str() || *end != '\0' || errno == ERANGE)
    throw Error("config: '" + key + "' expects an integer, got '" + v + "'");
  return i;
}

bool to_bool(const std::string& key, const std::string& v) {
  std::string l = lower(v);
  if (l == "yes" || l == "true" || l == "on" || l == "1") return true;
  if (l == "no" || l == "false" || l == "off" || l == "0") return false;
  throw Error("config: '" + key + "' expects yes/no, got '" + v + "'");
}

template <class E>
E to_enum(const std::string& key, const std::string& v, 
std::initializer_list<std::pair<const char*, E>> opts) {
  std::string l = lower(v);
  for (auto& o : opts)
    if (l == o.first) return o.second;
  std::string msg = "config: '" + key + "' must be one of";
  for (auto& o : opts) msg += std::string(" ") + o.first;
  throw Error(msg + ", got '" + v + "'");
}

}  // namespace

Config Config::parse(const std::string& text) {
  Config c;
  std::istringstream in(text);
  std::string line;
  int lineno = 0;
  while (std::getline(in, line)) {
    ++lineno;
    size_t cut = line.find_first_of("#;");
    if (cut != std::string::npos) line = line.substr(0, cut);
    line = trim(line);
    if (line.empty()) continue;
    size_t eq = line.find('=');
    if (eq == std::string::npos) throw Error("config line " + 
std::to_string(lineno) + ": expected 'key = value'");
    std::string key = lower(trim(line.substr(0, eq)));
    std::string val = trim(line.substr(eq + 1));
    std::replace(key.begin(), key.end(), '-', '_');
    if (key.empty() || val.empty()) throw Error("config line " + 
std::to_string(lineno) + ": empty key or value");
    if (c.raw.count(key)) throw Error("config: duplicate key '" + key + "'");
    c.raw[key] = val;

    if (key == "integrator") c.integrator = to_enum<Integrator>(key, val, 
{{"vv", Integrator::VV}, {"baoab", Integrator::BAOAB}});
    else if (key == "dt") c.dt = to_double(key, val);
    else if (key == "nsteps") c.nsteps = to_int(key, val);
    else if (key == "seed") {
      long long s = to_int(key, val);
      if (s < 0) throw Error("config: 'seed' must be >= 0");
      c.seed = (uint64_t)s;
    }
    else if (key == "cutoff") c.cutoff = to_double(key, val);
    else if (key == "skin") c.skin = to_double(key, val);
    else if (key == "vdw_modifier") c.vdw_modifier = to_enum<VdwModifier>(key, 
val, {{"potential-shift", VdwModifier::PotentialShift}, {"force-switch", 
VdwModifier::ForceSwitch}});
    else if (key == "rvdw_switch") c.rvdw_switch = to_double(key, val);
    else if (key == "dispcorr") c.dispcorr = to_enum<bool>(key, val, {{"no", 
false}, {"enerpres", true}});
    else if (key == "coulombtype") c.coulombtype = to_enum<Coulomb>(key, val, 
{{"pme", Coulomb::PME}, {"reaction-field", Coulomb::ReactionField}, {"cutoff", 
Coulomb::Cutoff}});
    else if (key == "epsilon_rf") c.epsilon_rf = to_double(key, val);
    else if (key == "ewald_rtol") c.ewald_rtol = to_double(key, val);
