};

#define MDL_CUDA(call)                                                          
\
  do {                                                                          
\
    cudaError_t err_ = (call);                                                  
\
    if (err_ != cudaSuccess)                                                    
\
      throw ::mdl::Error(std::string("CUDA error: ") + cudaGetErrorString(err_) 
+ " at " +      \
                         __FILE__ + ":" + std::to_string(__LINE__));            
\
  } while (0)

#define MDL_CHECK_LAUNCH() MDL_CUDA(cudaGetLastError())

inline int blocks_for(long long n, int threads) { return (int)((n + threads - 1)
/ threads); }

// --- minimal device buffer
template <class T>
struct DevBuf {
  T* p = nullptr;
  size_t n = 0;
  DevBuf() = default;
  explicit DevBuf(size_t count) { resize(count); }
  DevBuf(const DevBuf&) = delete;
  DevBuf& operator=(const DevBuf&) = delete;
  ~DevBuf() { release(); }
  void release() {
    if (p) cudaFree(p);
    p = nullptr;
    n = 0;
  }
  void resize(size_t count) {
    if (count == n) return;
    release();
    if (count) MDL_CUDA(cudaMalloc(&p, count * sizeof(T)));
    n = count;
  }
  void zero(cudaStream_t s = 0) {
    if (n) MDL_CUDA(cudaMemsetAsync(p, 0, n * sizeof(T), s));
  }
  void upload(const T* h, size_t count) {
    resize(count);
    if (count) MDL_CUDA(cudaMemcpy(p, h, count * sizeof(T), 
cudaMemcpyHostToDevice));
  }
  void upload(const std::vector<T>& h) { upload(h.data(), h.size()); }
  void download(T* h, size_t count) const {
    if (count) MDL_CUDA(cudaMemcpy(h, p, count * sizeof(T), 
cudaMemcpyDeviceToHost));
  }
  std::vector<T> to_host() const {
    std::vector<T> h(n);
    download(h.data(), n);
    return h;
  }
};

struct Box {
  double L[3];
};

// minimum-image displacement for an orthorhombic box
__host__ __device__ inline void min_image(double& dx, double& dy, double& dz, 
const double* L) {
  dx -= L[0] * rint(dx / L[0]);
  dy -= L[1] * rint(dy / L[1]);
  dz -= L[2] * rint(dz / L[2]);
}

}  // namespace mdl

