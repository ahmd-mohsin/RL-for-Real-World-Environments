long long* f, long long* acc, cudaStream_t s);
void pme_setup(Pme& pme, int order, const int n[3], double beta);
// returns reciprocal energy; adds the reciprocal virial (xx,yy,zz,xy,xz,yz) to 
vir6
double pme_forces(Pme& pme, const DeviceTopology& t, const double* x, const 
double L[3], long long* f, double vir6[6], cudaStream_t s);

// constraints; return false on non-convergence. vir6 receives the constraint 
virial (velocity stage only)
bool shake(const DeviceTopology& t, double* x, const double* xref, double* v, 
double inv_dt, double tol, int maxit,
           const double L[3], cudaStream_t s);
bool rattle(const DeviceTopology& t, const double* x, double* v, double dt, 
double tol, int maxit, const double L[3],
            double vir6[6], cudaStream_t s);

