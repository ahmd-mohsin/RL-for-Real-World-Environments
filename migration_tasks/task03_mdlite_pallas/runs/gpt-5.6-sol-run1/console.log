"""Host-side construction of exclusions, pair parameters and clusters."""
import math
from collections import defaultdict, deque
import numpy as np

def validate_system(s, error):
    req=lambda ok,msg: None if ok else (_ for _ in ()).throw(error('mdsys: 
'+msg))
    N=s.natoms; T=len(s.types)
    req(N>=1,'system has no atoms'); req(T>=1,'system has no atom types')
    req(np.all(np.isfinite(s.box)) and np.all(s.box>0),'box lengths must be 
positive'); req(0<=s.nrexcl<=5,'nrexcl must be in [0, 5]')
    req(np.all(s.types['sigma']>=0) and np.all(s.types['epsilon']>=0),'negative 
LJ parameter')
    for n in s.nbfix: req(0<=n['ti']<T and 0<=n['tj']<T and n['sigma']>=0 and 
n['epsilon']>=0,'bad nbfix entry')
    req(np.all((s.type>=0)&(s.type<T)),'atom type out of range'); 
req(np.all(np.isfinite(s.mass)) and np.all(s.mass>0),'masses must be positive')
    req(np.all(np.isfinite(s.charge)),'non-finite charge'); 
req(np.all(np.isfinite(s.positions)),'non-finite position')
    if s.velocities is not 
None:req(np.all(np.isfinite(s.velocities)),'non-finite velocity')
    def atom(a):req(0<=a<N,'atom index out of range')
    def same(a,b):req(s.molecule[a]==s.molecule[b],'bonded atoms must belong to 
the same molecule')
    for b in s.bonds: atom(b['i']);atom(b['j']);req(b['i']!=b['j'],'bond to 
self');same(b['i'],b['j'])
    for a in s.angles: 
atom(a['i']);atom(a['j']);atom(a['k']);same(a['i'],a['j']);same(a['j'],a['k'])
    for d in s.dihedrals:
        for z in ('i','j','k','l'):atom(d[z])
        req(0<=d['mult']<=6,'dihedral multiplicity must be in [0, 
6]');same(d['i'],d['j']);same(d['j'],d['k']);same(d['k'],d['l'])
    for p in s.pairs:atom(p['i']);atom(p['j']);req(p['i']!=p['j'],'pair to 
self')
    for c in 
s.constraints:atom(c['i']);atom(c['j']);req(c['i']!=c['j'],'constraint to 
self');req(c['d']>0,'constraint length must be > 0');same(c['i'],c['j'])
    for e in s.exclusions:atom(e['i']);atom(e['j'])

def build_topology(s, use_constraints=True):
    N=s.natoms; adj=[[] for _ in range(N)]
    for arr in (s.bonds,s.constraints):
      for b in arr: 
i,j=int(b['i']),int(b['j']);adj[i].append(j);adj[j].append(i)
    ex=[set() for _ in range(N)]
    if s.nrexcl:
      for i in range(N):
        if not adj[i]:continue
        dist={i:0}; q=deque([i])
        while q:
          a=q.popleft()
          if dist[a]==s.nrexcl:continue
          for b in adj[a]:
            if b not in dist:dist[b]=dist[a]+1;q.append(b);ex[i].add(b)
    for e in s.exclusions:
      i,j=int(e['i']),int(e['j'])
      if i!=j:ex[i].add(j);ex[j].add(i)
    exlist=[sorted(z) for z in ex]; expairs=np.array([(i,j) for i,z in 
