    32  __device__ inline void lj_pair(const NbParams& p, double c6, double c12,
double r2, double rinv, double& fscal, double& e) {
    33    double rinv2 = rinv * rinv;
    34    double rinv6 = rinv2 * rinv2 * rinv2;
