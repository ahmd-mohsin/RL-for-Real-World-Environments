static const char CPT_MAGIC[8] = {'M', 'D', 'C', 'P', 'T', 0, 2, 0};
static const char TRJ_MAGIC[8] = {'M', 'D', 'T', 'R', 'J', 0, 1, 0};
constexpr double FLEXIBLE_CONSTRAINT_K = 400000.0;  // kJ/mol/nm^2, used when 
constraints = no

// GROMACS calc_ewaldcoeff_q: erfc(beta * rc) = rtol, by doubling then 60 
bisection steps
double ewald_coefficient(double rc, double rtol) {
  double beta = 5.0, low, high;
  int i = 0;
  while (std::erfc(beta * rc) > rtol) {
    ++i;
    beta *= 2.0;
  }
  int n = i + 60;
  low = 0.0;
  high = beta;
  for (i = 0; i < n; ++i) {
    beta = 0.5 * (low + high);
    if (std::erfc(beta * rc) > rtol) low = beta;
    else high = beta;
  }
  return beta;
}

// smallest even n >= max(ceil(L / spacing), 2 * order) whose prime factors are 
all in {2, 3, 5, 7}
int pme_grid_size(double L, double spacing, int order) {
  int n = std::max((int)std::ceil(L / spacing), 2 * order);
  for (;; ++n) {
    if (n % 2) continue;
    int m = n;
    for (int p : {2, 3, 5, 7})
      while (m % p == 0) m /= p;
    if (m == 1) return n;
  }
}

