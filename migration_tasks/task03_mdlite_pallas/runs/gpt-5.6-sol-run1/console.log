    75  // move every molecule rigidly so that its centre of mass scales by mu
    76  __global__ void k_scale_mol(double* x, const double* m, const int* 
mol_ptr, const int* mol_atoms, int nmol, double mu) {
    77    int k = blockIdx.x * blockDim.x + threadIdx.x;
    78    if (k >= nmol) return;
    79    double M = 0, cx = 0, cy = 0, cz = 0;
    80    for (int a = mol_ptr[k]; a < mol_ptr[k + 1]; ++a) {
    81      int i = mol_atoms[a];
    82      M += m[i]; cx += m[i] * x[3 * i]; cy += m[i] * x[3 * i + 1]; cz += 
m[i] * x[3 * i + 2];
    83    }
    84    double s = (mu - 1.0) / M;
    85    cx *= s; cy *= s; cz *= s;
    86    for (int a = mol_ptr[k]; a < mol_ptr[k + 1]; ++a) {
    87      int i = mol_atoms[a];
    88      x[3 * i] += cx; x[3 * i + 1] += cy; x[3 * i + 2] += cz;
    89    }
    90  }
