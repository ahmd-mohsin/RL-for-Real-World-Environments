// Excluded pairs: PME removes the reciprocal-space interaction erf(beta r)/r of
// every excluded pair (at any distance); reaction-field adds q_i q_j (k_rf r^2 
- c_rf)
// for excluded pairs inside the cut-off.
__global__ void k_exclusions(const double* x, const int* pairs, int npairs, 
double L0, double L1, double L2, const double* q,
                             NbParams p, double rc2, long long* f, long long* 
acc) {
  int k = blockIdx.x * blockDim.x + threadIdx.x;
  long long a[7] = {0, 0, 0, 0, 0, 0, 0};
  if (k < npairs) {
    const double L[3] = {L0, L1, L2};
    int i = pairs[2 * k], j = pairs[2 * k + 1];
    double qq = p.epsfac * q[i] * q[j];
    double dx = x[3 * i] - x[3 * j], dy = x[3 * i + 1] - x[3 * j + 1], dz = x[3 
* i + 2] - x[3 * j + 2];
    min_image(dx, dy, dz, L);
    double r2 = dx * dx + dy * dy + dz * dz;
    double fs = 0, e = 0;
    if (qq != 0.0) {
      if (p.coul == 0) {
        if (r2 > 0) {
          double r = sqrt(r2);
          double br = p.beta * r;
          double erf_br = erf(br);
          e = -qq * erf_br / r;
          // d/dr [erf(br)/r] = (2b/sqrt(pi) exp(-b^2 r^2) r - erf(br)) / r^2 ; 
force = -dV/dr * dx/r
          fs = -qq * (erf_br / r - 1.1283791670955126 * p.beta * exp(-br * br)) 
/ r2;
        } else {
          e = -qq * 1.1283791670955126 * p.beta;
        }
      } else if (r2 < rc2) {
        e = qq * (p.krf * r2 - p.crf);
        fs = -2.0 * qq * p.krf;
      }
    }
    if (fs != 0.0) {
      long long fx = to_fixed(fs * dx, FORCE_SCALE), fy = to_fixed(fs * dy, 
FORCE_SCALE), fz = to_fixed(fs * dz, FORCE_SCALE);
      atomic_add_fixed(f + 3 * i, fx); atomic_add_fixed(f + 3 * i + 1, fy); 
atomic_add_fixed(f + 3 * i + 2, fz);
      atomic_add_fixed(f + 3 * j, -fx); atomic_add_fixed(f + 3 * j + 1, -fy); 
atomic_add_fixed(f + 3 * j + 2, -fz);
    }
    a[0] = to_fixed(e, ENERGY_SCALE);
    a[1] = to_fixed(dx * fs * dx, VIRIAL_SCALE);
    a[2] = to_fixed(dy * fs * dy, VIRIAL_SCALE);
    a[3] = to_fixed(dz * fs * dz, VIRIAL_SCALE);
    a[4] = to_fixed(dx * fs * dy, VIRIAL_SCALE);
    a[5] = to_fixed(dx * fs * dz, VIRIAL_SCALE);
    a[6] = to_fixed(dy * fs * dz, VIRIAL_SCALE);
  }
  const int slots[7] = {A_COUL_EXCL, A_VXX, A_VYY, A_VZZ, A_VXY, A_VXZ, A_VYZ};
  block_flush<7>(a, acc, slots);
}

