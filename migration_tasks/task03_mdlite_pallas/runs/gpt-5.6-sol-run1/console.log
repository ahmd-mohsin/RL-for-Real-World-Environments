+def ewald_coefficient(rc,rtol):
+    beta=5.;i=0
+    while math.erfc(beta*rc)>rtol:i+=1;beta*=2
+    lo=0.;hi=beta
+    for _ in range(i+60):
+      beta=.5*(lo+hi)
