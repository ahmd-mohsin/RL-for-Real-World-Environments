void Simulation::write_frame() {
  int N = sys_.natoms;
  std::vector<double> x(3 * (size_t)N);
  get_positions(x.data());
  std::vector<float> xf(x.begin(), x.end());
  int64_t st = step_;
  double t = step_ * cfg_.dt;
  std::fwrite(&st, 8, 1, traj_file_);
  std::fwrite(&t, 8, 1, traj_file_);
  std::fwrite(L_, 8, 3, traj_file_);
  std::fwrite(xf.data(), 4, xf.size(), traj_file_);
  if (cfg_.nstvout > 0) {
    get_velocities(x.data());
    std::vector<float> vf(x.begin(), x.end());
    std::fwrite(vf.data(), 4, vf.size(), traj_file_);
  }
}

void Simulation::get_positions(double* out) const {
  MDL_CUDA(cudaMemcpy(out, x_.p, 3 * (size_t)sys_.natoms * sizeof(double), 
cudaMemcpyDeviceToHost));
}
void Simulation::get_velocities(double* out) const {
  MDL_CUDA(cudaMemcpy(out, v_.p, 3 * (size_t)sys_.natoms * sizeof(double), 
cudaMemcpyDeviceToHost));
}
void Simulation::set_positions(const double* in) {
  for (size_t k = 0; k < 3 * (size_t)sys_.natoms; ++k)
    if (!std::isfinite(in[k])) throw Error("set_positions: non-finite value");
  MDL_CUDA(cudaMemcpy(x_.p, in, 3 * (size_t)sys_.natoms * sizeof(double), 
cudaMemcpyHostToDevice));
  box_changed_ = true;
  forces_valid_ = false;
  cache_valid_ = false;
}
void Simulation::set_velocities(const double* in) {
  for (size_t k = 0; k < 3 * (size_t)sys_.natoms; ++k)
    if (!std::isfinite(in[k])) throw Error("set_velocities: non-finite value");
  MDL_CUDA(cudaMemcpy(v_.p, in, 3 * (size_t)sys_.natoms * sizeof(double), 
cudaMemcpyHostToDevice));
  cache_valid_ = false;
}
void Simulation::set_box(const double L[3]) {
  double old[3] = {L_[0], L_[1], L_[2]};
  for (int d = 0; d < 3; ++d) L_[d] = L[d];
  try {
    for (int d = 0; d < 3; ++d)
      if (!(std::isfinite(L[d]) && L[d] > 0)) throw Error("set_box: box lengths 
must be positive");
    check_box();
  } catch (...) {
    for (int d = 0; d < 3; ++d) L_[d] = old[d];
    throw;
  }
  box_changed_ = true;
  forces_valid_ = false;
  cache_valid_ = false;
}

void Simulation::save_checkpoint(const std::string& path) const {
  int N = sys_.natoms;
  std::vector<double> x(3 * (size_t)N), v(3 * (size_t)N);
  get_positions(x.data());
  get_velocities(v.data());
  std::string buf;
  auto put = [&](const void* p, size_t n) { buf.append(static_cast<const 
char*>(p), n); };
  put(CPT_MAGIC, 8);
  int64_t st = step_;
  put(&st, 8);
  int32_t hdr[2] = {N, 0};
  put(hdr, 8);
  put(L_, 24);
  put(&integral_, 8);
  put(cvir_, 48);
  uint64_t seed = cfg_.seed;
  put(&seed, 8);
  put(&cfg_.dt, 8);
  put(x.data(), x.size() * 8);
  put(v.data(), v.size() * 8);
  uint32_t crc = crc32(reinterpret_cast<const unsigned char*>(buf.data()), 
buf.size());
  put(&crc, 4);
  std::string tmp = path + ".tmp";
  {
    std::ofstream f(tmp, std::ios::binary | std::ios::trunc);
    if (!f) throw Error("cannot write checkpoint '" + path + "'");
    f.write(buf.data(), (std::streamsize)buf.size());
    if (!f) throw Error("cannot write checkpoint '" + path + "'");
  }
  if (std::rename(tmp.c_str(), path.c_str()) != 0) throw Error("cannot write 
checkpoint '" + path + "'");
}

void Simulation::load_checkpoint(const std::string& path) {
  std::ifstream f(path, std::ios::binary);
  if (!f) throw Error("cannot open checkpoint '" + path + "'");
  std::vector<char> buf((std::istreambuf_iterator<char>(f)), 
std::istreambuf_iterator<char>());
  int N = sys_.natoms;
  size_t expect = 8 + 8 + 8 + 24 + 8 + 48 + 8 + 8 + 48 * (size_t)N + 4;
  if (buf.size() < 16 || std::memcmp(buf.data(), CPT_MAGIC, 8) != 0) throw 
Error("checkpoint: bad magic");
  if (buf.size() != expect) throw Error("checkpoint: size does not match the 
system");
  uint32_t crc;
  std::memcpy(&crc, buf.data() + buf.size() - 4, 4);
  if (crc32(reinterpret_cast<const unsigned char*>(buf.data()), buf.size() - 4) 
!= crc) throw Error("checkpoint: checksum mismatch");
  const char* p = buf.data() + 8;
  auto get = [&](void* dst, size_t n) { std::memcpy(dst, p, n); p += n; };
  int64_t st;
  get(&st, 8);
  int32_t hdr[2];
  get(hdr, 8);
  if (hdr[0] != N) throw Error("checkpoint: atom count does not match the 
system");
  double L[3], integral, cvir[6], dt;
  uint64_t seed;
  get(L, 24);
  get(&integral, 8);
  get(cvir, 48);
  get(&seed, 8);
  get(&dt, 8);
  std::vector<double> x(3 * (size_t)N), v(3 * (size_t)N);
  get(x.data(), x.size() * 8);
  get(v.data(), v.size() * 8);
  double Lold[3] = {L_[0], L_[1], L_[2]};
  for (int d = 0; d < 3; ++d) L_[d] = L[d];
  try {
    check_box();
  } catch (...) {
    for (int d = 0; d < 3; ++d) L_[d] = Lold[d];
    throw;
  }
  step_ = st;
  integral_ = integral;
  std::memcpy(cvir_, cvir, sizeof(cvir_));
  MDL_CUDA(cudaMemcpy(x_.p, x.data(), x.size() * 8, cudaMemcpyHostToDevice));
  MDL_CUDA(cudaMemcpy(v_.p, v.data(), v.size() * 8, cudaMemcpyHostToDevice));
  box_changed_ = true;
  forces_valid_ = false;
  cache_valid_ = false;
  last_output_step_ = -1;
  compute_forces();
}

std::string Simulation::info_json() const {
  std::ostringstream o;
  o.precision(17);
  o << "{\"natoms\": " << sys_.natoms << ", \"dof\": " << dof_ << ", 
\"constraints\": " << topo_.ncons
    << ", \"constraint_clusters\": " << dt_.nclusters << ", \"exclusion_pairs\":
" << dt_.nexcl_pairs
    << ", \"rlist\": " << nl_.rlist << ", \"neighbor_builds\": " << nl_.builds 
<< ", \"neighbor_capacity\": " << nl_.cap
    << ", \"cells\": [" << nl_.nc[0] << ", " << nl_.nc[1] << ", " << nl_.nc[2] 
<< "]";
