   406  // Bussi, Donadio, Parrinello, J. Chem. Phys. 126, 014101 (2007)
   407  void Simulation::thermostat_csvr() {
   408    if (dof_ == 0) return;
   409    double ke6[6], mom[3];
   410    kinetic_energy(ke6, mom);
   411    double K = ke6[0] + ke6[1] + ke6[2];
   412    if (K <= 0) return;
   413    double Kt = 0.5 * dof_ * BOLTZ * cfg_.ref_t;
   414    double c = std::exp(-cfg_.nsttcouple * cfg_.dt / cfg_.tau_t);
   415    HostStream rs(cfg_.seed, (uint64_t)step_, STREAM_CSVR);
   416    double r1 = rs.gauss();
   417    double sumr2 = rs.sum_noises(dof_ - 1);
   418    double Knew = K + (1.0 - c) * (Kt * (sumr2 + r1 * r1) / dof_ - K) + 
2.0 * r1 * std::sqrt(Kt / dof_ * (1.0 - c) * c * K);
   419    if (Knew < 0) Knew = 0;
   420    scale_velocities(v_.p, std::sqrt(Knew / K), sys_.natoms, s_);
   421    integral_ -= Knew - K;
   422  }
