void nonbonded_forces(const NeighborList& nl, const DeviceTopology& t, const 
NbParams& p, const double* x, const double L[3],
                      long long* f, long long* acc, cudaStream_t s) {
  // halving of the doubly counted pair sums happens at read-out 
(Simulation::energies)
  k_nonbonded<<<blocks_for(t.N, NB_THREADS), NB_THREADS, 0, s>>>(x, t.N, L[0], 
L[1], L[2], nl.count.p, nl.list.p, nl.cap, t.type.p,
                                                                 t.charge.p, 
t.c6.p, t.c12.p, t.ntypes, p, f, acc);
  MDL_CHECK_LAUNCH();
}

void exclusion_corrections(const DeviceTopology& t, const NbParams& p, double 
cutoff, const double* x, const double L[3],
                           long long* f, long long* acc, cudaStream_t s) {
  if (t.nexcl_pairs == 0) return;
  k_exclusions<<<blocks_for(t.nexcl_pairs, NB_THREADS), NB_THREADS, 0, s>>>(x, 
t.excl_pairs.p, t.nexcl_pairs, L[0], L[1], L[2],
                                                                            t.ch
arge.p, p, cutoff * cutoff, f, acc);
  MDL_CHECK_LAUNCH();
}

