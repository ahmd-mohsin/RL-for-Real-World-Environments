# Legacy toolchain: CUDA 11.8 (the last CUDA with texture references) for the original PCL GPU modules.
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
      libeigen3-dev libboost-filesystem-dev libboost-iostreams-dev libboost-system-dev libboost-date-time-dev \
      libboost-thread-dev libboost-program-options-dev libflann-dev libvtk9-dev libqhull-dev libpng-dev zlib1g-dev \
      liblz4-dev qtbase5-dev libqt5opengl5-dev bzip2 python3 python3-numpy ninja-build && rm -rf /var/lib/apt/lists/*
