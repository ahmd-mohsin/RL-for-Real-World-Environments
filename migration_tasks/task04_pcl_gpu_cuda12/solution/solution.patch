+    __global__ void
+    reduceSolveKernel (PtrStep<double> gbuf, int length, double* sums, unsigned int* done, float* pose, int* status, double det_min)
+    {
+      constexpr int THREADS = 256;
+      __shared__ double part[THREADS / 32];
+      __shared__ bool last;
+      const double* row = gbuf.ptr (blockIdx.x);
+      double v = 0;
+      for (int i = threadIdx.x; i < length; i += THREADS)
+        v += row[i];
+      v = warpSumDouble (v);
+      if ((threadIdx.x & 31) == 0)
+        part[threadIdx.x >> 5] = v;
