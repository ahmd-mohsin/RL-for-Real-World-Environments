+//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+// Device-resident ICP: the pose lives in device memory and every iteration is three kernels (correspondences +
+// per-block partial sums, the final reduction, and the 6x6 solve with the pose update), so that a frame's
+// iterations run without host round trips. FP64 is slow on GeForce parts: partial sums are formed in FP32
+// within a warp and accumulated in FP64 across warps, blocks and the final reduction.
+
+namespace pcl
+{
+  namespace device
+  {
+    __device__ __forceinline__ float
+    warpSumFloat (float v)
+    {
+      #pragma unroll
+      for (int o = 16; o > 0; o >>= 1)
+        v += __shfl_down_sync (0xffffffffu, v, o);
+      return v;
+    }
+
+    __device__ __forceinline__ double
+    warpSumDouble (double v)
+    {
+      #pragma unroll
+      for (int o = 16; o > 0; o >>= 1)
+        v += __shfl_down_sync (0xffffffffu, v, o);
+      return v;
+    }
+
+    __global__ void
+    combinedPoseKernel (Combined cs, const float* __restrict__ pose)
+    {
+      #pragma unroll
+      for (int r = 0; r < 3; ++r)
+      {
+        cs.Rcurr.data[r].x = __ldg (pose + 3 * r + 0);
+        cs.Rcurr.data[r].y = __ldg (pose + 3 * r + 1);
+        cs.Rcurr.data[r].z = __ldg (pose + 3 * r + 2);
+      }
+      cs.tcurr = make_float3 (__ldg (pose + 9), __ldg (pose + 10), __ldg (pose + 11));
+
+      int x = threadIdx.x + blockIdx.x * Combined::CTA_SIZE_X;
+      int y = threadIdx.y + blockIdx.y * Combined::CTA_SIZE_Y;
+
+      float3 n, d, s;
+      bool found_coresp = false;
+      if (x < cs.cols && y < cs.rows)
+        found_coresp = cs.search (x, y, n, d, s);
+
+      float row[7];
+      if (found_coresp)
+      {
+        *(float3*)&row[0] = cross (s, n);
+        *(float3*)&row[3] = n;
+        row[6] = dot (n, d - s);
+      }
+      else
+        row[0] = row[1] = row[2] = row[3] = row[4] = row[5] = row[6] = 0.f;
+
+      constexpr int WARPS = Combined::CTA_SIZE / 32;
+      __shared__ float wsum[27][WARPS];
+      const int tid = Block::flattenedThreadId ();
+      const int lane = tid & 31, warp = tid >> 5;
+      int k = 0;
+      #pragma unroll
+      for (int i = 0; i < 6; ++i)
+      {
+        #pragma unroll
+        for (int j = i; j < 7; ++j)
+        {
+          float v = warpSumFloat (row[i] * row[j]);
+          if (lane == 0)
+            wsum[k][warp] = v;
+          ++k;
+        }
+      }
+      __syncthreads ();
+      if (tid < 27)
+      {
+        double sum = 0;
+        #pragma unroll
+        for (int w = 0; w < WARPS; ++w)
+          sum += (double)wsum[tid][w];
+        cs.gbuf.ptr (tid)[blockIdx.x + gridDim.x * blockIdx.y] = sum;
+      }
+    }
+
+    // 27 blocks: block k sums row k of the per-block partials in a fixed order (deterministic); the last block to
+    // finish solves A x = b by Cholesky (A = J^T J is symmetric positive semi-definite; det(A) = prod(L_ii)^2 is the
+    // original's nullspace check) and applies the pose update of the host code:
+    // Rinc = Rz(gamma) Ry(beta) Rx(alpha); t = Rinc t + tinc; R = Rinc R
+    __global__ void
+    reduceSolveKernel (PtrStep<double> gbuf, int length, double* sums, unsigned int* done, float* pose, int* status)
+    {
+      constexpr int THREADS = 256;
+      __shared__ double part[THREADS / 32];
+      __shared__ bool last;
+      const double* row = gbuf.ptr (blockIdx.x);
+      double v = 0;
+      for (int i = threadIdx.x; i < length; i += THREADS)
+        v += row[i];
+      v = warpSumDouble (v);
+      if ((threadIdx.x & 31) == 0)
+        part[threadIdx.x >> 5] = v;
+      __syncthreads ();
+      if (threadIdx.x == 0)
+      {
+        double s = 0;
+        #pragma unroll
+        for (int w = 0; w < THREADS / 32; ++w)
+          s += part[w];
+        sums[blockIdx.x] = s;
+        __threadfence ();
+        last = atomicAdd (done, 1u) == gridDim.x - 1;
+      }
+      __syncthreads ();
+      if (!last || threadIdx.x != 0)
+        return;
+      *done = 0;  // ready for the next iteration (kernels on the stream are ordered)
+      __threadfence ();
+      if (*status != 0)
+        return;
+
+      double A[6][6], b[6];
+      {
+        int shift = 0;
+        #pragma unroll
+        for (int i = 0; i < 6; ++i)
+        {
+          #pragma unroll
+          for (int j = i; j < 7; ++j)
+          {
+            const double val = __ldcg (sums + shift++);
+            if (j == 6) b[i] = val;
+            else A[i][j] = A[j][i] = val;
+          }
+        }
+      }
+      double L[6][6], inv[6];
+      double det = 1;
+      bool ok = true;
+      #pragma unroll
+      for (int j = 0; j < 6; ++j)
+      {
+        double dd = A[j][j];
+        #pragma unroll
+        for (int k = 0; k < j; ++k) dd -= L[j][k] * L[j][k];
+        ok = ok && dd > 0;
+        det *= dd;
+        inv[j] = rsqrt (dd);
+        L[j][j] = dd * inv[j];
+        #pragma unroll
+        for (int i = j + 1; i < 6; ++i)
+        {
+          double val = A[i][j];
+          #pragma unroll
+          for (int k = 0; k < j; ++k) val -= L[i][k] * L[j][k];
+          L[i][j] = val * inv[j];
+        }
+      }
+      if (!ok || fabs (det) < 1e-15 || isnan (det))
+      {
+        *status = 1;
+        return;
+      }
+      double y[6], x[6];
+      #pragma unroll
+      for (int i = 0; i < 6; ++i)
+      {
+        double val = b[i];
+        #pragma unroll
+        for (int k = 0; k < i; ++k) val -= L[i][k] * y[k];
+        y[i] = val * inv[i];
+      }
+      #pragma unroll
+      for (int i = 5; i >= 0; --i)
+      {
+        double val = y[i];
+        #pragma unroll
+        for (int k = i + 1; k < 6; ++k) val -= L[k][i] * x[k];
+        x[i] = val * inv[i];
+      }
+
+      float ca, sa, cb, sb, cg, sg;
+      sincosf ((float)x[0], &sa, &ca);
+      sincosf ((float)x[1], &sb, &cb);
+      sincosf ((float)x[2], &sg, &cg);
+      const float Rz[3][3] = {{cg, -sg, 0}, {sg, cg, 0}, {0, 0, 1}};
+      const float Ry[3][3] = {{cb, 0, sb}, {0, 1, 0}, {-sb, 0, cb}};
+      const float Rx[3][3] = {{1, 0, 0}, {0, ca, -sa}, {0, sa, ca}};
+      float Rzy[3][3], Rinc[3][3];
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+        #pragma unroll
+        for (int j = 0; j < 3; ++j)
+          Rzy[i][j] = Rz[i][0] * Ry[0][j] + Rz[i][1] * Ry[1][j] + Rz[i][2] * Ry[2][j];
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+        #pragma unroll
+        for (int j = 0; j < 3; ++j)
+          Rinc[i][j] = Rzy[i][0] * Rx[0][j] + Rzy[i][1] * Rx[1][j] + Rzy[i][2] * Rx[2][j];
+
+      float R[3][3], t[3];
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+      {
+        t[i] = pose[9 + i];
+        #pragma unroll
+        for (int j = 0; j < 3; ++j) R[i][j] = pose[i * 3 + j];
+      }
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+      {
+        pose[9 + i] = Rinc[i][0] * t[0] + Rinc[i][1] * t[1] + Rinc[i][2] * t[2] + (float)x[3 + i];
+        #pragma unroll
+        for (int j = 0; j < 3; ++j)
+          pose[i * 3 + j] = Rinc[i][0] * R[0][j] + Rinc[i][1] * R[1][j] + Rinc[i][2] * R[2][j];
+      }
+    }
+  }
+}
+
+void
+pcl::device::estimateCombinedStep (float* pose, int* status, const MapArr& vmap_curr, const MapArr& nmap_curr,
+                                   const Mat33& Rprev_inv, const float3& tprev, const Intr& intr,
+                                   const MapArr& vmap_g_prev, const MapArr& nmap_g_prev, float distThres, float angleThres,
+                                   DeviceArray2D<double>& gbuf, DeviceArray<double>& sums, unsigned int* done)
+{
+  int cols = vmap_curr.cols ();
+  int rows = vmap_curr.rows () / 3;
+
+  Combined cs;
+  cs.vmap_curr = vmap_curr;
+  cs.nmap_curr = nmap_curr;
+  cs.Rprev_inv = Rprev_inv;
+  cs.tprev = tprev;
+  cs.intr = intr;
+  cs.vmap_g_prev = vmap_g_prev;
+  cs.nmap_g_prev = nmap_g_prev;
+  cs.distThres = distThres;
+  cs.angleThres = angleThres;
+  cs.cols = cols;
+  cs.rows = rows;
+
+  dim3 block (Combined::CTA_SIZE_X, Combined::CTA_SIZE_Y);
+  dim3 grid (divUp (cols, block.x), divUp (rows, block.y));
+  if (gbuf.rows () != TranformReduction::TOTAL || gbuf.cols () < (int)(grid.x * grid.y))
+    gbuf.create (TranformReduction::TOTAL, grid.x * grid.y);
+  sums.create (TranformReduction::TOTAL);
+  cs.gbuf = gbuf;
+
+  combinedPoseKernel<<<grid, block>>>(cs, pose);
+  cudaSafeCall (cudaGetLastError ());
+  reduceSolveKernel<<<TranformReduction::TOTAL, 256>>>(gbuf, grid.x * grid.y, sums.ptr (), done, pose, status);
+  cudaSafeCall (cudaGetLastError ());
+}
