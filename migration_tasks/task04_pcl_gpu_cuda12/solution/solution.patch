+        L[j][j] = dd * inv[j];
+        #pragma unroll
+        for (int i = j + 1; i < 6; ++i)
+        {
+          double val = A[i][j];
+          #pragma unroll
+          for (int k = 0; k < j; ++k) val -= L[i][k] * L[j][k];
+          L[i][j] = val * inv[j];
+        }
+      }
+      if (!ok || fabs (det) < det_min || isnan (det))
+      {
+        *status = 1;
+        return;
+      }
+      double y[6], x[6];
+      #pragma unroll
+      for (int i = 0; i < 6; ++i)
+      {
+        double val = b[i];
+        #pragma unroll
+        for (int k = 0; k < i; ++k) val -= L[i][k] * y[k];
+        y[i] = val * inv[i];
+      }
+      #pragma unroll
+      for (int i = 5; i >= 0; --i)
+      {
+        double val = y[i];
+        #pragma unroll
+        for (int k = i + 1; k < 6; ++k) val -= L[k][i] * x[k];
+        x[i] = val * inv[i];
+      }
+
+      float ca, sa, cb, sb, cg, sg;
+      sincosf ((float)x[0], &sa, &ca);
+      sincosf ((float)x[1], &sb, &cb);
+      sincosf ((float)x[2], &sg, &cg);
+      const float Rz[3][3] = {{cg, -sg, 0}, {sg, cg, 0}, {0, 0, 1}};
+      const float Ry[3][3] = {{cb, 0, sb}, {0, 1, 0}, {-sb, 0, cb}};
+      const float Rx[3][3] = {{1, 0, 0}, {0, ca, -sa}, {0, sa, ca}};
+      float Rzy[3][3], Rinc[3][3];
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+        #pragma unroll
+        for (int j = 0; j < 3; ++j)
+          Rzy[i][j] = Rz[i][0] * Ry[0][j] + Rz[i][1] * Ry[1][j] + Rz[i][2] * Ry[2][j];
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+        #pragma unroll
+        for (int j = 0; j < 3; ++j)
+          Rinc[i][j] = Rzy[i][0] * Rx[0][j] + Rzy[i][1] * Rx[1][j] + Rzy[i][2] * Rx[2][j];
+
+      float R[3][3], t[3];
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+      {
+        t[i] = pose[9 + i];
+        #pragma unroll
+        for (int j = 0; j < 3; ++j) R[i][j] = pose[i * 3 + j];
+      }
+      #pragma unroll
+      for (int i = 0; i < 3; ++i)
+      {
+        pose[9 + i] = Rinc[i][0] * t[0] + Rinc[i][1] * t[1] + Rinc[i][2] * t[2] + (float)x[3 + i];
+        #pragma unroll
+        for (int j = 0; j < 3; ++j)
+          pose[i * 3 + j] = Rinc[i][0] * R[0][j] + Rinc[i][1] * R[1][j] + Rinc[i][2] * R[2][j];
+      }
+    }
+  }
+  }
+}
+
+void
+pcl::device::kinfuLS::estimateCombinedStep (float* pose, int* status, unsigned int* done, const float3& origin,
+                                            const MapArr& vmap_curr, const MapArr& nmap_curr, const Mat33& Rprev_inv,
+                                            const float3& tprev, const Intr& intr, const MapArr& vmap_g_prev,
+                                            const MapArr& nmap_g_prev, float distThres, float angleThres,
+                                            DeviceArray2D<double>& gbuf, DeviceArray<double>& sums, double det_min)
+{
+  int cols = vmap_curr.cols ();
+  int rows = vmap_curr.rows () / 3;
+
+  Combined cs;
+  cs.vmap_curr = vmap_curr;
+  cs.nmap_curr = nmap_curr;
+  cs.Rprev_inv = Rprev_inv;
+  cs.tprev = tprev;
+  cs.intr = intr;
+  cs.vmap_g_prev = vmap_g_prev;
+  cs.nmap_g_prev = nmap_g_prev;
+  cs.distThres = distThres;
+  cs.angleThres = angleThres;
+  cs.cols = cols;
+  cs.rows = rows;
+
+  dim3 block (Combined::CTA_SIZE_X, Combined::CTA_SIZE_Y);
+  dim3 grid (divUp (cols, block.x), divUp (rows, block.y));
+  if (gbuf.rows () != TranformReduction::TOTAL || gbuf.cols () < (int)(grid.x * grid.y))
+    gbuf.create (TranformReduction::TOTAL, grid.x * grid.y);
+  sums.create (TranformReduction::TOTAL);
+  cs.gbuf = gbuf;
+
+  combinedPoseKernel<<<grid, block>>>(cs, pose, origin);
+  cudaSafeCall (cudaGetLastError ());
+  reduceSolveKernel<<<TranformReduction::TOTAL, 256>>>(gbuf, grid.x * grid.y, sums.ptr (), done, pose, status, det_min);
+  cudaSafeCall (cudaGetLastError ());
+}
