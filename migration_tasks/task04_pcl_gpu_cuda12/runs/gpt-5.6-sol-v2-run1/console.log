                        static __device__ __forceinline__ T reduce(volatile T* 
buffer, T init, BinOp op)
                        {
                                int tid = flattenedThreadId();
                                T val =  buffer[tid] = init;
                                __syncthreads();

                                if (CTA_SIZE >= 1024) { if (tid < 512) 
buffer[tid] = val = op(val, buffer[tid + 512]); __syncthreads(); }
                                if (CTA_SIZE >=  512) { if (tid < 256) 
buffer[tid] = val = op(val, buffer[tid + 256]); __syncthreads(); }
                                if (CTA_SIZE >=  256) { if (tid < 128) 
buffer[tid] = val = op(val, buffer[tid + 128]); __syncthreads(); }
                                if (CTA_SIZE >=  128) { if (tid <  64) 
buffer[tid] = val = op(val, buffer[tid +  64]); __syncthreads(); }

                                if (tid < 32)
