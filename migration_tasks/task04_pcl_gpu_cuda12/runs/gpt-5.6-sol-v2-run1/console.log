                        }

                        template <typename T, class BinOp>
                        static __device__ __forceinline__ void reduce_n(T* data,
unsigned int n, BinOp op)
                        {
                                int ftid = flattenedThreadId();
                                int sft = stride();

                                if (sft < n)
                                {
                                        for (unsigned int i = sft + ftid; i < n;
i += sft)
                                                data[ftid] = op(data[ftid], 
data[i]);

                                        __syncthreads();

                                        n = sft;
                                }

                                while (n > 1)
                                {
                                        unsigned int half = n/2;

                                        if (ftid < half)
                                                data[ftid] = op(data[ftid], 
data[n - ftid - 1]);

                                        __syncthreads();

                                        n = n - half;
                                }
                        }
                };
