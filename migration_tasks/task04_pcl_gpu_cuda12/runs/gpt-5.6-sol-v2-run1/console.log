   299                }
   300              }/* if (x < VOLUME_X && y < VOLUME_Y) */
   301  
   302              // local_count counts the number of zero crossing for the 
current thread. Now we need to merge this knowledge with the other threads
   303              // not we fulfilled points array at current iteration
   304              int total_warp = __popc (__ballot_sync (__activemask (), 
local_count > 0))
   305                             + __popc (__ballot_sync (__activemask (), 
local_count > 1))
   306                             + __popc (__ballot_sync (__activemask (), 
local_count > 2));
   307  
   308              if (total_warp > 0)  ///more than 0 zero-crossings
   309              {
   310                int lane = Warp::laneId ();  ///index of thread within 
warp [0-31]
   311                int storage_index = (ftid >> Warp::LOG_WARP_SIZE) * 
Warp::WARP_SIZE * MAX_LOCAL_POINTS;
   312  
   313                // Pointer to the beginning of the current warp buffer
   314                volatile int* cta_buffer = (int*)(storage_X + 
storage_index);
   315  
   316                // Compute offset of current warp
   317                // Call in place scanning (see 
http://http.developer.nvidia.com/GPUGems3/gpugems3_ch39.html)
   318                cta_buffer[lane] = local_count;
   319                int offset = scan_warp<exclusive>(cta_buffer, lane);   
//How many crossings did we have before index "lane" ?
   320  
   321                // We want to do only 1 operation per warp (not thread) ->
because it is faster
   322                if (lane == 0) 
   323                {
   324                  int old_global_count = atomicAdd (&global_count, 
total_warp); ///We use atomicAdd, so that threads do not collide
   325                  cta_buffer[0] = old_global_count;
   326                }
   327                int old_global_count = cta_buffer[0];
   328  
   329                // Perform compaction (dump all current crossings)
   330                for (int l = 0; l < local_count; ++l)
   331                {
   332                  storage_X[storage_index + offset + l] = points[l].x;// x
coordinates of the points we found in STORAGE_X
   333                  storage_Y[storage_index + offset + l] = points[l].y;// y
coordinates of the points we found in STORAGE_Y
   334                  storage_Z[storage_index + offset + l] = points[l].z;// z
coordinates of the points we found in STORAGE_Z
   335                  storage_I[storage_index + offset + l] = points[l].w;// 
Intensity values of the points we found in STORAGE_I
   336                }
   337  
   338                // Retrieve Zero-crossings as 3D points
   339                int offset_storage = old_global_count + lane;
   340                for (int idx = lane; idx < total_warp; idx += 
Warp::STRIDE, offset_storage += Warp::STRIDE)
   341                {
   342                  if (offset_storage >= output_xyz.size) break;
   343                  float x = storage_X[storage_index + idx];
   344                  float y = storage_Y[storage_index + idx];
   345                  float z = storage_Z[storage_index + idx];
   346                  float i = storage_I[storage_index + idx];
   347                  store_point_intensity (x, y, z, i, output_xyz.data, 
output_intensity.data, offset_storage);
   348                }
   349  
   350                // Sanity check to make sure our output_xyz buffer is not 
full already
   351                bool full = (old_global_count + total_warp) >= 
output_xyz.size;
   352  
   353                if (full)
   354                  break;
   355              }
   356  
   357              } /* for(int z = 0; z < VOLUME_Z - 1; ++z) */
   358  
   359            ///////////////////////////
   360            // Prepare for future scans
   361            if (ftid == 0)
   362            {
   363              unsigned int total_blocks = gridDim.x * gridDim.y * 
gridDim.z;
   364              unsigned int value = atomicInc (&blocks_done, total_blocks);
   365  
   366              // Last block
   367              if (value == total_blocks - 1)
   368              {
   369                output_xyz_count = min ((int)output_xyz.size, 
global_count);
   370                blocks_done = 0;
   371                global_count = 0;
   372              }
   373            }
   374          } /* operator() */
