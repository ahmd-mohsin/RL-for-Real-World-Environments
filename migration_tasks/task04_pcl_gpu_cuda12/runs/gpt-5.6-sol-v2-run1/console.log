   218  /**
   219  * \brief Segmented scan kernel
   220  *
   221  * Calculates per-row prefix scans of the input image.
   222  * Out-of-bounds safe: reads 'size' elements, writes 'size+1' elements
   223  *
   224  * \tparam T_in      Type of input image elements
   225  * \tparam T_out     Type of output image elements
   226  * \tparam T_op      Defines an operation to be performed on the input 
image pixels
   227  *
   228  * \param d_src      [IN] Source image pointer
   229  * \param srcWidth   [IN] Source image width
   230  * \param srcStride  [IN] Source image stride
   231  * \param d_II       [OUT] Output image pointer
   232  * \param IIstride   [IN] Output image stride
   233  *
   234  * \return None
   235  */
   236  template <class T_in, class T_out, bool tbDoSqr>
   237  __global__ void scanRows(T_in *d_src, Ncv32u texOffs, Ncv32u srcWidth, 
Ncv32u srcStride,
   238                           T_out *d_II, Ncv32u IIstride)
   239  {
   240      //advance pointers to the current line
   241      if (sizeof(T_in) != 1)
   242      {
   243          d_src += srcStride * blockIdx.x;
   244      }
   245      //for initial image 8bit source we use texref tex8u
   246      d_II += IIstride * blockIdx.x;
   247  
   248      Ncv32u numBuckets = (srcWidth + NUM_SCAN_THREADS - 1) >> 
LOG2_NUM_SCAN_THREADS;
   249      Ncv32u offsetX = 0;
   250  
   251      __shared__ T_out shmem[NUM_SCAN_THREADS * 2];
   252      __shared__ T_out carryElem;
   253      carryElem = 0;
   254      __syncthreads();
   255  
   256      while (numBuckets--)
   257      {
   258          Ncv32u curElemOffs = offsetX + threadIdx.x;
   259          T_out curScanElem;
   260  
   261          T_in curElem;
   262          T_out curElemMod;
   263  
   264          if (curElemOffs < srcWidth)
   265          {
   266              //load elements
   267              curElem = readElem<T_in>(d_src, texOffs, srcStride, 
curElemOffs);
   268          }
   269          curElemMod = _scanElemOp<T_in, 
T_out>::scanElemOp<tbDoSqr>(curElem);
   270  
   271          //inclusive scan
   272          curScanElem = blockScanInclusive<T_out, 
NUM_SCAN_THREADS>(curElemMod, shmem);
   273  
   274          if (curElemOffs <= srcWidth)
   275          {
   276              //make scan exclusive and write the bucket to the output 
buffer
   277              d_II[curElemOffs] = carryElem + curScanElem - curElemMod;
   278              offsetX += NUM_SCAN_THREADS;
   279          }
   280  
   281          //remember last element for subsequent buckets adjustment
   282          __syncthreads();
   283          if (threadIdx.x == NUM_SCAN_THREADS-1)
   284          {
   285              carryElem += curScanElem;
   286          }
   287          __syncthreads();
   288      }
   289  
   290      if (offsetX == srcWidth && !threadIdx.x)
   291      {
   292          d_II[offsetX] = carryElem;
   293      }
   294  }
