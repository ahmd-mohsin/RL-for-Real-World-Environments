    74    pcl::device::kinfuLS::generateTriangles(tsdf.data(), occupied_voxels, 
volume_size, (DeviceArray<pcl::device::kinfuLS::PointType>&)triangles_buffer);
    75  return DeviceArray<PointType>(triangles_buffer.ptr(), total_vertexes);
