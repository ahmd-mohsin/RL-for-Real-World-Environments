   285        __device__ __forceinline__ float3
   286        vertex_interp (float3 p0, float3 p1, float f0, float f1) const
   287        {        
   288          float t = (isoValue() - f0) / (f1 - f0 + 1e-15f);
   289          float x = p0.x + t * (p1.x - p0.x);
   290          float y = p0.y + t * (p1.y - p0.y);
   291          float z = p0.z + t * (p1.z - p0.z);
   292          return make_float3 (x, y, z);
   293        }
   294  
   295        __device__ __forceinline__ void
   296        operator () () const
   297        {
   298          int tid = threadIdx.x;
   299          int idx = (blockIdx.y * MAX_GRID_SIZE_X + blockIdx.x) * CTA_SIZE
+ tid;
   300        
   301  
   302          if (idx >= voxels_count)
   303            return;
   304  
   305          int voxel = occupied_voxels[idx];
   306  
   307          int z = voxel / (VOLUME_X * VOLUME_Y);
   308          int y = (voxel - z * VOLUME_X * VOLUME_Y) / VOLUME_X;
   309          int x = (voxel - z * VOLUME_X * VOLUME_Y) - y * VOLUME_X;
   310  
   311          float f[8];
   312          int cubeindex = computeCubeIndex (x, y, z, f);
   313  
   314          // calculate cell vertex positions
   315          float3 v[8];
   316          v[0] = getNodeCoo (x, y, z);
   317          v[1] = getNodeCoo (x + 1, y, z);
   318          v[2] = getNodeCoo (x + 1, y + 1, z);
   319          v[3] = getNodeCoo (x, y + 1, z);
   320          v[4] = getNodeCoo (x, y, z + 1);
   321          v[5] = getNodeCoo (x + 1, y, z + 1);
   322          v[6] = getNodeCoo (x + 1, y + 1, z + 1);
   323          v[7] = getNodeCoo (x, y + 1, z + 1);
   324  
   325          // find the vertices where the surface intersects the cube
   326          // use shared memory to avoid using local
   327          __shared__ float3 vertlist[12][CTA_SIZE];
   328  
   329          vertlist[0][tid] = vertex_interp (v[0], v[1], f[0], f[1]);
   330          vertlist[1][tid] = vertex_interp (v[1], v[2], f[1], f[2]);
   331          vertlist[2][tid] = vertex_interp (v[2], v[3], f[2], f[3]);
   332          vertlist[3][tid] = vertex_interp (v[3], v[0], f[3], f[0]);
   333          vertlist[4][tid] = vertex_interp (v[4], v[5], f[4], f[5]);
   334          vertlist[5][tid] = vertex_interp (v[5], v[6], f[5], f[6]);
   335          vertlist[6][tid] = vertex_interp (v[6], v[7], f[6], f[7]);
   336          vertlist[7][tid] = vertex_interp (v[7], v[4], f[7], f[4]);
   337          vertlist[8][tid] = vertex_interp (v[0], v[4], f[0], f[4]);
   338          vertlist[9][tid] = vertex_interp (v[1], v[5], f[1], f[5]);
   339          vertlist[10][tid] = vertex_interp (v[2], v[6], f[2], f[6]);
   340          vertlist[11][tid] = vertex_interp (v[3], v[7], f[3], f[7]);
   341          __syncthreads ();
   342  
   343          // output triangle vertices
