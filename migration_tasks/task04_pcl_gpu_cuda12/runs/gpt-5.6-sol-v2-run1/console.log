   351            int v2 = tex1Dfetch (triTex, (cubeindex * 16) + i + 1);
   352            int v3 = tex1Dfetch (triTex, (cubeindex * 16) + i + 2);
   353  
   354            store_point (output, index + 0, vertlist[v1][tid]);
   355            store_point (output, index + 1, vertlist[v2][tid]);
   356            store_point (output, index + 2, vertlist[v3][tid]);
   
