// kinfu_replay: headless KinectFusion runs on synthetic depth sequences.
//
//   kinfu_replay --mode kinfu|kinfuls --frames N --out DIR [--noise SEED] 
[--icp-trunc M] [--skip-mesh]
//                [--traj orbit|walk|static] [--scene room|corridor] [--stop K] 
[--shift M]
//                [--extract-every K] [--color] [--api]
//                [--concurrent "mode:traj:noise,..."]
//
// Writes DIR/result.json (poses, ground truth, errors, TSDF statistics, mesh
// quality, timing) and DIR/tsdf_slices.bin (three axis-aligned TSDF slices).
// --color feeds RGB frames (procedural scene colours) to the trackers' colour 
volumes;
// --api also exercises normals, colours, rendered views, ray-cast maps, the 
last-frame
// buffers and the host-side extraction, writing DIR/view.bin and 
DIR/scene_view.bin.
#include <pcl/gpu/containers/device_array.h>
#include <pcl/gpu/kinfu/color_volume.h>
#include <pcl/gpu/kinfu/kinfu.h>
#include <pcl/gpu/kinfu/marching_cubes.h>
