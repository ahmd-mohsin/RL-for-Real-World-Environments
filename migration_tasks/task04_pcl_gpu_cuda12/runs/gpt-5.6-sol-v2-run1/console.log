p.write_text(license+r'''#ifndef PCL_GPU_UTILS_TEXTURE_BINDER_HPP_
#define PCL_GPU_UTILS_TEXTURE_BINDER_HPP_

#include <pcl/gpu/containers/device_array.h>
#include <pcl/gpu/utils/safe_call.hpp>

namespace pcl::gpu {
/** RAII wrapper for a CUDA texture object backed by a device array.
  *
  * Unlike the removed module-global binding API, the handle is ordinary launch
  * state and is consequently safe when callers use multiple host threads.
  */
class TextureObject {
public:
  TextureObject() = default;

  template<class T>
  explicit TextureObject(const DeviceArray<T>& array,
                         cudaTextureAddressMode address = cudaAddressModeClamp,
                         cudaTextureFilterMode filter = cudaFilterModePoint)
  {
    cudaResourceDesc resource{};
    resource.resType = cudaResourceTypeLinear;
    resource.res.linear.devPtr = array.ptr();
    resource.res.linear.desc = cudaCreateChannelDesc<T>();
    resource.res.linear.sizeInBytes = array.sizeBytes();
    create(resource, address, filter, false);
  }

  template<class T>
  explicit TextureObject(const DeviceArray2D<T>& array,
                         cudaTextureAddressMode address = cudaAddressModeClamp,
                         cudaTextureFilterMode filter = cudaFilterModePoint,
                         bool normalized = false)
  {
    cudaResourceDesc resource{};
    resource.resType = cudaResourceTypePitch2D;
    resource.res.pitch2D.devPtr = array.ptr();
    resource.res.pitch2D.desc = cudaCreateChannelDesc<T>();
    resource.res.pitch2D.width = array.cols();
    resource.res.pitch2D.height = array.rows();
    resource.res.pitch2D.pitchInBytes = array.step();
    create(resource, address, filter, normalized);
  }

  TextureObject(const TextureObject&) = delete;
  TextureObject& operator=(const TextureObject&) = delete;
  TextureObject(TextureObject&& other) noexcept : object_(other.object_) { 
other.object_ = 0; }
  TextureObject& operator=(TextureObject&& other) noexcept
  {
    if (this != &other) { reset(); object_ = other.object_; other.object_ = 0; }
    return *this;
  }
  ~TextureObject() { reset(); }
  operator cudaTextureObject_t() const { return object_; }
  cudaTextureObject_t get() const { return object_; }

private:
  void create(const cudaResourceDesc& resource, cudaTextureAddressMode address,
              cudaTextureFilterMode filter, bool normalized)
  {
    cudaTextureDesc desc{};
    desc.addressMode[0] = address;
    desc.addressMode[1] = address;
    desc.addressMode[2] = address;
    desc.filterMode = filter;
    desc.readMode = cudaReadModeElementType;
    desc.normalizedCoords = normalized;
    cudaSafeCall(cudaCreateTextureObject(&object_, &resource, &desc, nullptr));
  }
  void reset()
  {
    if (object_) { cudaSafeCall(cudaDestroyTextureObject(object_)); object_ = 0;
}
  }
  cudaTextureObject_t object_ = 0;
};
} // namespace pcl::gpu

namespace pcl::device { using pcl::gpu::TextureObject; }
#endif
''')
