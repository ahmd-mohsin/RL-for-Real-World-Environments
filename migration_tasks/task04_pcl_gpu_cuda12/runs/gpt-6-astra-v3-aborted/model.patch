new file mode 100644
index 0000000..bba25b4
--- /dev/null
+++ b/gpu/containers/include/pcl/gpu/containers/impl/texture_object.hpp
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Non-owning, kernel-argument texture views. No device-global binding state.
+ * Linear views deliberately use read-only global memory, including unaligned input.
+ */
+#pragma once
+#include <cuda_runtime.h>
+#include <cstddef>
+#include <limits>
+namespace pcl { namespace gpu {
+template<class T, int Dim, cudaTextureReadMode Mode = cudaReadModeElementType>
+struct TextureView {
+  const T* data = nullptr;
+  std::size_t count = std::numeric_limits<std::size_t>::max() / sizeof(T);
+  cudaTextureObject_t object = 0;
+  cudaTextureAddressMode addressMode[2] = {cudaAddressModeClamp, cudaAddressModeClamp};
+  cudaTextureFilterMode filterMode = cudaFilterModePoint;
+  bool normalized = false;
+};
+template<class T, int D, cudaTextureReadMode M>
+cudaError_t releaseTexture(TextureView<T,D,M>& t) {
+  if (t.object) {
+    auto e = cudaStreamSynchronize(cudaStreamPerThread);
+    if (e != cudaSuccess) return e;
+    e = cudaDestroyTextureObject(t.object); t.object = 0; return e;
+  }
+  return cudaSuccess;
+}
+template<class T, int D, cudaTextureReadMode M, class P>
+cudaError_t bindTexture(std::size_t* offset, TextureView<T,D,M>& t, P ptr,
+                        cudaChannelFormatDesc, std::size_t bytes = std::numeric_limits<std::size_t>::max()) {
+  if (offset) *offset = 0;
+  t.data = reinterpret_cast<const T*>(ptr);
+  t.count = bytes / sizeof(T);
+  return cudaSuccess;
+}
+template<class T, int D, cudaTextureReadMode M, class P>
+cudaError_t bindTexture(std::size_t* offset, TextureView<T,D,M>& t, P ptr, std::size_t bytes) {
+  return bindTexture(offset,t,ptr,cudaCreateChannelDesc<T>(),bytes);
+}
+template<class T, int D, cudaTextureReadMode M, class P>
+cudaError_t bindTexture2D(std::size_t* offset, TextureView<T,D,M>& t, P ptr,
+                          cudaChannelFormatDesc desc, std::size_t w, std::size_t h, std::size_t pitch) {
+  auto e = releaseTexture(t); if(e != cudaSuccess) return e;
+  if(offset) *offset = 0;
+  cudaResourceDesc r{};
+  r.resType = cudaResourceTypePitch2D;
+  r.res.pitch2D.devPtr = const_cast<void*>(reinterpret_cast<const void*>(ptr));
+  r.res.pitch2D.desc = desc; r.res.pitch2D.width = w; r.res.pitch2D.height = h; r.res.pitch2D.pitchInBytes = pitch;
+  cudaTextureDesc d{};
+  d.addressMode[0] = t.addressMode[0]; d.addressMode[1] = t.addressMode[1];
+  d.filterMode = t.filterMode; d.readMode = M; d.normalizedCoords = t.normalized;
+  return cudaCreateTextureObject(&t.object,&r,&d,nullptr);
+}
+}}
+template<class T, int D, cudaTextureReadMode M>
+__device__ __forceinline__ T tex1Dfetch(pcl::gpu::TextureView<T,D,M> t, int i) { return i >= 0 && static_cast<std::size_t>(i) < t.count ? t.data[i] : T{}; }
+template<class T, int D, cudaTextureReadMode M>
+__device__ __forceinline__ T tex2D(pcl::gpu::TextureView<T,D,M> t, float x, float y) { return tex2D<T>(t.object,x,y); }
