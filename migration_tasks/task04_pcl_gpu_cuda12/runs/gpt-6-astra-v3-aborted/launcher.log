namespace pcl
{
  namespace device
  {
    struct Edges
    {        
        enum { UP = 1, DOWN = 2, LEFT = 4, RIGHT = 8, INVALID = 0xF0 };         
        
        unsigned char data;
        
        __device__ __host__ __forceinline__ 
        Edges() : data(0) {};        
    };
    
    enum 
    { 
        CTA_SIZE_X = 32, 
        CTA_SIZE_Y = 8, 

        TILES_PER_BLOCK_X = 1,
        TILES_PER_BLOCK_Y = 4,

        TPB_X = TILES_PER_BLOCK_X,
        TPB_Y = TILES_PER_BLOCK_Y,        

        TILE_COLS = CTA_SIZE_X * TPB_X, 
        TILE_ROWS = CTA_SIZE_Y * TPB_Y,

        MERGE_CTA_SIZE = 256
    };
  }
}

