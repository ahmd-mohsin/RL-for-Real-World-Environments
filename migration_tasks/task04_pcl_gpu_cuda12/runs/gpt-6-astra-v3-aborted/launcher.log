// Monotone union-find. Atomic reads as well as atomic hooks make this valid on
// independently scheduled warps. A kernel boundary separates hooking from
// compression; the representative is always the smallest raster index.
namespace pcl { namespace device {
__device__ int* componentPtr(PtrStepSz<int> p, int i) {
  return p.ptr(i / p.cols) + i % p.cols;
}
__device__ int componentRoot(PtrStepSz<int> p, int i) {
  for (;;) {
    int next = atomicAdd(componentPtr(p,i), 0);
    if (next == i) return i;
    i = next;
  }
}
__device__ void componentUnion(PtrStepSz<int> p, int a, int b) {
  for (;;) {
    a = componentRoot(p,a); b = componentRoot(p,b);
    if (a == b) return;
    int hi = max(a,b), lo = min(a,b);
    int old = atomicMin(componentPtr(p,hi),lo);
    if (old == hi) return;
    a = old; b = lo;
  }
}
__global__ void componentInit(PtrStepSz<int> p) {
  int x = blockIdx.x * blockDim.x + threadIdx.x;
  int y = blockIdx.y * blockDim.y + threadIdx.y;
  if(x < p.cols && y < p.rows) p.ptr(y)[x] = y*p.cols+x;
}
__global__ void componentHook(PtrStepSz<int> p, PtrStep<unsigned char> edges) {
  int x = blockIdx.x * blockDim.x + threadIdx.x;
  int y = blockIdx.y * blockDim.y + threadIdx.y;
  if(x >= p.cols || y >= p.rows) return;
  unsigned e = edges.ptr(y)[x];
  int i = y*p.cols+x;
  if(e & Edges::RIGHT) componentUnion(p,i,i+1);
  if(e & Edges::DOWN) componentUnion(p,i,i+p.cols);
}
__global__ void componentFlatten(PtrStepSz<int> p, PtrStep<unsigned char> edges,
PtrStep<int> out) {
  int x = blockIdx.x * blockDim.x + threadIdx.x;
  int y = blockIdx.y * blockDim.y + threadIdx.y;
  if(x < p.cols && y < p.rows)
    out.ptr(y)[x] = (edges.ptr(y)[x] & Edges::INVALID) ? -1 : 
componentRoot(p,y*p.cols+x);
}
}}
void pcl::device::ConnectedComponents::labelComponents(const 
DeviceArray2D<unsigned char>& edges, DeviceArray2D<int>& comps)
{
  comps.create(edges.rows(), edges.cols());
  // Separate final storage prevents invalid pixels (-1) entering the forest.
  thread_local DeviceArray2D<int> parents;
  parents.create(edges.rows(), edges.cols());
  dim3 block(32,8), grid(divUp(edges.cols(),32), divUp(edges.rows(),8));
  componentInit<<<grid,block>>>(parents);
  componentHook<<<grid,block>>>(parents,edges);
  componentFlatten<<<grid,block>>>(parents,edges,comps);
  cudaSafeCall(cudaGetLastError());
  cudaSafeCall(cudaStreamSynchronize(cudaStreamPerThread));
}
