template <NcvBool tbCacheTextureIImg,
          NcvBool tbCacheTextureCascade,
          NcvBool tbDoAtomicCompaction>
__global__ void 
applyHaarClassifierClassifierParallel(pcl::gpu::TextureView<uint4, 1, 
cudaReadModeElementType> texHaarClassifierNodes, pcl::gpu::TextureView<uint2, 1,
cudaReadModeElementType> texHaarFeatures, pcl::gpu::TextureView<Ncv32u, 1, 
cudaReadModeElementType> texIImage, Ncv32u *d_IImg, Ncv32u IImgStride,
                                                      Ncv32f *d_weights, Ncv32u 
weightsStride,
                                                      HaarFeature64 *d_Features,
HaarClassifierNode128 *d_ClassifierNodes, HaarStage64 *d_Stages,
                                                      Ncv32u *d_inMask, Ncv32u 
*d_outMask,
                                                      Ncv32u mask1Dlen, Ncv32u 
mask2Dstride,
