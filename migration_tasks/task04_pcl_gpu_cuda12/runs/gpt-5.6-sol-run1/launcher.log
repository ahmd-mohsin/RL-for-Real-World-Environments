  } else if (v == "noise") {
    for (size_t i = 0; i < c->points.size(); ++i) {
      auto& p = c->points[i];
      if (!std::isfinite(p.z)) continue;
      float u = (hash32((std::uint32_t)i * 2654435761U) + 0.5f) / 4294967296.f -
