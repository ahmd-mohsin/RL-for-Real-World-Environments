      __device__ __forceinline__ void
      reduce (int i) const
      {
        __shared__ volatile int smem[CTA_SIZE];

        int tid = Block::flattenedThreadId ();

        smem[tid] = i;
        __syncthreads ();

        Block::reduce<CTA_SIZE>(smem, plus ());

        __shared__ bool isLastBlockDone;

        if (tid == 0)
