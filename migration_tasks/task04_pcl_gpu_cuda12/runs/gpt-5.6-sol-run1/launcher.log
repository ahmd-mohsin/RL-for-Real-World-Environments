   257  namespace pcl
   258  {
   259    namespace device
   260    {
   261      struct TrianglesGenerator : public CubeIndexEstimator
   262      {
   263        enum { CTA_SIZE = 256, MAX_GRID_SIZE_X = 65536 };
   264  
   265        const int* occupied_voxels;
   266        const int* vertex_ofssets;
   267        int voxels_count;
   268        float3 cell_size;
   269  
   270        mutable PointType *output;
   271  
   272        __device__ __forceinline__ float3
   273        getNodeCoo (int x, int y, int z) const
   274        {
   275          float3 coo = make_float3 (x, y, z);
   276          coo += 0.5f;                 //shift to volume cell center;
   277  
   278          coo.x *= cell_size.x;
   279          coo.y *= cell_size.y;
   280          coo.z *= cell_size.z;
   281  
   282          return coo;
   283        }
   284  
   285        __device__ __forceinline__ float3
   286        vertex_interp (float3 p0, float3 p1, float f0, float f1) const
   287        {        
   288          float t = (isoValue() - f0) / (f1 - f0 + 1e-15f);
   289          float x = p0.x + t * (p1.x - p0.x);
   290          float y = p0.y + t * (p1.y - p0.y);
   291          float z = p0.z + t * (p1.z - p0.z);
   292          return make_float3 (x, y, z);
   293        }
   294  
   295        __device__ __forceinline__ void
   296        operator () () const
   297        {
   298          int tid = threadIdx.x;
   299          int idx = (blockIdx.y * MAX_GRID_SIZE_X + blockIdx.x) * CTA_SIZE
+ tid;
   300        
   301  
   302          if (idx >= voxels_count)
   303            return;
   304  
   305          int voxel = occupied_voxels[idx];
   306  
   307          int z = voxel / (VOLUME_X * VOLUME_Y);
   308          int y = (voxel - z * VOLUME_X * VOLUME_Y) / VOLUME_X;
   309          int x = (voxel - z * VOLUME_X * VOLUME_Y) - y * VOLUME_X;
   310  
   311          float f[8];
   312          int cubeindex = computeCubeIndex (x, y, z, f);
   313  
   314          // calculate cell vertex positions
   315          float3 v[8];
   316          v[0] = getNodeCoo (x, y, z);
   317          v[1] = getNodeCoo (x + 1, y, z);
   318          v[2] = getNodeCoo (x + 1, y + 1, z);
   319          v[3] = getNodeCoo (x, y + 1, z);
   320          v[4] = getNodeCoo (x, y, z + 1);
   321          v[5] = getNodeCoo (x + 1, y, z + 1);
   322          v[6] = getNodeCoo (x + 1, y + 1, z + 1);
   323          v[7] = getNodeCoo (x, y + 1, z + 1);
   324  
   325          // find the vertices where the surface intersects the cube
   326          // use shared memory to avoid using local
   327          __shared__ float3 vertlist[12][CTA_SIZE];
   328  
   329          vertlist[0][tid] = vertex_interp (v[0], v[1], f[0], f[1]);
   330          vertlist[1][tid] = vertex_interp (v[1], v[2], f[1], f[2]);
   331          vertlist[2][tid] = vertex_interp (v[2], v[3], f[2], f[3]);
   332          vertlist[3][tid] = vertex_interp (v[3], v[0], f[3], f[0]);
   333          vertlist[4][tid] = vertex_interp (v[4], v[5], f[4], f[5]);
   334          vertlist[5][tid] = vertex_interp (v[5], v[6], f[5], f[6]);
   335          vertlist[6][tid] = vertex_interp (v[6], v[7], f[6], f[7]);
   336          vertlist[7][tid] = vertex_interp (v[7], v[4], f[7], f[4]);
   337          vertlist[8][tid] = vertex_interp (v[0], v[4], f[0], f[4]);
   338          vertlist[9][tid] = vertex_interp (v[1], v[5], f[1], f[5]);
   339          vertlist[10][tid] = vertex_interp (v[2], v[6], f[2], f[6]);
   340          vertlist[11][tid] = vertex_interp (v[3], v[7], f[3], f[7]);
   341          __syncthreads ();
   342  
   343          // output triangle vertices
   344          int numVerts = tex1Dfetch (numVertsTex, cubeindex);
   345  
   346          for (int i = 0; i < numVerts; i += 3)
   347          {
   348            int index = vertex_ofssets[idx] + i;
   349  
   350            int v1 = tex1Dfetch (triTex, (cubeindex * 16) + i + 0);
   351            int v2 = tex1Dfetch (triTex, (cubeindex * 16) + i + 1);
   352            int v3 = tex1Dfetch (triTex, (cubeindex * 16) + i + 2);
   353  
   354            store_point (output, index + 0, vertlist[v1][tid]);
   355            store_point (output, index + 1, vertlist[v2][tid]);
   356            store_point (output, index + 2, vertlist[v3][tid]);
   357          }
   358        }
   359  
   360        __device__ __forceinline__ void
   361        store_point (float4 *ptr, int index, const float3& point) const {
   362          ptr[index] = make_float4 (point.x, point.y, point.z, 1.0f);
   363        }
   364      };
   365      __global__ void
   366      trianglesGeneratorKernel (const TrianglesGenerator tg) {tg (); }
   367    }
   368  }
   369  
   370  
   371  void
   372  pcl::device::generateTriangles (const PtrStep<short2>& volume, const 
DeviceArray2D<int>& occupied_voxels, const float3& volume_size, 
DeviceArray<PointType>& output)
   373  {   
   374    int device;
   375    cudaSafeCall( cudaGetDevice(&device) );
   376  
   377    cudaDeviceProp prop;
   378    cudaSafeCall( cudaGetDeviceProperties(&prop, device) );
   379    
   380    int block_size = prop.major < 2 ? 96 : 256; // please see 
TrianglesGenerator::CTA_SIZE
   381  
   382    using Tg = TrianglesGenerator;
   383    Tg tg;
   384  
   385    tg.volume = volume;
   386    tg.occupied_voxels = occupied_voxels.ptr (0);
   387    tg.vertex_ofssets = occupied_voxels.ptr (2);
   388    tg.voxels_count = occupied_voxels.cols ();
   389    tg.cell_size.x = volume_size.x / VOLUME_X;
   390    tg.cell_size.y = volume_size.y / VOLUME_Y;
   391    tg.cell_size.z = volume_size.z / VOLUME_Z;
   392    tg.output = output;
   393  
   394    int blocks_num = divUp (tg.voxels_count, block_size);
   395  
   396    dim3 block (block_size);
   397    dim3 grid(min(blocks_num, Tg::MAX_GRID_SIZE_X), divUp(blocks_num, 
Tg::MAX_GRID_SIZE_X));
   398  
   399    trianglesGeneratorKernel<<<grid, block>>>(tg);
   400    cudaSafeCall ( cudaGetLastError () );
   401    cudaSafeCall (cudaDeviceSynchronize ());
   402  }

