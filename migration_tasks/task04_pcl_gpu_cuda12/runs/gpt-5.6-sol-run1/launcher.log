    77      template<bool testFG> __device__ __forceinline__ Label 
    78      evaluateTree(int u, int v, float f, int treeHeight, int numNodes, 
const Node* nodes, const Label* leaves, const PtrStepSz<unsigned short> 
depthMap, int fgThresh)
    79      {
    80        int    depth = readClamped(depthMap, u, v);
    81  
    82        float  scale = f / depth;
    83  
    84        // go down the tree
    85        int nid = 0;
    86        for(int nodeDepth = 0; nodeDepth < treeHeight; ++nodeDepth)
    87        {
    88          const Node node = nodes[nid];
    89  
    90          const AttribLocation& loc = node.loc;
    91          int d1 = readClamped(depthMap, static_cast<int>(u + loc.du1 * 
scale), static_cast<int>(v + loc.dv1 * scale));
    92          int d2 = readClamped(depthMap, static_cast<int>(u + loc.du2 * 
scale), static_cast<int>(v + loc.dv2 * scale));
    93  
    94          if (testFG)
    95          {
    96            if( d1 - depth > fgThresh ) 
    97              d1 = std::numeric_limits<short>::max();
    98  
    99            if( d2 - depth > fgThresh ) 
   100              d2 = std::numeric_limits<short>::max();
   101          }
   102  
   103          int delta = d1-d2;
   104          bool test = delta > (int)node.thresh;
   105          if( test ) nid = nid*2+2;
   106          else       nid = nid*2+1;
   107        }
   108        return leaves[nid-numNodes];
   109      }
