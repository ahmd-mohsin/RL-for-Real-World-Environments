public:
  template <class T>
  explicit TextureBinder(const DeviceArray2D<T>& arr,
                         const cudaTextureDesc& description = 
defaultDescription())
  {
    createPitch2D(arr.ptr(), arr.cols(), arr.rows(), arr.step(), description);
  }

  template <class T>
  explicit TextureBinder(const PtrStepSz<T>& arr,
                         const cudaTextureDesc& description = 
defaultDescription())
  {
    createPitch2D(arr.data, arr.cols, arr.rows, arr.step, description);
  }

  template <class T>
  explicit TextureBinder(const DeviceArray<T>& arr,
                         const cudaTextureDesc& description = 
defaultDescription())
  {
    createLinear(arr.ptr(), arr.sizeBytes(), description);
  }

  template <class T>
  explicit TextureBinder(const PtrSz<T>& arr,
                         const cudaTextureDesc& description = 
defaultDescription())
  {
    createLinear(arr.data, arr.size * arr.elemSize(), description);
  }

  TextureBinder(const TextureBinder&) = delete;
  TextureBinder& operator=(const TextureBinder&) = delete;
  ~TextureBinder() { if (object_) 
cudaSafeCall(cudaDestroyTextureObject(object_)); }

  cudaTextureObject_t get() const { return object_; }
  operator cudaTextureObject_t() const { return object_; }

  static cudaTextureDesc defaultDescription()
  {
    cudaTextureDesc result{};
    result.addressMode[0] = cudaAddressModeClamp;
    result.addressMode[1] = cudaAddressModeClamp;
    result.filterMode = cudaFilterModePoint;
    result.readMode = cudaReadModeElementType;
    return result;
  }

private:
  template <class T>
  void createPitch2D(T* ptr, std::size_t width, std::size_t height,
                     std::size_t pitch, const cudaTextureDesc& description)
  {
    cudaResourceDesc resource{};
    resource.resType = cudaResourceTypePitch2D;
    resource.res.pitch2D.devPtr = ptr;
    resource.res.pitch2D.desc = cudaCreateChannelDesc<T>();
    resource.res.pitch2D.width = width;
    resource.res.pitch2D.height = height;
    resource.res.pitch2D.pitchInBytes = pitch;
    cudaSafeCall(cudaCreateTextureObject(&object_, &resource, &description, 
nullptr));
  }

  template <class T>
  void createLinear(T* ptr, std::size_t bytes, const cudaTextureDesc& 
description)
  {
    cudaResourceDesc resource{};
    resource.resType = cudaResourceTypeLinear;
    resource.res.linear.devPtr = ptr;
    resource.res.linear.desc = cudaCreateChannelDesc<T>();
    resource.res.linear.sizeInBytes = bytes;
    cudaSafeCall(cudaCreateTextureObject(&object_, &resource, &description, 
nullptr));
  }

  cudaTextureObject_t object_{};
};'''
