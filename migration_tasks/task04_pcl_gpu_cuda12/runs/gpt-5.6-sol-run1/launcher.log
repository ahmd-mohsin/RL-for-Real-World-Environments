        }
        __syncthreads ();

        if (isLastBlockDone)
        {
          int sum = 0;
          int stride = Block::stride ();
          for (int pos = tid; pos < gridDim.x * gridDim.y; pos += stride)
            sum += gbuf[pos];

          smem[tid] = sum;
          __syncthreads ();
          Block::reduce<CTA_SIZE>(smem, plus ());

          if (tid == 0)
          {
            gbuf[0] = smem[0];
            count = 0;
          }
        }
