   502    comps.create(edges.rows(), edges.cols());
   503  
   504    dim3 block(CTA_SIZE_X, CTA_SIZE_Y);
   505    dim3 grid(divUp(edges.cols(), TILE_COLS), divUp(edges.rows(), 
TILE_ROWS));
   506    
   507    smemTilesKernel<<<grid, block>>>(edges, comps);
   508    cudaSafeCall( cudaGetLastError() );
   509    cudaSafeCall( cudaDeviceSynchronize() );
   510  
   511    TextureBinder binder(edges, edgesTex);
   512  
   513    // the code below assumes such resolution
   514    assert(edges.cols() == 640 && edges.rows() == 480);
   515  
   516    TilesMerge tm;
   517    tm.comps = comps;
   518  
   519    //merge 4x3 -> 5x5 grid
   520    tm.tileSizeX = TILE_COLS;
   521    tm.tileSizeY = TILE_ROWS;
   522    tm.tilesNumX = 4;
   523    tm.tilesNumY = 3;
   524  
   525    grid.x = edges.cols()/(tm.tileSizeX * tm.tilesNumX);
   526    grid.y = edges.rows()/(tm.tileSizeY * tm.tilesNumY);
   527    
   528    mergeKernel<<<grid, 768>>>(tm);
   529    cudaSafeCall( cudaGetLastError() );
   530    cudaSafeCall( cudaDeviceSynchronize() );

