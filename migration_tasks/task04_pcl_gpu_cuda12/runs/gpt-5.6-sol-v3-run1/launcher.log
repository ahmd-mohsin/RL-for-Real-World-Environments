      * \param[out] output triangle array            
      */
    void
    generateTriangles(const PtrStep<short2>& volume, const DeviceArray2D<int>& 
occupied_voxels, const float3& volume_size, DeviceArray<PointType>& output, 
const int* tri_table, const int* num_verts_table);
