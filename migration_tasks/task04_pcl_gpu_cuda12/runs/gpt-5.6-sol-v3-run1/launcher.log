    76      template<bool testFG> __device__ __forceinline__ Label 
    77      evaluateTree(int u, int v, float f, int treeHeight, int numNodes, 
const Node* nodes, const Label* leaves)
    78      {
    79        int    depth = tex2D(depthTex, u, v);
    80  
    81        float  scale = f / depth;
    82  
    83        // go down the tree
    84        int nid = 0;
    85        for(int nodeDepth = 0; nodeDepth < treeHeight; ++nodeDepth)
    86        {
    87          const Node node = nodes[nid];
    88  
    89          const AttribLocation& loc = node.loc;
    90          int d1 = tex2D (depthTex, u + loc.du1 * scale, v + loc.dv1 * 
scale);
    91          int d2 = tex2D (depthTex, u + loc.du2 * scale, v + loc.dv2 * 
scale);
    92  
    93          if (testFG)
    94          {
    95            if( d1 - depth > constFGThresh ) 
    96              d1 = std::numeric_limits<short>::max();
    97  
    98            if( d2 - depth > constFGThresh ) 
    99              d2 = std::numeric_limits<short>::max();
   100          }
   101  
   102          int delta = d1-d2;
   103          bool test = delta > (int)node.thresh;
   104          if( test ) nid = nid*2+2;
   105          else       nid = nid*2+1;
   106        }
   107        return leaves[nid-numNodes];
   108      }
