    template<typename T>
    struct TransformEstimator
    {
      enum
      {
        CTA_SIZE_X = 32,
        CTA_SIZE_Y = 8,
        CTA_SIZE = CTA_SIZE_X * CTA_SIZE_Y
      };

      struct plus
      {
        __forceinline__ __device__ T
        operator () (const T &lhs, const volatile T &rhs) const {
          return lhs + rhs;
        }
      };

