   485      __global__ void flattenTreesKernel(PtrStepSz<int> comps, const 
PtrStep<Edges> edges)
   486      {
   487        int x = threadIdx.x + blockIdx.x * blockDim.x;
   488        int y = threadIdx.y + blockIdx.y * blockDim.y;       
   489  
   490        if( x < comps.cols && y < comps.rows)
   491        {  
   492          int invalid = edges.ptr(y)[x].data & Edges::INVALID;            
   493          comps.ptr(y)[x] = invalid ? -1 : findRoot(comps, 
comps.ptr(y)[x]);
   494        }             
   495      }
   496    }
