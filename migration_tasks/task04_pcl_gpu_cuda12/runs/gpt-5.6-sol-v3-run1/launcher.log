pcl::device::CUDATree::CUDATree (int treeHeight_arg, const std::vector<Node>& 
nodes, const std::vector<Label>& leaves)
{
  treeHeight = treeHeight_arg;
#include <limits>

#include "internal.h"
#include <pcl/gpu/utils/safe_call.hpp>
#include <pcl/gpu/containers/initialization.h>
#include <pcl/gpu/containers/impl/texture_binder.hpp>
#include "npp.h"

#include <stdio.h>

namespace pcl
{
  namespace device
  {
    __global__ void colorKernel(const PtrStepSz<unsigned char> labels, const 
uchar4* map, PtrStep<uchar4> output)
    {
      int x = threadIdx.x + blockIdx.x * blockDim.x;
      int y = threadIdx.y + blockIdx.y * blockDim.y;

      if (x < labels.cols && y < labels.rows)
      {
        int l = labels.ptr(y)[x];
        output.ptr(y)[x] = map[l];
      }
    }

    __global__ void mixedColorKernel(const PtrStepSz<unsigned char> labels, 
const uchar4* map, PtrStepSz<uchar4> rgba, PtrStep<uchar4> output)
    {
      int x = threadIdx.x + blockIdx.x * blockDim.x;
      int y = threadIdx.y + blockIdx.y * blockDim.y;

      if (x < labels.cols && y < labels.rows)
      {        
        uchar4 c = rgba.ptr(y)[x];

        int l = labels.ptr(y)[x];
        if (l != 8) // RHip but should be background
          c = map[l];

        output.ptr(y)[x] = c;
      }
    }
  }
}

void pcl::device::colorLMap(const Labels& labels, const DeviceArray<uchar4>& 
map, Image& rgba)
{
  dim3 block(32, 8);
  dim3 grid( divUp(labels.cols(), block.x), divUp(labels.rows(), block.y) );

  colorKernel<<< grid, block >>>( labels, map.ptr(), rgba );

  cudaSafeCall( cudaGetLastError() );
  cudaSafeCall( cudaDeviceSynchronize() );  
}

void pcl::device::mixedColorMap(const Labels& labels, const DeviceArray<uchar4>&
map, const Image& rgba, Image& output)
{
  dim3 block(32, 8);
  dim3 grid(divUp(labels.cols(), block.x), divUp(labels.rows(), block.y));

  mixedColorKernel<<<grid, block>>>(labels, map.ptr(), rgba, output);
  cudaSafeCall( cudaGetLastError() );
  cudaSafeCall( cudaDeviceSynchronize() );
}

