// all trackers of a --concurrent --throughput run start their timed loops 
together
std::mutex g_start_mutex;
std::condition_variable g_start_cv;
int g_start_waiting = 0, g_start_total = 1;
void startBarrier() {
  std::unique_lock<std::mutex> lk(g_start_mutex);
  if (++g_start_waiting >= g_start_total) g_start_cv.notify_all();
  else g_start_cv.wait(lk, [] { return g_start_waiting >= g_start_total; });
}

struct Args {
  std::string mode = "kinfu", out = ".";
  int frames = 120, noise = -1;
  int stop = 0;           // > 0: run only the first `stop` frames of the 
trajectory
  int extract_every = 0;  // > 0: extract a mesh (and a cloud) every K frames 
and record checksums
  float icp_trunc = 0.f, shift = 0.8f;  // shift: kinfuLS volume shifting 
distance (m)
  bool skip_mesh = false, color = false, api = false;
  bool throughput = false;  // pre-rendered frames tracked back to back, no 
device-wide syncs (see run_frames)
  std::string traj, scene;
};

Args parse(int argc, char** argv) {
  Args a;
  for (int i = 1; i < argc; ++i) {
    std::string k = argv[i];
    auto val = [&]() -> std::string {
      if (i + 1 >= argc) throw std::runtime_error("missing value for " + k);
      return argv[++i];
    };
    if (k == "--mode") a.mode = val();
    else if (k == "--frames") a.frames = std::stoi(val());
    else if (k == "--stop") a.stop = std::stoi(val());
    else if (k == "--shift") a.shift = std::stof(val());
    else if (k == "--extract-every") a.extract_every = std::stoi(val());
    else if (k == "--out") a.out = val();
    else if (k == "--noise") a.noise = std::stoi(val());
    else if (k == "--icp-trunc") a.icp_trunc = std::stof(val());
    else if (k == "--skip-mesh") a.skip_mesh = true;
    else if (k == "--color") a.color = true;
    else if (k == "--api") a.api = true;
    else if (k == "--throughput") a.throughput = true;
    else if (k == "--traj") a.traj = val();
    else if (k == "--scene") a.scene = val();
    else throw std::runtime_error("unknown argument " + k);
  }
  return a;
}

std::string mat(const Eigen::Affine3f& p) {
