ref[1]) + std::abs((int)cols[i].b - ref[2])) / 3.0;
    }
  }
  const double k = n ? 1.0 / n : 0;
  std::string s = "{\"points\": " + std::to_string(n) + ", \"mean\": [" + 
num(mean[0] * k) + "," + num(mean[1] * k) + "," + num(mean[2] * k) + "]";
  if (gt) s += ", \"abs_err_mean\": " + num(err * k);
  return s + "}";
}

