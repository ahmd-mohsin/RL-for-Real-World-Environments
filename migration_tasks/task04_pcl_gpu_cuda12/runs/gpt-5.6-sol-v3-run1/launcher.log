bool finite3(float x, float y, float z) { return std::isfinite(x) && 
std::isfinite(y) && std::isfinite(z); }

// oriented points against the scene: count, mean |sdf| and mean normal angle 
(degrees, sign-free)
struct Oriented {
  long long valid = 0;
  double sdf = 0, angle = 0, absn[3] = {0, 0, 0};
  void add(const Scene& scene, const Eigen::Affine3f& T, float px, float py, 
float pz, float nx, float ny, float nz, bool gt) {
    if (!finite3(px, py, pz) || !finite3(nx, ny, nz)) return;
    Eigen::Vector3f n(nx, ny, nz);
    if (n.norm() < 0.5f) return;
    ++valid;
    absn[0] += std::abs(nx); absn[1] += std::abs(ny); absn[2] += std::abs(nz);
    if (!gt) return;
    Eigen::Vector3f p = T * Eigen::Vector3f(px, py, pz);
    sdf += std::abs(scene.sdf(p));
    float c = std::abs((T.linear() * n.normalized()).dot(sceneNormal(scene, 
p)));
    angle += std::acos(std::min(1.f, c)) * 57.29578;
  }
  std::string json(bool gt) const {
    double k = valid ? 1.0 / valid : 0;
    std::ostringstream o;
    o << "{\"valid\": " << valid << ", \"abs_normal_mean\": [" << num(absn[0] * 
k) << "," << num(absn[1] * k) << "," << num(absn[2] * k) << "]";
    if (gt) o << ", \"sdf_mean\": " << num(sdf * k) << ", \"angle_deg_mean\": " 
<< num(angle * k);
    o << "}";
    return o.str();
  }
};

template <class Map>
std::string mapStats(const Scene& scene, const Eigen::Affine3f& T, const Map& 
vmap, const Map& nmap, bool gt) {
  std::vector<float> v, n;
  int cv, cn;
  vmap.download(v, cv);
  nmap.download(n, cn);
  const size_t H = v.size() / cv / 3;
  Oriented s;
  for (size_t y = 0; y < H; ++y)
    for (int x = 0; x < cv; ++x)
      s.add(scene, T, v[y * cv + x], v[(y + H) * cv + x], v[(y + 2 * H) * cv + 
x], n[y * cn + x], n[(y + H) * cn + x],
            n[(y + 2 * H) * cn + x], gt);
  return s.json(gt);
}

template <class Pixel>
std::string saveView(const std::string& path, const 
pcl::gpu::DeviceArray2D<Pixel>& view) {
  std::vector<Pixel> h;
  int cols;
  view.download(h, cols);
  const int rows = cols ? (int)(h.size() / cols) : 0;
  std::ofstream f(path, std::ios::binary);
  f.write(reinterpret_cast<const char*>(&rows), 4);
  f.write(reinterpret_cast<const char*>(&cols), 4);
  double sum[3] = {0, 0, 0};
  for (const auto& p : h) {
    const unsigned char c[3] = {p.r, p.g, p.b};
    f.write(reinterpret_cast<const char*>(c), 3);
    sum[0] += c[0]; sum[1] += c[1]; sum[2] += c[2];
  }
  const double k = h.empty() ? 0 : 1.0 / h.size();
  return "{\"rows\": " + std::to_string(rows) + ", \"cols\": " + 
std::to_string(cols) + ", \"mean\": [" + num(sum[0] * k) + "," +
         num(sum[1] * k) + "," + num(sum[2] * k) + "]}";
}

std::string colorStats(const Eigen::Affine3f& T, const 
