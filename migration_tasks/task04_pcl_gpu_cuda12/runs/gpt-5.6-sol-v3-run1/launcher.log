            smem[tid] = row[i] * row[j];
            __syncthreads ();

            Block::reduce<CTA_SIZE>(smem, plus ());

            if (tid == 0)
              gbuf.ptr (shift++)[blockIdx.x + gridDim.x * blockIdx.y] = smem[0];
          }
        }
      }
    };

