new file mode 100644
index 0000000..a564799
--- /dev/null
+++ b/test/gpu/kinfu/test_isolation.cpp
@@ -0,0 +1,94 @@
+/*
+ * Copyright (c) 2026, Point Cloud Library contributors.
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+#include <pcl/gpu/kinfu/tsdf_volume.h>
+#include <pcl/gpu/kinfu/marching_cubes.h>
+#include <pcl/gpu/kinfu_large_scale/tsdf_volume.h>
+#include <pcl/gpu/kinfu_large_scale/marching_cubes.h>
+#include <stdexcept>
+#include <iostream>
+#include <cstring>
+#include <future>
+#include <vector>
+
+namespace {
+void require(bool condition) {
+  if (!condition) throw std::runtime_error("volume extraction regression");
+}
+using Points = std::vector<pcl::PointXYZ>;
+struct Surface {
+  Points cloud, mesh, small_cloud, small_mesh;
+};
+
+template<class Volume, class Mesher>
+Surface extract(const std::vector<int>& packed) {
+  Volume volume(Eigen::Vector3i::Constant(512));
+  auto data = volume.data();
+  data.upload(packed.data(), 512 * sizeof(int), 512 * 512, 512);
+  Mesher mesher;
+  pcl::gpu::DeviceArray<pcl::PointXYZ> cloud, mesh, small_cloud(997), small_mesh(1001);
+  pcl::gpu::DeviceArray<pcl::PointXYZ> too_small(2);
+  require(mesher.run(volume, too_small).empty());
+  Surface result;
+  volume.fetchCloud(cloud).download(result.cloud);
+  mesher.run(volume, mesh).download(result.mesh);
+  volume.fetchCloud(small_cloud).download(result.small_cloud);
+  mesher.run(volume, small_mesh).download(result.small_mesh);
+  return result;
+}
+
+void equal(const Points& a, const Points& b) {
+  require(a.size() == b.size());
+  require(std::memcmp(a.data(), b.data(), a.size() * sizeof(pcl::PointXYZ)) == 0);
+}
+void equal(const Surface& a, const Surface& b) {
+  equal(a.cloud, b.cloud);
+  equal(a.mesh, b.mesh);
+  equal(a.small_cloud, b.small_cloud);
+  equal(a.small_mesh, b.small_mesh);
+}
+void prefix(const Points& a, const Points& small) {
+  require(a.size() >= small.size());
+  require(std::memcmp(a.data(), small.data(), small.size() * sizeof(pcl::PointXYZ)) == 0);
+}
+}
+
+void testConcurrentExtractionAndBoundedPrefixes() {
+  // Two observed slices, with a non-planar crossing between them. The rest of
+  // the volume is unobserved. Include all x/y boundaries and partial output CTAs.
+  std::vector<int> packed(std::size_t(512) * 512 * 512, 0);
+  for (int z = 200; z <= 201; ++z)
+    for (int y = 0; y < 512; ++y)
+      for (int x = 0; x < 512; ++x) {
+        short distance = (z == 200 ? -1 : 1) * (1000 + ((x + 3 * y + z) % 37) * 77);
+        packed[(std::size_t(z) * 512 + y) * 512 + x] = 0x10000 | static_cast<unsigned short>(distance);
+      }
+  using V = pcl::gpu::TsdfVolume;
+  using M = pcl::gpu::MarchingCubes;
+  using L = pcl::gpu::kinfuLS::TsdfVolume;
+  using LM = pcl::gpu::kinfuLS::MarchingCubes;
+  auto reference = extract<V, M>(packed);
+  require(reference.small_cloud.size() == 997);
+  require(reference.small_mesh.size() == 999);
+  prefix(reference.cloud, reference.small_cloud);
+  prefix(reference.mesh, reference.small_mesh);
+  equal(reference, extract<L, LM>(packed));
+  auto a = std::async(std::launch::async, [&] { return extract<V, M>(packed); });
+  auto b = std::async(std::launch::async, [&] { return extract<L, LM>(packed); });
+  auto c = std::async(std::launch::async, [&] { return extract<V, M>(packed); });
+  equal(reference, a.get());
+  equal(reference, b.get());
+  equal(reference, c.get());
+}
+
+int main() {
+  try {
+    testConcurrentExtractionAndBoundedPrefixes();
+    std::cout << "concurrent extraction and bounded prefixes passed\n";
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
