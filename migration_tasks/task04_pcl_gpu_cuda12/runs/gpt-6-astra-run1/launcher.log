pcl/gpu/containers/include/pcl/gpu/containers/impl/texture_binder.hpp
#ifndef PCL_GPU_UTILS_TEXTURE_BINDER_HPP_
#define PCL_GPU_UTILS_TEXTURE_BINDER_HPP_

#include <pcl/gpu/containers/device_array.h>
#include <pcl/gpu/utils/safe_call.hpp>
#include <cuda_runtime.h>
#include <vector>
#include <cstdint>

namespace pcl { namespace gpu {
// A trivially copyable kernel argument. Ownership stays with the invoking host
// operation, never in a device symbol or a process-wide texture binding.
template<class T> struct TextureView {
  cudaTextureObject_t object = 0;
  cudaTextureAddressMode addressMode[2] = {cudaAddressModeClamp, 
cudaAddressModeClamp};
  cudaTextureFilterMode filterMode = cudaFilterModePoint;
  bool normalized = false;
};

template<class T> __device__ __forceinline__ T tex1Dfetch(TextureView<T> t, int 
i) {
  return ::tex1Dfetch<T>(t.object, i);
}
template<class T> __device__ __forceinline__ T tex2D(TextureView<T> t, float x, 
float y) {
  return ::tex2D<T>(t.object, x, y);
}

class TextureScope {
  std::vector<cudaTextureObject_t> objects_;
  cudaStream_t stream_;
  bool synchronize_;
  template<class T> cudaError_t create(TextureView<T>& t, cudaResourceDesc& r) {
    cudaTextureDesc d{};
    d.addressMode[0] = t.addressMode[0];
    d.addressMode[1] = t.addressMode[1];
    d.filterMode = t.filterMode;
    d.readMode = cudaReadModeElementType;
    d.normalizedCoords = t.normalized;
    auto e = cudaCreateTextureObject(&t.object, &r, &d, nullptr);
    if (e == cudaSuccess) objects_.push_back(t.object);
    return e;
  }
public:
  explicit TextureScope(cudaStream_t stream = 0, bool synchronize = true)
    : stream_(stream), synchronize_(synchronize) {}
  TextureScope(const TextureScope&) = delete;
  TextureScope& operator=(const TextureScope&) = delete;
  ~TextureScope() {
    // CUDA requires the resource to remain alive until its last use completes.
    if (synchronize_ && !objects_.empty()) 
cudaSafeCall(cudaStreamSynchronize(stream_));
    for (auto o : objects_) cudaSafeCall(cudaDestroyTextureObject(o));
  }
  template<class T, class P>
  cudaError_t bind(size_t* offset, TextureView<T>& t, const P* p,
                   cudaChannelFormatDesc desc, size_t bytes) {
    int device, alignment;
    auto e = cudaGetDevice(&device);
    if (e != cudaSuccess) return e;
    e = cudaDeviceGetAttribute(&alignment, cudaDevAttrTextureAlignment, device);
    if (e != cudaSuccess) return e;
    auto address = reinterpret_cast<std::uintptr_t>(p);
    size_t delta = address % alignment;
    if (offset) *offset = delta;
    else if (delta) return cudaErrorInvalidValue;
    cudaResourceDesc r{};
    r.resType = cudaResourceTypeLinear;
    r.res.linear.devPtr = reinterpret_cast<void*>(address - delta);
    r.res.linear.desc = desc;
    r.res.linear.sizeInBytes = bytes + delta;
    return create(t, r);
  }
  template<class T, class P>
  cudaError_t bind(size_t* offset, TextureView<T>& t, const P* p, size_t bytes) 
{
    return bind(offset, t, p, cudaCreateChannelDesc<T>(), bytes);
  }
  template<class T, class P>
  cudaError_t bind2D(size_t* offset, TextureView<T>& t, const P* p,
                     cudaChannelFormatDesc desc, size_t width, size_t height, 
size_t pitch) {
    if (offset) *offset = 0;
    cudaResourceDesc r{};
    r.resType = cudaResourceTypePitch2D;
    r.res.pitch2D.devPtr = const_cast<P*>(p);
    r.res.pitch2D.desc = desc;
    r.res.pitch2D.width = width;
    r.res.pitch2D.height = height;
    r.res.pitch2D.pitchInBytes = pitch;
    return create(t, r);
  }
};

class TextureBinder {
  TextureScope scope_;
public:
  template<class T> TextureBinder(const DeviceArray2D<T>& a, TextureView<T>& t)
    : TextureBinder(static_cast<PtrStepSz<T>>(a), t) {}
  template<class T> TextureBinder(const DeviceArray<T>& a, TextureView<T>& t)
    : TextureBinder(static_cast<PtrSz<T>>(a), t) {}
  template<class T> TextureBinder(const PtrStepSz<T>& a, TextureView<T>& t) {
    cudaSafeCall(scope_.bind2D(nullptr, t, a.data, cudaCreateChannelDesc<T>(), 
a.cols, a.rows, a.step));
  }
  template<class T> TextureBinder(const PtrSz<T>& a, TextureView<T>& t) {
    cudaSafeCall(scope_.bind(nullptr, t, a.data, a.size * sizeof(T)));
  }
};
}} // pcl::gpu
namespace pcl { namespace device {
using pcl::gpu::TextureBinder;
using pcl::gpu::TextureView;
}}
#endif
