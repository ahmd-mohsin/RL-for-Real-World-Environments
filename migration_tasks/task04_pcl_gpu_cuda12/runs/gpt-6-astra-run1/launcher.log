template <bool tbDoSqr, class T_in, class T_out>
NCVStatus scanRowsWrapperDevice(T_in *d_src, Ncv32u srcStride,
                                T_out *d_dst, Ncv32u dstStride, NcvSize32u roi)
{
    TextureSet textures;
    pcl::gpu::TextureScope textures_owner(nppStGetActiveCUDAstream());

    cudaChannelFormatDesc cfdTex;
    std::size_t alignmentOffset = 0;
    if (sizeof(T_in) == 1)
    {
        cfdTex = cudaCreateChannelDesc<Ncv8u>();
        ncvAssertCUDAReturn(textures_owner.bind(&alignmentOffset, 
textures.tex8u, d_src, cfdTex, roi.height * srcStride), 
NPPST_TEXTURE_BIND_ERROR);

    }
    scanRows
        <T_in, T_out, tbDoSqr>
        <<<roi.height, NUM_SCAN_THREADS, 0, nppStGetActiveCUDAstream()>>>
        (textures, d_src, (Ncv32u)alignmentOffset, roi.width, srcStride, d_dst, 
dstStride);
    
    ncvAssertCUDALastErrorReturn(NPPST_CUDA_KERNEL_EXECUTION_ERROR);

    return NPPST_SUCCESS;
}


