def add_arg(s,names,arg='textures',decl='const TextureSet& textures'):
    pat=r'\b('+ '|'.join(names)+r')\s*(?:<[^;{}()]*?>\s*)?(?:<<<.*?>>>\s*)?\('
    edits=[]
    for m in re.finditer(pat,s,re.S):
        pre=s[max(s.rfind(';',0,m.start()),s.rfind('{',0,m.start()),s.rfind('}',
0,m.start()))+1:m.start()]
        definition='__device__' in pre or '__global__' in pre
        d=decl.replace('const TextureSet&','TextureSet') if '__global__' in pre 
else decl
        edits.append((m.end(), (d if definition else arg)+', '))
    for i,t in reversed(edits):s=s[:i]+t+s[i:]
    return s

