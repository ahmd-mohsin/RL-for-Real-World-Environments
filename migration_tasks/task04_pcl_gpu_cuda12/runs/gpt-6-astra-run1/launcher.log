/*
 * Copyright (c) 2026, Point Cloud Library contributors.
 * SPDX-License-Identifier: BSD-3-Clause
 */
#pragma once

#include <pcl/gpu/utils/safe_call.hpp>
#include <cub/device/device_scan.cuh>
#include <cuda_runtime.h>
#include <algorithm>

namespace pcl { namespace device {

// A warp owns one column of the volume. Within a column, traversal is ordered;
// only the order in which warps reserve staging space is nondeterministic.
// Record that permutation, scan the (small) array of column sizes, then 
scatter.
// This is linear in the output size, rather than sorting the extracted surface.
struct WarpCompaction {
  unsigned* keys;
  int* counts;
  int* counter;
  bool direct = false;

  __device__ unsigned warp() const {
    return (blockIdx.y * gridDim.x + blockIdx.x) * blockDim.y + threadIdx.y;
  }
  __device__ int reserve(int n, int local) const {
    if (direct) return counts[warp()] + local;
    int base = 0;
    if (threadIdx.x == 0) base = atomicAdd(counter, n);
    return __shfl_sync(0xffffffff, base, 0);
  }
  __device__ void record(int index, int local) const {
    // A 32-lane column has at most 32 * 3 * 512 entries.
    if (!direct) keys[index] = (warp() << 16) | unsigned(local);
  }
  __device__ void finish(int n) const {
    if (!direct && threadIdx.x == 0) counts[warp()] = n;
  }
};

template<class T> struct CompactArrayWriter {
  T* data;
  __device__ void operator()(int i, const T& v) const { data[i] = v; }
};

template<class T, class Writer>
__global__ void scatterWarpCompaction(const T* values, const unsigned* keys,
                                     const int* offsets, int size, Writer out) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < size) {
    unsigned key = keys[i];
    out(offsets[key >> 16] + (key & 65535), values[i]);
  }
}

template<class T> class WarpedCompaction {
  void* allocation_ = nullptr;
  void* scan_storage_;
  size_t scan_bytes_ = 0;
  int capacity_, warps_;
  static size_t aligned(size_t n) { return (n + 255) & ~size_t(255); }
public:
  T* values;
  WarpCompaction device;
  WarpedCompaction(int capacity, int warps) : capacity_(capacity), warps_(warps)
{
    cudaSafeCall(cub::DeviceScan::ExclusiveSum(nullptr, scan_bytes_,
                                              (int*)nullptr, (int*)nullptr, 
warps));
    size_t a = aligned(sizeof(T) * capacity);
    size_t b = aligned(sizeof(unsigned) * capacity);
    size_t c = aligned(sizeof(int) * (warps + 1));
    // Stream-ordered scratch avoids cudaMalloc/cudaFree's device-wide fences.
    // Each invocation owns its allocation; the pool never aliases live calls.
    cudaSafeCall(cudaMallocAsync(&allocation_, a + b + c + scan_bytes_, 0));
    char* p = static_cast<char*>(allocation_);
    values = reinterpret_cast<T*>(p);
    device.keys = reinterpret_cast<unsigned*>(p + a);
    device.counts = reinterpret_cast<int*>(p + a + b);
    device.counter = device.counts + warps;
    scan_storage_ = p + a + b + c;
    cudaSafeCall(cudaMemsetAsync(device.counts, 0, sizeof(int) * (warps + 1), 
0));
  }
  WarpedCompaction(const WarpedCompaction&) = delete;
  WarpedCompaction& operator=(const WarpedCompaction&) = delete;
  ~WarpedCompaction() { cudaSafeCall(cudaFreeAsync(allocation_, 0)); }
  int scan() {
    int size;
    cudaSafeCall(cudaMemcpy(&size, device.counter, sizeof(size), 
cudaMemcpyDeviceToHost));
    cudaSafeCall(cub::DeviceScan::ExclusiveSum(scan_storage_, scan_bytes_,
                                              device.counts, device.counts, 
warps_));
    return size;
  }
  template<class Writer> void scatter(int size, Writer out) {
    if (size) {
      scatterWarpCompaction<<<(size + 255) / 256, 256>>>(values, device.keys, 
device.counts, size, out);
      cudaSafeCall(cudaGetLastError());
    }
  }
};
}} // pcl::device
