Eigen::Affine3f trajectoryPose(const std::string& traj, int k, int n) {
  float t = n > 1 ? float(k) / float(n - 1) : 0.f;
  Eigen::Affine3f pose = Eigen::Affine3f::Identity();
  if (traj == "orbit") {
    // a slow sweep in front of the objects (small inter-frame motion, as KinFu 
needs)
    float a = 0.35f * std::sin(6.2831853f * t);
    float b = 0.12f * std::sin(12.566371f * t);
    pose.linear() = (Eigen::AngleAxisf(a, Eigen::Vector3f::UnitY()) * 
Eigen::AngleAxisf(b, Eigen::Vector3f::UnitX())).toRotationMatrix();
    pose.translation() = Eigen::Vector3f(1.5f + 0.45f * std::sin(6.2831853f * 
t), 1.35f + 0.1f * std::sin(18.849556f * t),
                                         0.35f + 0.25f * (1.f - 
std::cos(6.2831853f * t)));
  } else if (traj == "static") {
    pose.translation() = Eigen::Vector3f(1.5f, 1.35f, 0.35f);
  } else if (traj == "walk") {
    // walk along the gallery (x from 0.9 to 6.9 m), facing the back wall, with 
a slight wobble
    float yaw = 0.15f * std::sin(12.566371f * t);
    pose.linear() = (Eigen::AngleAxisf(yaw, Eigen::Vector3f::UnitY()) *
                     Eigen::AngleAxisf(0.06f * std::sin(18.849556f * t), 
Eigen::Vector3f::UnitX())).toRotationMatrix();
    pose.translation() = Eigen::Vector3f(0.9f + 6.0f * t, 1.3f + 0.04f * 
std::sin(31.4159f * t), 0.55f + 0.15f * std::sin(6.2831853f * t));
  } else {
    throw std::runtime_error("unknown trajectory " + traj);
  }
  return pose;
