// ---------------------------------------------------------------- float 
filters, resize, interpolation
std::vector<Ncv32f> floatImage(int W, int H, Ncv32u stepElems, float phase) {
  std::vector<Ncv32f> v(stepElems * H, 0.f);
  for (int y = 0; y < H; ++y)
    for (int x = 0; x < W; ++x)
      v[y * stepElems + x] = std::sin(0.071f * x + phase) * std::cos(0.053f * y 
- phase) + 0.25f * ((hash32(y * 4099 + x) & 255) / 255.f);
  return v;
}

