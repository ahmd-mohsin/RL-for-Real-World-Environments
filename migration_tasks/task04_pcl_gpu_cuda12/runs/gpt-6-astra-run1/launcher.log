// ncv_check: exercises the NVIDIA NCV / NPP-staging image primitives shipped 
inside
// pcl::gpu::people (integral images, decimation, rect std-dev, separable 
filters,
// resize, frame interpolation, stream compaction, transpose).
//
//   ncv_check --out DIR [--seed S]
//
// --seed S (S != 0) draws different input data and image sizes; S = 0 is the 
default set.
// Writes DIR/<case>.bin with each output buffer and DIR/result.json with the
// status code of every call and, where the library provides a host reference
// implementation, the maximum difference against it.
#include <pcl/gpu/people/NCV.hpp>
#include <pcl/gpu/people/NPP_staging.hpp>

#include <cuda_runtime.h>

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

namespace {

std::string g_out;
std::uint32_t g_seed = 0;
std::ostringstream g_json;
bool g_first = true;

void check(cudaError_t e, const char* what) {
  if (e != cudaSuccess) throw std::runtime_error(std::string(what) + ": " + 
cudaGetErrorString(e));
}

std::uint32_t hash32(std::uint32_t x) {
  x ^= g_seed * 0x9e3779b1U;
  x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16;
  return x;
}

template <class T>
void save(const std::string& name, const std::vector<T>& v) {
  std::ofstream f(g_out + "/" + name + ".bin", std::ios::binary);
  f.write(reinterpret_cast<const char*>(v.data()), v.size() * sizeof(T));
}

void record(const std::string& name, int status, double maxdiff = -1) {
  g_json << (g_first ? "" : ", ") << "\"" << name << "\": {\"status\": " << 
status << ", \"max_diff_vs_host\": " << maxdiff << "}";
  g_first = false;
  std::cout << name << " status " << status << " max_diff_vs_host " << maxdiff 
<< std::endl;
}

template <class T>
T* devAlloc(size_t bytes) {
  void* p = nullptr;
  check(cudaMalloc(&p, bytes), "cudaMalloc");
  check(cudaMemset(p, 0, bytes), "cudaMemset");
  return static_cast<T*>(p);
}

// ---------------------------------------------------------------- integral 
images
void testIntegral(cudaDeviceProp& prop, int W, int H, int offset, const 
std::string& tag) {
  const Ncv32u srcStep = ((W + offset + 255) / 256) * 256;
  std::vector<Ncv8u> h_src(srcStep * H, 0);
  for (int y = 0; y < H; ++y)
    for (int x = 0; x < W; ++x) h_src[y * srcStep + x + offset] = 
(Ncv8u)(hash32(y * 7919 + x) & 0xff);
  Ncv8u* d_srcBase = devAlloc<Ncv8u>(h_src.size());
  check(cudaMemcpy(d_srcBase, h_src.data(), h_src.size(), 
cudaMemcpyHostToDevice), "upload");
  Ncv8u* d_src = d_srcBase + offset;  // offset != 0: not texture-aligned
  NcvSize32u roi = {(Ncv32u)W, (Ncv32u)H};

  const Ncv32u dstStep = ((W + 1) * 4 + 255) / 256 * 256;
  Ncv32u bufSize = 0;
  int st = nppiStIntegralGetSize_8u32u(roi, &bufSize, prop);
  Ncv8u* buf = devAlloc<Ncv8u>(std::max<Ncv32u>(bufSize, 1));
  Ncv32u* d_int = devAlloc<Ncv32u>(dstStep * (H + 1));
  if (st == NPPST_SUCCESS) st = nppiStIntegral_8u32u_C1R(d_src, srcStep, d_int, 
dstStep, roi, buf, bufSize, prop);
  check(cudaDeviceSynchronize(), "integral");
  std::vector<Ncv32u> got(dstStep / 4 * (H + 1)), ref(got.size());
  check(cudaMemcpy(got.data(), d_int, got.size() * 4, cudaMemcpyDeviceToHost), 
"download");
  nppiStIntegral_8u32u_C1R_host(h_src.data() + offset, srcStep, ref.data(), 
dstStep, roi);
  double md = 0;
  for (int y = 0; y <= H; ++y)
    for (int x = 0; x <= W; ++x) md = std::max(md, std::abs((double)got[y * 
dstStep / 4 + x] - ref[y * dstStep / 4 + x]));
  save("integral_" + tag, got);
  record("integral_" + tag, st, md);

  // squared integral
  const Ncv32u sqStep = ((W + 1) * 8 + 255) / 256 * 256;
  Ncv32u sqBuf = 0;
  int st2 = nppiStSqrIntegralGetSize_8u64u(roi, &sqBuf, prop);
  Ncv8u* buf2 = devAlloc<Ncv8u>(std::max<Ncv32u>(sqBuf, 1));
  Ncv64u* d_sq = devAlloc<Ncv64u>(sqStep * (H + 1));
  if (st2 == NPPST_SUCCESS) st2 = nppiStSqrIntegral_8u64u_C1R(d_src, srcStep, 
d_sq, sqStep, roi, buf2, sqBuf, prop);
  check(cudaDeviceSynchronize(), "sqintegral");
  std::vector<Ncv64u> got2(sqStep / 8 * (H + 1)), ref2(got2.size());
  check(cudaMemcpy(got2.data(), d_sq, got2.size() * 8, cudaMemcpyDeviceToHost), 
"download");
  nppiStSqrIntegral_8u64u_C1R_host(h_src.data() + offset, srcStep, ref2.data(), 
sqStep, roi);
  double md2 = 0;
  for (int y = 0; y <= H; ++y)
    for (int x = 0; x <= W; ++x) md2 = std::max(md2, std::abs((double)got2[y * 
sqStep / 8 + x] - (double)ref2[y * sqStep / 8 + x]));
  save("sqintegral_" + tag, got2);
  record("sqintegral_" + tag, st2, md2);

  // rect std-dev over the integral images, through the read-only cache and 
through plain loads
  if (offset == 0) {
    NcvRect32u rect = {1, 2, 9, 7};
    NcvSize32u nroi = {(Ncv32u)(W - rect.x - rect.width), (Ncv32u)(H - rect.y - 
rect.height)};
    const Ncv32u normStep = (nroi.width * 4 + 255) / 256 * 256;
    std::vector<Ncv32f> ref3(normStep / 4 * nroi.height);
    nppiStRectStdDev_32f_C1R_host(ref.data(), dstStep, ref2.data(), sqStep, 
ref3.data(), normStep, nroi, rect, 1.0f);
    for (int tex = 0; tex < 2; ++tex) {
      Ncv32f* d_norm = devAlloc<Ncv32f>(normStep * nroi.height);
      int st3 = nppiStRectStdDev_32f_C1R(d_int, dstStep, d_sq, sqStep, d_norm, 
normStep, nroi, rect, 1.0f, tex != 0);
      check(cudaDeviceSynchronize(), "rectstddev");
      std::vector<Ncv32f> got3(ref3.size());
      check(cudaMemcpy(got3.data(), d_norm, got3.size() * 4, 
cudaMemcpyDeviceToHost), "download");
      double md3 = 0;
      for (Ncv32u y = 0; y < nroi.height; ++y)
        for (Ncv32u x = 0; x < nroi.width; ++x)
          md3 = std::max(md3, (double)std::abs(got3[y * normStep / 4 + x] - 
ref3[y * normStep / 4 + x]));
      save(std::string("rectstddev_") + (tex ? "tex" : "notex"), got3);
      record(std::string("rectstddev_") + (tex ? "tex" : "notex"), st3, md3);
      cudaFree(d_norm);
    }
  }
  cudaFree(d_srcBase); cudaFree(buf); cudaFree(d_int); cudaFree(buf2); 
cudaFree(d_sq);
}

