    template<typename NormalType>
    struct ExtractNormals
    {
      float3 cell_size;
      PtrStep<short2> volume;
      PtrSz<PointType> points;

      mutable NormalType* output;

      __device__ __forceinline__ float
      readTsdf (int x, int y, int z) const
      {
        return unpack_tsdf (volume.ptr (VOLUME_Y * z + y)[x]);
      }

      __device__ __forceinline__ float3
      fetchPoint (int idx) const
      {
          unsigned mask = __ballot_sync(0xffffffff, nv != 0);
          int pos = base + count + __popc(mask & ((1u << lane) - 1));
          if (emit && nv && pos < max_size) {
            voxels_indeces[pos] = (z * VOLUME_Y + y) * VOLUME_X + x;
            vetexes_number[pos] = nv;
          }
          count += __popc(mask);
        }
        if (!emit && lane == 0) counts[warp] = count;
      }
    };
    __global__ void getOccupiedVoxelsKernel(OccupiedVoxels ov) { ov(); }
      int
      getOccupiedVoxels (const PtrStep<short2>& volume, DeviceArray2D<int>& 
occupied_voxels, const int* numVertsBuf)
      {
  OccupiedVoxels ov;
  ov.volume = volume;
  ov.numVertsTex = numVertsBuf;
  ov.voxels_indeces = occupied_voxels.ptr(0);
  ov.vetexes_number = occupied_voxels.ptr(1);
  ov.max_size = occupied_voxels.cols();
  dim3 block(32, 8);
  dim3 grid(divUp(VOLUME_X, 32), divUp(VOLUME_Y, 8), divUp(VOLUME_Z - 1, 8));
  int n = grid.x * grid.y * grid.z * 8;
  DeviceArray<int> counts(n + 1), offsets(n + 1);
  cudaSafeCall(cudaMemsetAsync(counts.ptr(), 0, (n + 1) * sizeof(int), 0));
  ov.counts = counts.ptr(); ov.offsets = offsets.ptr(); ov.emit = false;
  getOccupiedVoxelsKernel<<<grid, block>>>(ov);
  thrust::exclusive_scan(thrust::cuda::par.on(0), 
thrust::device_pointer_cast(counts.ptr()),
      thrust::device_pointer_cast(counts.ptr() + n + 1), 
thrust::device_pointer_cast(offsets.ptr()));
  int total;
  cudaSafeCall(cudaMemcpy(&total, offsets.ptr() + n, sizeof(int), 
cudaMemcpyDeviceToHost));
  ov.emit = true;
  getOccupiedVoxelsKernel<<<grid, block>>>(ov);
  cudaSafeCall(cudaGetLastError());
  cudaSafeCall(cudaStreamSynchronize(0));
  return std::min(total, ov.max_size);
}

      int
      computeOffsetsAndTotalVertexes (DeviceArray2D<int>& occupied_voxels)
      {
        thrust::device_ptr<int> beg (occupied_voxels.ptr (1));
        thrust::device_ptr<int> end = beg + occupied_voxels.cols ();

        thrust::device_ptr<int> out (occupied_voxels.ptr (2));
        thrust::exclusive_scan (beg, end, out);

        int lastElement, lastScanElement;

        DeviceArray<int> last_elem (occupied_voxels.ptr(1) + 
occupied_voxels.cols () - 1, 1);
        DeviceArray<int> last_scan (occupied_voxels.ptr(2) + 
occupied_voxels.cols () - 1, 1);

        last_elem.download (&lastElement);
        last_scan.download (&lastScanElement);

        return lastElement + lastScanElement;
      }
    }
  }
}

