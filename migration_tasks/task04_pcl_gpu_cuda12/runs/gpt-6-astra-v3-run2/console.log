            for(unsigned int stride = arrayLength / 2; stride > 0; stride >>= 1)
            {        
                unsigned int pos = 2 * lane - (lane & (stride - 1));

                if ( (keys[pos] > keys[pos + stride]) == dir )
                {
                    swap(keys[pos], keys[pos + stride]);
                    swap(vals[pos], vals[pos + stride]);
                }     
            }
