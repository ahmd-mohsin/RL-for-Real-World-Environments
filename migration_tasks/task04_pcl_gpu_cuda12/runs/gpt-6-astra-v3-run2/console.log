from pathlib import Path
code='''
    // Graphs amortize launch/transfer submission across the many ICP 
iterations.
    // The cache is per host thread and device. Every launch is completed before
    // reuse, so one thread may freely alternate tracker instances and 
resolutions.
    struct IcpGraph {
      cudaGraph_t graph = nullptr;
      cudaGraphExec_t executable = nullptr;
      cudaGraphNode_t correspondence{}, reduction{}, download{};
      float_type* host = nullptr;
      const void* input = nullptr;
      float_type* output = nullptr;
      std::size_t step = 0;
      int length = 0;

      IcpGraph() {
        cudaSafeCall(cudaHostAlloc(reinterpret_cast<void**>(&host),
                                  TranformReduction::TOTAL * sizeof(float_type),
cudaHostAllocPortable));
      }
      ~IcpGraph() {
        if (executable) cudaGraphExecDestroy(executable);
        if (graph) cudaGraphDestroy(graph);
        if (host) cudaFreeHost(host);
      }
      IcpGraph(const IcpGraph&) = delete;
      IcpGraph& operator=(const IcpGraph&) = delete;

      const float_type* run(Combined& cs, TranformReduction& tr, dim3 grid, dim3
block) {
        void* args1[] = {&cs};
        void* args2[] = {&tr};
        cudaKernelNodeParams first{};
        first.func = reinterpret_cast<void*>(combinedKernel);
        first.gridDim = grid; first.blockDim = block; first.kernelParams = 
args1;
        cudaKernelNodeParams second{};
        second.func = reinterpret_cast<void*>(TransformEstimatorKernel2);
        second.gridDim = dim3(TranformReduction::TOTAL);
        second.blockDim = dim3(TranformReduction::CTA_SIZE); second.kernelParams
= args2;
        constexpr std::size_t bytes = TranformReduction::TOTAL * 
sizeof(float_type);
        if (!executable) {
          cudaSafeCall(cudaGraphCreate(&graph, 0));
          cudaSafeCall(cudaGraphAddKernelNode(&correspondence, graph, nullptr, 
0, &first));
          cudaSafeCall(cudaGraphAddKernelNode(&reduction, graph, 
&correspondence, 1, &second));
          cudaSafeCall(cudaGraphAddMemcpyNode1D(&download, graph, &reduction, 1,
host, tr.output, bytes, cudaMemcpyDeviceToHost));
          cudaSafeCall(cudaGraphInstantiate(&executable, graph, nullptr, 
nullptr, 0));
        } else {
          cudaSafeCall(cudaGraphExecKernelNodeSetParams(executable, 
correspondence, &first));
          if (input != tr.gbuf.data || step != tr.gbuf.step || length != 
tr.length || output != tr.output)
            cudaSafeCall(cudaGraphExecKernelNodeSetParams(executable, reduction,
&second));
          if (output != tr.output)
            cudaSafeCall(cudaGraphExecMemcpyNodeSetParams1D(executable, 
download, host, tr.output, bytes, cudaMemcpyDeviceToHost));
        }
        input = tr.gbuf.data; step = tr.gbuf.step; length = tr.length; output = 
tr.output;
        cudaSafeCall(cudaGraphLaunch(executable, 0));
        cudaSafeCall(cudaStreamSynchronize(0));
        return host;
      }
    };
'''
