#ifndef PCL_GPU_BITONIC_SORT_WARP_HPP
#define PCL_GPU_BITONIC_SORT_WARP_HPP

namespace pcl
{
    namespace device
    {
        template<typename T>    
        __device__ __forceinline__ void swap(T& a, T& b) { T t = a; a = b; b = 
t; }

        template<typename V, typename K>
        __device__ __forceinline__ void bitonicSortWarp(volatile K* keys, 
volatile V* vals, unsigned int dir = 1)
        {
