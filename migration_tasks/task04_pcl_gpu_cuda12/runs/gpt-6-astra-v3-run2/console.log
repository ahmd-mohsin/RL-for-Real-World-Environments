// A texture object is immutable after construction and belongs to one 
invocation.
// Only its lightweight, typed view is passed to kernels, never host ownership.
template<class T> struct TextureView {
  cudaTextureObject_t object = 0;
};
template<class T> __device__ T tex2D(TextureView<T> t, float x, float y) {
  return ::tex2D<T>(t.object, x, y);
}
template<class T> __device__ T tex1Dfetch(TextureView<T> t, int x) {
  return ::tex1Dfetch<T>(t.object, x);
}
class TextureBinder {
  cudaTextureObject_t object_ = 0;
public:
  template<class T> TextureBinder(const PtrStepSz<T>& a, TextureView<T>& view,
      cudaTextureAddressMode address = cudaAddressModeClamp,
      cudaTextureFilterMode filter = cudaFilterModePoint, bool normalized = 
false) {
    cudaResourceDesc r{};
    r.resType = cudaResourceTypePitch2D;
    r.res.pitch2D.devPtr = const_cast<T*>(a.data);
    r.res.pitch2D.desc = cudaCreateChannelDesc<T>();
    r.res.pitch2D.width = a.cols; r.res.pitch2D.height = a.rows;
    r.res.pitch2D.pitchInBytes = a.step;
    cudaTextureDesc t{};
