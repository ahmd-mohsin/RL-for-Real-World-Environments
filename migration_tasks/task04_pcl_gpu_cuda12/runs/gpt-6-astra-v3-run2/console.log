  for (int y = 0; y < H; ++y)
    for (int x = 0; x < W; ++x) {
      float v = 120.f + 55.f * std::sin(0.13f * x + 0.7f * salt) * 
std::cos(0.09f * y - 0.3f * salt) +
                45.f * ((hash32(y * 7919 + x + salt * 104729u) & 255) / 255.f - 
0.5f);
      // a few bright and dark blocks of different sizes
      for (int b = 0; b < 6; ++b) {
        int bx = (int)(hash32(salt * 31 + b) % (W - 40)), by = (int)(hash32(salt
* 37 + b) % (H - 40));
        int bs = 12 + (int)(hash32(salt * 41 + b) % 28);
        if (x >= bx && x < bx + bs && y >= by && y < by + bs) v += (b & 1) ? 
60.f : -60.f;
      }
      img[(size_t)y * W + x] = (Ncv8u)std::min(255.f, std::max(0.f, v));
    }
  return img;
}

void testHaar(cudaDeviceProp& prop) {
  NCVMemNativeAllocator gpuAlloc(NCVMemoryTypeDevice, 
static_cast<Ncv32u>(prop.textureAlignment));
  NCVMemNativeAllocator cpuAlloc(NCVMemoryTypeHostPinned, 
static_cast<Ncv32u>(prop.textureAlignment));
  for (int ci = 0; ci < 2; ++ci) {
    Cascade c = makeCascade(11 + ci);
    NCVVectorAlloc<HaarStage64> h_stages(cpuAlloc, (Ncv32u)c.stages.size());
    NCVVectorAlloc<HaarStage64> d_stages(gpuAlloc, (Ncv32u)c.stages.size());
    NCVVectorAlloc<HaarClassifierNode128> d_nodes(gpuAlloc, 
(Ncv32u)c.nodes.size());
    NCVVectorAlloc<HaarFeature64> d_features(gpuAlloc, 
(Ncv32u)c.features.size());
    std::copy(c.stages.begin(), c.stages.end(), h_stages.ptr());
    check(cudaMemcpy(d_stages.ptr(), c.stages.data(), c.stages.size() * 
sizeof(HaarStage64), cudaMemcpyHostToDevice), "upload");
    check(cudaMemcpy(d_nodes.ptr(), c.nodes.data(), c.nodes.size() * 
sizeof(HaarClassifierNode128), cudaMemcpyHostToDevice), "upload");
    check(cudaMemcpy(d_features.ptr(), c.features.data(), c.features.size() * 
sizeof(HaarFeature64), cudaMemcpyHostToDevice), "upload");
    const int W = ci ? 352 : 320, H = ci ? 288 : 240;
    std::vector<Ncv8u> img = haarImage(W, H, 3 + ci);
    struct Cfg { const char* name; int major, minor; Ncv32u pixelStep, flags, 
minNeighbors; float scaleStep; };
    for (Cfg cfg : {Cfg{"real", 0, 0, 1, NCVPipeObjDet_Default, 0, 1.2f}, 
Cfg{"step2", 0, 0, 2, NCVPipeObjDet_Default, 0, 1.2f},
                    Cfg{"fair", 0, 0, 1, NCVPipeObjDet_UseFairImageScaling, 0, 
1.25f},
                    Cfg{"sm13", 1, 3, 1, NCVPipeObjDet_Default, 0, 1.2f}, 
Cfg{"sm10", 1, 0, 1, NCVPipeObjDet_Default, 0, 1.2f},
                    Cfg{"sm10_group", 1, 0, 1, NCVPipeObjDet_Default, 2, 1.15f},
                    Cfg{"sm10_largest", 1, 0, 1, 
NCVPipeObjDet_FindLargestObject, 1, 1.2f}}) {
      cudaDeviceProp p = prop;
      if (cfg.major) { p.major = cfg.major; p.minor = cfg.minor; }
      NCVMatrixAlloc<Ncv8u> d_img(gpuAlloc, (Ncv32u)W, (Ncv32u)H);
      check(cudaMemcpy2D(d_img.ptr(), d_img.pitch(), img.data(), W, W, H, 
cudaMemcpyHostToDevice), "upload");
      const Ncv32u maxRects = 1u << 19;  // above the number of candidate 
windows over all scales: no truncation
      NCVVectorAlloc<NcvRect32u> d_rects(gpuAlloc, maxRects);
      Ncv32u num = 0;
      int st = ncvDetectObjectsMultiScale_device(d_img, NcvSize32u{(Ncv32u)W, 
(Ncv32u)H}, d_rects, num, c.desc, h_stages, d_stages,
                                                 d_nodes, d_features, 
NcvSize32u{24, 24}, cfg.minNeighbors, cfg.scaleStep,
                                                 cfg.pixelStep, cfg.flags, 
gpuAlloc, cpuAlloc, p, 0);
      check(cudaDeviceSynchronize(), "haar");
      std::vector<NcvRect32u> rects(std::min(num, maxRects));
      if (!rects.empty())
        check(cudaMemcpy(rects.data(), d_rects.ptr(), rects.size() * 
sizeof(NcvRect32u), cudaMemcpyDeviceToHost), "download");
      // detections are compacted with atomics on newer devices: compare them as
a set
      std::vector<std::uint32_t> out;
      for (auto& r : rects) out.insert(out.end(), {r.x, r.y, r.width, 
r.height});
      std::vector<std::array<std::uint32_t, 4>> q;
      for (size_t i = 0; i + 3 < out.size(); i += 4) q.push_back({out[i], out[i 
+ 1], out[i + 2], out[i + 3]});
      std::sort(q.begin(), q.end());
      out.clear();
      out.push_back(num);
      for (auto& a : q) out.insert(out.end(), a.begin(), a.end());
      std::string name = std::string("haar") + std::to_string(ci) + "_" + 
cfg.name;
      save(name, out);
      record(name, st, num);
    }
  }
}

