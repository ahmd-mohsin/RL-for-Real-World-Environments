    t.filterMode = filter; t.normalizedCoords = normalized;
    t.readMode = cudaReadModeElementType;
    cudaSafeCall(cudaCreateTextureObject(&object_, &r, &t, nullptr));
    view.object = object_;
  }
  template<class T> TextureBinder(const DeviceArray2D<T>& a, TextureView<T>& v)
    : TextureBinder(static_cast<PtrStepSz<T>>(a), v) {}
  template<class T> TextureBinder(const PtrSz<T>& a, TextureView<T>& view) {
    cudaResourceDesc r{};
    r.resType = cudaResourceTypeLinear;
    r.res.linear.devPtr = const_cast<T*>(a.data);
    r.res.linear.desc = cudaCreateChannelDesc<T>();
    r.res.linear.sizeInBytes = a.size * sizeof(T);
    cudaTextureDesc t{}; t.readMode = cudaReadModeElementType;
    cudaSafeCall(cudaCreateTextureObject(&object_, &r, &t, nullptr));
    view.object = object_;
