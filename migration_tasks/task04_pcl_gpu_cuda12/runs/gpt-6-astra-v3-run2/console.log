/// compute hue functionality 

namespace pcl
{
  namespace device
  {
    __device__ __host__ __forceinline__ float computeHueFunc (int rgba)
    {
      int r = (rgba      ) & 0xFF;
      int g = (rgba >>  8) & 0xFF;
      int b = (rgba >> 16) & 0xFF;

      int v = max (r, max (g, b));
      float h;

      float div_inv = 1.f / (v - min (r, min (g, b)) );

      if (v == 0)
          return -1;

      if (r == v)
          h = (    (g - b)) * div_inv;
      else if (g == v)
          h = (2 + (b - r)) * div_inv;
      else 
          h = (4 + (r - g)) * div_inv;

      h *= 60;    
      if (h < 0)
          h += 360;

      return h;
    }

  }
}

float pcl::device::computeHue(int rgba) 
{ 
  return computeHueFunc(rgba); 
}

