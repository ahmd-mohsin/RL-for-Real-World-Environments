// A synthetic cascade (stumps and two-level trees, two- and three-rectangle 
features; the late stages are
// large enough for the classifier-parallel kernels) run through the multi-scale
detection pipeline under
// several configurations, including the code paths that the library selects for
older devices.
struct Cascade {
  HaarClassifierCascadeDescriptor desc;
  std::vector<HaarStage64> stages;
  std::vector<HaarClassifierNode128> nodes;
  std::vector<HaarFeature64> features;
};

float u01(std::uint32_t k, std::uint32_t salt) { return (hash32(k * 2654435761U 
^ salt) & 0xffffffU) / 16777215.f; }

Cascade makeCascade(std::uint32_t salt) {
