+++ b/gpu/containers/src/initialization.cpp
@@ -42,6 +42,21 @@
 #include <array> // replace c-style array with std::array
 #include <cstdio>
 
+#include <atomic>
+
+namespace {
+std::atomic<unsigned> active_tracking_frames{0};
+}
+void pcl::gpu::detail::enterTrackingFrame() {
+  active_tracking_frames.fetch_add(1, std::memory_order_relaxed);
+}
+void pcl::gpu::detail::leaveTrackingFrame() {
+  active_tracking_frames.fetch_sub(1, std::memory_order_relaxed);
+}
+bool pcl::gpu::detail::concurrentTrackingFrames() {
+  return active_tracking_frames.load(std::memory_order_relaxed) > 1;
+}
+
 #if !defined(HAVE_CUDA)
 #define HAVE_CUDA
 #endif
