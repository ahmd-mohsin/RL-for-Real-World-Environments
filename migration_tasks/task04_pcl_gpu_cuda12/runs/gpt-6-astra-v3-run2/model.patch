+namespace {
+// Inline the same RGB-to-hue arithmetic used by the CUDA implementation. The
+// conversion loop can then be vectorized without a per-pixel shared-library call.
+inline float hostHue(int rgba)
+{
+  int r = rgba & 255, g = (rgba >> 8) & 255, b = (rgba >> 16) & 255;
+  int v = std::max(r, std::max(g, b));
+  float inv = 1.f / (v - std::min(r, std::min(g, b)));
+  if (v == 0) return -1.f;
+  float h;
+  if (r == v) h = (g - b) * inv;
+  else if (g == v) h = (2 + (b - r)) * inv;
+  else h = (4 + (r - g)) * inv;
+  h *= 60;
+  if (h < 0) h += 360;
+  return h;
+}
+}
