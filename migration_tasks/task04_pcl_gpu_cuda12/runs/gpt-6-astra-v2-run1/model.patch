+template<class T, int Dim> struct TextureView {
+  const T* data = nullptr;
+  std::size_t count = 0;
+  cudaTextureObject_t object = 0;
+  cudaTextureAddressMode addressMode[2] = {cudaAddressModeClamp, cudaAddressModeClamp};
+  cudaTextureFilterMode filterMode = cudaFilterModePoint;
+  bool normalized = false;
+};
+template<class T, int D, class P>
+cudaError_t bindLinear(std::size_t* offset, TextureView<T,D>& v, const P* p,
+                       cudaChannelFormatDesc, std::size_t bytes) {
+  v.data = reinterpret_cast<const T*>(p); v.count = bytes / sizeof(T);
+  if (offset) *offset = 0;
+  return cudaSuccess;
+}
+template<class T, int D, class P>
+cudaError_t bindLinear(std::size_t* offset, TextureView<T,D>& v, const P* p, std::size_t bytes) {
+  return bindLinear(offset, v, p, cudaCreateChannelDesc<T>(), bytes);
+}
+template<class T, class P>
+cudaError_t bindPitch(std::size_t* offset, TextureView<T,2>& v, const P* p,
+                      cudaChannelFormatDesc desc, std::size_t w, std::size_t h, std::size_t pitch) {
+  cudaResourceDesc r{}; r.resType = cudaResourceTypePitch2D;
+  r.res.pitch2D.devPtr = const_cast<P*>(p); r.res.pitch2D.desc = desc;
+  r.res.pitch2D.width = w; r.res.pitch2D.height = h; r.res.pitch2D.pitchInBytes = pitch;
+  cudaTextureDesc t{}; t.addressMode[0] = v.addressMode[0]; t.addressMode[1] = v.addressMode[1];
+  t.filterMode = v.filterMode; t.normalizedCoords = v.normalized;
+  t.readMode = cudaReadModeElementType;
+  if (offset) *offset = 0;
+  return cudaCreateTextureObject(&v.object, &r, &t, nullptr);
+}
+template<class T, int D> cudaError_t releaseTexture(TextureView<T,D>& v) {
+  if (!v.object) return cudaSuccess;
+  auto result = cudaDestroyTextureObject(v.object); v.object = 0; return result;
+}
