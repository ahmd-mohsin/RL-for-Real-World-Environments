index 0000000..5c4a9e4
--- /dev/null
+++ b/src/raster/splat_raster.cpp
@@ -0,0 +1,321 @@
+// Tessera - tile-based compositing of splats over the surface layer.
+//
+// Derived from gsplat's rasterize_to_pixels_3dgs_fwd_kernel and the blending
+// helpers in RasterizeToPixels3DGSDevice.cuh (Apache-2.0). Changes for
+// Tessera: three colour channels, a per-pixel surface layer that both bounds
+// the visible depth range and replaces the background, and a per-splat depth
+// carried through the team-memory batch.
+//
+// One team per tile. A tile has CTA_SIZE virtual lanes, each owning
+// PIXELS_PER_THREAD pixels; a thread of the team serves every lane
+// v = tid, tid + nthreads, ... so the kernel is correct for any team size the
+// runtime grants. Lane state (transmittance, colour, last contributor) lives
+// in team memory between batches and in registers while a batch is blended.
+#include "../prims/team.h"
+#include "tsr/geom/gaussian_math.h"
+#include "tsr/math/vec.h"
+#include "tsr/raster/splat_raster.h"
+
+namespace tsr
+{
+namespace
+{
+#pragma omp begin declare target
+struct GaussianWeight
+{
+    float vis;   // exp(-sigma)
+    float alpha; // min(kMaxAlpha, opacity * vis)
+    bool valid;  // sigma >= 0 and alpha >= kAlphaThreshold
+};
+
+// sigma is the Mahalanobis exponent for the pixel offset (dx, dy) = mean - pixel.
+inline GaussianWeight eval_gaussian_weight(const float3 &conic, float dx, float dy, float opac)
+{
+    const float sigma = 0.5f * (conic.x * dx * dx + conic.z * dy * dy) + conic.y * dx * dy;
+    const float vis   = fast_expf(-sigma);
+    const float alpha = fminf(geom::kMaxAlpha, opac * vis);
+    return GaussianWeight{vis, alpha, !(sigma < 0.f || alpha < geom::kAlphaThreshold)};
+}
+
+constexpr std::uint32_t kMaxLanePixels = 256; // CTA_SIZE * PIXELS_PER_THREAD for every variant
+#pragma omp end declare target
+
+template<std::uint32_t TILE_SIZE, std::uint32_t CTA_SIZE>
+void rasterize_splats_teams(
+    const float2 *__restrict__ means2d,
+    const float3 *__restrict__ conics,
+    const float3 *__restrict__ colors,
+    const float *__restrict__ opacities,
+    const float *__restrict__ depths,
+    const std::uint32_t image_width,
+    const std::uint32_t image_height,
+    const std::uint32_t tile_width,
+    const std::uint32_t n_tiles,
+    const std::int32_t *__restrict__ tile_offsets, // [n_tiles + 1]
+    const std::int32_t *__restrict__ flatten_ids,  // [n_isects]
+    const float3 *__restrict__ surface_color,      // [H][W]
+    const float *__restrict__ surface_depth,       // [H][W]
+    float3 *__restrict__ render_colors,            // [H][W]
+    float *__restrict__ render_alphas,             // [H][W]
+    std::int32_t *__restrict__ last_ids            // [H][W]
+)
+{
+    constexpr std::uint32_t BATCH_SIZE        = CTA_SIZE;
+    constexpr std::uint32_t PIXELS_PER_THREAD = TILE_SIZE * TILE_SIZE / CTA_SIZE;
+    constexpr std::uint32_t ROW_STRIDE        = CTA_SIZE / TILE_SIZE;
+    constexpr std::uint32_t TILE_MASK         = TILE_SIZE - 1;
+    constexpr std::uint32_t TILE_SHIFT        = TILE_SIZE == 16 ? 4 : (TILE_SIZE == 8 ? 3 : 2);
+    constexpr std::uint32_t ALL_DONE          = (1u << PIXELS_PER_THREAD) - 1u;
+    static_assert((TILE_SIZE & (TILE_SIZE - 1)) == 0 && TILE_SIZE >= 4 && TILE_SIZE <= 16, "TILE_SIZE must be 4, 8 or 16");
+    static_assert(PIXELS_PER_THREAD > 0, "CTA_SIZE must not exceed TILE_SIZE * TILE_SIZE");
+    static_assert(CTA_SIZE * PIXELS_PER_THREAD <= kMaxLanePixels, "lane state does not fit");
+
+    const int dev = device_id();
+#pragma omp target teams num_teams(static_cast<int>(n_tiles)) thread_limit(CTA_SIZE) device(dev)                   \
+    is_device_ptr(means2d, conics, colors, opacities, depths, tile_offsets, flatten_ids, surface_color, surface_depth, \
+                  render_colors, render_alphas, last_ids)
+    {
+        // current batch of splats, front to back
+        std::int32_t id_batch[BATCH_SIZE];
+        float3 xy_opacity_batch[BATCH_SIZE];
+        float3 conic_batch[BATCH_SIZE];
+        float depth_batch[BATCH_SIZE];
+        // lane state, [lane * PIXELS_PER_THREAD + p]
+        float s_T[kMaxLanePixels];
+        float s_zlimit[kMaxLanePixels];
+        float3 s_pix_out[kMaxLanePixels];
+        std::int32_t s_last[kMaxLanePixels];
+        std::uint32_t s_done[CTA_SIZE];
+        // lanes finished after batch b, double buffered on b & 1
+        std::uint32_t n_done[2];
+#pragma omp allocate(id_batch, xy_opacity_batch, conic_batch, depth_batch, s_T, s_zlimit, s_pix_out, s_last, s_done, n_done) \
+    allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(CTA_SIZE)
+        {
+            const std::uint32_t tid      = static_cast<std::uint32_t>(omp_get_thread_num());
+            const std::uint32_t nthreads = static_cast<std::uint32_t>(omp_get_num_threads());
+            for(std::uint32_t tile_id = static_cast<std::uint32_t>(omp_get_team_num()); tile_id < n_tiles;
+                tile_id += static_cast<std::uint32_t>(omp_get_num_teams()))
+            {
+                const std::uint32_t tile_x = tile_id % tile_width;
+                const std::uint32_t tile_y = tile_id / tile_width;
+
+                // initialise lane state
+                for(std::uint32_t v = tid; v < CTA_SIZE; v += nthreads)
+                {
+                    const std::uint32_t out_x = tile_x * TILE_SIZE + (v & TILE_MASK);
+                    // Out-of-image pixels start done.
+                    std::uint32_t done = (out_x >= image_width) ? ALL_DONE : 0u;
+                    for(std::uint32_t p = 0; p < PIXELS_PER_THREAD; ++p)
+                    {
+                        const std::uint32_t out_y = tile_y * TILE_SIZE + (v >> TILE_SHIFT) + p * ROW_STRIDE;
+                        if(out_y >= image_height)
+                        {
+                            done |= (1u << p);
+                        }
+                        const std::uint32_t s = v * PIXELS_PER_THREAD + p;
+                        s_zlimit[s]           = (done & (1u << p)) ? 0.f : surface_depth[out_y * image_width + out_x];
+                        s_T[s]                = 1.0f;
+                        s_last[s]             = 0;
+                        s_pix_out[s]          = make_float3(0.f, 0.f, 0.f);
+                    }
+                    s_done[v] = done;
+                }
+                if(tid == 0)
+                {
+                    n_done[0] = 0u;
+                    n_done[1] = 0u;
+                }
+
+                const std::int32_t range_start = tile_offsets[tile_id];
+                const std::int32_t range_end   = tile_offsets[tile_id + 1];
+                const std::int32_t num_batches = (range_end - range_start + static_cast<std::int32_t>(BATCH_SIZE) - 1) / static_cast<std::int32_t>(BATCH_SIZE);
+
+                for(std::int32_t b = 0; b < num_batches; ++b)
+                {
+                    const std::int32_t batch_offset = static_cast<std::int32_t>(BATCH_SIZE) * b;
+                    const std::int32_t batch_start  = range_start + batch_offset;
+                    // each lane fetches one splat
+                    for(std::uint32_t v = tid; v < BATCH_SIZE; v += nthreads)
+                    {
+                        const std::int32_t idx = batch_start + static_cast<std::int32_t>(v);
+                        if(idx < range_end)
+                        {
+                            const std::int32_t g = flatten_ids[idx];
+                            id_batch[v]          = g;
+                            const float2 xy      = means2d[g];
+                            xy_opacity_batch[v]  = make_float3(xy.x, xy.y, opacities[g]);
+                            conic_batch[v]       = conics[g];
+                            depth_batch[v]       = depths[g];
+                        }
+                    }
+#pragma omp barrier
+                    // Reset the counter of the next batch. Every thread has
+                    // read it (for batch b - 1) before reaching the barrier above.
+                    if(tid == 0)
+                    {
+                        n_done[(b + 1) & 1] = 0u;
+                    }
+
+                    const std::int32_t remaining   = range_end - batch_start;
+                    const std::uint32_t batch_size = static_cast<std::uint32_t>(remaining < static_cast<std::int32_t>(BATCH_SIZE) ? remaining : static_cast<std::int32_t>(BATCH_SIZE));
+                    for(std::uint32_t v = tid; v < CTA_SIZE; v += nthreads)
+                    {
+                        std::uint32_t done_mask = s_done[v];
+                        if(done_mask != ALL_DONE)
+                        {
+                            const float px = static_cast<float>(tile_x * TILE_SIZE + (v & TILE_MASK)) + 0.5f;
+                            float py[PIXELS_PER_THREAD], T[PIXELS_PER_THREAD], zl[PIXELS_PER_THREAD];
+                            float3 pix_out[PIXELS_PER_THREAD];
+                            std::int32_t last_offset[PIXELS_PER_THREAD];
+                            TSR_UNROLL
+                            for(std::uint32_t p = 0; p < PIXELS_PER_THREAD; ++p)
+                            {
+                                const std::uint32_t s = v * PIXELS_PER_THREAD + p;
+                                py[p]                 = static_cast<float>(tile_y * TILE_SIZE + (v >> TILE_SHIFT) + p * ROW_STRIDE) + 0.5f;
+                                T[p]                  = s_T[s];
+                                zl[p]                 = s_zlimit[s];
+                                pix_out[p]            = s_pix_out[s];
+                                last_offset[p]        = s_last[s];
+                            }
+                            for(std::uint32_t t = 0; (t < batch_size) && (done_mask != ALL_DONE); ++t)
+                            {
+                                const float3 conic   = conic_batch[t];
+                                const float3 xy_opac = xy_opacity_batch[t];
+                                const float depth    = depth_batch[t];
+                                const float dx       = xy_opac.x - px;
+                                TSR_UNROLL
+                                for(std::uint32_t p = 0; p < PIXELS_PER_THREAD; ++p)
+                                {
+                                    if(done_mask & (1u << p))
+                                    {
+                                        continue;
+                                    }
+                                    if(depth >= zl[p])
+                                    {
+                                        // At or behind the surface; so is every later splat.
+                                        done_mask |= (1u << p);
+                                        continue;
+                                    }
+                                    const float dy          = xy_opac.y - py[p];
+                                    const GaussianWeight gw = eval_gaussian_weight(conic, dx, dy, xy_opac.z);
+                                    if(!gw.valid)
+                                    {
+                                        continue;
+                                    }
+                                    const float next_T = T[p] * (1.0f - gw.alpha);
+                                    if(next_T <= geom::kTransmittanceThreshold)
+                                    {
+                                        // saturated: exclusive of this splat
+                                        done_mask |= (1u << p);
+                                        continue;
+                                    }
+                                    const float vis = gw.alpha * T[p];
+                                    pix_out[p]     += colors[id_batch[t]] * vis;
+                                    last_offset[p]  = batch_offset + static_cast<std::int32_t>(t);
+                                    T[p]            = next_T;
+                                }
+                            }
+                            TSR_UNROLL
+                            for(std::uint32_t p = 0; p < PIXELS_PER_THREAD; ++p)
+                            {
+                                const std::uint32_t s = v * PIXELS_PER_THREAD + p;
+                                s_T[s]                = T[p];
+                                s_pix_out[s]          = pix_out[p];
+                                s_last[s]             = last_offset[p];
+                            }
+                            s_done[v] = done_mask;
+                        }
+                        if(done_mask == ALL_DONE)
+                        {
+#pragma omp atomic update
+                            n_done[b & 1] += 1u;
+                        }
+                    }
+#pragma omp barrier
+                    // stop once every lane is done (the batch arrays are free again)
+                    if(n_done[b & 1] >= CTA_SIZE)
+                    {
+                        break;
+                    }
+                }
+
+                // write out
+                for(std::uint32_t v = tid; v < CTA_SIZE; v += nthreads)
+                {
+                    const std::uint32_t out_x = tile_x * TILE_SIZE + (v & TILE_MASK);
+                    if(out_x >= image_width)
+                    {
+                        continue;
+                    }
+                    for(std::uint32_t p = 0; p < PIXELS_PER_THREAD; ++p)
+                    {
+                        const std::uint32_t out_y = tile_y * TILE_SIZE + (v >> TILE_SHIFT) + p * ROW_STRIDE;
+                        if(out_y < image_height)
+                        {
+                            const std::uint32_t s      = v * PIXELS_PER_THREAD + p;
+                            const std::int32_t pix_id  = static_cast<std::int32_t>(out_y * image_width + out_x);
+                            render_alphas[pix_id]      = 1.0f - s_T[s];
+                            render_colors[pix_id]      = s_pix_out[s] + s_T[s] * surface_color[pix_id];
+                            last_ids[pix_id]           = s_last[s];
+                        }
+                    }
+                }
+#pragma omp barrier
+            }
+        }
+    }
+}
+
+template<std::uint32_t TILE_SIZE, std::uint32_t CTA_SIZE>
+void launch_variant(const ProjectedSplats &splats, const TileBinning &binning, const SurfaceLayer &surface, const Camera &camera, SplatRasterOutput &out)
+{
+    rasterize_splats_teams<TILE_SIZE, CTA_SIZE>(
+        splats.means2d.data(), splats.conics.data(), splats.colors.data(), splats.opacities.data(), splats.depths.data(),
+        camera.width, camera.height, binning.tiles_x, binning.n_tiles(), binning.tile_offsets.data(), binning.sorted_splat_ids.data(),
+        surface.color.data(), surface.depth.data(), out.color.data(), out.alpha.data(), out.last_contributor.data()
+    );
+}
+} // namespace
+
+void rasterize_splats(
+    const ProjectedSplats &splats,
+    const TileBinning &binning,
+    const SurfaceLayer &surface,
+    const Camera &camera,
+    const SplatRasterSettings &settings,
+    SplatRasterOutput &out,
+    Stream stream
+)
+{
+    TSR_CHECK(surface.width == static_cast<int>(camera.width) && surface.height == static_cast<int>(camera.height),
+              "surface layer does not match the camera resolution");
+    const std::size_t n = static_cast<std::size_t>(camera.width) * camera.height;
+    out.width           = static_cast<int>(camera.width);
+    out.height          = static_cast<int>(camera.height);
+    out.color.resize(n);
+    out.alpha.resize(n);
+    out.last_contributor.resize(n);
+    if(binning.n_tiles() == 0)
+    {
+        return;
+    }
+
+    switch(binning.tile_size)
+    {
+    case 16:
+        if(settings.pixels_per_thread == 4)
+        {
+            launch_variant<16, 64>(splats, binning, surface, camera, out);
+        }
+        else
+        {
+            launch_variant<16, 256>(splats, binning, surface, camera, out);
+        }
+        break;
+    case 8: launch_variant<8, 64>(splats, binning, surface, camera, out); break;
+    case 4: launch_variant<4, 16>(splats, binning, surface, camera, out); break;
+    default: TSR_CHECK(false, "unsupported tile size " << binning.tile_size << "; supported values are {4, 8, 16}");
+    }
+}
+} // namespace tsr
