-__global__ void dynamic_smem_kernel(int *out)
-{
-    TSR_DYNAMIC_SMEM(int, s);
-    s[threadIdx.x] = static_cast<int>(threadIdx.x) * 3;
-    __syncthreads();
-    out[blockIdx.x * blockDim.x + threadIdx.x] = s[blockDim.x - 1 - threadIdx.x];
-}
