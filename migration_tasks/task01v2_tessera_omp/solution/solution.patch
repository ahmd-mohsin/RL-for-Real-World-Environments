-        WarpRound r;
-        r.mask = mask;
-        w.rounds.push_back(r);
-    }
-    WarpRound &round      = w.rounds[idx];
-    round.slots[tc.lane]  = value;
-    round.arrived        |= me;
-
-    const unsigned need = mask & ~w.dead;
