-{
-    const bool a_greater = key_a > key_b || (key_a == key_b && val_a > val_b);
-    if(a_greater == (dir != 0))
-    {
-        const K tk = key_a;
-        key_a      = key_b;
-        key_b      = tk;
-        const V tv = val_a;
-        val_a      = val_b;
-        val_b      = tv;
-    }
-}
