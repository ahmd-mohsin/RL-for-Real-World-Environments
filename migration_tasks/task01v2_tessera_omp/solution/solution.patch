diff --git a/include/tsr/device/vector_types.h b/include/tsr/device/vector_types.h
new file mode 100644
index 0000000..c9c2070
--- /dev/null
+++ b/include/tsr/device/vector_types.h
@@ -0,0 +1,58 @@
+// Tessera - small vector types.
+// Same names, layout and alignment as CUDA's <vector_types.h>; they are plain
+// aggregates shared by host and device code.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// Usable from host code and from OpenMP target regions.
+#pragma omp begin declare target
+
+#define TSR_VEC_VEC2(T, NAME, ALIGN)       \
+    struct alignas(ALIGN) NAME             \
+    {                                      \
+        T x, y;                            \
+    };                                     \
+    inline constexpr NAME make_##NAME(T x, T y) { return NAME{x, y}; }
+
+#define TSR_VEC_VEC3(T, NAME)              \
+    struct NAME                            \
+    {                                      \
+        T x, y, z;                         \
+    };                                     \
+    inline constexpr NAME make_##NAME(T x, T y, T z) { return NAME{x, y, z}; }
+
+#define TSR_VEC_VEC4(T, NAME, ALIGN)       \
+    struct alignas(ALIGN) NAME             \
+    {                                      \
+        T x, y, z, w;                      \
+    };                                     \
+    inline constexpr NAME make_##NAME(T x, T y, T z, T w) { return NAME{x, y, z, w}; }
+
+TSR_VEC_VEC2(float, float2, 8)
+TSR_VEC_VEC3(float, float3)
+TSR_VEC_VEC4(float, float4, 16)
+TSR_VEC_VEC2(int, int2, 8)
+TSR_VEC_VEC3(int, int3)
+TSR_VEC_VEC4(int, int4, 16)
+TSR_VEC_VEC2(unsigned int, uint2, 8)
+TSR_VEC_VEC3(unsigned int, uint3)
+TSR_VEC_VEC4(unsigned int, uint4, 16)
+TSR_VEC_VEC2(double, double2, 16)
+TSR_VEC_VEC2(long long, longlong2, 16)
+TSR_VEC_VEC2(unsigned long long, ulonglong2, 16)
+TSR_VEC_VEC2(unsigned short, ushort2, 4)
+TSR_VEC_VEC4(unsigned char, uchar4, 4)
+TSR_VEC_VEC4(signed char, char4, 4)
+
+#undef TSR_VEC_VEC2
+#undef TSR_VEC_VEC3
+#undef TSR_VEC_VEC4
+
+static_assert(sizeof(float2) == 8 && alignof(float2) == 8, "float2 layout");
+static_assert(sizeof(float3) == 12 && alignof(float3) == 4, "float3 layout");
+static_assert(sizeof(float4) == 16 && alignof(float4) == 16, "float4 layout");
+static_assert(sizeof(int2) == 8 && sizeof(uint4) == 16, "int vector layout");
+
+#pragma omp end declare target
