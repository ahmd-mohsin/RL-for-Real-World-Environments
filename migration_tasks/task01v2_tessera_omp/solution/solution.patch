diff --git a/src/post/tonemap.cpp b/src/post/tonemap.cpp
new file mode 100644
index 0000000..5af78bd
--- /dev/null
+++ b/src/post/tonemap.cpp
@@ -0,0 +1,180 @@
+// Tessera - exposure and tone mapping of the linear composite.
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include "tsr/math/vec.h"
+#include "tsr/post/tonemap.h"
+#include "tsr/prims/prims.h"
+
+namespace tsr
+{
+namespace
+{
+#pragma omp begin declare target
+constexpr float kLumEpsilon = 1e-4f;
+
+TSR_HDI float luminance(const float3 &c) { return 0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z; }
+
+TSR_HDI float srgb_encode(float x)
+{
+    x = fminf(fmaxf(x, 0.f), 1.f);
+    return x <= 0.0031308f ? 12.92f * x : 1.055f * std::pow(x, 1.0f / 2.4f) - 0.055f;
+}
+
+TSR_HDI unsigned char to_unorm8(float x) { return static_cast<unsigned char>(fminf(fmaxf(x, 0.f), 1.f) * 255.f + 0.5f); }
+
+// Histogram bin of a pixel's exposed luminance (log2 scale, 256 bins).
+inline std::uint32_t luminance_bin(const float3 &c, float exposure)
+{
+    const float L = luminance(c) * exposure;
+    if(L <= 0.f)
+    {
+        return 0;
+    }
+    const float t = (fast_log2f(L) - kHistogramMinLog2) / (kHistogramMaxLog2 - kHistogramMinLog2);
+    return static_cast<std::uint32_t>(fminf(fmaxf(t * 256.f, 0.f), 255.f));
+}
+
+inline void tonemap_kernel(
+    std::uint32_t idx,
+    const float3 *__restrict__ hdr,
+    bool enabled,
+    float exposure,
+    float inv_white_sq,
+    uchar4 *__restrict__ out
+)
+{
+    const std::uint32_t i = idx;
+    float3 c = hdr[i];
+    if(enabled)
+    {
+        c             = c * exposure;
+        const float L = luminance(c);
+        // extended Reinhard: L (1 + L / Lw^2) / (1 + L)
+        const float Ld = L * (1.f + L * inv_white_sq) / (1.f + L);
+        c              = L > 0.f ? c * (Ld / L) : make_float3(0.f, 0.f, 0.f);
+    }
+    out[i] = make_uchar4(to_unorm8(srgb_encode(c.x)), to_unorm8(srgb_encode(c.y)), to_unorm8(srgb_encode(c.z)), 255);
+}
+#pragma omp end declare target
+
+void tonemap_pixels(std::uint32_t n, const float3 *hdr, bool enabled, float exposure, float inv_white_sq, uchar4 *out)
+{
+    const int dev = device_id();
+#pragma omp target teams distribute parallel for thread_limit(kLinearBlockSize) device(dev) is_device_ptr(hdr, out)
+    for(std::uint32_t i = 0; i < n; ++i)
+    {
+        tonemap_kernel(i, hdr, enabled, exposure, inv_white_sq, out);
+    }
+}
+} // namespace
+
+float linear_to_srgb(float x) { return srgb_encode(x); }
+
+float srgb_to_linear(float x)
+{
+    x = std::fmin(std::fmax(x, 0.f), 1.f);
+    return x <= 0.04045f ? x / 12.92f : std::pow((x + 0.055f) / 1.055f, 2.4f);
+}
+
+void tonemap(
+    const float3 *hdr,
+    int width,
+    int height,
+    const TonemapSettings &settings,
+    uchar4 *out,
+    TonemapStats *stats,
+    Arena &arena,
+    Stream stream
+)
+{
+    const auto n = static_cast<std::uint32_t>(width * height);
+    if(n == 0)
+    {
+        return;
+    }
+    TonemapStats local;
+    TonemapStats &s = stats != nullptr ? *stats : local;
+    s               = TonemapStats{};
+
+    if(!settings.enabled)
+    {
+        tonemap_pixels(n, hdr, false, 1.f, 1.f, out);
+        return;
+    }
+    TSR_CHECK(settings.white_percentile > 0.f && settings.white_percentile <= 1.f, "white percentile must be in (0, 1]");
+
+    // 1. exposure from the log-average luminance (one reduction)
+    const int dev = device_id();
+    float host_sum = 0.f;
+#pragma omp target teams distribute parallel for thread_limit(256) device(dev) is_device_ptr(hdr) reduction(+ : host_sum) map(tofrom : host_sum)
+    for(std::uint32_t i = 0; i < n; ++i)
+    {
+        host_sum += fast_logf(kLumEpsilon + luminance(hdr[i]));
+    }
+    s.log_average_luminance = std::exp(host_sum / static_cast<float>(n));
+    s.exposure              = settings.key / s.log_average_luminance;
+
+    // 2. white point from the luminance histogram: team-local bins, merged
+    //    into the zero-initialised host array mapped tofrom (one launch)
+    const float exposure = s.exposure;
+    std::uint32_t *h     = s.histogram.data();
+    const int teams      = static_cast<int>(std::min<std::uint32_t>(div_round_up<std::uint32_t>(n, 4096u), 512u));
+#pragma omp target teams num_teams(teams) thread_limit(256) device(dev) is_device_ptr(hdr) map(tofrom : h[0 : prims::kHistogramBins])
+    {
+        std::uint32_t local[prims::kHistogramBins];
+#pragma omp allocate(local) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(256)
+        {
+            const std::uint32_t tid      = static_cast<std::uint32_t>(omp_get_thread_num());
+            const std::uint32_t nthreads = static_cast<std::uint32_t>(omp_get_num_threads());
+            for(std::uint32_t v = tid; v < prims::kHistogramBins; v += nthreads)
+            {
+                local[v] = 0u;
+            }
+#pragma omp barrier
+            const std::uint32_t stride = static_cast<std::uint32_t>(omp_get_num_teams()) * nthreads;
+            for(std::uint32_t i = static_cast<std::uint32_t>(omp_get_team_num()) * nthreads + tid; i < n; i += stride)
+            {
+                const std::uint32_t bin = luminance_bin(hdr[i], exposure);
+#pragma omp atomic update
+                local[bin] += 1u;
+            }
+#pragma omp barrier
+            for(std::uint32_t v = tid; v < prims::kHistogramBins; v += nthreads)
+            {
+                if(local[v] != 0u)
+                {
+#pragma omp atomic update
+                    h[v] += local[v];
+                }
+            }
+        }
+    }
+    std::vector<std::uint32_t> cdf(prims::kHistogramBins);
+    std::uint64_t running = 0;
+    for(std::uint32_t b = 0; b < prims::kHistogramBins; ++b)
+    {
+        running += h[b];
+        cdf[b]   = static_cast<std::uint32_t>(running);
+    }
+
+    const double target = settings.white_percentile * static_cast<double>(n);
+    std::uint32_t white_bin = prims::kHistogramBins - 1;
+    for(std::uint32_t b = 0; b < prims::kHistogramBins; ++b)
+    {
+        if(static_cast<double>(cdf[b]) >= target)
+        {
+            white_bin = b;
+            break;
+        }
+    }
+    // upper edge of the bin
+    const float log2_white = kHistogramMinLog2 + (white_bin + 1) * (kHistogramMaxLog2 - kHistogramMinLog2) / 256.f;
+    s.white_point          = std::fmax(std::exp2(log2_white), 1e-3f);
+
+    // 3. tone map
+    tonemap_pixels(n, hdr, true, s.exposure, 1.f / (s.white_point * s.white_point), out);
+}
+} // namespace tsr
