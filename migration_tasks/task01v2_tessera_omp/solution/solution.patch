diff --git a/src/prims/bitonic_sort.cpp b/src/prims/bitonic_sort.cpp
new file mode 100644
index 0000000..23d6537
--- /dev/null
+++ b/src/prims/bitonic_sort.cpp
@@ -0,0 +1,95 @@
+// Tessera - single-team bitonic sort for short key/value arrays (OpenMP offload).
+//
+// The array is padded with maximal sentinels to a power of two and sorted in
+// team-shared arrays by one team; every compare-exchange stage is separated
+// by a barrier. Ordering is by (key, value).
+#include <omp.h>
+
+#include <limits>
+
+#include "tsr/prims/prims.h"
+
+namespace tsr::prims
+{
+namespace
+{
+constexpr unsigned kLimit = static_cast<unsigned>(kBitonicMaxElements);
+
+template<typename K, typename V>
+void bitonic_device(const K *keys_in, K *keys_out, const V *vals_in, V *vals_out, unsigned n, unsigned length)
+{
+    const int dev     = device_id();
+    const K key_max   = std::numeric_limits<K>::max();
+    const V val_max   = std::numeric_limits<V>::max();
+#pragma omp target teams num_teams(1) device(dev) is_device_ptr(keys_in, keys_out, vals_in, vals_out)
+    {
+        K s_key[kLimit];
+        V s_val[kLimit];
+#pragma omp parallel
+        {
+            const unsigned tid      = static_cast<unsigned>(omp_get_thread_num());
+            const unsigned nthreads = static_cast<unsigned>(omp_get_num_threads());
+            for(unsigned i = tid; i < length; i += nthreads)
+            {
+                s_key[i] = i < n ? keys_in[i] : key_max;
+                s_val[i] = i < n ? vals_in[i] : val_max;
+            }
+            for(unsigned size = 2; size <= length; size <<= 1)
+            {
+                for(unsigned stride = size / 2; stride > 0; stride >>= 1)
+                {
+#pragma omp barrier
+                    for(unsigned t = tid; t < length / 2; t += nthreads)
+                    {
+                        const unsigned pos = 2 * t - (t & (stride - 1));
+                        // ascending inside even blocks of `size`, descending in odd ones;
+                        // the last merge (size == length) is ascending everywhere
+                        const bool ascending = size == length || (pos & size) == 0;
+                        K &ka = s_key[pos];
+                        K &kb = s_key[pos + stride];
+                        V &va = s_val[pos];
+                        V &vb = s_val[pos + stride];
+                        const bool a_greater = ka > kb || (ka == kb && va > vb);
+                        if(a_greater == ascending)
+                        {
+                            const K tk = ka;
+                            ka         = kb;
+                            kb         = tk;
+                            const V tv = va;
+                            va         = vb;
+                            vb         = tv;
+                        }
+                    }
+                }
+            }
+#pragma omp barrier
+            for(unsigned i = tid; i < n; i += nthreads)
+            {
+                keys_out[i] = s_key[i];
+                vals_out[i] = s_val[i];
+            }
+        }
+    }
+}
+} // namespace
+
+template<typename K, typename V>
+void bitonic_sort_pairs(const K *keys_in, K *keys_out, const V *values_in, V *values_out, std::size_t n, Stream)
+{
+    TSR_CHECK(n <= kBitonicMaxElements, "bitonic_sort_pairs handles at most " << kBitonicMaxElements << " elements, got " << n);
+    if(n == 0)
+    {
+        return;
+    }
+    unsigned length = 2;
+    while(length < n)
+    {
+        length <<= 1;
+    }
+    bitonic_device(keys_in, keys_out, values_in, values_out, static_cast<unsigned>(n), length);
+}
+
+template void bitonic_sort_pairs<std::uint64_t, std::int32_t>(const std::uint64_t *, std::uint64_t *, const std::int32_t *, std::int32_t *, std::size_t, Stream);
+template void bitonic_sort_pairs<std::uint32_t, std::uint32_t>(const std::uint32_t *, std::uint32_t *, const std::uint32_t *, std::uint32_t *, std::size_t, Stream);
+template void bitonic_sort_pairs<std::uint32_t, std::int32_t>(const std::uint32_t *, std::uint32_t *, const std::int32_t *, std::int32_t *, std::size_t, Stream);
+} // namespace tsr::prims
