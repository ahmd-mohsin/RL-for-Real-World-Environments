new file mode 100644
index 0000000..6705a67
--- /dev/null
+++ b/src/encode/mlp.cpp
@@ -0,0 +1,335 @@
+// Tessera - small fully connected network evaluated with tiled GEMMs.
+//
+// The GEMM kernel is the shared-memory tiling scheme of MatrixMulCUDA from the
+// cuda-samples "matrixMul" sample (BSD-3-Clause), extended with bounds checks
+// for arbitrary shapes and a fused bias + activation epilogue.
+#include <algorithm>
+#include <cmath>
+
+#include "tsr/encode/mlp.h"
+#include "tsr/util/random.h"
+
+namespace tsr
+{
+namespace
+{
+#pragma omp begin declare target
+constexpr int kTile = 16;
+
+inline float activate(float x, Activation act)
+{
+    switch(act)
+    {
+    case Activation::ReLU: return fmaxf(x, 0.f);
+    case Activation::Sigmoid: return 1.f / (1.f + fast_expf(-x));
+    case Activation::None: break;
+    }
+    return x;
+}
+#pragma omp end declare target
+
+// Shared-memory tiling of MatrixMulCUDA: one team per kTile x kTile block of
+// C, slabs of A and B staged in team memory. Lane v = (ty, tx) owns one
+// element of the block; its partial sum lives in team memory so the kernel is
+// correct for any number of threads the runtime grants.
+void gemm_teams(const float *A, const float *B, const float *bias, float *C, int M, int N, int K, Activation act)
+{
+    const int row_blocks = div_round_up(M, kTile);
+    const int col_blocks = div_round_up(N, kTile);
+    const long long n_blocks = static_cast<long long>(row_blocks) * col_blocks;
+    const int teams      = static_cast<int>(std::min<long long>(n_blocks, 65536));
+    const int dev        = device_id();
+#pragma omp target teams num_teams(teams) thread_limit(kTile * kTile) device(dev) is_device_ptr(A, B, bias, C)
+    {
+        float As[kTile][kTile];
+        float Bs[kTile][kTile];
+        float acc[kTile * kTile];
+#pragma omp allocate(As, Bs, acc) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(kTile * kTile)
+        {
+            const int tid      = omp_get_thread_num();
+            const int nthreads = omp_get_num_threads();
+            for(long long blk = omp_get_team_num(); blk < n_blocks; blk += omp_get_num_teams())
+            {
+                // rows fastest: neighbouring teams share the same B columns
+                const int by = static_cast<int>(blk % row_blocks);
+                const int bx = static_cast<int>(blk / row_blocks);
+                for(int v = tid; v < kTile * kTile; v += nthreads)
+                {
+                    acc[v] = 0.f;
+                }
+                for(int t = 0; t < K; t += kTile)
+                {
+                    for(int v = tid; v < kTile * kTile; v += nthreads)
+                    {
+                        const int ty = v / kTile, tx = v % kTile;
+                        const int row = by * kTile + ty, col = bx * kTile + tx;
+                        As[ty][tx]    = (row < M && t + tx < K) ? A[static_cast<std::size_t>(row) * K + t + tx] : 0.f;
+                        Bs[ty][tx]    = (t + ty < K && col < N) ? B[static_cast<std::size_t>(t + ty) * N + col] : 0.f;
+                    }
+#pragma omp barrier
+                    for(int v = tid; v < kTile * kTile; v += nthreads)
+                    {
+                        const int ty = v / kTile, tx = v % kTile;
+                        float c      = acc[v];
+                        TSR_UNROLL
+                        for(int k = 0; k < kTile; ++k)
+                        {
+                            c += As[ty][k] * Bs[k][tx];
+                        }
+                        acc[v] = c;
+                    }
+#pragma omp barrier
+                }
+                for(int v = tid; v < kTile * kTile; v += nthreads)
+                {
+                    const int ty = v / kTile, tx = v % kTile;
+                    const int row = by * kTile + ty, col = bx * kTile + tx;
+                    if(row < M && col < N)
+                    {
+                        C[static_cast<std::size_t>(row) * N + col] = activate(acc[v] + (bias != nullptr ? bias[col] : 0.f), act);
+                    }
+                }
+#pragma omp barrier
+            }
+        }
+    }
+}
+// ---- fully fused forward pass ----------------------------------------------
+//
+// For the small networks of the neural material (hidden width 16, 32 or 64,
+// at most kFusedMaxLayers layers) one thread evaluates the whole network for
+// one input row: every weight and bias lives in team memory, the hidden
+// activations stay in registers, and no intermediate matrix touches global
+// memory. Sums run over k in increasing order and the bias is added last,
+// exactly as in gemm_bias_act, so both paths agree up to FMA contraction.
+constexpr int kFusedMaxLayers  = 5;
+constexpr int kFusedSmemFloats = 11 * 1024;
+constexpr int kFusedMaxOut     = 4;
+constexpr int kFusedThreads    = 128;
+
+struct FusedLayers
+{
+    const float *w[kFusedMaxLayers];
+    const float *b[kFusedMaxLayers];
+    int w_off[kFusedMaxLayers];
+    int b_off[kFusedMaxLayers];
+    int total_floats;
+};
+
+template<int H>
+void fused_forward(const float *input, std::uint32_t M, int in_dim, int out_dim, int n_layers, const FusedLayers &L, float *output)
+{
+    const float *w0 = L.w[0], *w1 = L.w[1], *w2 = L.w[2], *w3 = L.w[3], *w4 = L.w[4];
+    const float *b0 = L.b[0], *b1 = L.b[1], *b2 = L.b[2], *b3 = L.b[3], *b4 = L.b[4];
+    const FusedLayers lay = L;
+    const int teams       = static_cast<int>(std::min<std::uint32_t>(div_round_up<std::uint32_t>(M, kFusedThreads), 4096u));
+    const int dev         = device_id();
+#pragma omp target teams num_teams(teams) thread_limit(kFusedThreads) device(dev) \
+    is_device_ptr(input, output, w0, w1, w2, w3, w4, b0, b1, b2, b3, b4) firstprivate(lay)
+    {
+        float params[kFusedSmemFloats];
+#pragma omp allocate(params) allocator(omp_pteam_mem_alloc)
+#pragma omp parallel num_threads(kFusedThreads)
+        {
+            const int tid      = omp_get_thread_num();
+            const int nthreads = omp_get_num_threads();
+            const float *ws[kFusedMaxLayers] = {w0, w1, w2, w3, w4};
+            const float *bs[kFusedMaxLayers] = {b0, b1, b2, b3, b4};
+            for(int l = 0; l < n_layers; ++l)
+            {
+                const int fan_in  = l == 0 ? in_dim : H;
+                const int fan_out = l == n_layers - 1 ? out_dim : H;
+                for(int i = tid; i < fan_in * fan_out; i += nthreads)
+                {
+                    params[lay.w_off[l] + i] = ws[l][i];
+                }
+                for(int i = tid; i < fan_out; i += nthreads)
+                {
+                    params[lay.b_off[l] + i] = bs[l][i];
+                }
+            }
+#pragma omp barrier
+            const std::uint32_t stride = static_cast<std::uint32_t>(omp_get_num_teams()) * static_cast<std::uint32_t>(nthreads);
+            for(std::uint32_t row = static_cast<std::uint32_t>(omp_get_team_num()) * nthreads + tid; row < M; row += stride)
+            {
+                float h[H];
+                // input layer: in_dim -> H
+                {
+                    const float *W = params + lay.w_off[0];
+                    TSR_UNROLL
+                    for(int o = 0; o < H; ++o)
+                    {
+                        h[o] = 0.f;
+                    }
+                    const float *x = input + static_cast<std::size_t>(row) * in_dim;
+                    for(int k = 0; k < in_dim; ++k)
+                    {
+                        const float xk = x[k];
+                        TSR_UNROLL
+                        for(int o = 0; o < H; ++o)
+                        {
+                            h[o] += xk * W[k * H + o];
+                        }
+                    }
+                    const float *B = params + lay.b_off[0];
+                    TSR_UNROLL
+                    for(int o = 0; o < H; ++o)
+                    {
+                        h[o] = fmaxf(h[o] + B[o], 0.f);
+                    }
+                }
+                // hidden layers: H -> H
+                for(int l = 1; l < n_layers - 1; ++l)
+                {
+                    const float *W = params + lay.w_off[l];
+                    const float *B = params + lay.b_off[l];
+                    float g[H];
+                    TSR_UNROLL
+                    for(int o = 0; o < H; ++o)
+                    {
+                        g[o] = 0.f;
+                    }
+                    TSR_UNROLL
+                    for(int k = 0; k < H; ++k)
+                    {
+                        TSR_UNROLL
+                        for(int o = 0; o < H; ++o)
+                        {
+                            g[o] += h[k] * W[k * H + o];
+                        }
+                    }
+                    TSR_UNROLL
+                    for(int o = 0; o < H; ++o)
+                    {
+                        h[o] = fmaxf(g[o] + B[o], 0.f);
+                    }
+                }
+                // output layer: H -> out_dim, sigmoid
+                {
+                    const float *W = params + lay.w_off[n_layers - 1];
+                    const float *B = params + lay.b_off[n_layers - 1];
+                    for(int o = 0; o < out_dim; ++o)
+                    {
+                        float y = 0.f;
+                        TSR_UNROLL
+                        for(int k = 0; k < H; ++k)
+                        {
+                            y += h[k] * W[k * out_dim + o];
+                        }
+                        output[static_cast<std::size_t>(row) * out_dim + o] = activate(y + B[o], Activation::Sigmoid);
+                    }
+                }
+            }
+        }
+    }
+}
+} // namespace
+
+void gemm_bias_act(
+    const float *A,
+    const float *B,
+    const float *bias,
+    float *C,
+    std::uint32_t M,
+    std::uint32_t N,
+    std::uint32_t K,
+    Activation act,
+    Stream stream
+)
+{
+    if(M == 0 || N == 0)
+    {
+        return;
+    }
+    gemm_teams(A, B, bias, C, static_cast<int>(M), static_cast<int>(N), static_cast<int>(K), act);
+}
+
+void Mlp::initialize(std::uint32_t in_dim, std::uint32_t out_dim, const MlpConfig &config, std::uint32_t seed, Stream stream)
+{
+    TSR_CHECK(in_dim > 0 && out_dim > 0 && config.hidden_width > 0, "MLP dimensions must be positive");
+    in_dim_  = in_dim;
+    out_dim_ = out_dim;
+    dims_.clear();
+    dims_.push_back(in_dim);
+    for(std::uint32_t l = 0; l < config.hidden_layers; ++l)
+    {
+        dims_.push_back(config.hidden_width);
+    }
+    dims_.push_back(out_dim);
+
+    Pcg32 rng(seed, 0x9e3779b97f4a7c15ULL);
+    weights_.clear();
+    biases_.clear();
+    weights_.resize(dims_.size() - 1);
+    biases_.resize(dims_.size() - 1);
+    for(std::size_t l = 0; l + 1 < dims_.size(); ++l)
+    {
+        const std::uint32_t fan_in  = dims_[l];
+        const std::uint32_t fan_out = dims_[l + 1];
+        const float limit           = std::sqrt(6.0f / static_cast<float>(fan_in + fan_out));
+        std::vector<float> w(static_cast<std::size_t>(fan_in) * fan_out);
+        for(float &v : w)
+        {
+            v = rng.uniform(-limit, limit);
+        }
+        weights_[l].upload(w, stream);
+        biases_[l].upload(std::vector<float>(fan_out, 0.f), stream);
+    }
+}
+
+void Mlp::forward(const float *input, std::uint32_t M, float *output, Arena &arena, Stream stream) const
+{
+    TSR_CHECK(!weights_.empty(), "MLP is not initialized");
+    if(M == 0)
+    {
+        return;
+    }
+    // Fused path for the material networks.
+    const int n_layers = static_cast<int>(weights_.size());
+    const int H        = n_layers > 1 ? static_cast<int>(dims_[1]) : 0;
+    bool fused         = n_layers >= 2 && n_layers <= kFusedMaxLayers && (H == 16 || H == 32 || H == 64) && dims_[0] <= 64
+                 && out_dim_ <= static_cast<std::uint32_t>(kFusedMaxOut);
+    for(int l = 1; fused && l < n_layers; ++l)
+    {
+        fused = static_cast<int>(dims_[l]) == H;
+    }
+    if(fused)
+    {
+        FusedLayers L{};
+        int off = 0;
+        for(int l = 0; l < n_layers; ++l)
+        {
+            L.w[l]     = weights_[l].data();
+            L.b[l]     = biases_[l].data();
+            L.w_off[l] = off;
+            off       += static_cast<int>(dims_[l] * dims_[l + 1]);
+            L.b_off[l] = off;
+            off       += static_cast<int>(dims_[l + 1]);
+        }
+        L.total_floats = off;
+        fused          = off <= kFusedSmemFloats;
+        if(fused)
+        {
+            const int in_dim = static_cast<int>(dims_[0]), out_dim = static_cast<int>(out_dim_);
+            switch(H)
+            {
+            case 16: fused_forward<16>(input, M, in_dim, out_dim, n_layers, L, output); break;
+            case 32: fused_forward<32>(input, M, in_dim, out_dim, n_layers, L, output); break;
+            default: fused_forward<64>(input, M, in_dim, out_dim, n_layers, L, output); break;
+            }
+            return;
+        }
+    }
+
+    const float *src = input;
+    for(std::size_t l = 0; l < weights_.size(); ++l)
+    {
+        const bool last      = l + 1 == weights_.size();
+        float *dst           = last ? output : arena.allocate<float>(static_cast<std::size_t>(M) * dims_[l + 1]);
+        const Activation act = last ? Activation::Sigmoid : Activation::ReLU;
+        gemm_bias_act(src, weights_[l].data(), biases_[l].data(), dst, M, dims_[l + 1], dims_[l], act, stream);
+        src = dst;
+    }
+}
+} // namespace tsr
