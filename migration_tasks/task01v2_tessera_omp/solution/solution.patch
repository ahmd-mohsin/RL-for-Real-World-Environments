diff --git a/include/tsr/device/device.h b/include/tsr/device/device.h
new file mode 100644
index 0000000..1d1ddca
--- /dev/null
+++ b/include/tsr/device/device.h
@@ -0,0 +1,33 @@
+// Tessera - OpenMP offload device access.
+//
+// All device memory lives on one OpenMP device (the default device unless
+// TSR_DEVICE is set). Work is submitted synchronously; Stream is kept as an
+// opaque handle so call sites stay source compatible with the former CUDA
+// API, and nullptr names the default stream.
+#pragma once
+
+#include <cstddef>
+
+#include "tsr/device/error.h"
+
+namespace tsr
+{
+struct StreamImpl;
+using Stream = StreamImpl *;
+
+// OpenMP device number used for every allocation and kernel.
+int device_id();
+// OpenMP device number of the host.
+int host_id();
+
+void *device_alloc(std::size_t bytes);
+void device_free(void *ptr) noexcept;
+void copy_to_device(void *dst, const void *src, std::size_t bytes);
+void copy_to_host(void *dst, const void *src, std::size_t bytes);
+void copy_device_to_device(void *dst, const void *src, std::size_t bytes);
+void device_memset(void *dst, int value, std::size_t bytes);
+
+// Waits for outstanding work on `stream` (all work is synchronous today).
+inline void synchronize(Stream = nullptr) {}
+
+} // namespace tsr
