+
+                // One bin per thread: reserve space for this chunk's faces with a
+                // single global atomic, then write them in face order.
+                for(int byx = tid; byx < num_bins_y * num_bins_x; byx += nthreads)
+                {
+                    const unsigned int *row = mask + byx * words_per;
+                    int count               = 0;
+                    for(int i = 0; i < words_per; ++i)
+                    {
+                        count += popcount32(row[i]);
+                    }
+                    if(count == 0)
+                    {
+                        continue;
+                    }
+                    int start;
+#pragma omp atomic capture
+                    {
+                        start = elems_per_bin[byx];
+                        elems_per_bin[byx] += count;
+                    }
+                    if(start + count > M)
+                    {
+#pragma omp atomic write
+                        *overflow_flag = 1;
+                        continue;
+                    }
+                    int next_idx = byx * M + start;
+                    for(int i = 0; i < words_per; ++i)
+                    {
+                        unsigned int word = row[i];
+                        while(word != 0u)
+                        {
+                            const int bit         = __builtin_ctz(word);
+                            bin_elems[next_idx++] = chunk_start + i * 32 + bit;
+                            word &= word - 1u;
+                        }
+                    }
+                }
+#pragma omp barrier
+            }
+        }
+    }
+}
+} // namespace
+
+void bin_mesh_faces(
+    const ViewFaces &faces,
+    int width,
+    int height,
+    const MeshBinningSettings &settings,
+    MeshBins &out,
+    Arena &arena,
+    Stream stream
+)
+{
+    TSR_CHECK(settings.bin_size > 0, "bin size must be positive");
+    out.bin_size          = settings.bin_size;
+    out.bins_x            = 1 + (width - 1) / settings.bin_size;
+    out.bins_y            = 1 + (height - 1) / settings.bin_size;
+    out.max_faces_per_bin = settings.max_faces_per_bin;
+    out.overflowed        = false;
+    TSR_CHECK(out.bins_x < kMaxBinsPerSide && out.bins_y < kMaxBinsPerSide,
+              "too many bins (" << out.bins_x << " x " << out.bins_y << "); increase bin_size");
+
+    const int n_bins = out.bins_x * out.bins_y;
+    out.faces_per_bin.resize(static_cast<std::size_t>(n_bins));
+    out.bin_faces.resize(static_cast<std::size_t>(n_bins) * settings.max_faces_per_bin);
+    out.faces_per_bin.zero(stream);
+    device_memset(out.bin_faces.data(), 0xff, out.bin_faces.bytes()); // -1 sentinels
+    const int F = static_cast<int>(faces.n_faces);
+    if(F == 0)
+    {
+        return;
+    }
+
+    float4 *bboxes     = arena.allocate<float4>(F);
+    std::uint8_t *skip = arena.allocate<std::uint8_t>(F);
+    int *overflow_flag = arena.allocate<int>(1);
+    device_memset(overflow_flag, 0, sizeof(int));
+    {
+        const float3 *ndc   = faces.ndc.data();
+        const float blur    = settings.blur_radius;
+        const int dev       = device_id();
+#pragma omp target teams distribute parallel for thread_limit(kLinearBlockSize) device(dev) is_device_ptr(ndc, bboxes, skip)
+        for(int f = 0; f < F; ++f)
+        {
+            triangle_bounding_box(f, ndc, blur, bboxes, skip);
+        }
+    }
+
+    // The bit mask holds n_bins x chunk bits; shrink the chunk for large bin
+    // grids so that it fits the team-memory budget.
+    const int chunk = std::min(kMaxChunkSize, (kMaskWords * 32 / n_bins) / 32 * 32);
+    TSR_CHECK(chunk >= 32, "too many bins (" << out.bins_x << " x " << out.bins_y << ") for the coarse rasterizer; increase bin_size");
+    rasterize_coarse(bboxes, skip, F, height, width, settings.bin_size, settings.max_faces_per_bin, chunk, out.faces_per_bin.data(),
+                     out.bin_faces.data(), overflow_flag);
+
+    int overflow = 0;
+    copy_to_host(&overflow, overflow_flag, sizeof(int));
+    out.overflowed = overflow != 0;
+}
+} // namespace tsr
