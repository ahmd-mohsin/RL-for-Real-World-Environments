};
template<int N>
using vec_t = typename vec_of<N>::type;

TSR_HDI float comp(const float2 &v, int i) { return i == 0 ? v.x : v.y; }
TSR_HDI float comp(const float3 &v, int i) { return i == 0 ? v.x : (i == 1 ? v.y
: v.z); }
TSR_HDI float comp(const float4 &v, int i) { return i == 0 ? v.x : (i == 1 ? v.y
: (i == 2 ? v.z : v.w)); }

template<int N>
TSR_HDI vec_t<N> vec_from(const float *a)
{
    if constexpr(N == 2)
    {
        return make_float2(a[0], a[1]);
    }
    else if constexpr(N == 3)
    {
        return make_float3(a[0], a[1], a[2]);
