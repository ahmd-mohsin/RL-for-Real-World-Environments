cmake_minimum_required(VERSION 3.24)
project(tessera VERSION 0.7.0 LANGUAGES CXX)

option(TSR_BUILD_TESTS "Build the test suite" ON)
option(TSR_BUILD_APPS "Build command line tools" ON)
set(TSR_OFFLOAD_ARCH "" CACHE STRING "OpenMP GPU offload architecture (for 
example sm_89)")
set(TSR_OFFLOAD_TARGETS "" CACHE STRING "OpenMP target triples used when 
TSR_OFFLOAD_ARCH is empty")

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_BUILD_TYPE RelWithDebInfo CACHE STRING "" FORCE)
endif()
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  message(FATAL_ERROR "Tessera OpenMP target offload requires clang++ 18 or 
newer")
endif()

if(TSR_OFFLOAD_ARCH)
  set(TSR_OMP_FLAGS -fopenmp -fopenmp-targets=nvptx64-nvidia-cuda 
--offload-arch=${TSR_OFFLOAD_ARCH})
elseif(TSR_OFFLOAD_TARGETS)
  set(TSR_OMP_FLAGS -fopenmp -fopenmp-targets=${TSR_OFFLOAD_TARGETS})
else()
  # A host-only build is still an OpenMP implementation and is useful as the
  # CPU fallback.  OMP_TARGET_OFFLOAD controls whether fallback is permitted.
  set(TSR_OMP_FLAGS -fopenmp)
endif()

include(cmake/TesseraDevice.cmake)
add_subdirectory(src)
if(TSR_BUILD_APPS)
  add_subdirectory(apps)
endif()
if(TSR_BUILD_TESTS)
  enable_testing()
  add_subdirectory(tests)
endif()
set(TSR_DEVICE_SOURCES
  device/error.cpp
  device/memory.cpp
  prims/scan.cpp
  prims/reduce.cpp
  prims/histogram.cpp
  prims/radix_sort.cpp
  prims/bitonic_sort.cpp
  prims/compact.cpp
  geom/camera.cpp
  geom/projection.cpp
  geom/mesh.cpp
  bin/tile_intersect.cpp
  bin/mesh_bins.cpp
  raster/mesh_raster.cpp
  raster/splat_raster.cpp
  encode/hashgrid.cpp
  encode/mlp.cpp
  render/surface.cpp
  render/renderer.cpp
  post/tonemap.cpp
  scene/scene.cpp
  io/image.cpp
  sched/frame_scheduler.cpp
)


add_library(tessera SHARED ${TSR_DEVICE_SOURCES})
target_include_directories(tessera PUBLIC ${PROJECT_SOURCE_DIR}/include)
target_compile_features(tessera PUBLIC cxx_std_20)
find_package(Threads REQUIRED)
target_link_libraries(tessera PUBLIC Threads::Threads)
tsr_target_warnings(tessera)
tsr_target_offload(tessera)
function(tsr_target_offload target)
  target_compile_options(${target} PRIVATE ${TSR_OMP_FLAGS} -ffp-contract=fast)
  target_link_options(${target} PUBLIC ${TSR_OMP_FLAGS})
endfunction()
function(tsr_target_warnings target)
  target_compile_options(${target} PRIVATE -Wall -Wextra -Wno-unknown-pragmas 
-Wno-unused-parameter)
endfunction()

