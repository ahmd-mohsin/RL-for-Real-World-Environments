TSR_DI float2 ellipse_intersection(float A, float B, float C, float disc, float 
t, float2 p, bool is_y, float coord)
{
    const float p_u       = is_y ? p.y : p.x;
    const float p_v       = is_y ? p.x : p.y;
    const float coeff     = is_y ? A : C;
    const float h         = coord - p_u;
    const float sqrt_term = sqrtf(disc * h * h + t * coeff);
    return make_float2((-B * h - sqrt_term) / coeff + p_v, (-B * h + sqrt_term) 
/ coeff + p_v);
}

// Walks the columns (or rows when is_y) of the tile rectangle and, for each,
// the range of tiles the ellipse covers. Counts them and, if keys != nullptr,
// emits one intersection per tile.
TSR_DI std::uint32_t accutile_tiles(
    float A,
    float B,
    float C,
    float disc,
    float t,
    float2 p,
    float2 bbox_min,
    float2 bbox_max,
    float2 bbox_argmin,
    float2 bbox_argmax,
    int2 rect_min,
    int2 rect_max,
    std::uint32_t tile_size,
    std::uint32_t tiles_x,
    bool is_y,
    std::uint64_t depth_bits,
    std::int32_t splat,
    std::uint64_t *keys,
    std::int32_t *ids,
    std::int64_t cursor
)
{
    const float block = static_cast<float>(tile_size);
    if(is_y)
    {
        rect_min    = make_int2(rect_min.y, rect_min.x);
        rect_max    = make_int2(rect_max.y, rect_max.x);
        bbox_min    = make_float2(bbox_min.y, bbox_min.x);
        bbox_max    = make_float2(bbox_max.y, bbox_max.x);
        bbox_argmin = make_float2(bbox_argmin.y, bbox_argmin.x);
        bbox_argmax = make_float2(bbox_argmax.y, bbox_argmax.x);
    }

    std::uint32_t count = 0;
    float2 intersect_max_line = make_float2(bbox_max.y, bbox_min.y);
    float min_line            = rect_min.x * block;
    float2 intersect_min_line = bbox_min.x <= min_line ? ellipse_intersection(A,
B, C, disc, t, p, is_y, min_line) : intersect_max_line;

    TSR_NO_UNROLL
    for(int u = rect_min.x; u < rect_max.x; ++u)
    {
        const float max_line = min_line + block;
        if(max_line <= bbox_max.x)
        {
            intersect_max_line = ellipse_intersection(A, B, C, disc, t, p, is_y,
max_line);
        }
        const float ellipse_min = (min_line <= bbox_argmin.y && bbox_argmin.y < 
max_line)
                                    ? bbox_min.y
                                    : fminf(intersect_min_line.x, 
intersect_max_line.x);
        const float ellipse_max = (min_line <= bbox_argmax.y && bbox_argmax.y < 
max_line)
                                    ? bbox_max.y
                                    : fmaxf(intersect_min_line.y, 
intersect_max_line.y);

        const int min_tile_v = max(rect_min.y, min(rect_max.y, 
static_cast<int>(ellipse_min / block)));
        const int max_tile_v = min(rect_max.y, max(rect_min.y, 
static_cast<int>(ellipse_max / block + 1)));

        TSR_NO_UNROLL
        for(int v = min_tile_v; v < max_tile_v; ++v)
        {
            const std::uint64_t tile_id = is_y ? static_cast<std::uint64_t>(u) *
tiles_x + v : static_cast<std::uint64_t>(v) * tiles_x + u;
            if(keys != nullptr)
            {
                keys[cursor + count] = (tile_id << 32) | depth_bits;
                ids[cursor + count]  = splat;
            }
            ++count;
        }
        intersect_min_line = intersect_max_line;
        min_line           = max_line;
    }
    return count;
}

