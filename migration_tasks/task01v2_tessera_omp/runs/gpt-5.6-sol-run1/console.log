#include <omp.h>
#include <cstring>
#include "tsr/device/memory.h"
namespace tsr {
namespace {
int target_device() { return omp_get_default_device(); }
}
namespace detail {
void *device_alloc(std::size_t n) {
 if(n==0) return nullptr;
 void *p=omp_target_alloc(n,target_device());
 if(!p) throw DeviceError(-1,"OpenMP target allocation failed for 
"+std::to_string(n)+" bytes");
 return p;
}
void device_free(void *p) noexcept { if(p) omp_target_free(p,target_device()); }
void copy_to_device(void *d,const void *h,std::size_t n) {
 if(n && omp_target_memcpy(d,const_cast<void 
*>(h),n,0,0,target_device(),omp_get_initial_device())!=0)
   throw DeviceError(-2,"OpenMP host-to-device copy failed");
}
void copy_from_device(void *h,const void *d,std::size_t n) {
 if(n && omp_target_memcpy(h,const_cast<void 
*>(d),n,0,0,omp_get_initial_device(),target_device())!=0)
   throw DeviceError(-3,"OpenMP device-to-host copy failed");
}
void device_memset(void *p,int value,std::size_t n) {
 if(!n) return;
 if(value==0) {
#pragma omp target teams distribute parallel for is_device_ptr(p)
  for(std::size_t i=0;i<n;++i) static_cast<unsigned char *>(p)[i]=0;
 } else {
#pragma omp target teams distribute parallel for is_device_ptr(p)
  for(std::size_t i=0;i<n;++i) static_cast<unsigned char 
*>(p)[i]=static_cast<unsigned char>(value);
 }
}
}
void device_synchronize(Stream) {
#pragma omp taskwait
}
