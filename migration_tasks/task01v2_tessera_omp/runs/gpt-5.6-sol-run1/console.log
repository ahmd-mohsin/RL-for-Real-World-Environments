#include <omp.h>
#include "tsr/prims/prims.h"
namespace tsr::prims { namespace {
constexpr std::size_t tile_size=1024;
template<class T> void scan_impl(const T *in,T *out,std::size_t n,bool 
inclusive,Arena &arena) {
 if(!n)return; std::size_t nt=div_round_up(n,tile_size); T 
*tot=nt>1?arena.allocate<T>(nt):nullptr;
#pragma omp target teams num_teams(nt) thread_limit(256) 
is_device_ptr(in,out,tot)
 {
  T data[tile_size]; const std::size_t team=omp_get_team_num(); const 
std::size_t base=team*tile_size;
#pragma omp parallel
  {
   int tid=omp_get_thread_num(), nth=omp_get_num_threads();
   for(int j=tid;j<(int)tile_size;j+=nth) data[j]=(base+j<n)?in[base+j]:T(0);
#pragma omp barrier
   for(int off=1;off<(int)tile_size;off<<=1) {
     for(int j=tid;j<(int)tile_size;j+=nth) { T v=data[j]; 
if(j>=off)v+=data[j-off]; out[(base+j<n)?base+j:0]=v; }
#pragma omp barrier
     for(int j=tid;j<(int)tile_size;j+=nth) if(base+j<n)data[j]=out[base+j];
#pragma omp barrier
   }
   for(int j=tid;j<(int)tile_size;j+=nth) if(base+j<n) 
out[base+j]=inclusive?data[j]:(j?data[j-1]:T(0));
   if(tid==0 && tot) tot[team]=data[tile_size-1];
  }
 }
 if(nt>1){scan_impl(tot,tot,nt,false,arena);
#pragma omp target teams distribute parallel for is_device_ptr(out,tot)
  for(std::size_t i=0;i<n;++i) out[i]+=tot[i/tile_size];
 }
}
}
template<class T> void exclusive_scan(const T*i,T*o,std::size_t 
n,Arena&a,Stream){scan_impl(i,o,n,false,a);}
template<class T> void inclusive_scan(const T*i,T*o,std::size_t 
n,Arena&a,Stream){scan_impl(i,o,n,true,a);}
template<class T> T exclusive_scan_total(const T*i,T*o,std::size_t 
n,Arena&a,Stream){if(!n)return T(0); T last[2]; 
detail::copy_from_device(last,i+n-1,sizeof(T));scan_impl(i,o,n,false,a);detail::
copy_from_device(last+1,o+n-1,sizeof(T));return last[0]+last[1];}
#define I(T) template void exclusive_scan<T>(const 
T*,T*,std::size_t,Arena&,Stream); template void inclusive_scan<T>(const 
T*,T*,std::size_t,Arena&,Stream); template T exclusive_scan_total<T>(const 
T*,T*,std::size_t,Arena&,Stream);
I(std::uint32_t) I(std::int32_t) I(std::uint64_t) I(std::int64_t) I(float)
#undef I
}
