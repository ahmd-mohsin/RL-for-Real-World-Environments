#include <omp.h>
#include <limits>
#include "tsr/prims/prims.h"
namespace tsr::prims { namespace {
template<class T> T ident(ReduceOp op){return 
op==ReduceOp::Sum?T(0):(op==ReduceOp::Max?std::numeric_limits<T>::lowest():std::
numeric_limits<T>::max());}
template<class T> void impl(const T*in,std::size_t n,T*out,ReduceOp op,Arena&a){
 if(!n){T v=ident<T>(op);detail::copy_to_device(out,&v,sizeof(v));return;} 
constexpr int NB=256; T*part=a.allocate<T>(NB);
