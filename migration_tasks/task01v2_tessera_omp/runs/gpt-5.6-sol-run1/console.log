void bin_mesh_faces(
    const ViewFaces &faces,
    int width,
    int height,
    const MeshBinningSettings &settings,
    MeshBins &out,
    Arena &arena,
    cudaStream_t stream
)
{
    TSR_CHECK(settings.bin_size > 0, "bin size must be positive");
    out.bin_size          = settings.bin_size;
    out.bins_x            = 1 + (width - 1) / settings.bin_size;
    out.bins_y            = 1 + (height - 1) / settings.bin_size;
    out.max_faces_per_bin = settings.max_faces_per_bin;
    out.overflowed        = false;
    TSR_CHECK(out.bins_x < kMaxBinsPerSide && out.bins_y < kMaxBinsPerSide,
              "too many bins (" << out.bins_x << " x " << out.bins_y << "); 
increase bin_size");

    const int n_bins = out.bins_x * out.bins_y;
    out.faces_per_bin.resize(static_cast<std::size_t>(n_bins));
    out.bin_faces.resize(static_cast<std::size_t>(n_bins) * 
settings.max_faces_per_bin);
    out.faces_per_bin.zero(stream);
    TSR_CUDA_CHECK(cudaMemsetAsync(out.bin_faces.data(), 0xff, 
out.bin_faces.bytes(), stream)); // -1 sentinels
    const int F = static_cast<int>(faces.n_faces);
    if(F == 0)
    {
        return;
    }

    float4 *bboxes      = arena.allocate<float4>(F);
    std::uint8_t *skip  = arena.allocate<std::uint8_t>(F);
    int *overflow_flag  = arena.allocate<int>(1);
    TSR_CUDA_CHECK(cudaMemsetAsync(overflow_flag, 0, sizeof(int), stream));
    launch_linear(triangle_bounding_box_kernel, static_cast<std::uint32_t>(F), 
stream, faces.ndc.data(), F, settings.blur_radius, bboxes, skip);

    // The bit mask holds n_bins x chunk bits; shrink the chunk for large bin
    // grids so that it fits the shared-memory budget.
    const int chunk = std::min(kMaxChunkSize, (kCoarseSmemBytes * 8 / n_bins) / 
32 * 32);
    TSR_CHECK(chunk >= 32, "too many bins (" << out.bins_x << " x " << 
out.bins_y << ") for the coarse rasterizer; increase bin_size");
    const std::size_t smem = static_cast<std::size_t>(n_bins) * chunk / 8;
    const int blocks       = std::min(kCoarseBlocks, 1 + (F - 1) / chunk);
    TSR_CUDA_CHECK(cudaFuncSetAttribute(rasterize_coarse_kernel, 
cudaFuncAttributeMaxDynamicSharedMemorySize, static_cast<int>(smem)));
    launch(
        rasterize_coarse_kernel,
        LaunchConfig{dim3(blocks), dim3(kCoarseThreads), smem, stream},
        bboxes, skip, F, height, width, settings.bin_size, 
settings.max_faces_per_bin, chunk, out.faces_per_bin.data(),
        out.bin_faces.data(), overflow_flag
    );

    int overflow = 0;
    TSR_CUDA_CHECK(cudaMemcpyAsync(&overflow, overflow_flag, sizeof(int), 
cudaMemcpyDeviceToHost, stream));
    TSR_CUDA_CHECK(cudaStreamSynchronize(stream));
    out.overflowed = overflow != 0;
}
} // namespace tsr

