namespace tsr
{
struct SplatRasterSettings
{
    // 1: one thread per pixel. 4: each thread shades four pixels of a column,
    // which lowers occupancy needs on small tiles (only valid for 16x16 tiles).
    std::uint32_t pixels_per_thread = 1;
};

struct SplatRasterOutput
{
    int width  = 0;
    int height = 0;
    DeviceBuffer<float3> color;        // [H][W] final composite (linear 
radiance)
    DeviceBuffer<float> alpha;         // [H][W] splat coverage: 1 - 
transmittance
    DeviceBuffer<std::int32_t> last_contributor; // [H][W] tile-relative index 
of the last blended intersection
};

