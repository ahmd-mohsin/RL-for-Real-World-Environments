    config_ = config;

    const float log2_scale = std::log2(config.per_level_scale);
    offsets_.assign(config.n_levels + 1, 0);
    std::uint32_t offset = 0;
    for(std::uint32_t level = 0; level < config.n_levels; ++level)
    {
        const std::uint32_t resolution = grid_resolution(grid_scale(level, 
log2_scale, config.base_resolution));
        const std::uint32_t max_params = 
std::numeric_limits<std::uint32_t>::max() / 2;
        const float dense              = 
std::pow(static_cast<float>(resolution), static_cast<float>(kPosDims));
        std::uint32_t params_in_level  = dense > static_cast<float>(max_params) 
? max_params : resolution * resolution * resolution;
        // keep memory accesses aligned
        params_in_level = next_multiple(params_in_level, 8u);
        params_in_level = std::min(params_in_level, 1u << 
config.log2_hashmap_size);
        offsets_[level] = offset;
        offset         += params_in_level;
    }
    offsets_[config.n_levels] = offset;

    Pcg32 rng(seed, 0x4f1bbcdcbfa53e0bULL);
    std::vector<float> host(static_cast<std::size_t>(offset) * 
config.features_per_level);
    for(float &v : host)
    {
        v = rng.uniform(-init_scale, init_scale);
    }
    params_.upload(host, stream);
    d_offsets_.upload(offsets_, stream);
}

void encode_positions(
    const HashGrid &grid,
    const float3 *positions,
    std::uint32_t n,
    float *out,
    GridInterpolation interpolation,
    Stream stream
)
{
    if(n == 0)
    {
        return;
    }
    const HashGridConfig &c  = grid.config();
    const float log2_scale   = std::log2(c.per_level_scale);
    auto levels=c.n_levels; auto base=c.base_resolution; auto 
F=c.features_per_level; auto *offsets=grid.device_offsets(); auto 
*params=grid.params(); auto *pos=positions; auto *dst=out;
#define TSR_ENCODE_CASE(NF) case NF: \
 _Pragma("omp target teams distribute parallel for collapse(2) 
is_device_ptr(offsets,params,pos,dst)") \
 for(std::uint32_t level=0;level<levels;++level) for(std::uint32_t i=0;i<n;++i) 
encode_one<NF>(i,level,levels,log2_scale,base,offsets,params,pos,interpolation,d
st); break
    switch(F) { TSR_ENCODE_CASE(1); TSR_ENCODE_CASE(2); TSR_ENCODE_CASE(4); 
TSR_ENCODE_CASE(8); default: TSR_CHECK(false,"unsupported features per level 
"<<F); }
#undef TSR_ENCODE_CASE
}}
