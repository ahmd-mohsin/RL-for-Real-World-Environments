if(bytes>main_.size()){TSR_CHECK(offset_==0&&overflow_.empty(),"Arena::reserve 
called while allocations are live");main_.resize(bytes);} }
void Arena::reset(){if(!overflow_.empty()){auto 
want=align_up(high_water_);overflow_.clear();main_.release();main_.resize(want);
}offset_=used_=0;}
void *Arena::allocate_bytes(std::size_t bytes){auto 
a=align_up(bytes?bytes:1);used_+=a;if(used_>high_water_)high_water_=used_;if(off
set_+a<=main_.size()){void*p=main_.data()+offset_;offset_+=a;return 
p;}overflow_.emplace_back(a);return overflow_.back().data();}
std::size_t Arena::capacity() const noexcept {std::size_t 
n=main_.size();for(auto &b:overflow_)n+=b.size();return n;}
}
