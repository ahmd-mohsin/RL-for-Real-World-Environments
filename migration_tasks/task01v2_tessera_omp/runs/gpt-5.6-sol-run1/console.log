===include/tsr/encode/hashgrid.h
// Tessera - multiresolution hash-grid encoding of 3D positions.
//
// L levels with geometrically increasing resolution; each level stores F
// features per grid vertex in a table that is dense while it fits and hashed
// beyond that. A position in [0, 1]^3 is encoded by trilinear interpolation
// at every level, giving L * F features.
#pragma once

#include <cstdint>
#include <vector>

#include "tsr/device/memory.h"
#include "tsr/scene/scene.h"

namespace tsr
{
enum class GridInterpolation : std::uint32_t
{
    Nearest = 0,
    Linear  = 1,
};

class HashGrid
{
public:
    // Builds the per-level offset table and draws parameters uniformly from
    // [-init_scale, init_scale] with a PCG32 seeded by `seed`.
    void initialize(const HashGridConfig &config, std::uint32_t seed, float 
init_scale, cudaStream_t stream);

    [[nodiscard]] const HashGridConfig &config() const { return config_; }
    [[nodiscard]] std::uint32_t n_output_dims() const { return config_.n_levels 
* config_.features_per_level; }
    [[nodiscard]] const std::vector<std::uint32_t> &offsets() const { return 
offsets_; } // [L + 1], in grid vertices
    [[nodiscard]] std::uint32_t n_params() const { return offsets_.empty() ? 0 :
offsets_.back() * config_.features_per_level; }
    [[nodiscard]] const float *params() const { return params_.data(); }
    [[nodiscard]] const std::uint32_t *device_offsets() const { return 
d_offsets_.data(); }
    [[nodiscard]] std::vector<float> params_to_host() const { return 
params_.to_host(); }

private:
    HashGridConfig config_{};
    std::vector<std::uint32_t> offsets_;
    DeviceBuffer<std::uint32_t> d_offsets_;
    DeviceBuffer<float> params_;
};

// Level scale and vertex resolution. `base_resolution` counts grid vertices,
// hence the -1 (power-of-two parameter grids for power-of-two bases).
float grid_scale(std::uint32_t level, float log2_per_level_scale, std::uint32_t 
base_resolution);
std::uint32_t grid_resolution(float scale);

// out[i * n_output_dims + level * F + f]; positions must lie in [0, 1]^3.
void encode_positions(
    const HashGrid &grid,
    const float3 *positions,
    std::uint32_t n,
    float *out,
    GridInterpolation interpolation,
    cudaStream_t stream
);

} // namespace tsr
===include/tsr/encode/mlp.h
// Tessera - small fully connected network evaluated with tiled GEMMs.
#pragma once

#include <cstdint>
#include <vector>

#include "tsr/device/memory.h"
#include "tsr/scene/scene.h"

namespace tsr
{
enum class Activation : std::uint32_t
{
    None    = 0,
    ReLU    = 1,
    Sigmoid = 2,
};

// C[M x N] = act(A[M x K] * B[K x N] + bias[N]); all row-major. bias may be 
null.
void gemm_bias_act(
    const float *A,
    const float *B,
    const float *bias,
    float *C,
    std::uint32_t M,
    std::uint32_t N,
    std::uint32_t K,
    Activation act,
    cudaStream_t stream
);

class Mlp
{
public:
    // in -> [hidden_width] x hidden_layers (ReLU) -> out (sigmoid). Weights use
    // Xavier-uniform initialization from a PCG32 seeded with `seed`; biases
    // start at zero.
    void initialize(std::uint32_t in_dim, std::uint32_t out_dim, const MlpConfig
&config, std::uint32_t seed, cudaStream_t stream);

    // input [M x in_dim] -> output [M x out_dim]
    void forward(const float *input, std::uint32_t M, float *output, Arena 
&arena, cudaStream_t stream) const;

    [[nodiscard]] std::uint32_t in_dim() const { return in_dim_; }
    [[nodiscard]] std::uint32_t out_dim() const { return out_dim_; }
    [[nodiscard]] std::size_t n_layers() const { return weights_.size(); }
    [[nodiscard]] std::vector<float> weights_to_host(std::size_t layer) const { 
return weights_[layer].to_host(); }
    [[nodiscard]] std::vector<float> biases_to_host(std::size_t layer) const { 
return biases_[layer].to_host(); }
    [[nodiscard]] std::uint32_t layer_in(std::size_t layer) const { return 
dims_[layer]; }
    [[nodiscard]] std::uint32_t layer_out(std::size_t layer) const { return 
dims_[layer + 1]; }

private:
    std::uint32_t in_dim_  = 0;
    std::uint32_t out_dim_ = 0;
    std::vector<std::uint32_t> dims_;
    std::vector<DeviceBuffer<float>> weights_; // [layer] row-major [in x out]
    std::vector<DeviceBuffer<float>> biases_;
};

} // namespace tsr
