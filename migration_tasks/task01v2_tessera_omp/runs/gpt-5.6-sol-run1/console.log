                const float vis = gw.alpha * T[p];
                pix_out[p]     += colors[id_batch[t]] * vis;
                last_offset[p]  = batch_offset + static_cast<std::int32_t>(t);
                T[p]            = next_T;
            }
        }

        // resync before the next batch; stop once every pixel is done
        if(__syncthreads_count(done_mask == ALL_DONE) >= 
static_cast<int>(BATCH_SIZE))
        {
            break;
        }
    }

    if(out_x < image_width)
    {
        TSR_UNROLL
        for(std::uint32_t p = 0; p < PIXELS_PER_THREAD; ++p)
        {
            if(out_y[p] < image_height)
            {
                render_alphas[pix_id[p]] = 1.0f - T[p];
                render_colors[pix_id[p]] = pix_out[p] + T[p] * 
surface_color[pix_id[p]];
                last_ids[pix_id[p]]      = last_offset[p];
            }
        }
    }
}

template<std::uint32_t TILE_SIZE, std::uint32_t CTA_SIZE>
void launch_variant(
    const ProjectedSplats &splats,
    const TileBinning &binning,
    const SurfaceLayer &surface,
    const Camera &camera,
    SplatRasterOutput &out,
    Stream stream
)
{
    const std::size_t smem = CTA_SIZE * (sizeof(std::int32_t) + 2 * 
sizeof(float3) + sizeof(float));
    TSR_CUDA_CHECK(cudaFuncSetAttribute(
        rasterize_splats_kernel<TILE_SIZE, CTA_SIZE>, 
cudaFuncAttributeMaxDynamicSharedMemorySize, static_cast<int>(smem)
    ));
    launch(
        rasterize_splats_kernel<TILE_SIZE, CTA_SIZE>, 
LaunchConfig{dim3(binning.n_tiles()), dim3(CTA_SIZE), smem, stream},
        splats.means2d.data(), splats.conics.data(), splats.colors.data(), 
splats.opacities.data(), splats.depths.data(),
        camera.width, camera.height, binning.tiles_x, 
binning.tile_offsets.data(), binning.sorted_splat_ids.data(),
        surface.color.data(), surface.depth.data(), out.color.data(), 
out.alpha.data(), out.last_contributor.data()
    );
}
} // namespace

void rasterize_splats(
    const ProjectedSplats &splats,
    const TileBinning &binning,
    const SurfaceLayer &surface,
    const Camera &camera,
    const SplatRasterSettings &settings,
    SplatRasterOutput &out,
    Stream stream
)
{
    TSR_CHECK(surface.width == static_cast<int>(camera.width) && surface.height 
== static_cast<int>(camera.height),
              "surface layer does not match the camera resolution");
    const std::size_t n = static_cast<std::size_t>(camera.width) * 
camera.height;
    out.width           = static_cast<int>(camera.width);
    out.height          = static_cast<int>(camera.height);
    out.color.resize(n);
    out.alpha.resize(n);
    out.last_contributor.resize(n);
    if(binning.n_tiles() == 0)
    {
        return;
    }

    switch(binning.tile_size)
    {
    case 16:
        if(settings.pixels_per_thread == 4)
        {
            launch_variant<16, 64>(splats, binning, surface, camera, out, 
stream);
        }
        else
        {
            launch_variant<16, 256>(splats, binning, surface, camera, out, 
stream);
        }
        break;
    case 8: launch_variant<8, 64>(splats, binning, surface, camera, out, 
stream); break;
    case 4: launch_variant<4, 16>(splats, binning, surface, camera, out, 
stream); break;
    default: TSR_CHECK(false, "unsupported tile size " << binning.tile_size << 
"; supported values are {4, 8, 16}");
    }
}
} // namespace tsr

