// Tessera - image files and image comparison.
#pragma once

#include <cstdint>
#include <string>
#include <vector>

#include "tsr/device/backend.h"

namespace tsr
{
struct Image8
{
    int width  = 0;
    int height = 0;
    std::vector<uchar4> pixels; // row-major, top row first
};

// Binary PPM (P6), alpha dropped on write and set to 255 on read.
void write_ppm(const std::string &path, int width, int height, const uchar4 
*pixels);
Image8 read_ppm(const std::string &path);

// Portable float map (PF), little endian. PFM stores the bottom row first;
// the writer flips so that `pixels` stays top row first.
void write_pfm(const std::string &path, int width, int height, const float3 
*pixels);

struct ImageDiff
{
    double psnr          = 0.0; // dB over RGB, infinity for identical images
    int max_abs_diff     = 0;   // largest channel difference
    std::size_t differing_pixels = 0;
};

ImageDiff compare_images(const Image8 &a, const Image8 &b);

} // namespace tsr
===include/tsr/sched/frame_scheduler.h
// Tessera - parallel rendering of many views.
//
// Fans views out over a host thread pool. Each worker owns a Renderer (its
// own stream, scratch arena and copy of the scene), the way a multi-GPU
// renderer would own one context per device, so views never share mutable
// state. Results are returned in camera order regardless of completion order.
#pragma once

#include <cstddef>
#include <functional>
#include <memory>
#include <mutex>
#include <vector>

#include "tsr/render/renderer.h"
#include "tsr/sched/thread_pool.h"

namespace tsr
{
class FrameScheduler
{
public:
    FrameScheduler(const Scene &scene, const RenderSettings &settings, 
std::size_t workers = 0);
    ~FrameScheduler();

    FrameScheduler(const FrameScheduler &)            = delete;
    FrameScheduler &operator=(const FrameScheduler &) = delete;

    std::vector<Frame> render_all(const std::vector<Camera> &cameras);

    // Calls on_frame(index, frame) from worker threads as views finish.
    // Blocks until every view is done; the first exception is rethrown.
    void render_each(const std::vector<Camera> &cameras, const 
std::function<void(std::size_t, Frame &&)> &on_frame);

    [[nodiscard]] std::size_t worker_count() const { return 
pool_.get_thread_count(); }

private:
    Renderer &renderer_for_this_thread();

    const Scene &scene_;
    RenderSettings settings_;
    sched::ThreadPool pool_;
    std::vector<std::unique_ptr<Renderer>> renderers_; // indexed by pool thread
    std::vector<std::once_flag> init_flags_;
};

} // namespace tsr

