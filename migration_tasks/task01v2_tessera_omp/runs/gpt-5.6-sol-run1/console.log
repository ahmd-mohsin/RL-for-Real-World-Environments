// Tessera - small fully connected network evaluated with tiled GEMMs.
//
// The GEMM kernel is the shared-memory tiling scheme of MatrixMulCUDA from the
// cuda-samples "matrixMul" sample (BSD-3-Clause), extended with bounds checks
// for arbitrary shapes and a fused bias + activation epilogue.
#include <cmath>

#include "tsr/encode/mlp.h"
#include "tsr/util/random.h"

namespace tsr
{
namespace
{
#pragma omp declare target
TSR_DI float activate(float x, Activation act) {
 switch(act){case Activation::ReLU:return fmaxf(x,0.f);case 
Activation::Sigmoid:return 1.f/(1.f+expf(-x));case Activation::None:break;} 
return x;
}
#pragma omp end declare target
} // namespace

void gemm_bias_act(
    const float *A,
    const float *B,
    const float *bias,
    float *C,
    std::uint32_t M,
    std::uint32_t N,
    std::uint32_t K,
    Activation act,
    Stream stream
)
{
    if(M == 0 || N == 0) return;
    const float *aa=A,*bb=B,*bi=bias; float *cc=C; int m=M,n=N,k=K; Activation 
activation=act;
#pragma omp target teams distribute parallel for collapse(2) 
is_device_ptr(aa,bb,bi,cc)
    for(int i=0;i<m;++i) for(int j=0;j<n;++j){float sum=0.f;
#pragma unroll 4
      for(int 
q=0;q<k;++q)sum+=aa[(std::size_t)i*k+q]*bb[(std::size_t)q*n+j];cc[(std::size_t)i
*n+j]=activate(sum+(bi?bi[j]:0.f),activation);}

}

void Mlp::initialize(std::uint32_t in_dim, std::uint32_t out_dim, const 
MlpConfig &config, std::uint32_t seed, Stream stream)
{
    TSR_CHECK(in_dim > 0 && out_dim > 0 && config.hidden_width > 0, "MLP 
dimensions must be positive");
    in_dim_  = in_dim;
    out_dim_ = out_dim;
    dims_.clear();
    dims_.push_back(in_dim);
    for(std::uint32_t l = 0; l < config.hidden_layers; ++l)
    {
        dims_.push_back(config.hidden_width);
    }
    dims_.push_back(out_dim);

    Pcg32 rng(seed, 0x9e3779b97f4a7c15ULL);
    weights_.clear();
    biases_.clear();
    weights_.resize(dims_.size() - 1);
    biases_.resize(dims_.size() - 1);
    for(std::size_t l = 0; l + 1 < dims_.size(); ++l)
    {
        const std::uint32_t fan_in  = dims_[l];
        const std::uint32_t fan_out = dims_[l + 1];
        const float limit           = std::sqrt(6.0f / static_cast<float>(fan_in
+ fan_out));
        std::vector<float> w(static_cast<std::size_t>(fan_in) * fan_out);
        for(float &v : w)
        {
            v = rng.uniform(-limit, limit);
        }
        weights_[l].upload(w, stream);
        biases_[l].upload(std::vector<float>(fan_out, 0.f), stream);
    }
}

void Mlp::forward(const float *input, std::uint32_t M, float *output, Arena 
&arena, Stream stream) const
{
    TSR_CHECK(!weights_.empty(), "MLP is not initialized");
    if(M == 0)
    {
        return;
    }
    const float *src = input;
    for(std::size_t l = 0; l < weights_.size(); ++l)
    {
        const bool last      = l + 1 == weights_.size();
        float *dst           = last ? output : 
arena.allocate<float>(static_cast<std::size_t>(M) * dims_[l + 1]);
        const Activation act = last ? Activation::Sigmoid : Activation::ReLU;
        gemm_bias_act(src, weights_[l].data(), biases_[l].data(), dst, M, 
dims_[l + 1], dims_[l], act, stream);
        src = dst;
    }
}
