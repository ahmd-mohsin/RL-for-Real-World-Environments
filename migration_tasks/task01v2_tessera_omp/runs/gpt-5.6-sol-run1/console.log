// Tessera - exposure and tone mapping of the linear composite.
//
// 1. log-average luminance (prims::reduce) sets the exposure so the scene's
//    key value maps to `key`
// 2. a 256-bin histogram of log2 exposed luminance (prims::histogram256) and
//    its prefix sum (prims::inclusive_scan) give the white point as a
//    luminance percentile
// 3. extended Reinhard maps luminance into [0, 1]; colours are encoded as sRGB
#pragma once

#include <array>
#include <cstdint>

#include "tsr/device/memory.h"

namespace tsr
{
struct TonemapSettings
{
    bool enabled           = true;  // false: clamp linear values and encode 
sRGB
    float key              = 0.18f; // target for the log-average luminance
    float white_percentile = 0.99f; // fraction of pixels darker than the white 
point
};

struct TonemapStats
{
    float log_average_luminance = 0.f;
    float exposure              = 1.f;
    float white_point           = 1.f; // exposed luminance mapped to 1
    std::array<std::uint32_t, 256> histogram{};
};

// Log2 luminance range covered by the histogram.
constexpr float kHistogramMinLog2 = -10.f;
constexpr float kHistogramMaxLog2 = 6.f;

void tonemap(
    const float3 *hdr,
    int width,
    int height,
    const TonemapSettings &settings,
    uchar4 *out,
    TonemapStats *stats,
    Arena &arena,
    cudaStream_t stream
);

// Host helpers shared with tests.
float linear_to_srgb(float x);
float srgb_to_linear(float x);

} // namespace tsr
// Tessera - binning of screen-space splats into image tiles.
//
// Every (splat, tile) overlap becomes an intersection with a 64-bit key
//
//     [ unused | tile id (tile_bits) | depth as IEEE-754 bits (32) ]
//
// Sorting the keys groups intersections by tile and orders each group front
// to back (positive floats compare like their bit patterns). The rasterizer
// then walks tile_offsets[t] .. tile_offsets[t + 1] of the sorted list.
#pragma once

#include <cstdint>

#include "tsr/device/memory.h"
#include "tsr/geom/camera.h"
#include "tsr/geom/projection.h"

namespace tsr
{
struct BinningSettings
{
    std::uint32_t tile_size = 16;
    // true: count only tiles the splat's ellipse actually touches (SnugBox +
    // AccuTile); false: every tile of the axis-aligned radius box.
    bool accurate = true;
};

struct TileBinning
{
    std::uint32_t tile_size = 0;
    std::uint32_t tiles_x   = 0;
    std::uint32_t tiles_y   = 0;
    std::uint32_t tile_bits = 0; // bits needed to encode a tile id
    std::uint32_t n_isects  = 0;

    DeviceBuffer<std::int64_t> tiles_per_splat; // after binning: inclusive 
prefix sum
    DeviceBuffer<std::uint64_t> keys;           // unsorted intersection keys
    DeviceBuffer<std::int32_t> splat_ids;       // unsorted splat index per 
intersection
    DeviceBuffer<std::uint64_t> sorted_keys;
    DeviceBuffer<std::int32_t> sorted_splat_ids;
    DeviceBuffer<std::int32_t> tile_offsets;    // [n_tiles + 1]; last entry == 
n_isects

    [[nodiscard]] std::uint32_t n_tiles() const { return tiles_x * tiles_y; }
};

// Number of bits needed to represent tile ids 0 .. n_tiles - 1.
std::uint32_t tile_id_bits(std::uint32_t n_tiles);

void bin_splats(
    const ProjectedSplats &splats,
    const Camera &camera,
    const BinningSettings &settings,
    TileBinning &out,
    Arena &arena,
    cudaStream_t stream
);

} // namespace tsr
// Tessera - coarse binning of mesh faces for the fine rasterizer.
//
// Bins are bin_size x bin_size squares of RASTER space (raster index grows
// towards +x/+y NDC, i.e. right-to-left and bottom-to-top in the image).
// bin_faces[bin][0 .. faces_per_bin[bin]) lists the faces whose (blurred)
// screen bounding boxes overlap the bin; unused slots hold -1.
#pragma once

#include <cstdint>

#include "tsr/device/memory.h"
#include "tsr/geom/mesh.h"

namespace tsr
{
struct MeshBinningSettings
{
    int bin_size          = 16;
    int max_faces_per_bin = 256;
    float blur_radius     = 0.f; // squared NDC distance, as in the fine 
rasterizer
};

struct MeshBins
{
    int bin_size          = 0;
    int bins_x            = 0;
    int bins_y            = 0;
    int max_faces_per_bin = 0;
    DeviceBuffer<std::int32_t> faces_per_bin; // [bins_y][bins_x]
    DeviceBuffer<std::int32_t> bin_faces;     // 
[bins_y][bins_x][max_faces_per_bin]
    // True if some bin received more faces than it can hold. The overflowing
    // faces are dropped, so the output may be incomplete.
    bool overflowed = false;
};

void bin_mesh_faces(
    const ViewFaces &faces,
    int width,
    int height,
    const MeshBinningSettings &settings,
    MeshBins &out,
    Arena &arena,
    cudaStream_t stream
);

} // namespace tsr

