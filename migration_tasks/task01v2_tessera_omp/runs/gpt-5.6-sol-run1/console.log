p='src/bin/mesh_bins.cpp';s=open(p).read();s=s.replace('if(pos<M)list[(std::size
_t)bin*M+pos]=f;else *overflow=1;','if(pos<M)list[(std::size_t)bin*M+pos]=f;else
{\n#pragma omp atomic update\n overflow[0]|=1;\n }');open(p,'w').write(s)
PY
# Remove local generated builds, including forbidden old source artifacts.
rm -rf build_cuda build_host build_omp build_testhost
# Static scan production names/content
find . -path './.git' -prune -o -path './tests' -prune -o \( -name '*.cu' -o 
-name '*.cuh' \) -print
grep -RInE 
'cudaStream_t|TSR_CUDA|__global__|__device__|__host__|<<<|>>>|CUDAToolkit|cudart
|enable_language\(CUDA|ompx_|__nvvm|__builtin_nvvm|TSR_BACKEND_EMU|device/emu|fi
ber' include src apps cmake CMakeLists.txt || true
git status --short | tail -80
