+#include <omp.h>
+#include "tsr/prims/prims.h"
+namespace tsr::prims { namespace {
+constexpr int RAD=256, LOGRAD=8, LANES=32, ROUNDS=32, TILE=LANES*ROUNDS;
+template<class K,class V>void radix(const K*ki,K*ko,const V*vi,V*vo,std::size_t n,int begin,int end,Arena&a){
+ if(!n)return;TSR_CHECK(begin>=0&&end>=begin&&end<=int(sizeof(K)*8),"invalid radix bit range");auto*tk=a.allocate<K>(n);auto*tv=a.allocate<V>(n);std::size_t nb=div_round_up(n,(std::size_t)TILE);auto*counts=a.allocate<std::uint32_t>(nb*RAD);auto*offsets=a.allocate<std::uint32_t>(nb*RAD);auto*totals=a.allocate<std::uint32_t>(RAD);
+ const K*srcK=ki;const V*srcV=vi;K*dstK=tk;V*dstV=tv;int pass=0;
+ for(int bit=begin;bit<end;bit+=LOGRAD,++pass){int width=min(LOGRAD,end-bit);unsigned mask=(1u<<width)-1;
+#pragma omp target teams num_teams(nb) thread_limit(128) is_device_ptr(srcK,counts)
+  {unsigned hist[RAD];int team=omp_get_team_num(),nteams=omp_get_num_teams();for(std::size_t block=team;block<nb;block+=nteams){
+#pragma omp parallel
+   {int t=omp_get_thread_num(),nt=omp_get_num_threads();for(int d=t;d<RAD;d+=nt)hist[d]=0;
+#pragma omp barrier
+    std::size_t base=block*TILE;for(int j=t;j<TILE;j+=nt){auto i=base+j;if(i<n){unsigned d=(unsigned)((srcK[i]>>bit)&mask);
+#pragma omp atomic update
+ hist[d]++;}}
+#pragma omp barrier
+    for(int d=t;d<RAD;d+=nt)counts[(std::size_t)d*nb+block]=hist[d];}}
+  }
+#pragma omp target teams num_teams(RAD) thread_limit(1) is_device_ptr(counts,offsets,totals)
+  {int d=omp_get_team_num(),nd=omp_get_num_teams();for(;d<RAD;d+=nd){unsigned run=0;for(std::size_t b=0;b<nb;++b){auto q=(std::size_t)d*nb+b;offsets[q]=run;run+=counts[q];}totals[d]=run;}}
+#pragma omp target teams num_teams(1) thread_limit(1) is_device_ptr(totals)
+  {unsigned run=0;for(int d=0;d<RAD;++d){unsigned x=totals[d];totals[d]=run;run+=x;}}
+#pragma omp target teams distribute parallel for collapse(2) is_device_ptr(offsets,totals)
+  for(int d=0;d<RAD;++d)for(std::size_t b=0;b<nb;++b)offsets[(std::size_t)d*nb+b]+=totals[d];
+#pragma omp target teams num_teams(nb) thread_limit(128) is_device_ptr(srcK,srcV,dstK,dstV,offsets)
+  {unsigned char digit[ROUNDS][LANES];unsigned prefix[ROUNDS][RAD];int team=omp_get_team_num(),nteams=omp_get_num_teams();for(std::size_t block=team;block<nb;block+=nteams){std::size_t base=block*TILE;
+#pragma omp parallel
+   {int t=omp_get_thread_num(),nt=omp_get_num_threads();for(int q=t;q<TILE;q+=nt){auto i=base+q;digit[q/LANES][q%LANES]=i<n?(unsigned char)((srcK[i]>>bit)&mask):255;}
+    for(int q=t;q<ROUNDS*RAD;q+=nt)prefix[q/RAD][q%RAD]=0;
+#pragma omp barrier
+    for(int q=t;q<TILE;q+=nt){auto i=base+q;if(i<n){unsigned d=digit[q/LANES][q%LANES];
+#pragma omp atomic update
+      prefix[q/LANES][d]++;}}
+#pragma omp barrier
+    for(int d=t;d<RAD;d+=nt){unsigned run=offsets[(std::size_t)d*nb+block];for(int r=0;r<ROUNDS;++r){unsigned c=prefix[r][d];prefix[r][d]=run;run+=c;}}
+#pragma omp barrier
+    for(int q=t;q<TILE;q+=nt){auto i=base+q;if(i<n){int r=q/LANES,l=q%LANES;unsigned d=digit[r][l],p=prefix[r][d];for(int x=0;x<l;++x)p+=digit[r][x]==d;dstK[p]=srcK[i];dstV[p]=srcV[i];}}}
+  }}
