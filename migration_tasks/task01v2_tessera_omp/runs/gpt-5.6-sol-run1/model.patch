+ }
+ if(srcK!=ko){
+#pragma omp target teams distribute parallel for is_device_ptr(srcK,srcV,ko,vo)
+  for(std::size_t i=0;i<n;++i){ko[i]=srcK[i];vo[i]=srcV[i];}}
+}
+}
