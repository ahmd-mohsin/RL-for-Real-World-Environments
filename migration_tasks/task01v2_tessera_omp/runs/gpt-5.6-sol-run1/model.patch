-    if(tl_ctx == nullptr)
-    {
-        fatal("device intrinsic used outside of a kernel");
-    }
-    return *tl_ctx;
-}
-
-void *dynamic_shared_memory()
-{
-    current_thread();
-    return tl_res.smem.empty() ? nullptr : tl_res.smem.data();
-}
