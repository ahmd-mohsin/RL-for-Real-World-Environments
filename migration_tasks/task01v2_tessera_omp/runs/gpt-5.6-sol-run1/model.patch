+#include <omp.h>
+#include <limits>
+#include "tsr/prims/prims.h"
+namespace tsr::prims { namespace {
+template<class T> T ident(ReduceOp op){return op==ReduceOp::Sum?T(0):(op==ReduceOp::Max?std::numeric_limits<T>::lowest():std::numeric_limits<T>::max());}
+template<class T> void impl(const T*in,std::size_t n,T*out,ReduceOp op,Arena&a){
+ if(!n){T v=ident<T>(op);detail::copy_to_device(out,&v,sizeof(v));return;} constexpr int NB=256; T*part=a.allocate<T>(NB); T identity=ident<T>(op);
+#pragma omp target teams distribute parallel for is_device_ptr(part)
+ for(int i=0;i<NB;++i)part[i]=identity;
+#pragma omp target teams num_teams(NB) thread_limit(256) is_device_ptr(in,part)
+ {T vals[256];int team=omp_get_team_num(),nteams=omp_get_num_teams();
+#pragma omp parallel
+  {int t=omp_get_thread_num(),nt=omp_get_num_threads();T x=ident<T>(op);for(std::size_t i=team*(std::size_t)nt+t;i<n;i+=(std::size_t)nteams*nt){T v=in[i];x=op==ReduceOp::Sum?x+v:(op==ReduceOp::Max?(x>v?x:v):(x<v?x:v));}vals[t]=x;
+#pragma omp barrier
+   for(int s=(nt+1)/2;s>0;s=(s+1)/2){if(t<s&&t+s<nt){T v=vals[t+s];vals[t]=op==ReduceOp::Sum?vals[t]+v:(op==ReduceOp::Max?(vals[t]>v?vals[t]:v):(vals[t]<v?vals[t]:v));}
+#pragma omp barrier
+    if(s==1)break;}
+   if(t==0)part[team]=vals[0];}}
+#pragma omp target teams num_teams(1) thread_limit(256) is_device_ptr(part,out)
+ {T vals[256];
+#pragma omp parallel
+  {int t=omp_get_thread_num(),nt=omp_get_num_threads();T x=ident<T>(op);for(int i=t;i<NB;i+=nt){T v=part[i];x=op==ReduceOp::Sum?x+v:(op==ReduceOp::Max?(x>v?x:v):(x<v?x:v));}vals[t]=x;
+#pragma omp barrier
+   for(int s=(nt+1)/2;s>0;s=(s+1)/2){if(t<s&&t+s<nt){T v=vals[t+s];vals[t]=op==ReduceOp::Sum?vals[t]+v:(op==ReduceOp::Max?(vals[t]>v?vals[t]:v):(vals[t]<v?vals[t]:v));}
+#pragma omp barrier
+    if(s==1)break;}if(t==0)*out=vals[0];}}
+}
+}
+template<class T>void reduce(const T*i,std::size_t n,T*o,ReduceOp op,Arena&a,Stream){impl(i,n,o,op,a);} 
+template void reduce<float>(const float*,std::size_t,float*,ReduceOp,Arena&,Stream);template void reduce<std::uint32_t>(const std::uint32_t*,std::size_t,std::uint32_t*,ReduceOp,Arena&,Stream);template void reduce<std::int32_t>(const std::int32_t*,std::size_t,std::int32_t*,ReduceOp,Arena&,Stream);
+}
