+namespace tsr { namespace {
+constexpr float kFaceEpsilon=1e-8f; constexpr int kMaxBinsPerSide=88;
+#pragma omp declare target
+void face_bbox(int f,const float3*v,float blur,float4*bb,std::uint8_t*skip){float r=sqrtf(blur);auto a=v[3*f],b=v[3*f+1],c=v[3*f+2];bb[f]=make_float4(fminf(a.x,fminf(b.x,c.x))-r,fmaxf(a.x,fmaxf(b.x,c.x))+r,fminf(a.y,fminf(b.y,c.y))-r,fmaxf(a.y,fmaxf(b.y,c.y))+r);skip[f]=fminf(a.z,fminf(b.z,c.z))<kFaceEpsilon;}
+#pragma omp end declare target
+}
+void bin_mesh_faces(const ViewFaces&faces,int width,int height,const MeshBinningSettings&s,MeshBins&out,Arena&arena,Stream){
+ TSR_CHECK(s.bin_size>0,"bin size must be positive");TSR_CHECK(s.max_faces_per_bin>0,"max_faces_per_bin must be positive");
+ out.bin_size=s.bin_size;out.bins_x=1+(width-1)/s.bin_size;out.bins_y=1+(height-1)/s.bin_size;out.max_faces_per_bin=s.max_faces_per_bin;out.overflowed=false;
+ TSR_CHECK(out.bins_x<kMaxBinsPerSide&&out.bins_y<kMaxBinsPerSide,"too many bins ("<<out.bins_x<<" x "<<out.bins_y<<"); increase bin_size");
+ int nb=out.bins_x*out.bins_y,F=faces.n_faces,M=s.max_faces_per_bin;out.faces_per_bin.resize(nb);out.bin_faces.resize((std::size_t)nb*M);out.faces_per_bin.zero();detail::device_memset(out.bin_faces.data(),0xff,out.bin_faces.bytes());if(!F)return;
+ auto*bb=arena.allocate<float4>(F);auto*skip=arena.allocate<std::uint8_t>(F);auto*overflow=arena.allocate<int>(1);detail::device_memset(overflow,0,sizeof(int));auto*v=faces.ndc.data();
+#pragma omp target teams distribute parallel for is_device_ptr(v,bb,skip)
+ for(int f=0;f<F;++f)face_bbox(f,v,s.blur_radius,bb,skip);
+ auto*counts=out.faces_per_bin.data();auto*list=out.bin_faces.data();int bxN=out.bins_x,byN=out.bins_y,bs=s.bin_size,W=width,H=height;
+#pragma omp target teams distribute parallel for is_device_ptr(bb,skip,counts,list,overflow)
+ for(int f=0;f<F;++f){if(skip[f])continue;float4 b=bb[f];float rx=geom::non_square_ndc_range(W,H),ry=geom::non_square_ndc_range(H,W);int x0=max(0,min(bxN-1,(int)floorf(((b.x/rx+.5f)*W)/bs)));int x1=max(0,min(bxN-1,(int)floorf(((b.y/rx+.5f)*W)/bs)));int y0=max(0,min(byN-1,(int)floorf(((b.z/ry+.5f)*H)/bs)));int y1=max(0,min(byN-1,(int)floorf(((b.w/ry+.5f)*H)/bs)));
+  float hpx=rx*.5f/W,hpy=ry*.5f/H;
+  for(int by=y0;by<=y1;++by){float ymin=geom::pix_to_non_square_ndc(by*bs,H,W)-hpy;float ymax=geom::pix_to_non_square_ndc((by+1)*bs-1,H,W)+hpy;bool yo=b.z<=ymax&&ymin<b.w;if(!yo)continue;for(int bx=x0;bx<=x1;++bx){float xmax=geom::pix_to_non_square_ndc((bx+1)*bs-1,W,H)+hpx;float xmin=geom::pix_to_non_square_ndc(bx*bs,W,H)-hpx;if(b.x<=xmax&&xmin<b.y){int bin=by*bxN+bx,pos;
+#pragma omp atomic capture
+ {pos=counts[bin];counts[bin]++;}
+ if(pos<M)list[(std::size_t)bin*M+pos]=f;else {
+#pragma omp atomic update
+ overflow[0]|=1;
+ }}}}}
+ // Atomics deliberately permit arbitrary insertion; restore the documented face order.
+#pragma omp target teams distribute parallel for is_device_ptr(counts,list)
+ for(int bin=0;bin<nb;++bin){int n=min(counts[bin],M);for(int i=1;i<n;++i){int x=list[(std::size_t)bin*M+i],j=i;while(j&&list[(std::size_t)bin*M+j-1]>x){list[(std::size_t)bin*M+j]=list[(std::size_t)bin*M+j-1];--j;}list[(std::size_t)bin*M+j]=x;}}
+ int ov=0;detail::copy_from_device(&ov,overflow,sizeof(ov));out.overflowed=ov!=0;
+}
+}
