-            values_out[pos]         = values[k];
-        }
-    }
-}
-} // namespace
-
-template<typename K, typename V>
-void radix_sort_pairs(
-    const K *keys_in,
-    K *keys_out,
-    const V *values_in,
-    V *values_out,
-    std::size_t n,
