-int worker_count()
-{
-    static const int n = []
-    {
-        const unsigned hw     = std::thread::hardware_concurrency();
-        const std::size_t def = std::min<std::size_t>(8, hw == 0 ? 1 : hw);
-        return static_cast<int>(env_size("TSR_EMU_WORKERS", def));
-    }();
-    return n;
-}
