    "policies": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "stages": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "tasks": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "type": "object"
  },
  "RewardSpec": {
   "additionalProperties": false,
   "properties": {
    "higher_is_better": {
     "default": true,
     "type": "boolean"
    },
    "range": {
     "default": [
      0.0,
      1.0
     ],
     "maxItems": 2,
     "minItems": 2,
     "prefixItems": [
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "type": "array"
    }
   },
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "authors": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "description": {
   "type": "string"
  },
  "determinism": {
   "default": "seeded",
   "enum": [
    "seeded",
    "nondeterministic"
   ],
   "type": "string"
  },
  "entry_point": {
   "type": "string"
  },
  "hooks": {
   "$ref": "#/$defs/PackHooks"
  },
