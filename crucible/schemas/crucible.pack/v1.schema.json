{
 "$defs": {
  "IngestSpec": {
   "additionalProperties": false,
   "properties": {
    "connector": {
     "default": "file_drop",
     "type": "string"
    },
    "discover": {
     "default": "discover",
     "type": "string"
    },
    "extra": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "family": {
     "type": "string"
    },
    "glob": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "init": {
     "additionalProperties": true,
     "type": "object"
    },
    "label": {
     "default": true,
     "type": "boolean"
    },
    "redaction_env": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "redaction_env_optional": {
     "default": false,
     "type": "boolean"
    },
    "root": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "scope": {
     "additionalProperties": true,
     "type": "object"
    }
   },
   "required": [
    "family"
   ],
   "type": "object"
  },
  "LabelSpec": {
   "additionalProperties": false,
   "properties": {
    "policy_roles": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "threshold": {
     "default": 1.0,
     "type": "number"
    }
   },
   "type": "object"
  },
  "PackHooks": {
   "additionalProperties": false,
   "properties": {
    "credit": {
