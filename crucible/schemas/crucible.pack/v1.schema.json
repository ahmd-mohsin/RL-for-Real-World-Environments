   "items": {
    "$ref": "#/$defs/IngestSpec"
   },
   "type": "array"
  },
  "kind": {
   "default": "domain",
   "enum": [
    "domain",
    "coding",
    "toy"
   ],
   "type": "string"
  },
  "label": {
   "$ref": "#/$defs/LabelSpec"
  },
  "license": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "package": {
   "type": "string"
  },
  "requires": {
   "items": {
    "enum": [
     "docker",
     "gpu",
     "network",
     "paid"
    ],
    "type": "string"
   },
   "type": "array"
  },
  "reward": {
   "$ref": "#/$defs/RewardSpec"
  },
  "schema_version": {
   "const": 1,
   "default": 1,
   "type": "integer"
  },
  "template_version": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "name",
  "version",
  "description",
  "license",
  "package",
  "entry_point"
 ],
 "type": "object"
}
